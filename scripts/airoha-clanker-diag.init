#!/bin/sh /etc/rc.common
# One boot snapshot after netifd/hostapd have had time to configure the radios.
START=99
USE_PROCD=1

start_service() {
	[ -r /sys/bus/platform/devices/1e900000.npu/clanker_status ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/airoha-clanker-diag --boot-wifi
	procd_close_instance
}
