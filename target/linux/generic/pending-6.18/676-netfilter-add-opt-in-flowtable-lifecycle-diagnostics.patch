Subject: [PATCH] netfilter: add opt-in flowtable lifecycle diagnostics

An accepted hardware rule can be withdrawn before the first stats poll.
Record teardown callers, GC decisions, closing and explicit device cleanup
under a default-off, root-only module parameter. Keep all lifecycle policy
unchanged. Cookies correlate with the Airoha ppe_debug flower diagnostics.

--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -3,5 +3,6 @@
 #include <linux/init.h>
 #include <linux/module.h>
+#include <linux/moduleparam.h>
 #include <linux/netfilter.h>
 #include <linux/rhashtable.h>
 #include <linux/netdevice.h>
@@ -18,6 +19,19 @@
 static DEFINE_MUTEX(flowtable_lock);
 static LIST_HEAD(flowtables);
 
+static bool flowtable_debug;
+module_param(flowtable_debug, bool, 0600);
+MODULE_PARM_DESC(flowtable_debug, "Rate-limited flowtable lifecycle diagnostics");
+
+#define flowtable_diag(flow, fmt, ...) \
+	do { \
+		if (READ_ONCE(flowtable_debug)) \
+			pr_info_ratelimited("flowtable-diag: orig=%lx reply=%lx flags=%lx " fmt, \
+				(unsigned long)&(flow)->tuplehash[0].tuple, \
+				(unsigned long)&(flow)->tuplehash[1].tuple, \
+				(flow)->flags, ##__VA_ARGS__); \
+	} while (0)
+
 static void
 flow_offload_fill_dir(struct flow_offload *flow,
 		      enum flow_offload_tuple_dir dir)
@@ -403,7 +417,10 @@ void flow_offload_teardown(struct flow_offload *flow)
 {
 	clear_bit(IPS_OFFLOAD_BIT, &flow->ct->status);
-	if (!test_and_set_bit(NF_FLOW_TEARDOWN, &flow->flags))
+	if (!test_and_set_bit(NF_FLOW_TEARDOWN, &flow->flags)) {
+		flowtable_diag(flow, "teardown caller=%pS ct_status=%lx\n",
+			       (void *)_RET_IP_, flow->ct->status);
 		flow_offload_fixup_ct(flow);
+	}
 }
 EXPORT_SYMBOL_GPL(flow_offload_teardown);
 
@@ -622,6 +641,9 @@ static void nf_flow_offload_gc_step(struct nf_flowtable *flow_table,
 	if (nf_flow_has_expired(flow) ||
 	    nf_ct_is_dying(flow->ct) ||
 	    nf_flow_custom_gc(flow_table, flow)) {
+		flowtable_diag(flow, "gc-teardown table=%p expired=%u dying=%u delta=%d\n",
+			       flow_table, nf_flow_has_expired(flow),
+			       nf_ct_is_dying(flow->ct), nf_flow_timeout_delta(flow->timeout));
 		flow_offload_teardown(flow);
 		teardown = true;
 	} else if (!teardown) {
@@ -641,6 +663,7 @@ static void nf_flow_offload_gc_step(struct nf_flowtable *flow_table,
 	} else if (test_bit(NF_FLOW_CLOSING, &flow->flags) &&
 		   test_bit(NF_FLOW_HW, &flow->flags) &&
 		   !test_bit(NF_FLOW_HW_DYING, &flow->flags)) {
+		flowtable_diag(flow, "gc-closing table=%p\n", flow_table);
 		nf_flow_offload_del(flow_table, flow);
 	} else if (test_bit(NF_FLOW_HW, &flow->flags)) {
 		nf_flow_offload_stats(flow_table, flow);
@@ -806,6 +829,8 @@ static void nf_flow_table_do_cleanup(struct nf_flowtable *flow_table,
 	struct net_device *dev = data;
 
 	if (!dev) {
+		flowtable_diag(flow, "cleanup table=%p dev=all\n",
+			       flow_table);
 		flow_offload_teardown(flow);
 		return;
 	}
@@ -813,7 +838,10 @@ static void nf_flow_table_do_cleanup(struct nf_flowtable *flow_table,
 	if (net_eq(nf_ct_net(flow->ct), dev_net(dev)) &&
 	    (flow->tuplehash[0].tuple.iifidx == dev->ifindex ||
-	     flow->tuplehash[1].tuple.iifidx == dev->ifindex))
+	     flow->tuplehash[1].tuple.iifidx == dev->ifindex)) {
+		flowtable_diag(flow, "cleanup table=%p dev=%s ifindex=%d\n",
+			       flow_table, dev->name, dev->ifindex);
 		flow_offload_teardown(flow);
+	}
 }
 
 void nf_flow_table_gc_cleanup(struct nf_flowtable *flowtable,
