/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "an7581.dtsi"



/memreserve/ 0x80000000 0x200000;

/ {
	model = "FiberHome AN4475-G2";
	compatible = "fiberhome,an4475-g2", "airoha,an7581", "airoha,en7581";

	aliases {
		label-mac-device = &lan_2p5g;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;

		serial0 = &uart1;
	};

	chosen {
		rootdisk = <&ubi_fit>;
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
	};
  
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		key-wlan {
			label = "wlan";
			linux,code = <KEY_WLAN>;
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			label = "green:power";
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&en7581_pinctrl 35 GPIO_ACTIVE_LOW>;
			default-state = "on";
			panic-indicator;
		};

	};

	pwmleds {
		compatible = "pwm-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pwm_gpio18_idx10_pins>;

		led-pon {
			label = "pon:green";
			pwms = <&en7581_pwm 10 4000000 0>;
			max-brightness = <255>;
			active-low;
		};
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "fixed-3.3V";
	};
};


&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};
	};

	pon_pins: pon-pins {
		mux {
			/* Leave pad gpio38 / TX_DISABLE under optical frontend control. */
			function = "pon";
			groups = "pon_tx_disable_gpio";
		};
	};

	i2c1_pins: i2c1-pins {
		mux {
			function = "i2c";
			groups = "i2c1";
		};
	};

	pcie0_rst_pins: pcie0-rst-pins {
		conf {
			pins = "pcie_reset0";
			drive-open-drain = <1>;
		};
	};

	pcie1_rst_pins: pcie1-rst-pins {
		conf {
			pins = "pcie_reset1";
			drive-open-drain = <1>;
		};
	};

	gswp3_led0_pins: gswp3-led0-pins {
		mux {
			function = "phy3_led0";
			pins = "gpio35";
		};
	};

	gswp4_led0_pins: gswp4-led0-pins {
		mux {
			function = "phy4_led0";
			pins = "gpio42";
		};
	};

	pwm_gpio18_idx10_pins: pwm-gpio18-idx10-pins {
		function = "pwm";
		pins = "gpio18";
		output-enable;
	};
};

&snfi {
	status = "okay";
};

&npu {
	status = "okay";
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";
};

&mdio {

	phy_2p5g: ethernet-phy@f {
		compatible = "ethernet-phy-id001c.c849";
		reg = <0xf>;
		reset-gpios = <&en7581_pinctrl 31 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <20000>;
	};
};

&eth_pcs {
	status = "okay";
};

&usb_pcs {
	status = "okay";
};

&gdm4 {
	/delete-property/ pcs-handle;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/*
	 * 2.5GE combo port (panel "2.5G内网1/外网1"). Only the copper
	 * side is described: RTL8221B on MDIO 0xf via eth_pcs HSGMII.
	 * TODO(verify): the SFP/fiber side of the combo is not modelled --
	 * check whether the board muxes it in hardware (then no DT node is
	 * needed) or needs an sfp node / GPIO detect line.
	 */
	lan_2p5g: ethernet-port@0 {
		compatible = "airoha,eth-port";
		reg = <0>;
		pcs-handle = <&eth_pcs>;
		phy-handle = <&phy_2p5g>;
		phy-mode = "2500base-x";
		openwrt,netdev-name = "lan1";
	};

	fttr_2p5g: ethernet-port@1 {
		compatible = "airoha,eth-port";
		reg = <1>;
		pcs-handle = <&usb_pcs>;
		phy-mode = "2500base-x";
		openwrt,netdev-name = "fttr0";

		fixed-link {
			speed = <2500>;
			full-duplex;
		};
	};
};

&switch {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
	status = "okay";
};


&gsw_port1 {
	label = "lan2";
	status = "okay";
};

&gsw_phy1 {
	interrupts = <1>;
	status = "okay";
};

&gsw_port2 {
	label = "lan3";
	status = "okay";
};

&gsw_phy2 {
	interrupts = <2>;
	status = "okay";
};

&gsw_port3 {
	label = "lan4";
	status = "okay";
};

&gsw_phy3 {
	interrupts = <3>;
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp3_led0_pins>;
	status = "okay";
};

&gsw_phy3_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <3>;
	active-low;
	status = "okay";
};

&gsw_port4 {
	label = "lan5";
	status = "okay";
};

&gsw_phy4 {
	interrupts = <4>;
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp4_led0_pins>;
	status = "okay";
};

&gsw_phy4_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <4>;
	active-low;
	status = "okay";
};

&usb1 {
	status = "okay";
	mediatek,u3p-dis-msk = <0x1>;
	phys = <&usb1_phy PHY_TYPE_USB2>;
	vusb33-supply = <&reg_3p3v>;
	#address-cells = <1>;
	#size-cells = <0>;

	usb_port2: port@1 {
		reg = <1>;
		#trigger-source-cells = <0>;
	};
};

&i2c0 {
	status = "okay";

	
	an4475_bosa: optical-front-end@51 {
		
		compatible = "fiberhome,hg5x-bosa", "airoha,paged-bosa";
		reg = <0x51>;
		fiberhome,ben-active-high;
		tx-disable-gpios = <&en7581_pinctrl 38 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
};

&pon_pcs {
	status = "okay";
};

&xpon_mac {
	pinctrl-names = "default";
	pinctrl-0 = <&pon_pins>;
	optical-front-end = <&an4475_bosa>;
	data-path = <&gdm2>;
	status = "okay";
};

&gdm2 {
	
	airoha,pon-data-path;
	status = "okay";
};


&pcie0 {
	status = "okay";
	max-link-speed = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_rst_pins>;

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;

		wifi_main: wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			airoha,npu = <&npu>;
			airoha,eth = <&eth>;

			wifi_band0: band@0 {
				reg = <0>;
			};

			wifi_band1: band@1 {
				reg = <1>;
			};
		};
	};
};

&pcie1 {
	status = "okay";
	max-link-speed = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_rst_pins>;

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;

		wifi_companion: wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			airoha,npu = <&npu>;
			airoha,eth = <&eth>;
		};
	};
};




&spi_nand {
	/* Same geometry as the upstream W1700K / Q1000K SPI-NAND boards.
	 * The controller owns its ECC engine; no nand-ecc-engine phandle is
	 * needed (and pointing it at the NAND node itself would be wrong). */
	#address-cells = <1>;
	#size-cells = <1>;

	partitions: partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bl2";
			reg = <0x00000000 0x00020000>;
			read-only;
		};

		partition@20000 {
			label = "ubi";
			/* 0x20000 + 0x1d7e0000 = 0x1d800000: exactly the end of the
			 * vendor 10-partition table. The last 40 MiB of the
			 * 512 MiB NAND stays untouched for airoha,bmt / BBT.
			 * (The old 0x1d600000 value ended at 0x1d620000 and
			 * silently dropped ~1.875 MiB / 15 PEBs.) */
			reg = <0x00020000 0x1d7e0000>;
			compatible = "linux,ubi";

			volumes {
				ubi_fip: ubi-volume-fip {
					/* BL31 + U-Boot second-stage FIP. */
					volname = "fip";
				};

				ubi_env: ubi-volume-ubootenv {
					volname = "ubootenv";
				};

				ubi_env2: ubi-volume-ubootenv2 {
					volname = "ubootenv2";
				};

				ubi_factory: ubi-volume-factory {
					volname = "factory";
				};

				ubi_fit: ubi-volume-fit {
					/* kernel + read-only rootfs FIT image. */
					volname = "fit";
				};
			};
		};
	};
};

&ubi_env {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool-layout";
	};
};

&ubi_env2 {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool-layout";
	};
};



&gdm1 {
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 1>;
};

&gdm2 {
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 0>;
};

&lan_2p5g {
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 0>;
};

&fttr_2p5g {
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 3>;
};

/* GE ports 1..4 = lan2..lan5, consecutive derived MACs base+5..base+8.
 * (Upstream H3C uses +6/+7/+8 for ports 2/3/4, so port1 is +5.) */
&gsw_port1 {
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 5>;
};

&gsw_port2 {
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 6>;
};

&gsw_port3 {
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 7>;
};

&gsw_port4 {
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 8>;
};

&xpon_mac {
	nvmem-cell-names = "pon-serial";
	nvmem-cells = <&pon_serial>;
};

&an4475_bosa {
	nvmem-cell-names = "calibration";
	nvmem-cells = <&pon_calibration>;
};


&wifi_main {
	nvmem-cell-names = "eeprom";
	nvmem-cells = <&wifi_eeprom>;
	/* No mediatek,eeprom-merge-otp here: mt7996/mcu.c already merges the
	 * 19-byte ADIE0 cal-free efuse data into 0x44c..0x471 / 0xb90..0xbaa
	 * unconditionally, and no upstream mt76 board declares this property.
	 * Adding an unbound property only makes dt-validate complain. */
};



&ubi_factory {
	nvmem-layout {
		compatible = "fixed-layout";
		#address-cells = <1>;
		#size-cells = <1>;

		container_magic: magic@0 {
			reg = <0x000000 0x000008>;
		};

		device_serial: device-serial@20 {
			reg = <0x000020 0x000018>;
		};

		pon_serial: pon-serial@38 {
			reg = <0x000038 0x000008>;
		};

		base_mac: base-mac@40 {
			compatible = "mac-base";
			reg = <0x000040 0x000006>;
			#nvmem-cell-cells = <1>;
		};

		wifi_mac_2g4: wifi-mac-2g4@96 {
			reg = <0x000096 0x000006>;
		};

		wifi_mac_5g: wifi-mac-5g@9c {
			reg = <0x00009c 0x000006>;
		};

		vendor_eeprom: eeprom-vendor@40000 {
			reg = <0x040000 0x14a800>;
		};

		pon_cal_10ge_asym: calibration-10ge-asym@1a0000 {
			reg = <0x1a0000 0x000800>;
		};

		pon_cal_10ge_sym: calibration-10ge-sym@1a1000 {
			reg = <0x1a1000 0x000800>;
		};

		pon_cal_xg: calibration-xg@1a2000 {
			reg = <0x1a2000 0x000800>;
		};

		pon_cal_xgs: calibration-xgs@1a3000 {
			reg = <0x1a3000 0x000800>;
		};

		pon_calibration: calibration@1a4000 {
			reg = <0x1a4000 0x000800>;
		};

		pon_cal_olt_downlink: calibration-olt-downlink@1a5000 {
			reg = <0x1a5000 0x000800>;
		};

		apd_wtd01: apd-wtd01@1a6000 {
			reg = <0x1a6000 0x00012a>;
		};

		apd_ys01: apd-ys01@1a7000 {
			reg = <0x1a7000 0x00012c>;
		};

		bosa_info: bosa-info@1a8000 {
			reg = <0x1a8000 0x0000e6>;
		};

		bosa_rssi: bosa-rssi@1a9000 {
			reg = <0x1a9000 0x0000cc>;
		};

		lan_optic_tx: lan-optic-tx-calib@1aa000 {
			reg = <0x1aa000 0x000218>;
		};

		wifi_eeprom: eeprom@1ab000 {
			reg = <0x1ab000 0x001e00>;
		};
	};
};

