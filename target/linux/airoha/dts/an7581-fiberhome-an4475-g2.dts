// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
/dts-v1/;

/memreserve/ 0x80000000 0x200000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/clock/en7523-clk.h>
#include <dt-bindings/reset/airoha,en7581-reset.h>
#include "an7581.dtsi"

/* ==========================================================================
 * 2.5G 口（LAN1）—— 当前只按电口配置
 *
 * 硬件本身是光电复用：gdm4 的 eth_pcs SerDes 走同一对差分，两个对端二选一
 *   电口 -> 板载 RTL8221B / YT8821（MDIO 7，HSGMII 2.5G）
 *   光口 -> 光模块直连 SerDes（无 PHY，链路只能靠 PCS 带内状态）
 * 媒体选择由 GPIO22/23 完成（原厂电平：电口 22=0 23=1；光口 22=1 23=0）
 *
 * 本版只做电口，光口的东西一律不写：
 *   - combo_mux_sel0/1 直接锁在电口电平；
 *   - phy_2p5g 正常启用，用 reset-gpios 管 GPIO30；
 *   - gdm4 = phy-handle + "2500base-x"，就是普通外置 PHY 接法。
 *
 * 为什么不做成 #if 双分支：
 *   光口要的是 managed = "in-band-status"，而且**必须没有 phy-handle** ——
 *   phylink 在 MLO_AN_INBAND 分支里，只要 pl->phydev 存在就一律取 PHY 状态、
 *   彻底忽略 PCS 带内状态；phy-mode 又只在 probe 时读一次（of_get_phy_mode）。
 *   电口和光口本来就是两份互斥配置，塞在一个文件里靠宏切换，
 *   只会让人误以为能热切。等真要做光口，另出一份 DTS 更干净。
 * ========================================================================== */

/* ==========================================================================
 * 下行 PON（PON-SPI 上的 fsl OLT MAC + UX3326S 光模块）总开关
 *
 * 0 = 只保留拓扑描述，不启用：
 *     - spi@1fbd4000 保持 disabled，fsl 子节点不实例化；
 *     - GPIO4（fsl 复位）用 hog 按住，状态确定、不浮空。
 * 1 = 启用：
 *     - spi@1fbd4000 改 okay，pinctrl 把 pin18..25 切成 pcm_spi；
 *     - 删掉 GPIO4 的 hog，把复位交给 fsl 的 reset-gpios。
 *
 * !! 现在只能填 0。主线与 ponwrt 都没有 0x1fbd4000 这颗 SPI 控制器的
 *    驱动（spi-airoha-snfi 只 match 0x1fa10000 的 SNAND），填 1 也只是
 *    让一个没人 probe 的节点变成 okay，fsl 仍然起不来。
 *    等 drivers/spi/spi-airoha-pcm.c 进树后，这一行改成 1 即可。
 * ========================================================================== */
#define AN4475_DOWNSTREAM_PON		0

/ {
	model = "FiberHome AN4475-G2";
	compatible = "fiberhome,an4475-g2", "airoha,an7581", "airoha,en7581";

	aliases {
		label-mac-device = &gdm2;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;

		serial0 = &uart1;
	};

	chosen {
		rootdisk = <&ubi_fit>;
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	/* 原厂用的是 gpio-keys-polled，且只有一个 reset_ 键：
	 *   gpios = <0 GPIO_ACTIVE_LOW>;  linux,code = <KEY_RESTART>;
	 * 这里换成中断式 gpio-keys（省掉 poll-interval 100ms 的常驻开销）。
	 * key-wlan(GPIO17) 原厂无对应项，是按面板有 WPS 键倒推的；
	 * 若该键在系统里自触发，先把它删掉再排查。
	 */
	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		key-wlan {
			label = "wlan";
			linux,code = <KEY_WLAN>;
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	/* 证据等级说明（原厂 DTB /leds 只有 4 个子节点：
	 *   pwr_led              GPIO35 AL   -> ✅ 与下面 led_power 一致
	 *   phy_tx_power_disable GPIO38 AH   -> 由 &an4475_bosa 的 tx-disable-gpios 表达
	 *   phy_tx_ben           GPIO41 AH   -> 已删除 hog，交给 PON 硬件（见 pinctrl 段）
	 *   an8811_reset         GPIO31 AL   -> 本机型不贴 EN8811H，不驱动（见 pinctrl 段）
	 * 下面 led_wlan(15) 与 led_lan2..5(43..46) 在原厂 DTB / led_cfg 里
	 * 都找不到对应项（led_cfg 里所有 *_led 全是 value '0'），属于按面板
	 * 实测补的。若上机发现某颗灯乱闪或常亮，先怀疑这几行。
	 */
	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&en7581_pinctrl 35 GPIO_ACTIVE_LOW>;
			default-state = "on";
			panic-indicator;
		};

		led_wlan: led-wlan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			gpios = <&en7581_pinctrl 15 GPIO_ACTIVE_LOW>;
		};

		led_lan2: led-lan2 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <2>;
			gpios = <&en7581_pinctrl 43 GPIO_ACTIVE_LOW>;
		};

		led_lan3: led-lan3 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <3>;
			gpios = <&en7581_pinctrl 44 GPIO_ACTIVE_LOW>;
		};

		led_lan4: led-lan4 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <4>;
			gpios = <&en7581_pinctrl 45 GPIO_ACTIVE_LOW>;
		};

		led_lan5: led-lan5 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <5>;
			gpios = <&en7581_pinctrl 46 GPIO_ACTIVE_LOW>;
		};

		/* ---- LOS / USB 两颗仍无实证，量到焊盘再开 -------------------
		 * LOS：led_cfg 里 los_led=0，脚本和原厂 DTB 都没有引脚；
		 * USB：整个镜像搜不到任何引用。
		 *
		 * led_los: led-los {
		 *	color = <LED_COLOR_ID_RED>;
		 *	function = LED_FUNCTION_WAN;
		 *	gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
		 *	linux,default-trigger = "pon0-los";
		 * };
		 *
		 * led_usb: led-usb {
		 *	color = <LED_COLOR_ID_GREEN>;
		 *	function = LED_FUNCTION_USB;
		 *	gpios = <&en7581_pinctrl 34 GPIO_ACTIVE_LOW>;
		 * };
		 */
	};

	/* PON LED: stock FDT
	 *   pwmleds { lan4_green { label = "pon:green";
	 *                         pwms = <&pwm 0xa 0x3d0900 0x1>; }; };
	 * i.e. PWM channel 10 (0xa), period 0x3d0900 = 4 ms, polarity 1
	 * (= PWM_POLARITY_INVERTED), max-brightness 0xff. The node name
	 * "lan4_green" in the vendor DTB is a copy-paste leftover; the label is
	 * what matters.
	 *
	 * NOTE: the vendor PWM driver supports inverted polarity, the mainline
	 * airoha PWM driver does NOT (pwm_apply_state() rejects it, which made
	 * leds_pwm probe fail with -22). Flags are therefore 0 (normal) here.
	 * If the LED is wired active-low, brightness semantics become inverted
	 * vs. stock (0 = on, 255 = off). Verify visually after flashing.
	 */
	pwmleds {
		compatible = "pwm-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pwm_gpio18_idx10_pins>;

		led_pon: led-pon {
			label = "pon:green";
			pwms = <&en7581_pwm 10 4000000 0>;
			max-brightness = <255>;
			linux,default-trigger = "pon0-registration";
		};
	};


	/* PCA9555 LED expander, 7-bit address 0x20.
	 *
	 * Stock firmware reaches it through the vendor-private
	 *   kdrv_debug i2c writeWord 2 0x20 6 0x0000
	 *   kdrv_debug i2c writeWord 2 0x20 2 0xff3f
	 * "channel 2" is NOT /dev/i2c-2 and NOT either mt7621 controller:
	 * it is a GPIO bit-banged bus. Verified on the running board by
	 * bit-banging every free GPIO pair (sysfs, open-drain emulation):
	 *   SDA = GPIO 29 (pin 42), SCL = GPIO 28 (pin 41)
	 * 5/5 repeated scans ACKed 0x20 only; full PCA9555 read/write
	 * transactions ACKed all bytes, reg0 reads back 0xff3f (exactly the
	 * value the vendor script writes), and writes to reg2/reg6 read back
	 * correctly. GPIO 13/14 used as a negative control: all NACK.
	 * Cross-check: stock `sys modifybit 1fa20218 16 1` touches bit16,
	 * which maps to GPIO 29 (GPIO = bit + 13, confirmed by the
	 * "set gpio 30 to force-gpio mode" comment at bit 17).
	 *
	 * Do NOT put this chip under &i2c1: the i2c1 group shares pin14/15
	 * with mdio, which drives the 2.5G PHY. Requires kmod-i2c-gpio.
	 */
	i2c_gpio: i2c-gpio {
		compatible = "i2c-gpio";
		sda-gpios = <&en7581_pinctrl 29 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&en7581_pinctrl 28 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <10>;	/* ~50 kHz, conservative */
		i2c-gpio,timeout-ms = <100>;
		#address-cells = <1>;
		#size-cells = <0>;

		pca9555: gpio@20 {
			compatible = "nxp,pca9555";
			reg = <0x20>;
			gpio-controller;
			#gpio-cells = <2>;
		};
	};

	leds_expander: leds-expander {
		compatible = "gpio-leds";

		led_sys: led-sys {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&pca9555 6 GPIO_ACTIVE_LOW>;
			default-state = "keep";
		};

		led_vpn: led-vpn {
			label = "green:vpn";
			gpios = <&pca9555 7 GPIO_ACTIVE_LOW>;
		};

		led_internet: led-internet {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&pca9555 0 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-online";
		};
	};

	/* The USB PHY 3.3V reference supply is always on. */
	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "fixed-3.3V";
	};

};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;

	pon_pins: pon-pins {
		mux {
			function = "pon";
			groups = "pon_tx_disable_gpio";
		};
	};

	downstream_pon_spi_pins: downstream-pon-spi-pins {
		mux {
			function = "pcm_spi";
			groups = "pcm_spi";
		};
	};

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};

		conf {
			pins = "gpio2";
			output-high;
		};
	};
	
	pcie0_rst_pins: pcie0-rst-pins {
		conf {
			pins = "pcie_reset0";
			drive-open-drain = <1>;
		};
	};

	pcie1_rst_pins: pcie1-rst-pins {
		conf {
			pins = "pcie_reset1";
			drive-open-drain = <1>;
		};
	};

	pwm_gpio18_idx10_pins: pwm-gpio18-idx10-pins {
		mux {
			function = "pwm";
			pins = "gpio18";
		};

		conf {
			pins = "gpio18";
			output-enable;
		};
	};

	/* RESERVED - DO NOT reference from &i2c1 while &switch uses &mdio_pins.
	 * The "mdio" and "i2c1" groups are the SAME two physical pins:
	 *   pin 14 (gpio1) + pin 15 (gpio2)
	 * airoha_pmxops.strict = true, and &switch already claims both pins for
	 * the MDIO bus that drives ethernet-phy@7 (RTL8221B). Applying this
	 * state from a second device makes that device's probe fail with -EBUSY,
	 * or steals the pins away from MDIO. Kept here as documentation only.
	 */
	i2c1_pins: i2c1-pins {
		mux {
			function = "i2c";
			groups = "i2c1";
		};
	};

	/* ---- GPIO41 (pin 54)：不要在这里 hog ----------------------------
	 * 原厂 DTB 把它写成 LED 节点 phy_tx_ben（default-state="on"），
	 * 因为厂商平台没有 PON 的 pinmux，只能软件拉高当 TX burst enable。
	 *
	 * 我们走的是 &xpon_mac + pinctrl，而 pon 的 pin 组是：
	 *   pon_pins                = { 49, 50, 51, 52, 53, 54 }
	 *   pon_tx_disable_gpio_pins= { 49, 50, 52, 53, 54 }   <- 去掉 51
	 * 54 号 pin 就是 GPIO41。也就是说只要启用 pon pinctrl，
	 * 这根线的 TX_BEN 功能由 PON MAC 硬件接管，软件 GPIO 不再有效。
	 *
	 * 更要命的是 airoha_pmxops.strict = true，pinctrl core 的 pin_request()
	 * 在 strict 下会发现 pin 的 gpio_owner 已被 hog 占着，直接返回 -EBUSY，
	 * 导致 xpon_mac probe 时 default pinctrl 应用失败 —— 上行 PON 直接不启动。
	 * 所以这里必须让出 GPIO41，原厂那套 "LED 常亮" 的写法不能照抄。
	 * （原厂写法：leds/phy_tx_ben { gpios = <&pinctrl 41 0>;
	 *   default-state = "on"; } —— 仅记录，不要加回来。）
	 */

	/* GPIO31（原厂 /leds/an8811_reset）：本机型不贴 EN8811H，不要驱动。
	 *
	 * 原厂 DTB 里有这一项，是因为那份固件同时喂 AN4475-G2 / AN4475-C1
	 * 等多个 SKU，8811 那条 BOM 才需要拉这颗复位。G2 的 2.5G 口用的是
	 * RTL8221B / YT8821（见 &mdio 下 phy_2p5g 的检测注释），跟 EN8811H
	 * 无关 —— 这里一旦 hog，等于在驱动一根本机型上不存在的信号线。
	 *
	 * 原厂写法（仅记录，不要加回来）：
	 *   an8811_reset { gpios = <&en7581_pinctrl 31 GPIO_ACTIVE_LOW>;
	 *                  default-state = "off"; }
	 * "off" 在 ACTIVE_LOW 下是物理高 = 释放复位，LED 子系统只是借来
	 * 配一次电平的壳子。
	 */

	/* GPIO4 = 下行 PON ASIC（fsl）复位，低有效。
	 * 原厂 rcS 对它做 0->1 脉冲：
	 *   kdrv_debug gpio write 4 0   # cpu reset asic
	 *   kdrv_debug gpio write 4 1
	 *
	 * 当前 DOWNSTREAM_PON=0，pcm_spi 是 disabled、fsl 不 probe，
	 * 没有任何驱动会管这根线。上电默认电平不确定，所以按住复位：
	 *   GPIO_ACTIVE_LOW + output-high -> 逻辑有效 -> 物理低 -> 保持复位
	 *
	 * 这也是 strict 模式的硬要求：一旦启用 pcm_spi，fsl 的 reset-gpios
	 * 要自己控制 GPIO4，hog 先占住会让 pin_request 返回 -EBUSY，
	 * fsl probe 直接失败。所以两者必须互斥，用同一个开关切。
	 */
#if AN4475_DOWNSTREAM_PON
	/* 交给 fsl 的 reset-gpios，不在这里 hog。 */
#else
	fsl_reset_hog: fsl-reset-hog {
		gpio-hog;
		gpios = <4 GPIO_ACTIVE_LOW>;
		output-high;
		line-name = "fsl-reset";
	};
#endif

	/* GPIO20：原厂 DTB/脚本里都查不到这根线的操作（rcS 只碰过
	 * GPIO4 / 13 / 14 / 29 / 30 / 38 / 41 / 54），拉高是实测倒推的
	 * PON 供电使能。若上机发现 pon0 无光功率，第一个怀疑对象就是它。
	 */
	gpon_power_hog: gpon-power-hog {
		gpio-hog;
		gpios = <20 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "gpon-power";
	};
	/* ---- 2.5G 口媒体选择：固定电口 ------------------------------------
	 * 原厂电平：电口 22=0 / 23=1，光口 22=1 / 23=0。这里写死电口。
	 *
	 * 顺带说明一个老疑问：以前"只驱动 22/23 救不回 RX"不是 GPIO 的问题，
	 * 而是厂商还通过 /proc/tc3162/hsgmii_eth_mac_dbg "change mode" 改了
	 * SerDes 路由。主线走 phylink，pcs_config() 会按 DT 的 phy-mode
	 * 直接把 eth_pcs 配成 2500base-x（等价 mode 5），不需要抄 /proc 那套。
	 *
	 * 要做光口时：22 改 output-high、23 改 output-low，并且
	 *   - gdm4 去掉 phy-handle、改 managed = "in-band-status"；
	 *   - phy_2p5g 加 status = "disabled"；
	 *   - 补一个 GPIO30 的 hog（ACTIVE_LOW + output-high = 物理低 = 按住复位），
	 *     否则 PHY 会和光模块抢同一对差分。
	 * 三条必须同时改，缺一个都会 link down 或两边对打。
	 */
	combo_mux_sel0_hog: combo-mux-sel0-hog {
		gpio-hog;
		gpios = <22 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "combo-mux-sel0";
	};

	combo_mux_sel1_hog: combo-mux-sel1-hog {
		gpio-hog;
		gpios = <23 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "combo-mux-sel1";
	};

};

&snfi {
	status = "okay";
};

&{/soc} {
	/* 下行 PON 的 SPI 主控（PCM-SPI）。
	 *
	 * 原厂 DTB 是同一份地址：compatible = "airoha,spi"，status = "okay"，
	 * spi-num-chipselects = <2>，下面挂两个通用 spidev 从设备
	 * （CS0 20 MHz / CS1 50 MHz）。也就是说厂商根本没走 SPI 框架：
	 * fsl_core_fttr_chip.ko 直接 ioremap 0x1fbd4000 操作寄存器，
	 * 对外只暴露 /dev/fsl_crane_driver。
	 *
	 * 主线/ponwrt 目前都没有这颗控制器的驱动：
	 *   - spi-airoha-snfi.c 只 match "airoha,en7581-snand"（挂在 0x1fa10000）；
	 *   - patches-6.18 里的 SPI 补丁全部是 SNAND 那条；
	 *   - 所以这里即便写 okay 也没有任何 driver 会 probe，
	 *     下面的 fsl 子节点不会实例化、pinctrl 也不会被应用。
	 *
	 * 因此默认保持 disabled，由文件顶部的 AN4475_DOWNSTREAM_PON 统一控制
	 * （status 与 GPIO4 的 hog 互斥，改一个数就够，不会漏改另一半）。
	 *
	 * 注意 fsl 的 compatible 必须是 "fiberhome,an4475-g2-fsl"：
	 * fiberhome-fsl/src/fsl.c 的 of_match_table 只有这一个（带 -g2），
	 * 写成 "fiberhome,an4475-fsl" 会静默匹配不上 —— 编译、刷机全绿，
	 * 但 /dev/fsl-* 永远不出现。
	 */
	pcm_spi: spi@1fbd4000 {
		compatible = "airoha,en7581-spi", "airoha,spi";
		reg = <0x0 0x1fbd4000 0x0 0x140>;

		clocks = <&scuclk EN7523_CLK_SPI>;
		clock-names = "spi";
		resets = <&scuclk EN7581_SFC2_PCM_RST>;
		reset-names = "pcm";

		#address-cells = <1>;
		#size-cells = <0>;
		spi-num-chipselects = <2>;

		pinctrl-names = "default";
		pinctrl-0 = <&downstream_pon_spi_pins>;

#if AN4475_DOWNSTREAM_PON
		status = "okay";
#else
		status = "disabled";
#endif

		fsl: fsl@0 {
			compatible = "fiberhome,an4475-g2-fsl";
			reg = <0>;
			spi-max-frequency = <20000000>;
			/* 原厂 DTB 里控制器带 spi-cpol + spi-cpha（mode 3）。
			 * fsl_probe() 会无条件改写成 SPI_MODE_0 并把频率压到 10 MHz
			 * （源码注释：FSL 寄存器编码与 SPI 时序模式无关），
			 * 所以这两行只是如实记录硬件，不会真正生效。 */
			spi-cpol;
			spi-cpha;
			/* GPIO4 = fsl ASIC reset, low active.
			 * stock rcS: "kdrv_debug gpio write 4 0" (assert)
			 *             "kdrv_debug gpio write 4 1" (release)
			 */
			reset-gpios = <&en7581_pinctrl 4 GPIO_ACTIVE_LOW>;
		};
	};
};

&spi_nand {
	#address-cells = <1>;
	#size-cells = <1>;

	partitions: partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* BootROM reads the BL2 FIP at offset 0x800 in the first eraseblock. */
		partition@0 {
			label = "bl2";
			reg = <0x00000000 0x00020000>;
			read-only;
		};

		/* UBI manages every eraseblock after BL2. */
		partition@20000 {
			label = "ubi";
			reg = <0x00020000 0x00000000>;
			compatible = "linux,ubi";

			volumes {
				ubi_fip: ubi-volume-fip {
					/* The second-stage FIP contains BL31 and U-Boot. */
					volname = "fip";
				};

				ubi_env: ubi-volume-ubootenv {
					volname = "ubootenv";
				};

				ubi_env2: ubi-volume-ubootenv2 {
					volname = "ubootenv2";
				};

				ubi_factory: ubi-volume-factory {
					volname = "factory";
				};

				ubi_fit: ubi-volume-fit {
					volname = "fit";
				};
			};
		};
	};
};

&ubi_factory {
	nvmem-layout {
		compatible = "fixed-layout";
		#address-cells = <1>;
		#size-cells = <1>;

		container_magic: magic@0 {
			reg = <0x000000 0x000008>;
		};

		device_serial: device-serial@20 {
			reg = <0x000020 0x000018>;
		};

		pon_serial: pon-serial@a2 {
			reg = <0x0000a2 0x00000c>;
		};

		base_mac: base-mac@40 {
			compatible = "mac-base";
			reg = <0x000040 0x000006>;
			#nvmem-cell-cells = <1>;
		};

		eth_base_mac: eth-base-mac@46 {
			compatible = "mac-base";
			reg = <0x000046 0x000006>;
			#nvmem-cell-cells = <1>;
		};

		oui: oui@4c {
			reg = <0x00004c 0x000003>;
		};

		vendor_code: vendor-code@4f {
			reg = <0x00004f 0x000002>;
		};

		gpon_password: gpon-password@51 {
			reg = <0x000051 0x00000a>;
		};

		internet_mac: internet-mac@60 {
			reg = <0x000060 0x000006>;
		};

		tr069_mac: tr069-mac@66 {
			reg = <0x000066 0x000006>;
		};

		voip_mac: voip-mac@6c {
			reg = <0x00006c 0x000006>;
		};

		priprotocol_mac: priprotocol-mac@72 {
			reg = <0x000072 0x000006>;
		};

		wifi_mac_2g4: wifi-mac-2g4@96 {
			reg = <0x000096 0x000006>;
		};

		wifi_mac_5g: wifi-mac-5g@9c {
			reg = <0x00009c 0x000006>;
		};

		/* MT7993_EEPROM.bin: 1353728 B, stored verbatim, ends at 0x18a800. */
		vendor_eeprom: eeprom-vendor@40000 {
			reg = <0x040000 0x14a800>;
		};

		pon_cal_10ge_asym: calibration-10ge-asym@1a0000 {
			reg = <0x1a0000 0x000800>;
		};

		pon_cal_10ge_sym: calibration-10ge-sym@1a1000 {
			reg = <0x1a1000 0x000800>;
		};

		pon_cal_xg: calibration-xg@1a2000 {
			reg = <0x1a2000 0x000800>;
		};

		pon_cal_xgs: calibration-xgs@1a3000 {
			reg = <0x1a3000 0x000800>;
		};

		pon_calibration: calibration@1a4000 {
			reg = <0x1a4000 0x000800>;
		};

		pon_cal_olt_downlink: calibration-olt-downlink@1a5000 {
			reg = <0x1a5000 0x000800>;
		};

		apd_wtd01: apd-wtd01@1a6000 {
			reg = <0x1a6000 0x00012a>;
		};

		apd_ys01: apd-ys01@1a7000 {
			reg = <0x1a7000 0x00012c>;
		};

		bosa_info: bosa-info@1a8000 {
			reg = <0x1a8000 0x0000e6>;
		};

		bosa_rssi: bosa-rssi@1a9000 {
			reg = <0x1a9000 0x0000cc>;
		};

		lan_optic_tx: lan-optic-tx-calib@1aa000 {
			reg = <0x1aa000 0x000218>;
		};

		wifi_eeprom: eeprom@1ab000 {
			/* Exactly 7680 B = the mt76/OpenWrt EEPROM view. The full
			 * vendor image is 1353728 B (0x14a800) in vendor_eeprom. */
			reg = <0x1ab000 0x001e00>;
		};
	};
};

&ubi_env {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool";
	};
};

&ubi_env2 {
	nvmem-layout {
		compatible = "u-boot,env-redundant-bool";
	};
};

&usb1 {
	status = "okay";
	vusb33-supply = <&reg_3p3v>;
	#address-cells = <1>;
	#size-cells = <0>;
	usb_port2: port@1 { reg = <1>; #trigger-source-cells = <0>; };
};

&npu {
	status = "okay";
	/* Without this property airoha_npu_run_firmware() falls back to the
	 * generic en7581_npu_{rv32,data}.bin instead of the MT7996 pair.
	 * Both files exist so probe still succeeds, but WiFi offload firmware
	 * silently changes. Keep the MT7996 pair explicitly.
	 */
	firmware-name = "airoha/en7581_MT7996_npu_rv32.bin",
			"airoha/en7581_MT7996_npu_data.bin";
};

&eth {
	status = "okay";
};

&gdm1 {
	/* Internal switch/MAC conduit, LAN side -> LAN block, last slot. */
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&eth_base_mac 7>;
	status = "okay";
};

&eth_pcs {
	status = "okay";
};

&usb_pcs {
	status = "okay";
};

&mdio {

	phy_2p5g: ethernet-phy@7 {
		/* 二选一 BOM：RTL8221B(0x001cc849) 或 YT8821(0x4f51..)。
		 * 原厂 rcS 自己就在做检测：
		 *   tce miir 7 2  ->  value=001C (RTL8221B) / value=4F51 (YT8821)
		 *
		 * 所以这里**不能**写死 "ethernet-phy-id001c.c849"：
		 * 那会把 realtek 驱动强行绑到 YT8821 上（fwnode 给的 ID 优先于
		 * MDIO 读回值），比不写还糟。
		 *
		 * 留 C22，让 of_mdiobus 按 reg2/reg3 读真实 ID 再选驱动。
		 * 不写 compatible 也能被识别（旧式：有 reg 即视为 PHY），
		 * 但显式写出来与 dtsi 的 gsw_phy1..4 一致。
		 * 代价是读 ID 发生在复位释放之后，所以下面 68 ms 的
		 * reset-deassert-us 是硬前提，不能再压小。
		 */
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <7>;
		reset-gpios = <&en7581_pinctrl 30 GPIO_ACTIVE_LOW>;
		reset-assert-us = <15000>;
		reset-deassert-us = <68000>;
	};
};

&gdm4 {
	/* 电口：普通外置 PHY 接法。
	 * pcs-handle = <&eth_pcs> 由 an7581.dtsi 提供，不要覆盖 ——
	 * 2500base-x 下 MAC 侧仍要 PCS，只是链路状态来自 PHY 而不是带内。 */
	phy-handle = <&phy_2p5g>;
	phy-mode = "2500base-x";
	openwrt,netdev-name = "lan1";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&eth_base_mac 0>;
	status = "okay";
};


&switch {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
	status = "okay";
};

&gsw_port1 {
	label = "lan2";
	/* eth2mac = eth_base_mac + 1 (was base_mac+6 — wrong reserved range). */
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&eth_base_mac 1>;
	status = "okay";
};

&gsw_port2 {
	label = "lan3";
	/* eth3mac */
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&eth_base_mac 2>;
	status = "okay";
};

&gsw_port3 {
	label = "lan4";
	/* eth4mac */
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&eth_base_mac 3>;
	status = "okay";
};

&gsw_port4 {
	label = "lan5";
	/* eth5mac */
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&eth_base_mac 4>;
	status = "okay";
};

&gsw_phy1 {
	interrupts = <1>;
	status = "okay";
};

&gsw_phy2 {
	interrupts = <2>;
	status = "okay";
};

&gsw_phy3 {
	interrupts = <3>;
	status = "okay";
};

&gsw_phy4 {
	interrupts = <4>;
	status = "okay";
};


&i2c0 {
	status = "okay";
	an4475_bosa: optical-front-end@51 {
		compatible = "fiberhome,hg5x-bosa", "airoha,paged-bosa";
		reg = <0x51>;
		fiberhome,ben-active-high;
		tx-disable-gpios = <&en7581_pinctrl 38 GPIO_ACTIVE_HIGH>;
		nvmem-cells = <&pon_calibration>;
		nvmem-cell-names = "calibration";
		status = "okay";
	};

	/* 下行 BOSA（UX3326S）。
	 *
	 * 原厂并不是从主机 i2c0 访问它：fsl_core_fttr_chip.ko 里有一套
	 * 自带的 I2C 桥（寄存器 I2C_BRG_CTRL / I2C_BRG_WDATA / I2C_BRG_RDATA），
	 * 光模块是挂在那条内部总线后面的，主机侧只能通过 /dev/fsl_crane_driver
	 * 间接读写。所以这个节点放在 &i2c0 下只是**拓扑描述**：
	 * 目前没有任何驱动匹配 "fiberhome,ux3326s"，不会产生真实 I2C 事务，
	 * 因此不会在 i2c0 上打出 NACK。
	 *
	 * 如果将来有人给 ux3326s 写了 i2c 驱动，它会在这里 probe 并失败 ——
	 * 正确做法是把节点挪到 fsl 下面（由 fsl 驱动当 i2c 适配器注册），
	 * 而不是给 i2c0 加 clock-frequency 硬试。
	 */
	downstream_bosa: optical-front-end@63 {
		compatible = "fiberhome,ux3326s";
		reg = <0x63>;
	};
};

/* Hardware i2c1 controller: no devices attached.
 * The LED expander is on the i2c-gpio bus (GPIO 28/29) defined in the
 * root node above. Keep this controller WITHOUT a pinctrl state - the
 * "i2c1" pin group shares pin14/15 with mdio (2.5G PHY, airoha_pmxops
 * strict), so claiming it here would break the PHY or fail probe.
 * It is harmless to leave enabled; expect an empty i2c-1 bus.
 */
&i2c1 {
	status = "okay";
	clock-frequency = <400000>;
};

&pon_pcs {
	status = "okay";
};

&xpon_mac {
	pinctrl-names = "default";
	pinctrl-0 = <&pon_pins>;
	optical-front-end = <&an4475_bosa>;
	nvmem-cells = <&pon_serial>;
	nvmem-cell-names = "pon-serial";
	data-path = <&gdm2>;
	status = "okay";
};

&gdm2 {
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac 0>;
	airoha,pon-data-path;
	status = "okay";
};


/* ==========================================================================
 * Wi-Fi：MT7993（PCI id 0x7993）+ MT7976，双频 BE3600
 *
 * 原厂 /etc/wireless/l1profile.dat：
 *   INDEX0=MT7993
 *   INDEX0_main_ifname=ra0;rai0     <- 2.4G + 5G，没有 6G
 *   INDEX0_EEPROM_size=0x14a800     <- 厂商私有 1.29 MB
 *   INDEX0_EEPROM_name=MT7993_EEPROM.bin
 * mt76 只认其中的 7680 B 视图，也就是 &wifi_eeprom (0x1ab000, 0x1e00)。
 *
 * 一颗芯片两个 PCIe 端点，mainline mt7996 这样区分：
 *   主   0x7990 / 0x7992 / 0x7993
 *   hif2 0x7991 / 0x799a / 0x799b      <- 只做 WED 双路 DMA
 * mt7996_pci_init_hif2() 用 pci_get_device() 全局找 0x799b，不要求同一 bus，
 * 所以 an7581 这种"两个独立 root complex"的拓扑也能配上。
 *
 * 哪条 PCIe 挂 0x7993，DTS 层看不出来 —— PCI 设备靠硬件枚举，不是靠
 * compatible 匹配。所以两个节点都写完整的 eeprom + band：
 *   0x7993 -> mt7996_pci_probe 完整路径，读 EEPROM、注册 phy0/phy1；
 *   0x799b -> 开头就被 mt7996_pci_is_hif2() 分流到 hif2_probe 提前返回，
 *             不读 EEPROM、不建 netdev，这些属性实际不会被消费。
 * 两个都写，不管主芯片落在哪条，都能拿到校准数据；只要漏一边，
 * 一旦那边是主芯片就会 fallback 到 firmware 默认 bin —— MAC 随机、
 * 各信道功率表全 0，表现为"能起 phy 但信号差/连不上"。
 *
 * airoha,npu / airoha,eth：当前**没有消费方**。mt76 主线不认这两个属性；
 * ponwrt 的 package/kernel/mt76 只有 4 个上游补丁、没有 airoha 定制；
 * airoha_eth.c 里也搜不到任何 mtk_wed 调用。也就是说 WED/NPU offload
 * 在 an7581 上不可用（原厂的 npu_wifi.ko 是私有实现）。
 * 保留只为与 h3c/nokia 那些板的写法一致，别指望它生效。
 * 也正因如此，没有引入 an7581-npu-wlan.dtsi 里那 4 段 offload 内存
 * （pkt 44 MB + txpkt 64 MB + bufid + ba ≈ 110 MB），那是给真正能
 * 走 NPU 的 WiFi 留的，在 512 MB 的机器上白占。
 * ========================================================================== */

&pcie0 {
	status = "okay";
	max-link-speed = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_rst_pins>;

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;
		/* PCI 桥节点必须声明 3/2，否则下面 wifi@0,0 的 reg
		 * 会被 dtc 按默认 2/1 校验，报 invalid length。 */
		#address-cells = <3>;
		#size-cells = <2>;

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
			/* band 用 reg = <0>/<1> 做索引，父节点按 1/0 解析 */
			#address-cells = <1>;
			#size-cells = <0>;

			nvmem-cells = <&wifi_eeprom>;
			nvmem-cell-names = "eeprom";
			mediatek,eeprom-merge-otp;

			airoha,npu = <&npu>;
			airoha,eth = <&eth>;

			band@0 {
				reg = <0>;
				nvmem-cells = <&wifi_mac_2g4>;
				nvmem-cell-names = "mac-address";
			};

			band@1 {
				reg = <1>;
				nvmem-cells = <&wifi_mac_5g>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};

&pcie1 {
	status = "okay";
	max-link-speed = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_rst_pins>;

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;

		/* 与 pcie0 下的 wifi@0,0 完全一致，原因见上面那段长注释：
		 * 哪条 PCIe 挂 0x7993 是硬件决定的，DTS 层没法判断，
		 * 所以两边都配。落到 0x799b 的那份不会被消费。 */
		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;

			nvmem-cells = <&wifi_eeprom>;
			nvmem-cell-names = "eeprom";
			mediatek,eeprom-merge-otp;
			airoha,npu = <&npu>;
			airoha,eth = <&eth>;
			band@0 {
				reg = <0>;
				nvmem-cells = <&wifi_mac_2g4>;
				nvmem-cell-names = "mac-address";
			};

			band@1 {
				reg = <1>;
				nvmem-cells = <&wifi_mac_5g>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};
