Subject: netfilter: carry routed neighbor MACs into Kite admission

The inet flowtable route path normally uses FLOW_OFFLOAD_XMIT_NEIGH.  The
Kite Ethernet-key augmentation previously handled only DIRECT tuples, so a
Wi-Fi to WAN flow lost the authenticated station source MAC and was rejected
by the PPE admission code.  Resolve the reply neighbor for NEIGH tuples and
use its Wi-Fi hardware address plus the reply output device address.  The
path walker still proves that the ingress endpoint is a Kite station; no
broader rule is admitted when the neighbor is unresolved.

--- a/net/netfilter/nf_flow_table_offload.c
+++ b/net/netfilter/nf_flow_table_offload.c
@@ -850,24 +850,65 @@
-	if (other_tuple->xmit_type == FLOW_OFFLOAD_XMIT_DIRECT &&
-	    is_valid_ether_addr(other_tuple->out.h_source) &&
-	    is_valid_ether_addr(other_tuple->out.h_dest)) {
-		struct net_device_path_stack stack;
-		struct net_device *indev;
-		bool kite = false;
-
-		rcu_read_lock();
-		indev = dev_get_by_index_rcu(net, tuple->iifidx);
-		if (indev && !dev_fill_forward_path(indev,
-				other_tuple->out.h_dest, &stack) && stack.num_paths)
-			kite = stack.path[stack.num_paths - 1].type ==
-				DEV_PATH_AIROHA_NPU;
-		rcu_read_unlock();
-		if (kite) {
-			struct nf_flow_match *match = &flow_rule->match;
-
-			NF_FLOW_DISSECTOR(match, FLOW_DISSECTOR_KEY_ETH_ADDRS, eth);
-			memcpy(match->key.eth.src, other_tuple->out.h_dest, ETH_ALEN);
-			memcpy(match->key.eth.dst, other_tuple->out.h_source, ETH_ALEN);
-			memset(&match->mask.eth, 0xff, sizeof(match->mask.eth));
-			match->dissector.used_keys |= BIT_ULL(FLOW_DISSECTOR_KEY_ETH_ADDRS);
-		}
-	}
+	{
+		struct net_device_path_stack stack;
+		struct net_device *indev;
+		unsigned char ingress_mac[ETH_ALEN], egress_mac[ETH_ALEN];
+		bool have_macs = false, kite = false;
+
+		/* A DIRECT tuple already carries both Ethernet addresses. */
+		if (other_tuple->xmit_type == FLOW_OFFLOAD_XMIT_DIRECT &&
+		    is_valid_ether_addr(other_tuple->out.h_source) &&
+		    is_valid_ether_addr(other_tuple->out.h_dest)) {
+			ether_addr_copy(ingress_mac, other_tuple->out.h_dest);
+			ether_addr_copy(egress_mac, other_tuple->out.h_source);
+			have_macs = true;
+		} else if (other_tuple->xmit_type == FLOW_OFFLOAD_XMIT_NEIGH &&
+			   other_tuple->dst_cache &&
+			   is_valid_ether_addr(other_tuple->dst_cache->dev->dev_addr)) {
+			/* For a routed reply, dst_cache points at the Wi-Fi netdev.
+			 * Resolve the station neighbor exactly as the normal route
+			 * action does, and use the reply device MAC as the ingress
+			 * router destination seen by the original Wi-Fi packet. */
+			const void *daddr;
+			struct neighbour *n;
+
+			if (other_tuple->l3proto == AF_INET)
+				daddr = &other_tuple->dst_v4;
+			else if (other_tuple->l3proto == AF_INET6)
+				daddr = &other_tuple->dst_v6;
+			else
+				daddr = NULL;
+			if (daddr) {
+				n = dst_neigh_lookup(other_tuple->dst_cache, daddr);
+				if (n) {
+					read_lock_bh(&n->lock);
+					if ((n->nud_state & NUD_VALID) &&
+					    is_valid_ether_addr(n->ha)) {
+						ether_addr_copy(ingress_mac, n->ha);
+						ether_addr_copy(egress_mac,
+							       other_tuple->dst_cache->dev->dev_addr);
+						have_macs = true;
+					}
+					read_unlock_bh(&n->lock);
+					neigh_release(n);
+				}
+			}
+		}
+
+		if (have_macs) {
+			rcu_read_lock();
+			indev = dev_get_by_index_rcu(net, tuple->iifidx);
+			if (indev && !dev_fill_forward_path(indev, ingress_mac,
+							    &stack) && stack.num_paths)
+				kite = stack.path[stack.num_paths - 1].type ==
+					DEV_PATH_AIROHA_NPU;
+			rcu_read_unlock();
+		}
+		if (kite) {
+			struct nf_flow_match *match = &flow_rule->match;
+
+			NF_FLOW_DISSECTOR(match, FLOW_DISSECTOR_KEY_ETH_ADDRS, eth);
+			ether_addr_copy(match->key.eth.src, ingress_mac);
+			ether_addr_copy(match->key.eth.dst, egress_mac);
+			memset(&match->mask.eth, 0xff, sizeof(match->mask.eth));
+			match->dissector.used_keys |= BIT_ULL(FLOW_DISSECTOR_KEY_ETH_ADDRS);
+		}
+	}
