-			/* For a routed reply, dst_cache points at the Wi-Fi netdev.
-			 * Resolve the station neighbor exactly as the normal route
-			 * action does. The current tuple still supplies the
-			 * original packet's routed egress neighbor. */
+			   other_tuple->dst_cache) {
+			/* The opposite route supplies this packet's L2 source. */
 			struct neighbour *n;
 
 			if (other_tuple->l3proto == AF_INET)
@@ -890,8 +887,7 @@
 			}
