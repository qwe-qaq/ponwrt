 		const struct flow_offload_tuple *route_tuple = tuple;
 		const void *daddr;
 		bool have_macs = false, kite = false;
+		bool ingress_kite = false, egress_kite = false;
 
 		/* A DIRECT tuple already carries both Ethernet addresses. */
 		if (other_tuple->xmit_type == FLOW_OFFLOAD_XMIT_DIRECT &&
@@ -863,12 +864,8 @@
