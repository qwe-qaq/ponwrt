+/* Caller holds ppe_lock; normal admission checked the current STA/key.
+ * This records first successful readback after reopen, including idle time
+ * before a flow appears. It never changes admission or policy contents. */
+static void airoha_kite_note_bind(struct airoha_ppe *ppe,
+                                struct airoha_flow_table_entry *e)
+{
+ struct kdp_shared *s=READ_ONCE(ppe->kite_dp);
+ u32 wi=e->kite_out_wcid,request;
+ if (!s || !wi || wi>=KDP_WCIDS || !airoha_kite_flow_live(ppe,e)) return;
+ request=READ_ONCE(s->r60.ps[wi].request);
+ if (!request || READ_ONCE(s->r60.ps[wi].active) ||
+     READ_ONCE(s->r60.ps[wi].learned_request)==request) return;
+ WRITE_ONCE(s->r60.ps[wi].learned_ms,(u32)jiffies_to_msecs(jiffies)); dma_wmb();
+ WRITE_ONCE(s->r60.ps[wi].learned_request,request);
 }
 
