+/* Soft suspend keeps cookie ownership in flow_table/kite_flows, but stops
+ * every hardware capture. A later DESTROY/REPLACE still reaches its record.
+ * New learning is excluded by tx_blocked throughout the transaction. */
+int airoha_kite_suspend_tx(struct airoha_ppe_dev *dev, unsigned int wi, u32 request)
+{
+ struct airoha_ppe *ppe=dev->priv;
+ struct airoha_flow_table_entry *e;
+ struct kdp_shared *s;
+ int ret=0;
+ mutex_lock(&flow_offload_mutex);
+ s=ppe->kite_dp;
+ if (!s || !wi || wi>=KDP_WCIDS || !request ||
+     READ_ONCE(s->r60.ps[wi].request)!=request ||
+     !(READ_ONCE(s->sta[wi].tx_blocked)&KDP_TX_BLOCK_SOFTWARE)) { ret=-EINVAL; goto out; }
+ ret=ppe->kite_ops->pause(ppe->kite_priv); if (ret) goto out;
+ list_for_each_entry(e,&ppe->kite_flows,kite_node) {
+  struct kdp_flow key;
+  u32 base,i;
+  if (e->kite_out_wcid!=wi) continue;
+  if (e->kite_suspended) {
+   ret=airoha_kite_invalidate(ppe,e); if (ret) goto out;
+   continue; /* a partial revoke retry must still prove every slot stopped */
+  }
+  key=e->kite_capture_policy!=KDP_SLOT_NONE ? e->kite_key : e->kite_tx_key;
+  e->kite_soft_slot=KDP_SLOT_NONE;
+  if (key.type && ppe->kite_version != U32_MAX) {
+   base=kdp_flow_bucket(key.smac,key.dmac,key.vlan,wi);
+   base=kdp_flow_l4_bucket(base,key.src,key.dst,key.ports,key.protocol,
+      key.type==KDP_FLOW_BRIDGE_IPV4 ? KDP_FLOW_IPV4 :
+      key.type==KDP_FLOW_BRIDGE_IPV6 ? KDP_FLOW_IPV6 : key.type);
+   for (i=base;i<base+KDP_FLOW_WAYS;i++) {
+    struct kdp_flow *dst=&s->r60.soft[i];
+    if (READ_ONCE(dst->version)) continue;
+    key.version=0; *dst=key;
+    WRITE_ONCE(s->r60.soft_request[i],request); dma_wmb();
+    WRITE_ONCE(dst->version,++ppe->kite_version);
+    e->kite_soft_slot=i; break;
+   }
+  }
+  if (!key.type) s->r60.soft_unsupported++;
+  else if (e->kite_soft_slot==KDP_SLOT_NONE) s->r60.soft_full++;
+  e->kite_suspended=true;
+  ret=airoha_kite_invalidate(ppe,e); if (ret) goto out;
+ }
+ dma_wmb(); WRITE_ONCE(s->r60.ps[wi].active,request); dma_wmb();
+ ret=ppe->kite_ops->resume(ppe->kite_priv);
+out:
+ mutex_unlock(&flow_offload_mutex); return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_kite_suspend_tx);
