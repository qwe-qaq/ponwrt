+/* Called from the existing slow Wi-Fi watchdog under mt76.mutex. */
+int airoha_kite_health(struct airoha_ppe_dev *dev)
+{
+ struct airoha_ppe *ppe=dev->priv;
+ struct kdp_shared *s;
+ struct airoha_flow_table_entry *e;
+ u64 packets[2]={};
+ u32 bound[2]={},ready[2],p7=0,degrade=0,wi;
+ bool blocked=false;
+ int b,ret=0;
+ mutex_lock(&flow_offload_mutex);
+ s=ppe->kite_dp;
+ if (!s || !s->enabled || s->gate || kdp_failed(s) ||
+     time_before(jiffies,ppe->kite_health_at+HZ)) goto out;
+ ppe->kite_health_at=jiffies;
+ p7=airoha_fe_rr(ppe->eth,0x16c); /* AN7581 PSE port7 IQ:OQ */
+ WRITE_ONCE(s->r60.ingress_p7,p7);
+ blocked=s->tuning.ba.tids || s->perf.free_count<64;
+ for (wi=1;wi<KDP_WCIDS;wi++)
+  if (s->sta[wi].enabled && (s->sta[wi].tx_blocked || s->r60.ps[wi].active)) blocked=true;
+ list_for_each_entry(e,&ppe->kite_flows,kite_node) {
+  struct airoha_foe_stats64 st={};
+  wi=e->kite_out_wcid;
+  if (!wi || e->kite_suspended || !airoha_kite_flow_live(ppe,e)) continue;
+  b=s->sta[wi].band; if (b>1) continue;
+  if (e->type==FLOW_TYPE_L2) {
+   struct airoha_flow_table_entry *sub;
+   hlist_for_each_entry(sub,&e->l2_flows,l2_subflow_node) bound[b]+=sub->hash!=0xffff;
+  } else if (e->hash!=0xffff) {
+   bound[b]++; airoha_ppe_foe_entry_get_stats(ppe,e->hash,&st);
+   packets[b]+=st.packets;
+  }
+ }
+ for (b=0;b<2;b++) ready[b]=READ_ONCE(s->performance[b].reserved[KDP_PERF_TDMA_REARM]);
+ for (b=0;b<2;b++) {
+  u32 reason=0;
+  if (packets[b]>ppe->kite_health_packets[b]) reason|=1;
+  if (bound[b] && (p7&0xffff) && ready[1-b]==ppe->kite_health_ready[1-b]) reason|=2;
+  if (blocked || !bound[b] || s->r60.degraded[b] ||
+      ready[b]!=ppe->kite_health_ready[b] || !reason) ppe->kite_stall_at[b]=0;
+  else if (!ppe->kite_stall_at[b]) ppe->kite_stall_at[b]=jiffies;
+  else if (time_after_eq(jiffies,ppe->kite_stall_at[b]+2*HZ)) {
+   WRITE_ONCE(s->r60.ingress_reason[b],reason);
+   WRITE_ONCE(s->r60.degraded[b],1); dma_wmb(); degrade|=BIT(b);
+  }
+ }
+ for (b=0;b<2;b++) { ppe->kite_health_ready[b]=ready[b]; ppe->kite_health_packets[b]=packets[b]; }
+out:
+ mutex_unlock(&flow_offload_mutex);
+ if (!degrade) return ret;
+ /* Close new flow admission before retiring every current egress. RX PN,
+  * host TX, token allocations and DMA owners are retained. */
+ for (wi=1;wi<KDP_WCIDS;wi++) {
+  if (!s->sta[wi].generation || !(degrade & BIT(s->sta[wi].band))) continue;
+  ret=airoha_kite_revoke_tx(dev,wi); if (ret) break;
+ }
+ dev_warn(ppe->eth->dev,"Kite ingress stalled: bands=%x P7=%08x; hardware capture revoked, software retained, result=%d\n",degrade,p7,ret);
+ return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_kite_health);
