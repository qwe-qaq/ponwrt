+/* Snapshot exactly the egress tuple accepted by Linux. Unsupported
+ * encapsulations simply have no PS exception; normal steady TX is unchanged. */
+static void airoha_kite_tx_key(struct airoha_flow_table_entry *e,
+ const struct kdp_shared *s, const struct ethhdr *eth)
+{
+ struct kdp_flow *k = &e->kite_tx_key;
+ const struct airoha_foe_entry *h = &e->data;
+ u32 wi=e->kite_out_wcid, type=FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE,h->ib1);
+ u32 layers=FIELD_GET(AIROHA_FOE_IB1_BIND_VLAN_LAYER,h->ib1);
+ if (layers > 1 || (h->ib1 & AIROHA_FOE_IB1_BIND_PPPOE)) return;
+ k->session=s->session; k->generation=s->sta[wi].generation;
+ k->key_generation=s->sta[wi].key_generation; k->wcid=wi;
+ k->band=s->sta[wi].band; k->bss=s->sta[wi].bss;
+ ether_addr_copy(k->smac,eth->h_source); ether_addr_copy(k->dmac,eth->h_dest);
+ k->vlan=KDP_SLOT_NONE; k->hw_slot=KDP_SLOT_NONE;
+ k->cookie_lo=lower_32_bits(e->cookie); k->cookie_hi=upper_32_bits(e->cookie);
+ if (type == PPE_PKT_TYPE_IPV4_HNAPT) {
+  k->type=KDP_FLOW_IPV4; k->src[0]=h->ipv4.new_tuple.src_ip;
+  k->dst[0]=h->ipv4.new_tuple.dest_ip; k->ports=h->ipv4.new_tuple.ports;
+  if (layers) k->vlan=h->ipv4.l2.common.vlan1;
+ } else if (type == PPE_PKT_TYPE_IPV6_ROUTE_5T) {
+  k->type=KDP_FLOW_IPV6;
+  memcpy(k->src,h->ipv6.src_ip,sizeof(k->src));
+  memcpy(k->dst,h->ipv6.dest_ip,sizeof(k->dst)); k->ports=h->ipv6.ports;
+  if (layers) k->vlan=h->ipv6.l2.vlan1;
+ } else return;
+ k->protocol=(h->ib1 & AIROHA_FOE_IB1_BIND_UDP) ? IPPROTO_UDP : IPPROTO_TCP;
+}
