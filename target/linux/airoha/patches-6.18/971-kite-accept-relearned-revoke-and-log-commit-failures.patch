+/* Learning can replace INVALID with UNBIND before the readback. Both prove
+ * the old authorization is gone. BIND commits still require the exact type
+ * and protocol; never turn an unreadable/still-bound revoke into success. */
+static bool airoha_ppe_foe_commit_matches(u32 requested, u32 observed)
+{
+	u32 state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, observed);
+
+	if (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, requested) == AIROHA_FOE_STATE_INVALID)
+		return state == AIROHA_FOE_STATE_INVALID || state == AIROHA_FOE_STATE_UNBIND;
+	return !((observed ^ requested) & (AIROHA_FOE_IB1_BIND_STATE |
+		AIROHA_FOE_IB1_BIND_PACKET_TYPE | AIROHA_FOE_IB1_BIND_UDP));
+}
