+/* Resolve an output route without confusing DIRECT's union with NEIGH.
+ * The opposite tuple's source is the post-NAT destination, as in the
+ * native flow_offload_eth_dst() action builder. */
+static bool nf_flow_kite_route_l2(const struct flow_offload_tuple *tuple,
+				  const struct flow_offload_tuple *other,
+				  u8 *local, u8 *peer, int *ifindex)
+{
+	struct neighbour *n;
+	const void *daddr;
+	bool valid;
+
+	switch (tuple->xmit_type) {
+	case FLOW_OFFLOAD_XMIT_DIRECT:
+		ether_addr_copy(local, tuple->out.h_source);
+		ether_addr_copy(peer, tuple->out.h_dest);
+		*ifindex = tuple->out.ifidx;
+		break;
+	case FLOW_OFFLOAD_XMIT_NEIGH:
+		if (!tuple->dst_cache || !tuple->dst_cache->dev ||
+		    tuple->dst_cache->dev->addr_len != ETH_ALEN)
+			return false;
+		if (tuple->l3proto == AF_INET)
+			daddr = &other->src_v4;
+		else if (tuple->l3proto == AF_INET6)
+			daddr = &other->src_v6;
+		else
+			return false;
+		n = dst_neigh_lookup(tuple->dst_cache, daddr);
+		if (!n)
+			return false;
+		read_lock_bh(&n->lock);
+		valid = n->nud_state & NUD_VALID;
+		ether_addr_copy(peer, n->ha);
+		read_unlock_bh(&n->lock);
+		neigh_release(n);
+		if (!valid)
+			return false;
+		ether_addr_copy(local, tuple->dst_cache->dev->dev_addr);
+		*ifindex = tuple->ifidx;
+		break;
+	default:
+		return false;
+	}
+	return *ifindex > 0 && is_valid_ether_addr(local) &&
+		is_valid_ether_addr(peer);
+}
+
+/* Matches describe the original ingress frame. Output Ethernet addresses
+ * remain in native MANGLE actions, never in this ingress match. In a routed
+ * bridge/AP topology the ingress DA is the L3 bridge MAC, not the BSSID. */
+static void nf_flow_rule_kite_match(struct net *net,
+				   const struct flow_offload_tuple *tuple,
+				   const struct flow_offload_tuple *other,
+				   struct nf_flow_match *match)
+{
+	struct net_device_path_stack stack;
+	struct net_device *dev;
+	u8 ingress_src[ETH_ALEN], ingress_dst[ETH_ALEN];
+	u8 egress_src[ETH_ALEN], egress_dst[ETH_ALEN];
+	int ingress_ifindex, egress_ifindex;
+	bool kite = false;
+
+	if (!nf_flow_kite_route_l2(other, tuple, ingress_dst, ingress_src,
+				   &ingress_ifindex) ||
+	    !nf_flow_kite_route_l2(tuple, other, egress_src, egress_dst,
+				   &egress_ifindex))
+		return;
+	rcu_read_lock();
+	dev = dev_get_by_index_rcu(net, tuple->iifidx);
+	if (dev && !dev_fill_forward_path(dev, ingress_src, &stack) &&
+	    stack.num_paths)
+		kite = stack.path[stack.num_paths - 1].type == DEV_PATH_AIROHA_NPU;
+	dev = dev_get_by_index_rcu(net, egress_ifindex);
+	if (dev && !dev_fill_forward_path(dev, egress_dst, &stack) &&
+	    stack.num_paths)
+		kite |= stack.path[stack.num_paths - 1].type == DEV_PATH_AIROHA_NPU;
+	rcu_read_unlock();
+	if (!kite)
+		return;
+
+	NF_FLOW_DISSECTOR(match, FLOW_DISSECTOR_KEY_ETH_ADDRS, eth);
+	ether_addr_copy(match->key.eth.src, ingress_src);
+	ether_addr_copy(match->key.eth.dst, ingress_dst);
+	memset(&match->mask.eth, 0xff, sizeof(match->mask.eth));
+	match->dissector.used_keys |= BIT_ULL(FLOW_DISSECTOR_KEY_ETH_ADDRS);
+}
