From: FTTR maintainers
Subject: [PATCH] net: airoha: gate FTTR hardware rules by packet direction

The logical routed path bypasses the FMCS TC adapter. Enforce direction
policy at the common PPE replace entry, including duplicate callbacks.
Changing policy closes admission before synchronously draining netfilter
flows involving the FTTR lower device. Never hold flow_offload_mutex while
draining: destroy callbacks take it themselves.

--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -15,4 +15,6 @@
 #include <net/pkt_cls.h>
 #include <net/route.h>
+#include <net/netfilter/nf_flow_table.h>
+#include <linux/rtnetlink.h>
 
 #include "airoha_regs.h"
@@ -24,3 +26,82 @@
 DEFINE_MUTEX(flow_offload_mutex);
 static DEFINE_SPINLOCK(ppe_lock);
+
+/* HM2004-DU reserves fttr0 as the physical FTTR transport device.
+ * Bits: 0 = FTTR -> external, 1 = external -> FTTR, 2 = FTTR -> FTTR.
+ * Preserve existing behavior until the userspace owner applies its policy.
+ */
+static unsigned int fttr_offload_directions = 7;
+
+static int airoha_fttr_directions_set(const char *val,
+                                    const struct kernel_param *kp)
+{
+	struct net_device *lower;
+	void (*cleanup)(struct net_device *);
+	char name[IFNAMSIZ];
+	unsigned int mask;
+	int i, err = kstrtouint(val, 0, &mask);
+
+	if (err)
+		return err;
+	if (mask & ~7U)
+		return -ERANGE;
+	rtnl_lock();
+	if (mask == READ_ONCE(fttr_offload_directions))
+		goto unlock;
+	WRITE_ONCE(fttr_offload_directions, 0);
+	synchronize_net();
+	/* Ethernet can be built-in while nf_flow_table is a module. */
+	cleanup = symbol_get(nf_flow_table_cleanup);
+	/* Bridge tuples retain logical ingress ifindices, routed ones use fttr0. */
+	for (i = 0; cleanup && i <= 16; i++) {
+		snprintf(name, sizeof(name), "fttr%d", i);
+		lower = __dev_get_by_name(&init_net, name);
+		if (lower)
+			cleanup(lower);
+	}
+	if (cleanup)
+		symbol_put(nf_flow_table_cleanup);
+	WRITE_ONCE(fttr_offload_directions, mask);
+unlock:
+	rtnl_unlock();
+	return 0;
+}
+
+static const struct kernel_param_ops airoha_fttr_directions_ops = {
+	.set = airoha_fttr_directions_set,
+	.get = param_get_uint,
+};
+module_param_cb(fttr_offload_directions, &airoha_fttr_directions_ops,
+                &fttr_offload_directions, 0644);
+MODULE_PARM_DESC(fttr_offload_directions,
+                "FTTR PPE directions: bit0=upstream bit1=downstream bit2=ONU pair");
+
+static bool airoha_fttr_direction_allowed(struct airoha_eth *eth,
+                                         struct flow_cls_offload *f)
+{
+	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
+	struct net_device *lower;
+	struct flow_match_meta meta;
+	struct flow_action_entry *act;
+	bool in, out = false;
+	unsigned int bit;
+	int i;
+
+	if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_META))
+		return false;
+	lower = dev_get_by_name(dev_net(eth->napi_dev), "fttr0");
+	if (!lower)
+		return true;
+	flow_rule_match_meta(rule, &meta);
+	in = meta.mask->ingress_ifindex == U32_MAX &&
+	     meta.key->ingress_ifindex == lower->ifindex;
+	flow_action_for_each(i, act, &rule->action)
+		if (act->id == FLOW_ACTION_REDIRECT && act->dev == lower)
+			out = true;
+	dev_put(lower);
+	if (!in && !out)
+		return true;
+	bit = in && out ? BIT(2) : in ? BIT(0) : BIT(1);
+	return !!(READ_ONCE(fttr_offload_directions) & bit);
+}
 
@@ -1560,5 +1641,7 @@
 {
 	switch (f->command) {
 	case FLOW_CLS_REPLACE:
+		if (!airoha_fttr_direction_allowed(eth, f))
+			return -EOPNOTSUPP;
 		return airoha_ppe_flow_offload_replace(eth, f);
 	case FLOW_CLS_DESTROY:
