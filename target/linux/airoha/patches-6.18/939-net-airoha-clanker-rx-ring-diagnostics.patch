+static ssize_t clanker_rx_status_show(struct device *dev,
+				      struct device_attribute *attr, char *buf)
+{
+	struct airoha_npu *npu = dev_get_drvdata(dev);
+	struct airoha_clanker_diag *d = npu->clanker;
+	u32 *r = d->rings;
+	ssize_t n;
+	int i;
+
+	mutex_lock(&d->lock);
+	n = sysfs_emit(buf, "ring_abi=1 last_error=%d age_ms=%u port_type=%u\n",
+		d->ring_error, d->samples ? jiffies_to_msecs(jiffies - d->updated) : 0, r[4]);
+	if (d->ring_error || r[61] != 0x4b520001)
+		goto out;
+	n += sysfs_emit_at(buf, n, "windows reg=%#x base=%#x end=%#x; reg=%#x base=%#x end=%#x\n",
+		r[5], r[6], r[7], r[8], r[9], r[10]);
+	for (i = 0; i < 2; i++) {
+		u32 *b = r + 12 + i * 20;
+
+		n += sysfs_emit_at(buf, n,
+			"band%d ready=%u reg=%#x sram=%#x base=%#x count=%u cpu=%u dma=%u sw=%u desc=%08x/%08x/%08x/%08x glo=%#x\n",
+			i, b[12], b[0], b[1], b[2], b[3], b[4], b[5], b[6],
+			b[7], b[8], b[9], b[10], b[11]);
+	}
+out:
+	mutex_unlock(&d->lock);
+	return n;
+}
+static DEVICE_ATTR_RO(clanker_rx_status);
