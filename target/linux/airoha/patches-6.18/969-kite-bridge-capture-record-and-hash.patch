+	if (f->type != KDP_FLOW_BRIDGE &&
+		f->type != KDP_FLOW_BRIDGE_CAPTURE) {
 		if (f->type != p->type || f->ports != p->ports ||
 		    f->protocol != p->protocol)
 			return 0;
