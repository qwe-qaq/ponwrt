+		u32 capture_bucket = kdp_flow_bucket(k->smac, k->dmac,
+				k->vlan, k->wcid);
+		u32 capture;
+
+		for (capture = capture_bucket; capture < capture_bucket + KDP_FLOW_WAYS;
