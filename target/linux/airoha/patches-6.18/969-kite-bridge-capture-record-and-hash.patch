-		struct kdp_flow *dst = &ppe->kite_dp->flow[e->kite_policy];
+		struct kdp_flow *dst;
 
+		/* Publish the broad capture authorization first. A reader that sees
+		 * capture without the exact policy safely falls back to the host. */
+		if (e->kite_capture_policy != KDP_SLOT_NONE) {
+			dst = &ppe->kite_dp->flow[e->kite_capture_policy];
+			memcpy(dst, &e->kite_key, sizeof(*dst));
+			dst->type = KDP_FLOW_BRIDGE_CAPTURE;
+			dst->src[0] = dst->src[1] = dst->src[2] = dst->src[3] = 0;
+			dst->dst[0] = dst->dst[1] = dst->dst[2] = dst->dst[3] = 0;
+			dst->ports = dst->protocol = dst->dsfield = dst->dsmask = 0;
+			dma_wmb();
+			WRITE_ONCE(dst->version, ++ppe->kite_version);
+		}
+		dst = &ppe->kite_dp->flow[e->kite_policy];
 		memcpy(dst, &e->kite_key, sizeof(*dst));
 		dma_wmb();
 		WRITE_ONCE(dst->version, ++ppe->kite_version);
