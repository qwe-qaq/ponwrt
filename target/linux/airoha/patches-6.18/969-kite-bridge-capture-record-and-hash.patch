 }
 
+static void airoha_kite_policy_retire(struct airoha_ppe *ppe,
+				      struct airoha_flow_table_entry *e)
+{
+	if (!e->kite_in_wcid)
+		return;
+	WRITE_ONCE(ppe->kite_dp->flow[e->kite_policy].version, 0);
+	if (e->kite_capture_policy != KDP_SLOT_NONE)
+		WRITE_ONCE(ppe->kite_dp->flow[e->kite_capture_policy].version, 0);
+}
+
 static void airoha_kite_flow_publish(struct airoha_ppe *ppe,
 				    struct airoha_flow_table_entry *e)
 {
