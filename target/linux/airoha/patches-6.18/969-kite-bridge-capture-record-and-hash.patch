 	unsigned int protocol, unsigned int type)
 {
-	unsigned int i, h = bucket ^ ports ^ (protocol << 24) ^ type;
+	unsigned int i, h;
+	if (type == KDP_FLOW_BRIDGE_IPV4)
+		type = KDP_FLOW_IPV4;
+	else if (type == KDP_FLOW_BRIDGE_IPV6)
+		type = KDP_FLOW_IPV6;
+	h = bucket ^ ports ^ (protocol << 24) ^ type;
 	for (i = 0; i < 4; i++) {
 		h = (h * 33u) ^ src[i];
 		h = (h * 33u) ^ dst[i];
@@ -161,7 +166,8 @@
 	for (i = 0; i < 6; i++)
 		if (f->smac[i] != p->smac[i] || f->dmac[i] != p->dmac[i])
 			return 0;
