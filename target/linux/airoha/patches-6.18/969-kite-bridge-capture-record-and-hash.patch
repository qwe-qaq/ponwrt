 #define KDP_FLOW_BRIDGE_IPV4 4u
 #define KDP_FLOW_BRIDGE_IPV6 5u
+#define KDP_FLOW_BRIDGE_CAPTURE 6u
 #define KDP_SLOT_NONE 0xffffffffu
 
 struct kdp_sta {
--- a/include/linux/soc/airoha/kite-packet.h	2026-10-03 16:56:03.333960421 +0800
