 	seq_printf(m, "bind_ok=%lld\n", atomic64_read(&ppe->bind_ok));
 	seq_printf(m, "bind_fail=%lld\n", atomic64_read(&ppe->bind_fail));
 	seq_printf(m, "setup_errno=%d replace_errno=%d bind_errno=%d\n",
--- a/include/net/flow_offload.h
+++ b/include/net/flow_offload.h
@@ -184,6 +184,9 @@
 	FLOW_ACTION_VLAN_PUSH_ETH,
 	FLOW_ACTION_VLAN_POP_ETH,
 	FLOW_ACTION_CONTINUE,
+	/* Preserve bridge L2/IP semantics with the original exact match.
+	 * Drivers lacking such a representation must reject the rule. */
+	FLOW_ACTION_BRIDGE,
 	NUM_FLOW_ACTIONS,
 };
 
--- a/net/netfilter/nf_flow_table_offload.c
+++ b/net/netfilter/nf_flow_table_offload.c
@@ -801,12 +801,16 @@
 			enum flow_offload_tuple_dir dir,
 			struct nf_flow_rule *flow_rule)
 {
+	struct flow_action_entry *entry;
+
 	if (nf_flow_rule_route_common(net, flow, dir, flow_rule) < 0)
 		return -1;
 
-	flow_offload_redirect(net, flow, dir, flow_rule);
-
-	return 0;
+	entry = flow_action_entry_next(flow_rule);
+	if (!entry)
+		return -E2BIG;
+	entry->id = FLOW_ACTION_BRIDGE;
+	return flow_offload_redirect(net, flow, dir, flow_rule);
 }
 EXPORT_SYMBOL_GPL(nf_flow_rule_bridge);
 
--- a/net/netfilter/nf_flow_table_path.c
+++ b/net/netfilter/nf_flow_table_path.c
@@ -79,6 +79,7 @@
 
