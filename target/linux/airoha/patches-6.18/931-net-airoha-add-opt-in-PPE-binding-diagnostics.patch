Subject: [PATCH] net: airoha: add opt-in PPE submission and binding diagnostics

Distinguish successful NPU initialization from accepted flower templates
and from hardware-learned FOE binding. Keep diagnostics disabled by default
and rate limit each logging site. Do not change forwarding or commit policy.

The module parameter also works for the built-in Ethernet driver. Use the
ppe_debug parameter under /sys/module/airoha_eth/parameters at runtime.

--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -9,6 +9,7 @@
 #include <linux/ipv6.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
+#include <linux/moduleparam.h>
 #include <linux/rhashtable.h>
 #include <net/ipv6.h>
 #include <linux/if_vlan.h>
@@ -23,6 +24,17 @@
 DEFINE_MUTEX(flow_offload_mutex);
 static DEFINE_SPINLOCK(ppe_lock);
 
+static bool ppe_debug;
+module_param(ppe_debug, bool, 0600);
+MODULE_PARM_DESC(ppe_debug, "Rate-limited PPE template and learning diagnostics");
+
+#define ppe_diag(eth, fmt, ...) \
+	do { \
+		if (READ_ONCE(ppe_debug)) \
+			dev_info_ratelimited((eth)->dev, "ppe-diag: " fmt, \
+					     ##__VA_ARGS__); \
+	} while (0)
+
 static const struct rhashtable_params airoha_flow_table_params = {
 	.head_offset = offsetof(struct airoha_flow_table_entry, node),
 	.key_offset = offsetof(struct airoha_flow_table_entry, cookie),
@@ -916,5 +928,8 @@ unlock:
 	rcu_read_unlock();
 
+	ppe_diag(eth, "commit hash=%u wlan=%u ib1=%08x sram=%u ret=%d\n",
+		 hash, rx_wlan, e->ib1, hash < sram_num_entries, err);
+
 	return err;
 }
 
@@ -1076,6 +1092,9 @@
 		goto unlock;
 
 	state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
+	ppe_diag(ppe->eth, "learn hash=%u state=%u type=%u ib1=%08x\n",
+		 hash, state, (u32)FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE,
+				      hwe->ib1), hwe->ib1);
 	if (state == AIROHA_FOE_STATE_BIND)
 		goto unlock;
 
@@ -1097,8 +1116,12 @@
 			continue;
 		}
 
-		if (!airoha_ppe_foe_compare_entry(e, hwe))
+		if (!airoha_ppe_foe_compare_entry(e, hwe)) {
+			ppe_diag(ppe->eth,
+				 "compare-miss hash=%u bucket=%u cookie=%lx\n",
+				 hash, index, e->cookie);
 			continue;
+		}
 
 		airoha_ppe_foe_commit_entry(ppe, &e->data, hash, rx_wlan);
 		commit_done = true;
@@ -1108,6 +1131,8 @@
 	if (commit_done)
 		goto unlock;
 
+	ppe_diag(ppe->eth, "no-l4-template hash=%u bucket=%u\n",
+		 hash, index);
 l2_lookup:
 	airoha_ppe_foe_set_bridge_addrs(&br, eth_hdr(skb));
 	e = rhashtable_lookup_fast(&ppe->l2_flows, &br,
@@ -1253,7 +1278,7 @@
 }
 
-static int airoha_ppe_flow_offload_replace(struct airoha_eth *eth,
+static int airoha_ppe_flow_offload_replace_impl(struct airoha_eth *eth,
-					   struct flow_cls_offload *f)
+			struct flow_cls_offload *f, const char **stage)
 {
 	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
 	struct airoha_flow_table_entry *e;
@@ -1293,6 +1321,33 @@
 		return -EOPNOTSUPP;
 	}
 
+	if (READ_ONCE(ppe_debug)) {
+		struct flow_match_meta meta;
+
+		flow_rule_match_meta(rule, &meta);
+		ppe_diag(eth, "replace cookie=%lx ingress=%d addr_type=%u proto=%u actions=%u\n",
+			 f->cookie, meta.key->ingress_ifindex, addr_type,
+			 l4proto, rule->action.num_entries);
+		if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IPV4_ADDRS)) {
+			struct flow_match_ipv4_addrs addrs;
+
+			flow_rule_match_ipv4_addrs(rule, &addrs);
+			ppe_diag(eth, "ipv4 cookie=%lx src=%pI4 dst=%pI4\n",
+				 f->cookie, &addrs.key->src, &addrs.key->dst);
+		}
+		flow_action_for_each(i, act, &rule->action) {
+			ppe_diag(eth, "action cookie=%lx index=%d id=%u\n",
+				 f->cookie, i, act->id);
+			if (act->id == FLOW_ACTION_REDIRECT)
+				ppe_diag(eth, "redirect cookie=%lx dev=%s\n",
+					 f->cookie, act->dev ? act->dev->name : "none");
+			if (act->id == FLOW_ACTION_VLAN_PUSH)
+				ppe_diag(eth, "vlan-push cookie=%lx vid=%u proto=%04x\n",
+					 f->cookie, act->vlan.vid,
+					 ntohs(act->vlan.proto));
+		}
+	}
+
 	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IP)) {
 		struct flow_match_ip match;
 
@@ -1336,6 +1390,7 @@
 		return -EOPNOTSUPP;
 	}
 
+	*stage = "actions";
 	flow_action_for_each(i, act, &rule->action) {
 		switch (act->id) {
 		case FLOW_ACTION_MANGLE:
@@ -1380,11 +1435,13 @@
 		}
 	}
 
+	*stage = "ether-address";
 	if (!is_valid_ether_addr(data.eth.h_source) ||
 	    !is_valid_ether_addr(data.eth.h_dest))
 		return -EINVAL;
 
+	*stage = "prepare-egress";
 	err = airoha_ppe_foe_entry_prepare(eth, &hwe, odev, offload_type,
 					   &data, l4proto, dsfield,
 					   &egress_dev);
 	if (err) {
@@ -1398,6 +1456,7 @@
 		return err;
 	}
 
+	*stage = "ports";
 	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS)) {
 		struct flow_match_ports ports;
 
@@ -1428,6 +1487,7 @@
 		airoha_ppe_foe_entry_set_ipv6_tuple(&hwe, &data);
 	}
 
+	*stage = "mangle";
 	flow_action_for_each(i, act, &rule->action) {
 		if (act->id != FLOW_ACTION_MANGLE)
 			continue;
@@ -1439,6 +1499,7 @@
 			return err;
 	}
 
+	*stage = "translated-tuple";
 	if (addr_type == FLOW_DISSECTOR_KEY_IPV4_ADDRS) {
 		err = airoha_ppe_foe_entry_set_ipv4_tuple(&hwe, &data, true);
 		if (err)
@@ -1445,6 +1506,7 @@
 			return err;
 	}
 
+	*stage = "allocate-template";
 	e = kzalloc(sizeof(*e), GFP_KERNEL);
 	if (!e)
 		return -ENOMEM;
@@ -1452,6 +1514,7 @@
 	e->egress_dev = egress_dev;
 	memcpy(&e->data, &hwe, sizeof(e->data));
 
+	*stage = "commit-template";
 	err = airoha_ppe_foe_flow_commit_entry(eth->ppe, e);
 	if (err)
 		goto free_entry;
@@ -1457,6 +1520,7 @@
 	if (err)
 		goto free_entry;
 
+	*stage = "insert-template";
 	err = rhashtable_insert_fast(&eth->flow_table, &e->node,
 				     airoha_flow_table_params);
 	if (err < 0)
@@ -1468,6 +1532,19 @@ free_entry:
 	return err;
 }
 
+static int airoha_ppe_flow_offload_replace(struct airoha_eth *eth,
+					   struct flow_cls_offload *f)
+{
+	const char *stage = "match";
+	int err = airoha_ppe_flow_offload_replace_impl(eth, f, &stage);
+
+	ppe_diag(eth, "replace-result cookie=%lx ret=%d stage=%s reason=%s\n",
+		 f->cookie, err, stage,
+		 f->common.extack && f->common.extack->_msg ?
+		 f->common.extack->_msg : "none");
+	return err;
+}
+
 static int airoha_ppe_flow_offload_destroy(struct airoha_eth *eth,
 					   struct flow_cls_offload *f)
 {
@@ -1678,8 +1747,10 @@
 
 	mutex_lock(&flow_offload_mutex);
 
-	if (!eth->npu)
+	if (!eth->npu) {
 		err = airoha_ppe_offload_setup(eth);
+		ppe_diag(eth, "init ret=%d\n", err);
+	}
 	if (!err)
 		err = airoha_ppe_flow_offload_cmd(eth, type_data);
 
@@ -1705,6 +1777,8 @@
 		return;
 
 	ppe->foe_check_time[hash] = now;
+	ppe_diag(ppe->eth, "rx-check hash=%u wlan=%u dev=%s\n",
+		 hash, rx_wlan, skb->dev ? skb->dev->name : "none");
 	airoha_ppe_foe_insert_entry(ppe, skb, hash, rx_wlan);
 }
 
