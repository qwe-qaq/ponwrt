+int airoha_kite_reauthorize_tx(struct airoha_ppe_dev *dev, unsigned int wi)
+{
+ struct airoha_ppe *ppe = dev->priv;
+ struct airoha_flow_table_entry *e;
+ mutex_lock(&flow_offload_mutex);
+ list_for_each_entry(e, &ppe->kite_flows, kite_node) {
+  if (e->kite_out_wcid != wi || !e->kite_suspended) continue;
+  if (!e->kite_refresh) { atomic64_inc(&ppe->kite_ps_reauth_missing); continue; }
