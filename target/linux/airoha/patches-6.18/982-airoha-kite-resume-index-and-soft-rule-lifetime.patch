Subject: [PATCH] r64 kernel downlink performance and resume correctness

Revalidate native authority; preserve stopped unchanged soft rules, not old
FOEs. Keep single hart, exact policy, PN and DMA/WA ownership contracts.

--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -769,6 +769,9 @@
 	/* A live cookie may be replaced repeatedly while its route is refreshed. */
 	atomic64_t kite_replace_reuse, kite_replace_gc;
  atomic64_t kite_ps_reauth_requested, kite_ps_reauth_ok, kite_ps_reauth_missing;
+ atomic64_t kite_l2_reindexed, kite_soft_preserved, kite_scan_stopped;
+ atomic64_t kite_learn_reason[8];
+ u32 kite_learn_last_slot, kite_learn_last_reason;
  atomic64_t kite_reason[16];
  unsigned long kite_absent_cookie[64];
  u32 kite_absent_next, kite_last_reason;
