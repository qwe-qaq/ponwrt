+ airoha_kite_rule_snapshot(e, rule);
+ *candidate = e;
+ /* Complete rule/tuple/path validation first. PS is a temporary admission
+  * failure, not evidence that an unchanged suspended rule was revoked. */
+ if (e->kite_out_wcid && eth->ppe->kite_dp &&
+     (READ_ONCE(eth->ppe->kite_dp->sta[e->kite_out_wcid].tx_blocked) ||
+      READ_ONCE(eth->ppe->kite_dp->r60.degraded[eth->ppe->kite_dp->sta[e->kite_out_wcid].band]))) {
+  atomic64_inc(&eth->ppe->kite_egress_blocked);
+  return airoha_kite_reason(eth->ppe, 7, -EAGAIN);
+ }
+ return 0;
 free_entry:
 	airoha_ppe_flow_free(e);
 	return err;
@@ -1661,15 +1688,34 @@
    dma_wmb(); WRITE_ONCE(s->r63.first_rule_request[wi],request);
   }
  }
-	old = rhashtable_lookup(&eth->flow_table, &f->cookie, airoha_flow_table_params);
+ old = rhashtable_lookup(&eth->flow_table, &f->cookie, airoha_flow_table_params);
+ if (err == -EAGAIN && e && old && old->kite_refresh == f->hw_refresh &&
+     airoha_kite_soft_reusable(eth->ppe, old, e)) {
+  atomic64_inc(&eth->ppe->kite_soft_preserved);
+  airoha_ppe_flow_free(e);
+  return err; /* native owner retries; hardware remains stopped */
+ }
 	if (!err && old && old->kite_refresh == f->hw_refresh &&
      airoha_kite_flow_reusable(eth->ppe, old, e)) {
   if (old->kite_suspended) {
+   /* One MAC pair can have multiple exact owners. The indexed one may
+    * still be suspended/idle after this active cookie resumes. Replace
+    * the representative under the same lock as native skb learning. */
+   if (old->type == FLOW_TYPE_L2) {
+    spin_lock_bh(&ppe_lock);
+    err = airoha_ppe_foe_l2_flow_commit_entry(eth->ppe, old);
+    spin_unlock_bh(&ppe_lock);
+    if (err) { airoha_ppe_flow_free(e); return err; }
+    atomic64_inc(&eth->ppe->kite_l2_reindexed);
+   }
    /* A fresh native REPLACE proved the complete unchanged rule and current
     * endpoint. Old hardware slots stay INVALID: learn only real UNBINDs. */
    if (old->kite_soft_slot < KDP_FLOWS)
     WRITE_ONCE(eth->ppe->kite_dp->r60.soft[old->kite_soft_slot].version, 0);
-   dma_wmb(); old->kite_suspended = false;
+   dma_wmb();
+   spin_lock_bh(&ppe_lock);
+   old->kite_suspended = false;
+   spin_unlock_bh(&ppe_lock);
    atomic64_inc(&eth->ppe->kite_ps_reauth_ok);
   }
 		atomic64_inc(&eth->ppe->kite_replace_reuse);
