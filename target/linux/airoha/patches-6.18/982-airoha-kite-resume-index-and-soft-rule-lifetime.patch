 						 airoha_l2_flow_table_params);
-	if (!prev)
-		return 0;
+ if (!prev || prev == e)
+  return 0;
 
 	if (IS_ERR(prev))
 		return PTR_ERR(prev);
@@ -1634,9 +1653,17 @@
 	if (err)
 		goto free_entry;
 
-	airoha_kite_rule_snapshot(e, rule);
-	*candidate = e;
