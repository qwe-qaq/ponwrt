@@ -740,15 +735,14 @@
 		        (const u8 *)b + sizeof(b->ib1), sizeof(*a) - sizeof(a->ib1));
 }
 
-static bool airoha_kite_flow_reusable(struct airoha_ppe *ppe,
+static bool airoha_kite_flow_same(struct airoha_ppe *ppe,
 	struct airoha_flow_table_entry *old, struct airoha_flow_table_entry *new)
 {
 	struct kdp_shared *s = READ_ONCE(ppe->kite_dp);
 
 	/* Only optimize Kite. Ordinary Ethernet/PON retain their native path. */
 	if (!old || !s || (!new->kite_in_wcid && !new->kite_out_wcid) ||
-	    old->kite_retired || !airoha_kite_flow_live(ppe, old) ||
-     (old->kite_suspended && s->r60.ps[old->kite_out_wcid].active) ||
+	    old->kite_retired || !old->kite_published ||
 	    !old->kite_rule_len || old->kite_rule_len != new->kite_rule_len ||
 	    memcmp(old->kite_rule_bytes, new->kite_rule_bytes, old->kite_rule_len) ||
 	    old->egress_dev != new->egress_dev ||
@@ -770,6 +764,31 @@
 	     !READ_ONCE(s->flow[old->kite_capture_policy].version)))
 		return false;
 	return true;
+}
+
+/* A fresh rule is always fully built before either reuse decision. The
+ * soft case preserves only an already stopped owner under the SAME native
+ * rule/refresh cell; it never binds hardware while PS/WAKE is asserted. */
+static bool airoha_kite_flow_reusable(struct airoha_ppe *ppe,
+ struct airoha_flow_table_entry *old, struct airoha_flow_table_entry *new)
+{
+ return airoha_kite_flow_same(ppe, old, new) &&
+        airoha_kite_flow_live(ppe, old) &&
+        (!old->kite_suspended || !ppe->kite_dp->r60.ps[old->kite_out_wcid].active);
+}
+static bool airoha_kite_soft_reusable(struct airoha_ppe *ppe,
+ struct airoha_flow_table_entry *old, struct airoha_flow_table_entry *new)
+{
+ struct kdp_shared *s = READ_ONCE(ppe->kite_dp);
+ u32 wi = old ? old->kite_out_wcid : 0, blocked;
+ if (!wi || wi >= KDP_WCIDS || !s || !s->enabled || s->gate || kdp_failed(s) ||
+     !old->kite_suspended || !airoha_kite_flow_same(ppe, old, new)) return false;
+ blocked = READ_ONCE(s->sta[wi].tx_blocked);
+ return blocked && !(blocked & ~KDP_TX_BLOCK_SOFTWARE) &&
+        !s->r60.degraded[s->sta[wi].band] && s->sta[wi].enabled &&
+        s->sta[wi].authorized && s->session == old->kite_session &&
+        s->sta[wi].generation == old->kite_out_gen &&
+        s->sta[wi].key_generation == old->kite_out_key;
 }
 
 static void airoha_kite_capture_key(struct kdp_flow *dst, const struct kdp_flow *src)
@@ -1027,8 +1046,11 @@
 
 	mutex_lock(&flow_offload_mutex);
