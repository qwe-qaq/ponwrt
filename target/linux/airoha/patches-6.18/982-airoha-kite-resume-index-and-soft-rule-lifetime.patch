-      READ_ONCE(s->r60.degraded[out.airoha_npu.band])) {
-			atomic64_inc(&ppe->kite_egress_blocked);
-			return airoha_kite_reason(ppe, 7, -EAGAIN);
-		}
 		e->kite_out_wcid = out.airoha_npu.wcid;
