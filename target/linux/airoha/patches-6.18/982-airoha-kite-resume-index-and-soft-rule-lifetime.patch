+/* Invalidated children retain accounting ownership across a partial stop.
+ * Reuse a proved INVALID child on relearn instead of adding one on every
+ * sleep/wake. Never overwrite the hash of a still-live child. */
+static struct airoha_flow_table_entry *
+airoha_ppe_foe_find_subflow(struct airoha_flow_table_entry *e, u32 hash)
+{
+ struct airoha_flow_table_entry *f, *spare = NULL;
+ hlist_for_each_entry(f, &e->l2_flows, l2_subflow_node) {
+  if (f->hash == hash) return f;
+  if (f->hash == 0xffff && !spare) spare = f;
+ }
+ return spare;
+}
+
 static int
 airoha_ppe_foe_commit_subflow_entry(struct airoha_ppe *ppe,
 				    struct airoha_flow_table_entry *e,
@@ -1091,16 +1105,15 @@
 	if (!hwe_p)
 		return -EINVAL;
 
-	hlist_for_each_entry(f, &e->l2_flows, l2_subflow_node)
-		if (f->hash == hash)
-			goto prepare;
-	f = kzalloc(sizeof(*f), GFP_ATOMIC);
+ f = airoha_ppe_foe_find_subflow(e, hash);
+ if (f) goto prepare;
+ f = kzalloc(sizeof(*f), GFP_ATOMIC);
 	if (!f)
 		return -ENOMEM;
 
 	fresh = true;
 	f->type = FLOW_TYPE_L2_SUBFLOW;
-	f->hash = hash;
+	f->hash = 0xffff;
 
 	prepare:
