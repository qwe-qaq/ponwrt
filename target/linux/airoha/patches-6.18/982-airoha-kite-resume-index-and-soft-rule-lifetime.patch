+  atomic_set(&ppe->kite_scan_budget, 0);
+  atomic64_inc(&ppe->kite_scan_stopped);
+  goto out;
+ }
 	/* Read actual physical SRAM/DRAM entries. The software tuple hash only
 	 * indexes candidates after a hardware slot has been observed. */
 	for (n = 0; n < 64 && atomic_dec_if_positive(&ppe->kite_scan_budget) >= 0; n++) {
@@ -1104,14 +1126,13 @@
