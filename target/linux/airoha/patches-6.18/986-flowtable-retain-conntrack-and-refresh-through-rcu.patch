From: ponwrt maintainers
Subject: [PATCH] r71: Keep conntrack and refresh ownership until RCU flow readers leave.

Native patch on the r70 prepared baseline. Datapath ABI12 unchanged.

--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -251,6 +251,17 @@
 	nft_flow_dst_release(flow, FLOW_OFFLOAD_DIR_REPLY);
 }
 
+/* Readers may still use ct/hw_refresh after the flow is unhashed. Keep
+ * both owning references until they have left their RCU read section. */
+static void flow_offload_free_rcu(struct rcu_head *head)
+{
+	struct flow_offload *flow = container_of(head, struct flow_offload, rcu_head);
+
+	nf_ct_put(flow->ct);
+	flow_hw_refresh_put(flow->hw_refresh);
+	kfree(flow);
+}
+
 void flow_offload_free(struct flow_offload *flow)
 {
 	switch (flow->type) {
@@ -260,9 +271,7 @@
 	default:
 		break;
 	}
-	nf_ct_put(flow->ct);
-	flow_hw_refresh_put(flow->hw_refresh);
-	kfree_rcu(flow, rcu_head);
+	call_rcu(&flow->rcu_head, flow_offload_free_rcu);
 }
 EXPORT_SYMBOL_GPL(flow_offload_free);
 
@@ -878,6 +887,7 @@
 	unregister_netdevice_notifier(&flow_offload_netdev_notifier);
 	nf_flow_table_offload_exit();
 	unregister_pernet_subsys(&nf_flow_table_net_ops);
+	rcu_barrier(); /* callbacks above execute module text */
 }
 
 module_init(nf_flow_table_module_init);
