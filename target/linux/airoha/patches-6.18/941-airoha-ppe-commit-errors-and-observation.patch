 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_foe_bind);
+
+static int airoha_ppe_debugfs_status_show(struct seq_file *m, void *private)
+{
+	struct airoha_ppe *ppe = m->private;
+	unsigned int i, channel;
+
+	seq_printf(m, "abi=1 npu_attached=%u flow_stats=%u\n",
+		   !!rcu_access_pointer(ppe->eth->npu),
+		   IS_ENABLED(CONFIG_NET_AIROHA_FLOW_STATS));
+	seq_printf(m, "setup_attempts=%lld\n", atomic64_read(&ppe->setup_attempts));
+	seq_printf(m, "setup_ok=%lld\n", atomic64_read(&ppe->setup_ok));
+	seq_printf(m, "setup_fail=%lld\n", atomic64_read(&ppe->setup_fail));
+	seq_printf(m, "replace_ok=%lld\n", atomic64_read(&ppe->replace_ok));
+	seq_printf(m, "replace_fail=%lld\n", atomic64_read(&ppe->replace_fail));
+	seq_printf(m, "destroy_ok=%lld\n", atomic64_read(&ppe->destroy_ok));
+	seq_printf(m, "destroy_fail=%lld\n", atomic64_read(&ppe->destroy_fail));
+	seq_printf(m, "learn_requests=%lld\n", atomic64_read(&ppe->learn_requests));
+	seq_printf(m, "bind_ok=%lld\n", atomic64_read(&ppe->bind_ok));
+	seq_printf(m, "bind_fail=%lld\n", atomic64_read(&ppe->bind_fail));
+	seq_printf(m, "setup_errno=%d replace_errno=%d bind_errno=%d\n",
+		   READ_ONCE(ppe->setup_errno), READ_ONCE(ppe->replace_errno),
+		   READ_ONCE(ppe->bind_errno));
+	seq_puts(m, "scope=host_requests_and_commits_not_hardware_hits\n");
+	/* Already configured by airoha_qdma_init_qos_stats(); read only.
+	 * Values wrap at 32 bits. Never reset/reprogram shared QoS counters.
+	 */
+	for (i = 0; i < ARRAY_SIZE(ppe->eth->qdma); i++) {
+		struct airoha_qdma *qdma = &ppe->eth->qdma[i];
+
+		if (!qdma->regs)
+			continue;
+		for (channel = 0; channel < AIROHA_NUM_QOS_CHANNELS; channel++)
+			seq_printf(m, "qdma%u_channel%u cpu=%u fwd=%u cpu_cfg=%08x fwd_cfg=%08x\n",
+				   i, channel,
+				   airoha_qdma_rr(qdma, REG_CNTR_VAL(channel << 1)),
+				   airoha_qdma_rr(qdma, REG_CNTR_VAL((channel << 1) + 1)),
+				   airoha_qdma_rr(qdma, REG_CNTR_CFG(channel << 1)),
+				   airoha_qdma_rr(qdma, REG_CNTR_CFG((channel << 1) + 1)));
+	}
+	return 0;
+}
