+/* Cached GET32 page3: a sysfs reader never issues mailbox commands. */
+static ssize_t clanker_host_status_show(struct device *dev,
+				      struct device_attribute *attr, char *buf)
+{
+	static const char * const names[] = {
+		"not_ready", "invalid", "ring_invalid", "guard_full",
+		"desc_invalid", "copy_or_fault_hold", "rx_reject", "rx_hold",
+		"tx_reject", "tx_hold", "chain_reject", "chain_hold",
+	};
+	struct airoha_npu *npu = dev_get_drvdata(dev);
+	struct airoha_clanker_diag *d = npu->clanker;
+	ssize_t n;
+	unsigned int b, i;
+
+	mutex_lock(&d->lock);
+	n = sysfs_emit(buf, "host_abi=1 available=%u last_error=%d age_ms=%u seq=%u tick=%u\n",
+		d->host_valid, d->host_error,
+		d->host_valid ? jiffies_to_msecs(jiffies - d->host_updated) : 0,
+		d->host[2], d->host[3]);
+	if (!d->host_valid)
+		goto out;
+	for (b = 0; b < 2; b++) {
+		u32 *v = d->host + 28 + b * 11;
+
+		n += sysfs_emit_at(buf, n, "host_band%u", b);
+		for (i = 0; i < ARRAY_SIZE(names); i++)
+			n += sysfs_emit_at(buf, n, " %s=%u", names[i], d->host[4 + i * 2 + b]);
+		n += sysfs_emit_at(buf, n, "\n");
+		n += sysfs_emit_at(buf, n,
+			"host_last%u valid=%u seq=%u tick=%u cause_slot=%u wcid=%u origin=%u hold=%u length_or_segments=%u idx=%u ctrl=%#x guard_ctrl=%#x ready=%u\n",
+			b, v[10], v[0], v[1], v[2], v[3], v[4] & 0xff,
+			!!(v[4] & 0x100), v[5], v[6], v[7], v[8], v[9]);
+	}
+	n += sysfs_emit_at(buf, n, "scope=nonzero_calls origin_0_rx_1_tx_fallback_2_chain hold_retains_ownership; counters_not_atomic\n");
+out:
+	mutex_unlock(&d->lock);
+	return n;
+}
+static DEVICE_ATTR_RO(clanker_host_status);
+
