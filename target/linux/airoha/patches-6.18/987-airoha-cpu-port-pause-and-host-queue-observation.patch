 DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_frame);
 
+/* Fixed embedded queues only; no entry/descriptor dereference. Individual
+ * READ_ONCE values are observational, not a coherent ownership proof. No
+ * queue locks or MMIO scans are added to the packet/completion paths. */
+static int airoha_ppe_debugfs_queues_show(struct seq_file *m, void *private)
+{
+	struct airoha_ppe *ppe = m->private;
+	unsigned int d, i;
+
+	seq_puts(m, "queue_abi=1 atomic=0 scope=software_tx_queues\n");
+	for (d = 0; d < ARRAY_SIZE(ppe->eth->qdma); d++) {
+		struct airoha_qdma *qdma = &ppe->eth->qdma[d];
+
+		if (!qdma->regs)
+			continue;
+		for (i = 0; i < ARRAY_SIZE(qdma->q_tx); i++) {
+			struct airoha_queue *q = &qdma->q_tx[i];
+			int ndesc = READ_ONCE(q->ndesc);
+
+			if (!ndesc)
+				continue;
+			seq_printf(m, "qdma=%u txq=%u ndesc=%d queued=%d head=%u tail=%u stopped=%u flushing=%u\n",
+				d, i, ndesc, READ_ONCE(q->queued),
+				READ_ONCE(q->head), READ_ONCE(q->tail),
+				READ_ONCE(q->txq_stopped), READ_ONCE(q->flushing));
+		}
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_queues);
+
 int airoha_ppe_debugfs_init(struct airoha_ppe *ppe)
 {
 	ppe->debugfs_dir = debugfs_create_dir("ppe", NULL);
+	debugfs_create_file("queue_status", 0444, ppe->debugfs_dir, ppe,
+			    &airoha_ppe_debugfs_queues_fops);
  debugfs_create_file("frame_status", 0444, ppe->debugfs_dir, ppe,
                      &airoha_ppe_debugfs_frame_fops);
 	debugfs_create_file("status", 0444, ppe->debugfs_dir, ppe,
