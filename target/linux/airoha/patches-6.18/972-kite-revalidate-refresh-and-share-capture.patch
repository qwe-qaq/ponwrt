+	    old->kite_session != new->kite_session ||
+	    old->kite_in_gen != new->kite_in_gen || old->kite_in_key != new->kite_in_key ||
+	    old->kite_out_gen != new->kite_out_gen || old->kite_out_key != new->kite_out_key ||
+	    memcmp(&old->kite_key, &new->kite_key, sizeof(old->kite_key)) ||
+	    !airoha_kite_template_equal(&old->data, &new->data))
+		return false;
