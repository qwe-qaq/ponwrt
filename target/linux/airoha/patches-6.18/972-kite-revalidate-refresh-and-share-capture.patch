+	struct kdp_flow *k = &e->kite_key, capture, observed;
+	u32 i, bucket, cap_bucket, slot = KDP_SLOT_NONE;
+	bool bridge = k->type == KDP_FLOW_BRIDGE_IPV4 || k->type == KDP_FLOW_BRIDGE_IPV6;
