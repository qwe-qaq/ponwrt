+static bool airoha_kite_template_equal(const struct airoha_foe_entry *a,
+                                      const struct airoha_foe_entry *b)
+{
+	return !((a->ib1 ^ b->ib1) & ~AIROHA_FOE_IB1_BIND_TIMESTAMP) &&
+		!memcmp((const u8 *)a + sizeof(a->ib1),
+		        (const u8 *)b + sizeof(b->ib1), sizeof(*a) - sizeof(a->ib1));
+}
