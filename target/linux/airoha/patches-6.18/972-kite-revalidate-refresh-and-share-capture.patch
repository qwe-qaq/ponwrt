+static void airoha_kite_capture_key(struct kdp_flow *dst, const struct kdp_flow *src)
+{
+	*dst = *src;
+	dst->version = 0;
+	dst->type = KDP_FLOW_BRIDGE_CAPTURE;
+	memset(dst->src, 0, sizeof(dst->src));
+	memset(dst->dst, 0, sizeof(dst->dst));
+	dst->ports = dst->protocol = dst->dsfield = dst->dsmask = 0;
+	dst->cookie_lo = dst->cookie_hi = 0;
+	dst->hw_slot = KDP_SLOT_NONE;
+}
