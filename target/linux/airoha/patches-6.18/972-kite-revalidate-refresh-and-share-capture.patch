+	bucket = k->type == KDP_FLOW_BRIDGE ? cap_bucket :
+		kdp_flow_l4_bucket(cap_bucket, k->src, k->dst, k->ports, k->protocol, k->type);
+	if (bridge) {
+		airoha_kite_capture_key(&capture, k);
+		for (i = cap_bucket; i < cap_bucket + KDP_FLOW_WAYS; i++) {
+			if (!READ_ONCE(s->flow[i].version))
+				continue;
+			observed = s->flow[i];
+			if (observed.type != KDP_FLOW_BRIDGE_CAPTURE &&
+			    observed.type != KDP_FLOW_BRIDGE_GUARD)
+				continue;
+			observed.version = 0;
+			observed.type = KDP_FLOW_BRIDGE_CAPTURE;
+			if (!memcmp(&observed, &capture, sizeof(observed))) {
+				slot = i;
+				break;
+			}
+		}
+	}
+	for (i = bucket; i < bucket + KDP_FLOW_WAYS; i++)
+		if (!READ_ONCE(s->flow[i].version))
+			break;
+	if (i == bucket + KDP_FLOW_WAYS) {
+		atomic64_inc(&ppe->kite_policy_full);
+		WRITE_ONCE(ppe->kite_full_bucket, bucket);
+		return -ENOSPC;
+	}
+	e->kite_policy = i;
+	if (!bridge)
