+	    (old->kite_capture_policy >= KDP_FLOWS ||
+	     !ppe->kite_capture_refs[old->kite_capture_policy] ||
+	     READ_ONCE(s->flow[old->kite_capture_policy].type) != KDP_FLOW_BRIDGE_CAPTURE ||
