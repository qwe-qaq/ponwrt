+	if (slot == KDP_SLOT_NONE) {
+		for (slot = cap_bucket; slot < cap_bucket + KDP_FLOW_WAYS; slot++)
+			if (slot != i && !READ_ONCE(s->flow[slot].version))
+				break;
+		if (slot == cap_bucket + KDP_FLOW_WAYS) {
+			atomic64_inc(&ppe->kite_capture_full);
+			WRITE_ONCE(ppe->kite_full_bucket, cap_bucket);
+			return -ENOSPC;
+		}
+	}
+	e->kite_capture_policy = slot;
+	return 0; /* refs change only after successful commit + cookie insert */
+}
