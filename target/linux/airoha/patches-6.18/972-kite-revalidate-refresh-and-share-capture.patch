+/* A byte-for-byte rule snapshot avoids cookie/hash-only reuse. Padding may
+ * prevent an optimization, but can never grant broader authorization. */
+static bool airoha_kite_rule_snapshot(struct airoha_flow_table_entry *e,
+                                      const struct flow_rule *rule)
+{
+	u64 keys = rule->match.dissector->used_keys;
+	const struct flow_action_entry *act;
+	u32 len = 0;
+	int i;
+#define KITE_PUT(value) do { \
+	if (sizeof(value) > sizeof(e->kite_rule_bytes) - len) goto unsupported; \
+	memcpy(e->kite_rule_bytes + len, &(value), sizeof(value)); \
+	len += sizeof(value); \
+} while (0)
+#define KITE_MATCH(id, name) do { \
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_##id)) { \
+		struct flow_match_##name m; \
+		flow_rule_match_##name(rule, &m); \
+		KITE_PUT(*m.key); KITE_PUT(*m.mask); \
+	} \
+} while (0)
+	if (keys & ~(BIT_ULL(FLOW_DISSECTOR_KEY_META) |
+	    BIT_ULL(FLOW_DISSECTOR_KEY_CONTROL) | BIT_ULL(FLOW_DISSECTOR_KEY_BASIC) |
+	    BIT_ULL(FLOW_DISSECTOR_KEY_ETH_ADDRS) | BIT_ULL(FLOW_DISSECTOR_KEY_VLAN) |
+	    BIT_ULL(FLOW_DISSECTOR_KEY_IPV4_ADDRS) | BIT_ULL(FLOW_DISSECTOR_KEY_IPV6_ADDRS) |
+	    BIT_ULL(FLOW_DISSECTOR_KEY_IP) | BIT_ULL(FLOW_DISSECTOR_KEY_PORTS) |
+	    BIT_ULL(FLOW_DISSECTOR_KEY_TCP)))
+		goto unsupported;
+	KITE_PUT(keys);
+	KITE_MATCH(META, meta); KITE_MATCH(CONTROL, control);
+	KITE_MATCH(BASIC, basic); KITE_MATCH(ETH_ADDRS, eth_addrs);
+	KITE_MATCH(VLAN, vlan); KITE_MATCH(IPV4_ADDRS, ipv4_addrs);
+	KITE_MATCH(IPV6_ADDRS, ipv6_addrs); KITE_MATCH(IP, ip);
+	KITE_MATCH(PORTS, ports); KITE_MATCH(TCP, tcp);
+	KITE_PUT(rule->action.num_entries);
+	flow_action_for_each(i, act, &rule->action) {
+		KITE_PUT(act->id);
+		switch (act->id) {
+		case FLOW_ACTION_REDIRECT: KITE_PUT(act->dev); break;
+		case FLOW_ACTION_MANGLE: KITE_PUT(act->mangle); break;
+		case FLOW_ACTION_CSUM: KITE_PUT(act->csum_flags); break;
+		case FLOW_ACTION_VLAN_PUSH:
+			KITE_PUT(act->vlan.vid); KITE_PUT(act->vlan.proto);
+			KITE_PUT(act->vlan.prio); break;
+		case FLOW_ACTION_PPPOE_PUSH: KITE_PUT(act->pppoe.sid); break;
+		case FLOW_ACTION_VLAN_POP: case FLOW_ACTION_BRIDGE: break;
+		default: goto unsupported;
+		}
+	}
+	e->kite_rule_len = len;
+	return true;
+unsupported:
+	e->kite_rule_len = 0;
+	return false;
+#undef KITE_MATCH
+#undef KITE_PUT
+}
