From: ponwrt maintainers
Subject: [PATCH] r77: Expose FE1 enabled state and sampled credit peaks.

Native incremental patch on release76. Ownership and datapath ABI12 unchanged.

--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -912,7 +912,7 @@
   n+=sysfs_emit_at(buf,n,"queue_band%u pending=%u peak=%u demand=%u credit_hold=%u no_buffer=%u wait_kind=%u wait_at=%u no_buffer_cycles=%u credit_cycles=%u released=%u dma_wait=%u wa_wait=%u ready_wait=%u owner_wcid=%u owner_pending=%u sta_peak=%u no_buffer_cycles_hi=%u credit_cycles_hi=%u\n",
    b,p[0],p[1],p[2],p[3],p[4],p[5],p[6],p[7],p[8],p[9],p[10],p[11],p[12],p[13],p[14],p[15],p[16],p[17]);
  }
- n+=sysfs_emit_at(buf,n,"scope=KF1_u32_counters waits_not_drops pressure_fields_only_at_pressure_tick owner_and_sta_peak_sampled_at_pressure_tick per_STA_FIFO_not_bypassed\n");
+ n+=sysfs_emit_at(buf,n,"scope=KF1_u32_counters waits_not_drops revision77_peak_sampled_at_publication pressure_fields_only_at_pressure_tick owner_and_sta_peak_sampled_at_pressure_tick per_STA_FIFO_not_bypassed\n");
  mutex_unlock(&d->lock);return n;
 }
