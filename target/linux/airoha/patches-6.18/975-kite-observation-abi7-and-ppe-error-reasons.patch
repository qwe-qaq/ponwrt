+/* Diagnostic classes never alter return codes or revocation semantics. */
+static unsigned int airoha_ppe_error_class(int err)
+{
+ switch (err) {
+ case -EOPNOTSUPP: return 0;
+ case -ENOENT: return 1;
+ case -ENOSPC: return 2;
+ case -ENOMEM: return 3;
+ case -EBUSY: case -EAGAIN: return 4;
+ case -EIO: case -ETIMEDOUT: return 5;
+ default: return 6;
+ }
+}
