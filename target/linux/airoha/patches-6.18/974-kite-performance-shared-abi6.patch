+/* ABI6: boot-only optimization flags, and single hart4 performance counters.
+ * The old DMA regions do not move. The host writes flags only before BIND. */
+#define KDP_PERF_FAST 1u
+#define KDP_PERF_TOKENQ 2u
+struct kdp_perf_control {
+	unsigned int flags, free_count, pending_count, alloc_probe;
+	unsigned int alloc_empty, reap_probe, reap_ready, cache_flush;
+	unsigned int reserved[8];
+};
+struct kdp_perf_band {
+	unsigned int parse_fast, parse_slow, parse_reuse, hint_hit;
+	unsigned int hint_miss, tx_amsdu, tx_single, retry;
+	unsigned int reserved[8];
+};
+/* A-MSDU publication is one aligned word: peer max length and BA TID mask.
+ * No key/PN or authorization is granted by this optional TX capability. */
+static inline unsigned int kdp_amsdu_contract(unsigned int enabled,
+	unsigned int native, unsigned int wme, unsigned int max_len,
+	unsigned int tids)
+{
+	if (!enabled || !native || !wme || max_len < 3839 || max_len > 11454)
+		return 0;
+	return (max_len << 16) | (tids & 0xffu);
+}
+static inline int kdp_amsdu_allowed(unsigned int contract, unsigned int tid,
+	unsigned int len)
+{
+	return tid < 8 && (contract & (1u << tid)) && len <= 1514 &&
+	       len + 64 <= (contract >> 16);
+}
