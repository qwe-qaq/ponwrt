+/* Common downlink: Ethernet II, no VLAN, IPv4 with default QoS, no
+ * options/fragments, complete TCP/UDP and MTU <= 1500. A rejection only
+ * selects the original parser; it never grants an offload policy. */
+static inline int kdp_parse_ipv4_fast(const unsigned char *p, unsigned int len,
+	struct kdp_packet *out)
+{
+	unsigned int end, proto, i;
+	if (len < 42 || len > 1514 || (p[0] & 1) || (p[6] & 1) ||
+	    p[12] != 8 || p[13] || p[14] != 0x45 || p[15] ||
+	    (kdp_be16(p + 20) & 0xbfff))
+		return 0;
+	end = 14 + kdp_be16(p + 16);
+	proto = p[23];
+	if (end > len || end < 42)
+		return 0;
+	if (proto == 6) {
+		if (end < 54 || (p[47] & 7) || (p[46] >> 4) < 5 ||
+		    (unsigned int)(p[46] >> 4) * 4 > end - 34)
+			return 0;
+	} else if (proto != 17 || kdp_be16(p + 38) != end - 34) {
+		return 0;
+	}
+	out->src[0] = kdp_be32(p + 26);
+	out->dst[0] = kdp_be32(p + 30);
+	out->src[1] = out->src[2] = out->src[3] = 0;
+	out->dst[1] = out->dst[2] = out->dst[3] = 0;
+	out->ports = kdp_be32(p + 34);
+	out->protocol = proto;
+	out->type = KDP_FLOW_IPV4;
+	out->vlan = KDP_SLOT_NONE;
+	out->dsfield = 0;
+	for (i = 0; i < 6; i++) {
+		out->dmac[i] = p[i];
+		out->smac[i] = p[i + 6];
+	}
 	return 1;
 }
 
