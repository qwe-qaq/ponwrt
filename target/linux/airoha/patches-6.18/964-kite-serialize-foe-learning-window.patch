Subject: net: airoha: serialize Kite FOE scan-window admission

The bounded scan added by 963 is entered from both NPU RX pollers.  The
budget/time check was a plain read followed by a write, so simultaneous RX
pollers could each arm a 256-slot pass.  Under WAN plus 5 GHz traffic this
made the observed scan rate several times higher than the one-window-per-
second contract and consumed avoidable PPE/CPU time.  Serialize only the
window admission; the worker remains responsible for the MMIO scan.

--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -749,7 +749,8 @@ struct airoha_ppe {
 	struct list_head kite_flows;
 	struct delayed_work kite_learn;
 	atomic_t kite_scan_budget;
+	spinlock_t kite_scan_lock;
 	u32 kite_scan_slot, kite_version;
 	unsigned long kite_scan_next;
 	atomic64_t kite_scanned, kite_learned, kite_revoked;
 
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -1958,5 +1958,6 @@ int airoha_ppe_init(struct airoha_eth *eth)
 	INIT_LIST_HEAD(&ppe->kite_flows);
 	INIT_DELAYED_WORK(&ppe->kite_learn, airoha_kite_learn_work);
 	atomic_set(&ppe->kite_scan_budget, 0);
+	spin_lock_init(&ppe->kite_scan_lock);
 	eth->ppe = ppe;
 
--- a/drivers/net/ethernet/airoha/airoha_kite.c
+++ b/drivers/net/ethernet/airoha/airoha_kite.c
@@ -479,21 +479,27 @@ void airoha_kite_learn_hint(struct airoha_ppe_dev *dev)
 {
 	struct airoha_ppe *ppe = dev->priv;
-	u32 total;
+	unsigned long flags;
+	bool arm = false;
 
 	/* A miss restarts one bounded pass; no MMIO scanning in NAPI. */
-	if (!READ_ONCE(ppe->kite_dp) ||
-	    atomic_read(&ppe->kite_scan_budget) > 0 ||
-	    time_before(jiffies, READ_ONCE(ppe->kite_scan_next)))
-		return;
-
-	/* The regular skb path learns a fresh flow directly.  This pass is for
-	 * aged/moved entries, so rotate through a small window and coalesce the
-	 * many publication hints generated by a traffic burst. */
-	total = airoha_ppe_get_total_num_entries(ppe);
-	if (!total)
-		return;
-	WRITE_ONCE(ppe->kite_scan_next, jiffies + HZ);
-	atomic_set(&ppe->kite_scan_budget, min_t(u32, total, 256));
-	schedule_delayed_work(&ppe->kite_learn, msecs_to_jiffies(20));
+	spin_lock_irqsave(&ppe->kite_scan_lock, flags);
+	if (READ_ONCE(ppe->kite_dp) &&
+	    atomic_read(&ppe->kite_scan_budget) <= 0 &&
+	    !time_before(jiffies, READ_ONCE(ppe->kite_scan_next))) {
+		u32 total;
+
+		/* The regular skb path learns a fresh flow directly.  This pass is
+		 * for aged/moved entries, so rotate through a small window and
+		 * coalesce the many publication hints generated by a traffic burst. */
+		total = airoha_ppe_get_total_num_entries(ppe);
+		if (total) {
+			WRITE_ONCE(ppe->kite_scan_next, jiffies + HZ);
+			atomic_set(&ppe->kite_scan_budget, min_t(u32, total, 256));
+			arm = true;
+		}
+	}
+	spin_unlock_irqrestore(&ppe->kite_scan_lock, flags);
+	if (arm)
+		schedule_delayed_work(&ppe->kite_learn, msecs_to_jiffies(20));
 }
 EXPORT_SYMBOL_GPL(airoha_kite_learn_hint);
