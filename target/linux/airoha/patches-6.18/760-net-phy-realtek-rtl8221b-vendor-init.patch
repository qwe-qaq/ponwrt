Subject: [PATCH] net: phy: realtek: apply vendor RTL8221B 2500BASE-X SerDes init

The RTL8221B on the FiberHome AN4475-G2 2.5G combo port links on the copper
side (2500BASE-T full duplex with a real link partner) but never brings up the
SerDes lane towards the SoC: the Airoha EN7581 ETH PCS reports

  pcs_pma DIG_RO_RESERVE_2 RX_SIGDET = 0/6

while the same measurement on the PON PCS returns 6/6, i.e. the PCS side and
the measurement method are both fine and simply no signal arrives.

The stock firmware brings this PHY up with a sequence that mainline does not
perform.  Taken verbatim from the stock boot script (tce emiiw 7 <mmd> <reg>
<val>), for hwcfg 0x4000001B..0x4000002F:

  tce emiiw 7 0x1e 0x7588 0x2        } SerDes in-band AN off
  tce emiiw 7 0x1e 0x7589 0x71d0     }   (already done by config_inband)
  tce emiiw 7 0x1e 0x7587 0x3        }
  tce emiiw 7 0x7  0x003c 0x0        } EEE off
  tce emiiw 7 0x7  0x003e 0x0        }
  tce emiiw 7 0x1f 0xa442 0x0438     } "4 line patch" / SerDes lane config
  tce emiiw 7 0x1  0x0000 0x8000     } soft reset, latches the above
  tce emiiw 7 0x1e 0x6a11 0xb199     } low temperature compensation
  tce emiiw 7 0x1e 0x6a12 0xb317     }

Mainline writes 0x697a/0x6a04/0x6f10/0x6f11 but none of the above, and in
particular never the 0xa442 line patch nor the reset that latches the SerDes
mode.  Apply the missing vendor sequence after the option mode is programmed.

Mainline never touches VEND2 0xa468 bit 1 either.  That bit selects HiSGMII
framing on the line side and must agree with the option mode in 0x697a: modes
1 and 3 are HiSGMII (8B/10B), modes 0 and 2 are standard 2500BASE-X or SGMII
(64B/66B).  Driving a standard mode with the bit still set leaves a
framing mismatch that neither side reports as an error - both links come up
and every frame is dropped.  This patch therefore derives the bit from 0x697a
instead of forcing it on, right before the BMCR reset that latches both.

Gated behind rtl8221b_vendor_patch (default on) so the sequence can be
A/B tested on a live system without rebuilding:
  modprobe -r realtek && modprobe realtek rtl8221b_vendor_patch=0

Signed-off-by: local

--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -2040,9 +2040,160 @@
 	return rtl822x_set_serdes_option_mode(phydev, true);
 }
 
+static bool rtl8221b_vendor_patch = true;
+module_param_named(rtl8221b_vendor_patch, rtl8221b_vendor_patch, bool, 0644);
+MODULE_PARM_DESC(rtl8221b_vendor_patch,
+		 "Apply the vendor RTL8221B 2500BASE-X SerDes/line patch sequence");
+
+/*
+ * The stock firmware's extra analog writes (0xa442, 0x6a11/0x6a12, EEE off)
+ * are not part of the HiSGMII bring-up; the Realtek HiSGMII driver for the
+ * same PHY does none of them.  Keep them behind a switch so a box already
+ * running this tree can tell whether they help or hurt without a rebuild:
+ *   modprobe -r realtek && modprobe realtek rtl8221b_stock_extra=0
+ */
+static bool rtl8221b_stock_extra = true;
+module_param_named(rtl8221b_stock_extra, rtl8221b_stock_extra, bool, 0644);
+MODULE_PARM_DESC(rtl8221b_stock_extra,
+		 "Also apply the stock firmware 2500BASE-X analog tweaks");
+
+/*
+ * Vendor initialisation that mainline does not perform.  The register
+ * addresses below are MMD/offset pairs exactly as the stock firmware writes
+ * them; 0x1f is MDIO_MMD_VEND2 and 0x1e is MDIO_MMD_VEND1.
+ *
+ * The 0xa442 "4 line patch" is not documented in the public datasheet but is
+ * applied unconditionally by the stock firmware on every hwcfg that ships
+ * this PHY, and the following BMCR reset is what latches the SerDes option
+ * mode together with it.
+ */
+static int rtl8221b_vendor_serdes_init(struct phy_device *phydev)
+{
+	int ret, val;
+
+	if (!rtl8221b_vendor_patch)
+		return 0;
+
+	/* Only meaningful for a 2500BASE-X SerDes link */
+	if (phydev->interface != PHY_INTERFACE_MODE_2500BASEX &&
+	    !test_bit(PHY_INTERFACE_MODE_2500BASEX, phydev->host_interfaces))
+		return 0;
+
+	/*
+	 * The PHY drops VEND2 writes while its state machine is still
+	 * booting; the vendor driver polls 0xa420[1:0] == 3 first and so
+	 * must we.  A timeout is not fatal: the writes below still get
+	 * latched by the reset, they just have less chance of sticking.
+	 */
+	ret = phy_read_mmd_poll_timeout(phydev, MDIO_MMD_VEND2, 0xa420, val,
+					(val & GENMASK(1, 0)) == 3,
+					2000, 1500000, false);
+	if (ret < 0)
+		phydev_warn(phydev, "PHY not ready before SerDes init: %d\n", ret);
+
+	/*
+	 * VEND1 0x75f3 bit 0 (SERDES_CTRL_OPTION) selects where the SerDes
+	 * lane configuration is taken from.  The Realtek HiSGMII driver for
+	 * this PHY clears it before programming 0x697a; leaving it set makes
+	 * the option mode a read-only illusion - 0x697a reads back the value
+	 * that was written while the lane keeps its previous framing.
+	 */
+	ret = phy_clear_bits_mmd(phydev, MDIO_MMD_VEND1, 0x75f3, BIT(0));
+	if (ret < 0)
+		return ret;
+
+	if (rtl8221b_stock_extra) {
+		/*
+		 * SerDes in-band AN off, as the stock firmware writes it for
+		 * this hwcfg (tce emiiw 7 0x1e 0x7588/0x7589/0x7587).
+		 */
+		ret = phy_write_mmd(phydev, MDIO_MMD_VEND1, 0x7588, 0x0002);
+		if (ret < 0)
+			return ret;
+
+		ret = phy_write_mmd(phydev, MDIO_MMD_VEND1, 0x7589, 0x71d0);
+		if (ret < 0)
+			return ret;
+
+		ret = phy_write_mmd(phydev, MDIO_MMD_VEND1, 0x7587, 0x0003);
+		if (ret < 0)
+			return ret;
+
+		/* EEE off */
+		ret = phy_write_mmd(phydev, MDIO_MMD_AN, 0x003c, 0x0000);
+		if (ret < 0)
+			return ret;
+
+		ret = phy_write_mmd(phydev, MDIO_MMD_AN, 0x003e, 0x0000);
+		if (ret < 0)
+			return ret;
+
+		/* "4 line patch" */
+		ret = phy_modify_mmd(phydev, MDIO_MMD_VEND2, 0xa442, 0xffff,
+				     0x0438);
+		if (ret < 0)
+			return ret;
+	}
+
+	/*
+	 * VEND2 0xa468 bit 1 selects HiSGMII framing on the line side and
+	 * has to agree with the option mode programmed in 0x697a: modes 1
+	 * and 3 are HiSGMII (8B/10B), modes 0 and 2 are standard 2500BASE-X
+	 * or SGMII (64B/66B).  Keeping the bit set for a standard mode
+	 * leaves the lane on HiSGMII framing while the host PCS decodes
+	 * 64B/66B, so every frame is lost even though the lane is
+	 * electrically alive and both ends report link up.
+	 *
+	 * The reset below latches both this bit and the option mode.
+	 */
+	val = phy_read_mmd(phydev, MDIO_MMD_VEND1, 0x697a);
+	if (val < 0)
+		return val;
+
+	if ((val & GENMASK(5, 0)) == 1 || (val & GENMASK(5, 0)) == 3)
+		ret = phy_set_bits_mmd(phydev, MDIO_MMD_VEND2, 0xa468, BIT(1));
+	else
+		ret = phy_clear_bits_mmd(phydev, MDIO_MMD_VEND2, 0xa468, BIT(1));
+	if (ret < 0)
+		return ret;
+
+	/* Soft reset: latch SerDes option mode and line patch */
+	ret = __phy_write(phydev, MII_BMCR, BMCR_RESET);
+	if (ret < 0)
+		return ret;
+
+	msleep(1000);
+
+	phydev_info(phydev,
+		    "SerDes latched: 75f3=%#06x 697a=%#06x 7580=%#06x 7587=%#06x 7588=%#06x 7589=%#06x a468=%#06x\n",
+		    phy_read_mmd(phydev, MDIO_MMD_VEND1, 0x75f3),
+		    phy_read_mmd(phydev, MDIO_MMD_VEND1, 0x697a),
+		    phy_read_mmd(phydev, MDIO_MMD_VEND1, 0x7580),
+		    phy_read_mmd(phydev, MDIO_MMD_VEND1, 0x7587),
+		    phy_read_mmd(phydev, MDIO_MMD_VEND1, 0x7588),
+		    phy_read_mmd(phydev, MDIO_MMD_VEND1, 0x7589),
+		    phy_read_mmd(phydev, MDIO_MMD_VEND2, 0xa468));
+
+	if (!rtl8221b_stock_extra)
+		return 0;
+
+	/* Low temperature compensation */
+	ret = phy_write_mmd(phydev, MDIO_MMD_VEND1, 0x6a11, 0xb199);
+	if (ret < 0)
+		return ret;
+
+	return phy_write_mmd(phydev, MDIO_MMD_VEND1, 0x6a12, 0xb317);
+}
+
 static int rtl822xb_config_init(struct phy_device *phydev)
 {
-	return rtl822x_set_serdes_option_mode(phydev, false);
+	int ret;
+
+	ret = rtl822x_set_serdes_option_mode(phydev, false);
+	if (ret < 0)
+		return ret;
+
+	return rtl8221b_vendor_serdes_init(phydev);
 }
 
 static int rtl822x_config_inband(struct phy_device *phydev, unsigned int modes)
