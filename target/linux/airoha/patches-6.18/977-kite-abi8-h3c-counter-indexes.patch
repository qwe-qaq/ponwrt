+#define KDP_PERF_TDMA_EMPTY   1u
+#define KDP_PERF_TDMA_REARM   2u
+#define KDP_PERF_TX_RING_FULL 3u
+#define KDP_PERF_TX_PUBLISH   4u
+#define KDP_PERF_DMA_DONE     5u
+#define KDP_PERF_TX_READY     6u
+#define KDP_PERF_FALLBACK_HOLD 7u
