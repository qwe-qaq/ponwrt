+/* flow_offload_mutex serializes this control-only ring. No packet logs. */
+#define AIROHA_KITE_FLOW_EVENTS 256
+struct airoha_kite_flow_event {
+ u64 serial, ns;
+ unsigned long cookie;
+ struct kdp_flow key;
+ u32 event, request, active, blocked, suspended, soft_slot, soft_version;
+};
 struct airoha_ppe {
+ u64 kite_event_serial;
+ struct airoha_kite_flow_event kite_events[AIROHA_KITE_FLOW_EVENTS];
 	struct airoha_ppe_dev dev;
 	struct airoha_eth *eth;
 
