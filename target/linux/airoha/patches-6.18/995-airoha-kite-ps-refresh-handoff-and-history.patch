+static int airoha_ppe_debugfs_kite_history_show(struct seq_file *m, void *private)
+{
+ struct airoha_ppe *ppe=m->private;
+ u64 last, first, n;
+ mutex_lock(&flow_offload_mutex);
+ last=ppe->kite_event_serial;
+ first=last>AIROHA_KITE_FLOW_EVENTS ? last-AIROHA_KITE_FLOW_EVENTS+1 : 1;
+ seq_printf(m,"r76_flow_ring first=%llu last=%llu overwritten=%llu capacity=%u\n",
+  last?first:0,last,last>AIROHA_KITE_FLOW_EVENTS?last-AIROHA_KITE_FLOW_EVENTS:0,
+  AIROHA_KITE_FLOW_EVENTS);
+ for (n=first;n<=last;n++) {
+  const struct airoha_kite_flow_event *e=&ppe->kite_events[(n-1)%AIROHA_KITE_FLOW_EVENTS];
+  const struct kdp_flow *f=&e->key;
+  seq_printf(m,"r76_flow seq=%llu ns=%llu event=%u cookie=%lu request=%u active=%u blocked=%u suspended=%u soft_slot=%u soft_version=%u session=%u generation=%u key_generation=%u wcid=%u band=%u type=%u protocol=%u vlan=%u dsfield=%u dsmask=%u ports=%08x src=%08x:%08x:%08x:%08x dst=%08x:%08x:%08x:%08x smac=%pM dmac=%pM\n",
+   e->serial,e->ns,e->event,e->cookie,e->request,e->active,e->blocked,e->suspended,e->soft_slot,e->soft_version,
+   f->session,f->generation,f->key_generation,f->wcid,f->band,f->type,f->protocol,f->vlan,f->dsfield,f->dsmask,f->ports,
+   f->src[0],f->src[1],f->src[2],f->src[3],f->dst[0],f->dst[1],f->dst[2],f->dst[3],f->smac,f->dmac);
+ }
+ mutex_unlock(&flow_offload_mutex);
+ return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_kite_history);
 
