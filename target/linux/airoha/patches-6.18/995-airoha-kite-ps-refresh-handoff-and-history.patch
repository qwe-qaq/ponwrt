-/* A fresh rule is always fully built before either reuse decision. The
- * soft case preserves only an already stopped owner under the SAME native
- * rule/refresh cell; it never binds hardware while PS/WAKE is asserted. */
+/* A fresh rule is always fully built before either reuse decision.
+ * PS notification sets tx_blocked before suspend obtains flow_offload_mutex.
+ * An identical REPLACE in that interval must retain the exact owner too:
+ * otherwise suspend cannot publish its soft rule while sibling captures
+ * still deliver its tail. No hardware binding is performed here. Suspend
+ * will invalidate the retained slot under PARK; changed/DESTROY rules still
+ * retire through the normal fenced path. */
 static bool airoha_kite_flow_reusable(struct airoha_ppe *ppe,
  struct airoha_flow_table_entry *old, struct airoha_flow_table_entry *new)
