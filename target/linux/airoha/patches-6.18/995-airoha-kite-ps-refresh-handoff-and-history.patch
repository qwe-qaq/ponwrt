From: ponwrt maintainers
Subject: [PATCH] r76: Preserve exact authorization across pre-suspend refresh; publish bounded lifecycle and FE1 evidence.

Native incremental patch on release75. Datapath ABI12 and DMA ownership unchanged.

--- a/drivers/net/ethernet/airoha/airoha_kite.c
+++ b/drivers/net/ethernet/airoha/airoha_kite.c
@@ -5,6 +5,29 @@
  */
 /* Protected by flow_offload_mutex. Retained across Wi-Fi restart/rebind.
  * Exhaustion keeps that peer on the host path until the next SoC boot. */
+/* Event IDs: 1 publish, 2 pending-PS refresh preserved, 3 suspend,
+ * 4 resume, 5 retire, 6 changed/rejected REPLACE. Exact keys, no payloads.
+ * The caller holds flow_offload_mutex, including debugfs readers. */
+static void airoha_kite_flow_event(struct airoha_ppe *ppe,
+                                 const struct airoha_flow_table_entry *e, u32 kind)
+{
+ struct kdp_shared *s=ppe->kite_dp;
+ struct airoha_kite_flow_event *v;
+ u32 wi=e->kite_out_wcid;
+ u64 serial;
+ if (!s || !wi || wi>=KDP_WCIDS) return;
+ serial=++ppe->kite_event_serial;
+ v=&ppe->kite_events[(serial-1)%AIROHA_KITE_FLOW_EVENTS];
+ memset(v,0,sizeof(*v));
+ v->serial=serial; v->ns=ktime_get_ns(); v->cookie=e->cookie;
+ v->key=e->kite_capture_policy!=KDP_SLOT_NONE ? e->kite_key : e->kite_tx_key;
+ v->event=kind; v->request=READ_ONCE(s->r60.ps[wi].request);
+ v->active=READ_ONCE(s->r60.ps[wi].active); v->blocked=READ_ONCE(s->sta[wi].tx_blocked);
+ v->suspended=e->kite_suspended; v->soft_slot=e->kite_soft_slot;
+ if (e->kite_soft_slot<KDP_FLOWS)
+  v->soft_version=READ_ONCE(s->r60.soft[e->kite_soft_slot].version);
+}
+
 static u32 airoha_kite_route_serial;
 
