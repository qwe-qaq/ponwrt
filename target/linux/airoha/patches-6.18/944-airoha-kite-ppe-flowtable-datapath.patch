Subject: [PATCH] Authorize and learn Kite PPE flows with generation revocation

--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -15,6 +15,7 @@
 #include <linux/netdevice.h>
 #include <linux/reset.h>
 #include <linux/soc/airoha/airoha_offload.h>
+#include <linux/soc/airoha/airoha_kite.h>
 #include <net/dsa.h>
 
 #define AIROHA_MAX_NUM_GDM_PORTS	4
@@ -571,6 +572,11 @@
 	 */
 	struct airoha_gdm_dev *egress_dev;
 	struct list_head gc_node;
+	struct list_head kite_node;
+	u32 kite_in_wcid, kite_out_wcid, kite_policy;
+	u32 kite_session, kite_in_gen, kite_in_key, kite_out_gen, kite_out_key;
+	bool kite_retired;
+	struct kdp_flow kite_key;
 
 	/* Must be last --ends in a flexible-array member. */
 	struct airoha_foe_entry data;
@@ -736,6 +742,14 @@
 	atomic64_t bind_fail;
 	int setup_errno, replace_errno, bind_errno;
 	struct dentry *debugfs_dir;
+	struct kdp_shared *kite_dp;
+	const struct airoha_kite_ops *kite_ops;
+	void *kite_priv;
+	struct list_head kite_flows;
+	struct delayed_work kite_learn;
+	atomic_t kite_scan_budget;
+	u32 kite_scan_slot, kite_version;
+	atomic64_t kite_scanned, kite_learned, kite_revoked;
 };
 
 struct airoha_eth_soc_data {
--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_kite.c
@@ -0,0 +1,590 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included by airoha_ppe.c: uses the existing FOE lock, table and native
+ * SRAM accessors. All control operations hold flow_offload_mutex. Firmware
+ * receives policy only after Linux has accepted the matching TC rule.
+ */
+/* Protected by flow_offload_mutex. Retained across Wi-Fi restart/rebind.
+ * Exhaustion keeps that peer on the host path until the next SoC boot. */
+static u32 airoha_kite_route_serial;
+
+static void airoha_kite_route_retire(struct kdp_shared *s, u32 wi)
+{
+	u32 tag = READ_ONCE(s->sta[wi].tx_tag);
+
+	WRITE_ONCE(s->sta[wi].tx_tag, 0);
+	if (tag && READ_ONCE(s->route[tag & (KDP_ROUTES - 1)].tag) == tag)
+		WRITE_ONCE(s->route[tag & (KDP_ROUTES - 1)].tag, 0);
+	dma_wmb();
+}
+
+static void airoha_kite_route_allocate(struct kdp_shared *s, u32 wi)
+{
+	u32 tag;
+
+	while (airoha_kite_route_serial < KDP_ROUTE_MAX) {
+		struct kdp_route *r;
+
+		tag = ++airoha_kite_route_serial;
+		r = &s->route[tag & (KDP_ROUTES - 1)];
+		if (READ_ONCE(r->tag))
+			continue;
+		r->wcid = wi;
+		dma_wmb();
+		WRITE_ONCE(r->tag, tag);
+		WRITE_ONCE(s->sta[wi].tx_tag, tag);
+		return;
+	}
+}
+
+static bool airoha_kite_flow_live(struct airoha_ppe *ppe,
+				   struct airoha_flow_table_entry *e)
+{
+	struct kdp_shared *s = READ_ONCE(ppe->kite_dp);
+	u32 in = e->kite_in_wcid, out = e->kite_out_wcid;
+
+	if (!in && !out)
+		return true;
+	if (!s || s->session != e->kite_session || !s->enabled || s->gate || s->fault)
+		return false;
+	if (in && (!s->sta[in].enabled || !s->sta[in].authorized ||
+		   s->sta[in].generation != e->kite_in_gen ||
+		   s->sta[in].key_generation != e->kite_in_key))
+		return false;
+	if (out && (s->sta[out].tx_blocked || !s->sta[out].enabled || !s->sta[out].authorized ||
+		    s->sta[out].generation != e->kite_out_gen ||
+		    s->sta[out].key_generation != e->kite_out_key))
+		return false;
+	return true;
+}
+
+/* Unlike the historical best-effort cleanup, security revocation checks
+ * every hardware write and reads its real slot back before dropping the
+ * software reference. On error the global gate remains closed. */
+static int airoha_kite_invalidate_slot(struct airoha_ppe *ppe,
+				      struct airoha_flow_table_entry *e)
+{
+	struct airoha_foe_entry *hwe, invalid;
+	int ret;
+
+	if (e->hash == 0xffff)
+		return 0;
+	hwe = airoha_ppe_foe_get_entry_locked(ppe, e->hash);
+	if (!hwe)
+		return -EIO;
+	invalid = *hwe;
+	invalid.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+	invalid.ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE, AIROHA_FOE_STATE_INVALID);
+	ret = airoha_ppe_foe_commit_entry(ppe, &invalid, e->hash, true);
+	if (ret)
+		return ret;
+	hwe = airoha_ppe_foe_get_entry_locked(ppe, e->hash);
+	if (!hwe || FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1) == AIROHA_FOE_STATE_BIND)
+		return -EIO;
+	e->hash = 0xffff;
+	return 0;
+}
+
+static int airoha_kite_invalidate(struct airoha_ppe *ppe,
+				 struct airoha_flow_table_entry *e)
+{
+	struct airoha_flow_table_entry *sub;
+	int ret = 0;
+
+	spin_lock_bh(&ppe_lock);
+	if (e->type == FLOW_TYPE_L2) {
+		hlist_for_each_entry(sub, &e->l2_flows, l2_subflow_node) {
+			ret = airoha_kite_invalidate_slot(ppe, sub);
+			if (ret)
+				break;
+		}
+	} else {
+		ret = airoha_kite_invalidate_slot(ppe, e);
+	}
+	spin_unlock_bh(&ppe_lock);
+	if (ret)
+		WRITE_ONCE(ppe->kite_dp->fault, 10);
+	return ret;
+}
+
+static bool airoha_kite_endpoint(struct airoha_ppe *ppe,
+				const struct net_device_path *p)
+{
+	struct kdp_shared *s = READ_ONCE(ppe->kite_dp);
+	volatile struct kdp_sta *sta;
+	u32 wi = p->airoha_npu.wcid;
+
+	if (!s || p->type != DEV_PATH_AIROHA_NPU || !wi || wi >= KDP_WCIDS ||
+	    !READ_ONCE(s->enabled) || READ_ONCE(s->gate) || READ_ONCE(s->fault))
+		return false;
+	sta = &s->sta[wi];
+	return p->airoha_npu.session == READ_ONCE(s->session) &&
+		p->airoha_npu.generation == READ_ONCE(sta->generation) &&
+		p->airoha_npu.key_generation == READ_ONCE(sta->key_generation) &&
+		p->airoha_npu.band == READ_ONCE(sta->band) &&
+		p->airoha_npu.bss == READ_ONCE(sta->bss) &&
+		p->airoha_npu.tx_tag == READ_ONCE(sta->tx_tag) &&
+		READ_ONCE(sta->tx_tag) &&
+		READ_ONCE(sta->enabled) && READ_ONCE(sta->authorized);
+}
+
+static int airoha_kite_path(struct net_device *dev, const u8 *mac,
+			   struct net_device_path *last)
+{
+	struct net_device_path_stack stack;
+	int ret;
+
+	memset(last, 0, sizeof(*last));
+	rcu_read_lock();
+	ret = dev_fill_forward_path(dev, mac, &stack);
+	if (!ret && stack.num_paths)
+		*last = stack.path[stack.num_paths - 1];
+	rcu_read_unlock();
+	return ret;
+}
+
+static int airoha_kite_flow_prepare(struct airoha_ppe *ppe,
+	struct airoha_flow_table_entry *e, struct flow_rule *rule,
+	struct net_device *odev, const struct ethhdr *eth)
+{
+	struct kdp_shared *s = READ_ONCE(ppe->kite_dp);
+	struct net_device_path in, out;
+	struct flow_match_meta meta;
+	struct flow_match_eth_addrs mac;
+	struct net_device *idev;
+	struct kdp_flow *k = &e->kite_key;
+	u32 i, bucket;
+	int ret = 0;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	if (!odev)
+		return -EINVAL;
+	airoha_kite_path(odev, eth->h_dest, &out);
+	if (out.type == DEV_PATH_AIROHA_NPU) {
+		if (!airoha_kite_endpoint(ppe, &out))
+			return -EAGAIN;
+		e->kite_out_wcid = out.airoha_npu.wcid;
+		e->kite_out_gen = out.airoha_npu.generation;
+		e->kite_out_key = out.airoha_npu.key_generation;
+		e->kite_session = out.airoha_npu.session;
+	}
+	flow_rule_match_meta(rule, &meta);
+	if (meta.mask->ingress_ifindex != U32_MAX)
+		return -EOPNOTSUPP;
+	idev = dev_get_by_index(dev_net(odev), meta.key->ingress_ifindex);
+	if (!idev)
+		return -ENODEV;
+	/* Ordinary Ethernet/GDM ingress has its existing verified RX hash.
+	 * Wi-Fi ingress must provide the resolved L2 source, never IP guesses. */
+	if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_ETH_ADDRS)) {
+		if (idev->ieee80211_ptr)
+			ret = -EOPNOTSUPP;
+		goto put;
+	}
+	flow_rule_match_eth_addrs(rule, &mac);
+	airoha_kite_path(idev, mac.key->src, &in);
+	if (in.type != DEV_PATH_AIROHA_NPU)
+		goto put;
+	if (!airoha_kite_endpoint(ppe, &in)) {
+		ret = -EAGAIN;
+		goto put;
+	}
+	if (!is_broadcast_ether_addr(mac.mask->src) ||
+	    !is_broadcast_ether_addr(mac.mask->dst) ||
+	    !ether_addr_equal(mac.key->src, s->sta[in.airoha_npu.wcid].addr)) {
+		ret = -EOPNOTSUPP;
+		goto put;
+	}
+	/* Never grant a broader policy by ignoring an unfamiliar match key. */
+	if (rule->match.dissector->used_keys &
+	    ~(BIT_ULL(FLOW_DISSECTOR_KEY_META) | BIT_ULL(FLOW_DISSECTOR_KEY_CONTROL) |
+	      BIT_ULL(FLOW_DISSECTOR_KEY_BASIC) | BIT_ULL(FLOW_DISSECTOR_KEY_ETH_ADDRS) |
+	      BIT_ULL(FLOW_DISSECTOR_KEY_IPV4_ADDRS) | BIT_ULL(FLOW_DISSECTOR_KEY_IPV6_ADDRS) |
+	      BIT_ULL(FLOW_DISSECTOR_KEY_IP) | BIT_ULL(FLOW_DISSECTOR_KEY_PORTS) |
+	      BIT_ULL(FLOW_DISSECTOR_KEY_TCP) | BIT_ULL(FLOW_DISSECTOR_KEY_VLAN))) {
+		ret = -EOPNOTSUPP;
+		goto put;
+	}
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_TCP)) {
+		struct flow_match_tcp tcp;
+
+		flow_rule_match_tcp(rule, &tcp);
+		if (tcp.key->flags || (tcp.mask->flags & ~htons(7))) {
+			ret = -EOPNOTSUPP;
+			goto put;
+		}
+	}
+	k->session = in.airoha_npu.session;
+	k->generation = in.airoha_npu.generation;
+	k->key_generation = in.airoha_npu.key_generation;
+	k->wcid = in.airoha_npu.wcid;
+	k->band = in.airoha_npu.band;
+	k->bss = in.airoha_npu.bss;
+	ether_addr_copy(k->smac, mac.key->src);
+	ether_addr_copy(k->dmac, mac.key->dst);
+	k->vlan = KDP_SLOT_NONE;
+	k->hw_slot = KDP_SLOT_NONE;
+	k->cookie_lo = lower_32_bits(e->cookie);
+	k->cookie_hi = upper_32_bits(e->cookie);
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CVLAN) ||
+	    flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_ENC_CONTROL)) {
+		ret = -EOPNOTSUPP;
+		goto put;
+	}
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_VLAN)) {
+		struct flow_match_vlan vlan;
+
+		flow_rule_match_vlan(rule, &vlan);
+		if (vlan.key->vlan_tpid != htons(ETH_P_8021Q) ||
+		    vlan.mask->vlan_id != VLAN_VID_MASK) {
+			ret = -EOPNOTSUPP;
+			goto put;
+		}
+		/* Only PCP=DEI=0 is admitted; this is a safe subset of VID masks. */
+		k->vlan = vlan.key->vlan_id;
+	}
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IP)) {
+		struct flow_match_ip ip;
+
+		flow_rule_match_ip(rule, &ip);
+		if (ip.mask->ttl) {
+			ret = -EOPNOTSUPP;
+			goto put;
+		}
+		k->dsfield = ip.key->tos;
+		k->dsmask = ip.mask->tos;
+	}
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IPV4_ADDRS)) {
+		struct flow_match_ipv4_addrs a;
+
+		flow_rule_match_ipv4_addrs(rule, &a);
+		if (a.mask->src != cpu_to_be32(U32_MAX) ||
+		    a.mask->dst != cpu_to_be32(U32_MAX)) {
+			ret = -EOPNOTSUPP;
+			goto put;
+		}
+		k->src[0] = be32_to_cpu(a.key->src);
+		k->dst[0] = be32_to_cpu(a.key->dst);
+		k->type = KDP_FLOW_IPV4;
+	} else if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IPV6_ADDRS)) {
+		struct flow_match_ipv6_addrs a;
+
+		flow_rule_match_ipv6_addrs(rule, &a);
+		for (i = 0; i < 4; i++) {
+			if (a.mask->src.s6_addr32[i] != cpu_to_be32(U32_MAX) ||
+			    a.mask->dst.s6_addr32[i] != cpu_to_be32(U32_MAX)) {
+				ret = -EOPNOTSUPP;
+				goto put;
+			}
+			k->src[i] = be32_to_cpu(a.key->src.s6_addr32[i]);
+			k->dst[i] = be32_to_cpu(a.key->dst.s6_addr32[i]);
+		}
+		k->type = KDP_FLOW_IPV6;
+	} else {
+		k->type = KDP_FLOW_BRIDGE;
+	}
+	if (k->type != KDP_FLOW_BRIDGE) {
+		struct flow_match_ports ports;
+		struct flow_match_basic basic;
+
+		if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS)) {
+			ret = -EOPNOTSUPP;
+			goto put;
+		}
+		flow_rule_match_ports(rule, &ports);
+		flow_rule_match_basic(rule, &basic);
+		if (ports.mask->src != htons(U16_MAX) ||
+		    ports.mask->dst != htons(U16_MAX) || basic.mask->ip_proto != 0xff ||
+		    (basic.key->ip_proto != IPPROTO_TCP && basic.key->ip_proto != IPPROTO_UDP)) {
+			ret = -EOPNOTSUPP;
+			goto put;
+		}
+		k->ports = (u32)be16_to_cpu(ports.key->src) << 16 |
+			   be16_to_cpu(ports.key->dst);
+		k->protocol = basic.key->ip_proto;
+	}
+	bucket = kdp_flow_bucket(k->smac, k->dmac, k->vlan, k->wcid);
+	if (k->type != KDP_FLOW_BRIDGE)
+		bucket = kdp_flow_l4_bucket(bucket, k->src, k->dst, k->ports,
+					  k->protocol, k->type);
+	for (i = bucket; i < bucket + KDP_FLOW_WAYS; i++)
+		if (!READ_ONCE(s->flow[i].version))
+			break;
+	if (i == bucket + KDP_FLOW_WAYS || ppe->kite_version == U32_MAX) {
+		ret = -ENOSPC;
+		goto put;
+	}
+	e->kite_in_wcid = k->wcid;
+	e->kite_session = k->session;
+	e->kite_in_gen = k->generation;
+	e->kite_in_key = k->key_generation;
+	e->kite_policy = i;
+put:
+	dev_put(idev);
+	return ret;
+}
+
+static void airoha_kite_flow_publish(struct airoha_ppe *ppe,
+				    struct airoha_flow_table_entry *e)
+{
+	if (!e->kite_in_wcid && !e->kite_out_wcid)
+		return;
+	list_add_tail(&e->kite_node, &ppe->kite_flows);
+	if (e->kite_in_wcid) {
+		struct kdp_flow *dst = &ppe->kite_dp->flow[e->kite_policy];
+
+		memcpy(dst, &e->kite_key, sizeof(*dst));
+		dma_wmb();
+		WRITE_ONCE(dst->version, ++ppe->kite_version);
+	}
+	airoha_kite_learn_hint(&ppe->dev);
+}
+
+/* The caller retains e when a fence fails. Never free a possibly referenced
+ * policy or claim successful hardware revocation after a mailbox timeout. */
+static int airoha_kite_flow_remove(struct airoha_ppe *ppe,
+				 struct airoha_flow_table_entry *e)
+{
+	int ret;
+
+	if (!e->kite_in_wcid && !e->kite_out_wcid)
+		return 0;
+	ret = ppe->kite_ops->pause(ppe->kite_priv);
+	if (ret)
+		return ret;
+	if (e->kite_in_wcid)
+		WRITE_ONCE(ppe->kite_dp->flow[e->kite_policy].version, 0);
+	/* Retire the actual FOE while all NPU flow readers are parked. */
+	ret = airoha_kite_invalidate(ppe, e);
+	if (ret)
+		return ret;
+	airoha_ppe_foe_flow_remove_entry(ppe, e);
+	list_del_init(&e->kite_node);
+	e->kite_in_wcid = e->kite_out_wcid = 0;
+	atomic64_inc(&ppe->kite_revoked);
+	dma_wmb();
+	return ppe->kite_ops->resume(ppe->kite_priv);
+}
+
+static void airoha_kite_learn_work(struct work_struct *work)
+{
+	struct airoha_ppe *ppe = container_of(to_delayed_work(work),
+					    struct airoha_ppe, kite_learn);
+	u32 total = airoha_ppe_get_total_num_entries(ppe), n;
+	bool again = false;
+
+	mutex_lock(&flow_offload_mutex);
+	if (!ppe->kite_dp || READ_ONCE(ppe->kite_dp->fault) ||
+	    READ_ONCE(ppe->kite_dp->gate) || list_empty(&ppe->kite_flows))
+		goto out;
+	/* Read actual physical SRAM/DRAM entries. The software tuple hash only
+	 * indexes candidates after a hardware slot has been observed. */
+	for (n = 0; n < 64 && atomic_dec_if_positive(&ppe->kite_scan_budget) >= 0; n++) {
+		struct airoha_foe_entry *hwe;
+		struct airoha_flow_table_entry *e;
+		u32 slot = ppe->kite_scan_slot++, index, type;
+
+		if (ppe->kite_scan_slot == total)
+			ppe->kite_scan_slot = 0;
+		spin_lock_bh(&ppe_lock);
+		hwe = airoha_ppe_foe_get_entry_locked(ppe, slot);
+		atomic64_inc(&ppe->kite_scanned);
+		if (!hwe || FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1) !=
+				AIROHA_FOE_STATE_UNBIND)
+			goto unlock;
+		type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+		if (type == PPE_PKT_TYPE_BRIDGE) {
+			struct airoha_foe_bridge br = {};
+
+			br.dest_mac_hi = hwe->l2b.dest_mac_hi;
+			br.dest_mac_lo = hwe->l2b.dest_mac_lo;
+			br.src_mac_hi = hwe->l2b.src_mac_hi >> 16;
+			br.src_mac_lo = hwe->l2b.src_mac_hi << 16 | hwe->l2b.src_mac_lo;
+			e = rhashtable_lookup_fast(&ppe->l2_flows, &br,
+						   airoha_l2_flow_table_params);
+			if (e && e->kite_in_wcid && airoha_kite_flow_live(ppe, e) &&
+			    ((e->kite_key.vlan == KDP_SLOT_NONE ? 0 : e->kite_key.vlan) ==
+			     hwe->l2b.ingress_vlan) &&
+			    !airoha_ppe_foe_commit_subflow_entry(ppe, e, slot, true))
+				atomic64_inc(&ppe->kite_learned);
+			goto unlock;
+		}
+		if (type != PPE_PKT_TYPE_IPV4_HNAPT && type != PPE_PKT_TYPE_IPV6_ROUTE_5T)
+			goto unlock;
+		index = airoha_ppe_foe_get_entry_hash(ppe, hwe);
+		hlist_for_each_entry(e, &ppe->foe_flow[index], list) {
+			if (!e->kite_in_wcid || !airoha_kite_flow_live(ppe, e) ||
+			    e->type != FLOW_TYPE_L4 || !airoha_ppe_foe_compare_entry(e, hwe))
+				continue;
+			if (e->hash != 0xffff && e->hash != slot) {
+				struct airoha_foe_entry *old;
+
+				old = airoha_ppe_foe_get_entry_locked(ppe, e->hash);
+				if (!old || (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, old->ib1) ==
+						AIROHA_FOE_STATE_BIND &&
+					     airoha_ppe_foe_compare_entry(e, old)))
+					continue;
+			}
+			/* The old slot aged out or moved. Relearn from this actual
+			 * UNBIND slot without waiting for the Linux rule to expire. */
+			if (!airoha_ppe_foe_commit_entry(ppe, &e->data, slot, true)) {
+				e->hash = slot;
+				WRITE_ONCE(ppe->kite_dp->flow[e->kite_policy].hw_slot, slot);
+				atomic64_inc(&ppe->kite_learned);
+			}
+			break;
+		}
+unlock:
+		spin_unlock_bh(&ppe_lock);
+		cond_resched();
+	}
+	again = atomic_read(&ppe->kite_scan_budget) > 0;
+out:
+	mutex_unlock(&flow_offload_mutex);
+	if (again)
+		schedule_delayed_work(&ppe->kite_learn, msecs_to_jiffies(10));
+}
+
+void airoha_kite_learn_hint(struct airoha_ppe_dev *dev)
+{
+	struct airoha_ppe *ppe = dev->priv;
+
+	/* A miss restarts one bounded pass; no MMIO scanning in NAPI. */
+	if (READ_ONCE(ppe->kite_dp)) {
+		atomic_set(&ppe->kite_scan_budget, airoha_ppe_get_total_num_entries(ppe));
+		schedule_delayed_work(&ppe->kite_learn, 0);
+	}
+}
+EXPORT_SYMBOL_GPL(airoha_kite_learn_hint);
+
+int airoha_kite_attach(struct airoha_ppe_dev *dev, struct kdp_shared *shared,
+	const struct airoha_kite_ops *ops, void *priv)
+{
+	struct airoha_ppe *ppe = dev->priv;
+	int ret = 0;
+
+	mutex_lock(&flow_offload_mutex);
+	if (!airoha_is_7581(ppe->eth) || ppe->kite_dp ||
+	    shared->magic != KDP_MAGIC || shared->bytes != sizeof(*shared) ||
+	    !shared->gate || !ops || !ops->pause || !ops->resume) {
+		ret = -EINVAL;
+	} else {
+		unsigned int wi;
+
+		for (wi = 1; wi < KDP_WCIDS; wi++)
+			if (shared->sta[wi].generation) {
+				airoha_kite_route_retire(shared, wi);
+				airoha_kite_route_allocate(shared, wi);
+				if (!shared->sta[wi].tx_tag)
+					shared->sta[wi].enabled = 0;
+			}
+		ppe->kite_ops = ops;
+		ppe->kite_priv = priv;
+		WRITE_ONCE(ppe->kite_dp, shared);
+	}
+	mutex_unlock(&flow_offload_mutex);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_kite_attach);
+
+int airoha_kite_revoke(struct airoha_ppe_dev *dev, unsigned int wcid)
+{
+	struct airoha_ppe *ppe = dev->priv;
+	struct airoha_flow_table_entry *e, *tmp;
+	int ret = 0;
+
+	mutex_lock(&flow_offload_mutex);
+	if (!ppe->kite_dp)
+		goto out;
+	if (wcid >= KDP_WCIDS) {
+		ret = -EINVAL;
+		goto out;
+	}
+	ret = ppe->kite_ops->pause(ppe->kite_priv);
+	if (ret)
+		goto out;
+	if (wcid) {
+		WRITE_ONCE(ppe->kite_dp->sta[wcid].enabled, 0);
+		airoha_kite_route_retire(ppe->kite_dp, wcid);
+		airoha_kite_route_allocate(ppe->kite_dp, wcid);
+	} else {
+		u32 wi;
+
+		WRITE_ONCE(ppe->kite_dp->enabled, 0);
+		for (wi = 1; wi < KDP_WCIDS; wi++)
+			airoha_kite_route_retire(ppe->kite_dp, wi);
+	}
+	list_for_each_entry_safe(e, tmp, &ppe->kite_flows, kite_node) {
+		if (wcid && e->kite_in_wcid != wcid && e->kite_out_wcid != wcid)
+			continue;
+		if (e->kite_in_wcid)
+			WRITE_ONCE(ppe->kite_dp->flow[e->kite_policy].version, 0);
+		ret = airoha_kite_invalidate(ppe, e);
+		if (ret)
+			goto out;
+		airoha_ppe_foe_flow_remove_entry(ppe, e);
+		list_del_init(&e->kite_node);
+		rhashtable_remove_fast(&ppe->eth->flow_table, &e->node,
+				       airoha_flow_table_params);
+		kfree(e);
+		atomic64_inc(&ppe->kite_revoked);
+	}
+	dma_wmb();
+	ret = ppe->kite_ops->resume(ppe->kite_priv);
+out:
+	mutex_unlock(&flow_offload_mutex);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_kite_revoke);
+
+/* PS/TWT retains the shared RX PN/reorder authority. Retire only egress
+ * rules; subsequent frames reach mac80211's power-save buffering path. */
+int airoha_kite_revoke_tx(struct airoha_ppe_dev *dev, unsigned int wcid)
+{
+	struct airoha_ppe *ppe = dev->priv;
+	struct airoha_flow_table_entry *e, *tmp;
+	int ret = 0;
+
+	mutex_lock(&flow_offload_mutex);
+	if (!ppe->kite_dp || !wcid || wcid >= KDP_WCIDS)
+		goto out;
+	ret = ppe->kite_ops->pause(ppe->kite_priv);
+	if (ret)
+		goto out;
+	list_for_each_entry_safe(e, tmp, &ppe->kite_flows, kite_node) {
+		if (e->kite_out_wcid != wcid)
+			continue;
+		if (e->kite_in_wcid)
+			WRITE_ONCE(ppe->kite_dp->flow[e->kite_policy].version, 0);
+		ret = airoha_kite_invalidate(ppe, e);
+		if (ret)
+			goto out;
+		airoha_ppe_foe_flow_remove_entry(ppe, e);
+		list_del_init(&e->kite_node);
+		rhashtable_remove_fast(&ppe->eth->flow_table, &e->node,
+				       airoha_flow_table_params);
+		kfree(e);
+		atomic64_inc(&ppe->kite_revoked);
+	}
+	dma_wmb();
+	ret = ppe->kite_ops->resume(ppe->kite_priv);
+out:
+	mutex_unlock(&flow_offload_mutex);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_kite_revoke_tx);
+
+int airoha_kite_detach(struct airoha_ppe_dev *dev)
+{
+	struct airoha_ppe *ppe = dev->priv;
+	int ret = airoha_kite_revoke(dev, 0);
+
+	if (ret)
+		return ret;
+	mutex_lock(&flow_offload_mutex);
+	WRITE_ONCE(ppe->kite_dp, NULL);
+	mutex_unlock(&flow_offload_mutex);
+	cancel_delayed_work_sync(&ppe->kite_learn);
+	synchronize_net();
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_kite_detach);
