Subject: airoha: revoke old flow authorization before repeated REPLACE

A matching cookie does not prove that route, actions or station generation
are unchanged. Revalidate after revocation; retain the indexed object on
fence or removal failure. No live object is silently reused.

--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -1331,6 +1331,32 @@
 	return 0;
 }
 
+/* A cookie identifies a connection, not immutable actions or authorization.
+ * Revoke the previous policy before revalidating even a now-unsupported rule.
+ * Failed fences keep the object reachable for destroy/recovery and retry. */
+static int airoha_ppe_flow_replace_remove(struct airoha_eth *eth,
+                                         unsigned long cookie)
+{
+	struct airoha_flow_table_entry *e;
+	int err;
+
+	lockdep_assert_held(&flow_offload_mutex);
+	e = rhashtable_lookup(&eth->flow_table, &cookie, airoha_flow_table_params);
+	if (!e)
+		return 0;
+	err = airoha_kite_flow_remove(eth->ppe, e);
+	if (err)
+		return err;
+	airoha_ppe_foe_flow_remove_entry(eth->ppe, e);
+	err = rhashtable_remove_fast(&eth->flow_table, &e->node,
+				     airoha_flow_table_params);
+	if (err)
+		return err;
+	atomic64_inc(&eth->ppe->kite_replace_gc);
+	kfree(e);
+	return 0;
+}
+
 static int airoha_ppe_flow_offload_replace(struct airoha_eth *eth,
 					   struct flow_cls_offload *f)
 {
@@ -1345,30 +1371,16 @@
