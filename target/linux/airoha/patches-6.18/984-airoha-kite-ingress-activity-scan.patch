+/* Called under flow_offload_mutex, never in NAPI. Missing ingress rules
+ * alone cannot create a hardware UNBIND slot. Actual NPU RX immediately
+ * reopens the bounded scan; otherwise retain a slow rotating fallback. */
+static bool airoha_kite_scan_active(struct airoha_ppe *ppe)
+{
+ u32 a=READ_ONCE(ppe->kite_dp->rx_ppe[0]);
+ u32 b=READ_ONCE(ppe->kite_dp->rx_ppe[1]);
+ if (a!=ppe->kite_scan_rx[0] || b!=ppe->kite_scan_rx[1]) {
+  ppe->kite_scan_rx[0]=a; ppe->kite_scan_rx[1]=b;
+  ppe->kite_scan_idle_until=jiffies+30*HZ;
+  atomic64_inc(&ppe->kite_scan_rx_wakes);
+  return true;
+ }
+ if (time_before(jiffies,ppe->kite_scan_idle_until)) {
+  atomic64_inc(&ppe->kite_scan_idle);
+  return false;
+ }
+ ppe->kite_scan_idle_until=jiffies+30*HZ;
+ return true;
+}
