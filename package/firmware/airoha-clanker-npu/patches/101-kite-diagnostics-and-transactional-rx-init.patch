+#if defined(AN7581) && defined(MT7916)
+/* GET32 is independent of the ownership ABI. Values are observational:
+ * aligned 32-bit reads, not a globally atomic snapshot across harts. */
+static int kite_diag_snapshot(u32 *msg, u32 cnt)
+{
+	static u32 sequence;
+	u32 page = msg[0] & 15, i;
+	u32 *d = msg + 2;
+
+	if (cnt != 256 || page > 1)
+		return 0;
+	for (i = 0; i < 62; i++)
+		d[i] = 0;
+	d[0] = 0x4b440001;
+	d[1] = page;
+	d[2] = ++sequence;
+	d[3] = timer_raw_tick;
+	if (page == 0) {
+		d[4] = (rxd_2g_init_done ? 1 : 0) | (rxd_5g_init_done ? 2 : 0);
+		d[5] = hostadpt_tx_ring_ready;
+		d[6] = sram_alloc_offset;
+		d[7] = ndbg->cnt[NC_SRAM_ALLOCS];
+		d[8] = ndbg->cnt[NC_PPE_MAILS];
+		d[9] = ndbg->cnt[NC_TUN_PKTS];
+		d[10] = ndbg->cnt[NC_TUN_DROP];
+		d[11] = ndbg->cnt[NC_TDMA_TX_FULL];
+		d[12] = ndbg->cnt[NC_KITE_INIT_FAIL];
+		d[13] = ndbg->cnt[NC_SRAM_FAIL];
+		for (i = 0; i < MAX_CORE_NUM; i++) {
+			volatile struct ndbg_hart *h = &ndbg->hart[i];
+			u32 *out = d + 14 + i * 6;
+
+			out[0] = h->loop;
+			out[1] = h->beat;
+			out[2] = h->mails;
+			out[3] = h->trap_cnt;
+			out[4] = h->mcause;
+			out[5] = h->mepc;
+		}
+	} else {
+		/* Always-on, single-writer counters; wrap modulo 2^32. */
+		for (i = 0; i < 16; i++)
+			d[4 + i] = ndbg->cnt[NC_KITE_RX0 + i];
+		d[20] = rxd_2g_cpu_idx;
+		d[21] = rxd_5g_cpu_idx;
+		d[22] = wifi_driver_model;
+		d[23] = wifi_dbdc_mode;
+		d[24] = wifi_debug_flags;
+		d[25] = wifi_force_to_cpu;
+		d[26] = wifi_band_cap;
+	}
+	return 1;
+}
+#endif
