Local integration for fixed Clanker 735529c and ponwrt 6.18.52.

--- a/kite_rxd.h
+++ b/kite_rxd.h
@@ -80,4 +80,24 @@
 {
 	return wcid > 0 && wcid <= (dbdc ? 255u : 150u);
 }
+
+/* Legacy BA storage has two 150-WCID banks. This helper never dereferences
+ * an unallocated bank, even if the computed offset is nonzero. */
+static inline u32 kite_ba_address(u32 band, u32 wcid, u32 tid, u32 dbdc,
+				u32 bank_a, u32 bank_b)
+{
+	u32 base, index;
+
+	if (band > 1 || tid > 7 || !wcid || wcid > (dbdc ? 300u : 150u))
+		return 0;
+	if (dbdc) {
+		base = wcid > 150 ? bank_a : bank_b;
+		index = wcid > 150 ? wcid - 151 : wcid - 1;
+	} else {
+		base = band ? bank_b : bank_a;
+		index = wcid - 1;
+	}
+	return base ? base + (index * 8 + tid) * 28 : 0;
+}
+
 #endif
