+/* These words are private, naturally aligned copies on little-endian RV32.
+ * Exactly 48 bytes are fetched, only for len >= 48, after TDMA ownership. */
+static void dp_header_copy(u32 *h, const volatile kdp_word *p)
+{
+ h[0]=p[0]; h[1]=p[1]; h[2]=p[2]; h[3]=p[3];
+ h[4]=p[4]; h[5]=p[5]; h[6]=p[6]; h[7]=p[7];
+ h[8]=p[8]; h[9]=p[9]; h[10]=p[10]; h[11]=p[11];
+}
+static u32 dp_swap32(u32 x)
+{
+ return (x >> 24) | ((x >> 8) & 0xff00) |
+        ((x << 8) & 0xff0000) | (x << 24);
+}
+static int dp_parse_ipv4_words(const u32 *h, u32 len, struct kdp_packet *p)
+{
+ u32 end, proto, frag, v, hdrlen;
+ kdp_word *mac = (void *)p->smac;
+ if (len < 48 || len > 1514 || (h[0] & 1) || (h[1] & 0x10000) ||
+     h[3] != 0x00450008u) return 0;
+ frag = ((h[5] & 255) << 8) | ((h[5] >> 8) & 255);
+ if (frag & 0xbfff) return 0;
+ end = 14 + ((h[4] & 255) << 8) + ((h[4] >> 8) & 255);
+ proto = h[5] >> 24;
+ if (end > len || end < 42) return 0;
+ if (proto == 6) {
+  hdrlen = ((h[11] >> 20) & 15) * 4;
+  if (end < 54 || (h[11] & 0x07000000) || hdrlen < 20 || hdrlen > end - 34)
+   return 0;
+ } else if (proto != 17 ||
+            (((h[9] >> 16) & 255) << 8 | (h[9] >> 24)) != end - 34)
+  return 0;
+ p->src[0] = dp_swap32((h[6] >> 16) | (h[7] << 16));
+ p->dst[0] = dp_swap32((h[7] >> 16) | (h[8] << 16));
+ p->src[1]=p->src[2]=p->src[3]=0;
+ p->dst[1]=p->dst[2]=p->dst[3]=0;
+ p->ports = dp_swap32((h[8] >> 16) | (h[9] << 16));
+ p->protocol=proto; p->type=KDP_FLOW_IPV4; p->vlan=KDP_SLOT_NONE; p->dsfield=0;
+ /* smac[6] immediately followed by dmac[6], aligned at offset 52. */
+ v=h[2] >> 16;
+ mac[0]=(h[1] >> 16) | (h[2] << 16);
+ mac[1]=v | (h[0] << 16);
+ mac[2]=(h[0] >> 16) | (h[1] << 16);
+ return 1;
+}
+_Static_assert(__builtin_offsetof(struct kdp_packet, smac) % 4 == 0 &&
+ __builtin_offsetof(struct kdp_packet, dmac) == __builtin_offsetof(struct kdp_packet, smac) + 6,
+ "packet MAC word layout");
+static u32 dp_l2_bucket(const struct kdp_packet *p, u32 wcid, u32 band)
+{
+ struct dp_l2_hash *c = &dp_private.l2[band][wcid & 3];
+ const kdp_word *mac = (const void *)p->smac;
+ if (c->valid && c->wcid == wcid && c->vlan == p->vlan &&
+     c->mac[0] == mac[0] && c->mac[1] == mac[1] && c->mac[2] == mac[2])
+  return c->bucket;
+ c->wcid=wcid; c->vlan=p->vlan;
+ c->mac[0]=mac[0]; c->mac[1]=mac[1]; c->mac[2]=mac[2];
+ c->bucket=kdp_flow_bucket(p->smac,p->dmac,p->vlan,wcid);
+ c->valid=1;
+ return c->bucket;
+}
