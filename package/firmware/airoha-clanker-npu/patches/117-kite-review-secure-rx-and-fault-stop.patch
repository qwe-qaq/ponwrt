+/* The hardware splits translated A-MSDUs before this engine. Validate
+ * every child before releasing any of them: a bad FIRST must also suppress
+ * a later child that happens to match an authorized PPE rule. */
+static int dp_rx_mpdu_valid(struct dp_rx_context *ctx, const struct kdp_mpdu *m)
+{
+	volatile struct kdp_shared *s = ctx->s;
+	volatile struct kdp_rx_token *first;
+	u16 id = m->head;
+	u32 n;
+	static const u8 rfc1042[6] = { 0xaa, 0xaa, 3, 0, 0, 0 };
+
+	if (!m->complete || !m->count || m->count > 64 || id >= KDP_RX_TOKENS)
+		return 0;
+	first = &s->rx[id];
+	if (!first->wcid || first->wcid >= KDP_WCIDS || first->tid > 7 ||
+	    first->band != ctx->band)
+		return 0;
+	for (n = 0; n < m->count; n++) {
+		volatile struct kdp_rx_token *r;
+		const u8 *p;
+		u32 i, snap = 1, source = 0;
+
+		if (id >= KDP_RX_TOKENS)
+			return 0;
+		r = &s->rx[id];
+		if (r->wcid != first->wcid || r->tid != first->tid ||
+		    r->band != first->band || r->bss != first->bss ||
+		    r->generation != first->generation ||
+		    r->key_generation != first->key_generation || r->len > 3500)
+			return 0;
+		if (m->count > 1) {
+			if (!r->offset || r->offset > r->len || r->len - r->offset < 14)
+				return 0;
+			p = (const void *)(wifi_pkt_va(id) + r->offset);
+			for (i = 0; i < 6; i++) {
+				if (p[i] != rfc1042[i]) snap = 0;
+				source |= p[6 + i];
+			}
+			if ((!n && snap) || !source || (p[6] & 1))
+				return 0;
+		}
+		if (n + 1 == m->count && (id != m->tail || r->next != KDP_BA_NONE))
+			return 0;
+		id = r->next;
+	}
+	return 1;
+}
