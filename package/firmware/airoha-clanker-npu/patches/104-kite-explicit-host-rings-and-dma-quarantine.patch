+	 * transfer, and never clear another channel's completion. */
+	kite_copy_write(DMA_COPY_STATUS, KITE_COPY_MASK);
+	__asm__ volatile("fence iorw,iorw" ::: "memory");
+	if (kite_copy_read(DMA_COPY_STATUS) & KITE_COPY_MASK) {
+		kite_copy.fault = 2;
+		return KITE_HOST_HOLD;
+	}
