+/* SPDX-License-Identifier: GPL-2.0-only */
+/* AN7581 MT7916: channel 3 has exactly one writer (host delivery, hart 3).
+ * A timeout is loss of completion proof, NOT cancellation of DMA. Keep
+ * both source and destination owned, suppress publication, and latch the
+ * fault for the rest of this boot. Only a verified hardware reset could
+ * make automatic recovery safe; none is claimed here.
+ */
+#include "npu_internal.h"
+#include "kite-host.h"
+
+#if defined(AN7581) && defined(MT7916)
+#define KITE_COPY_CHANNEL 3u
+#define KITE_COPY_MASK (1u << KITE_COPY_CHANNEL)
+#define KITE_COPY_POLLS 1000000u
+/* Cycle bound also works when the timer ISR is not running. This is a
+ * conservative budget, not a claim about a fixed wall-clock duration. */
+#define KITE_COPY_CYCLES 8000000u
+
+static struct {
+	volatile u32 inflight, fault;
+	u32 submitted, completed, timeouts, src, dst, len;
+} kite_copy;
+
+static u32 kite_copy_read(u32 reg)
+{
+	return REG32(reg);
+}
+
+static void kite_copy_write(u32 reg, u32 value)
+{
+	REG32(reg) = value;
+}
+
+int kite_host_faulted(void)
+{
+	return kite_copy.fault != 0;
+}
+
+int kite_host_dma_idle(void)
+{
+	return !kite_copy.inflight && !kite_copy.fault;
+}
+
+void kite_host_dma_snapshot(u32 *out)
+{
+	out[0] = kite_copy.inflight;
+	out[1] = kite_copy.fault;
+	out[2] = kite_copy.submitted;
+	out[3] = kite_copy.completed;
+	out[4] = kite_copy.timeouts;
+	out[5] = kite_copy.src;
+	out[6] = kite_copy.dst;
+	out[7] = kite_copy.len;
+}
+
+int kite_host_copy(u32 src, u32 dst, u32 len)
+{
+	u32 start, polls;
+
+	if (!kite_host_dma_idle())
+		return KITE_HOST_HOLD;
