+/* The producer index alone cannot prove that Linux consumed descriptors
+ * already published to the ARM.  The own bit is written last by the
+ * producer and cleared by the host RX poller, so scan both bound rings
+ * before acknowledging a data stop. */
+int kite_host_dma_rings_empty(void)
+{
+	u32 band, i, base;
+
+	if (!kite_host_bands)
+		return 1;
+	for (band = 0; band < 2; band++) {
+		if (!(kite_host_bands & (1u << band)))
+			continue;
+		base = band ? hostadpt_rx_ring_base : hostadpt_tx_ring_base;
+		if (!base)
+			return 0;
+		for (i = 0; i < KITE_HOST_RING_COUNT; i++)
+			if (*(volatile u32 *)(base + i * 24) & 1)
+				return 0;
+	}
+	__asm__ volatile("fence iorw,iorw" ::: "memory");
+	return kite_host_dma_idle();
+}
