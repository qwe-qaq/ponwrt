+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Hart4-only, per-batch diagnostics. No ownership or admission authority.
+ * FE1 stays out of shared datapath ABI12 and is published uncached. */
+struct dp_feed_band {
+ u32 batches, packets, hist[5], end[8];
+ u32 mixed, wcid, tid, run_max, gap_samples, gap_cycles, gap_max;
+ u32 ready_gap_samples, ready_gap_cycles;
+};
+static struct {
+ struct dp_feed_band band[2];
+ u32 reason[2], stamp[2], armed[2], empty[2];
+} dp_feed __attribute__((section(".kite_observe")));
+static u32 dp_feed_storage[64] __attribute__((section(".kite_observe"),aligned(64)));
+static volatile u32 dp_feed_seq;
+static void dp_feed_batch(u32 band, u32 sampled)
+{
+ struct dp_publish_batch *q=&dp_batch[band];
+ struct dp_feed_band *v=&dp_feed.band[band];
+ u32 n=q->packets, bin;
+ if (!n) return;
+ bin=n==1?0:n<=4?1:n<=8?2:n<16?3:4;
+ v->batches++;v->packets+=n;v->hist[bin]++;
+ if (sampled) {
+  u32 now=csr_read(mcycle),run=0,wi=KDP_SLOT_NONE,tid=KDP_SLOT_NONE,mixed=0;
+  for (u32 i=0;i<n;i++) {
+   if (q->wcid[i]!=wi || q->tid[i]!=tid) {
+    mixed+=!!run;run=0;wi=q->wcid[i];tid=q->tid[i];
+   }
+   run++;if (run>v->run_max) v->run_max=run;
+  }
+  v->mixed+=!!mixed;v->wcid=wi;v->tid=tid;
+  if (dp_feed.armed[band]) {
+   u32 gap=now-dp_feed.stamp[band];
+   v->gap_samples++;v->gap_cycles+=gap;if(gap>v->gap_max)v->gap_max=gap;
+   if (!dp_feed.empty[band]) {v->ready_gap_samples++;v->ready_gap_cycles+=gap;}
+  }
+  dp_feed.stamp[band]=now;dp_feed.empty[band]=0;
+ }
+ /* Only adjacent sampled batches form an interval; unsampled work resets. */
+ dp_feed.armed[band]=!!sampled;
+}
+void kite_dp_feed_end(u32 band, u32 full, u32 exhausted)
+{
+ if (band>1) return;
+ u32 why=full?6:exhausted?7:dp_feed.reason[band];
+ if (why>7) why=0;
+ dp_feed.band[band].end[why]++;
+ dp_feed.reason[band]=0;
+}
+static void dp_feed_publish(void)
+{
+ volatile u32 *v=KDP_DIAG_UNCACHED(dp_feed_storage);
+ u32 seq=(dp_feed_seq&~1u)+2;if(!seq)seq=2;
+ dp_feed_seq=seq-1;KDP_BARRIER();
+ v[0]=1;v[1]=seq;v[2]=dp_session;v[3]=dp_epoch;v[4]=76;
+ v[5]=cpu_clock_get();v[6]=(u32)csr_read(mcycle)>>8;
+ v[7]=0;v[8]=0;
+ for(u32 b=0;b<2;b++)for(u32 i=0;i<24;i++)v[9+b*24+i]=((u32*)&dp_feed.band[b])[i];
+ KDP_BARRIER();dp_feed_seq=seq;
+}
+void kite_dp_feed_snapshot(u32 *out)
+{
+ const volatile u32 *v=KDP_DIAG_UNCACHED(dp_feed_storage);
+ for(u32 retry=0;retry<3;retry++){
+  u32 seq=dp_feed_seq;if(!seq||(seq&1))continue;
+  KDP_BARRIER();for(u32 i=0;i<57;i++)out[i]=v[i];KDP_BARRIER();
+  if(seq==dp_feed_seq&&out[1]==seq)return;
+ }
+ for(u32 i=0;i<57;i++)out[i]=0;
+}
