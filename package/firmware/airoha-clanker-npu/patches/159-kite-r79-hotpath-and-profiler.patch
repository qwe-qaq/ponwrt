+static inline __attribute__((always_inline)) int dp_hint_ipv4(
+ volatile struct kdp_shared *s, const struct dp_sta_tx *sta,
+ const struct dp_ipv4_key *p, u32 wcid, u32 band)
+{
+ /* Share one inlined proof between recent and hash probes: duplicating
+  * the full proof at two call sites bloats the TX instruction footprint. */
+ u32 recent=0,way=0,base=0,probes=0,index;
+ for (;;) {
+  if (recent<4) {
+   index=dp_private.recent[band][recent++];
+   if (!index || index>DP_HINT_SETS*DP_HINT_WAYS) continue;
+   index--;
+  } else {
+   if (!way) {
+    u32 hash=p->ports ^ p->src ^ (p->dst<<7) ^ wcid;
+    hash^=hash>>16;hash*=0x7feb352du;hash^=hash>>15;
+    base=(hash&(DP_HINT_SETS-1))*DP_HINT_WAYS;
+   }
+   if (way==DP_HINT_WAYS) {dp_obs.band[band].hint_probe+=probes;return 0;}
+   index=base+way++;probes++;
