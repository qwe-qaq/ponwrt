+  if (!dp_hint_ipv4_hit(s,sta,p,wcid,band,index)) continue;
+  if (probes) {
+   dp_obs.band[band].hint_probe+=probes;
+   dp_private.recent[band][dp_private.recent_next[band]++ & 3]=index+1;
+  }
+  return 1;
+ }
