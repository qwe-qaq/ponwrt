Subject: Kite: distinguish RX policy misses from TDMA admission failures

The existing RX-PPE counter alone cannot explain why an authorized frame
returned to the host. Count the policy decision and TDMA ring admission after
secure MPDU/PN validation, while keeping every failure on the host path.

--- a/kite-datapath.h
+++ b/kite-datapath.h
@@ -155,4 +155,5 @@
 	unsigned int tx_sent[2], tx_freed[2], tx_drop[2], tx_bad_done;
 	unsigned int rx_ppe[2], rx_host[2], rx_replay[2], rx_stale[2];
 	unsigned int rx_miss[2], rx_free[2], rx_unsupported[2], tx_aborted[2], reserved[1];
+	unsigned int rx_policy_hit[2], rx_policy_miss[2], rx_tdma_full[2];
 	struct kdp_sta sta[KDP_WCIDS];
--- a/npu_kite_secure_rx.c
+++ b/npu_kite_secure_rx.c
@@ -135,11 +135,20 @@
-		} else {
-			r->flags |= KDP_RX_REORDERED | (m->encrypted ? KDP_RX_PN : 0);
-			KDP_BARRIER();
-			if (dp_rx_policy(s, id) &&
-			    !tdma_tx_submit(id, r->len - r->offset,
-					    wifi_pkt_va(id) + r->offset, r->band)) {
-				s->rx_ppe[r->band]++;
-				s->stats[r->band].rx_bytes += r->len - r->offset;
-			} else
-				dp_rx_host(s, id);
+		} else {
+			int policy = dp_rx_policy(s, id);
+
+			r->flags |= KDP_RX_REORDERED | (m->encrypted ? KDP_RX_PN : 0);
+			KDP_BARRIER();
+			if (policy) {
+				s->rx_policy_hit[r->band]++;
+				if (!tdma_tx_submit(id, r->len - r->offset,
+						wifi_pkt_va(id) + r->offset, r->band)) {
+					s->rx_ppe[r->band]++;
+					s->stats[r->band].rx_bytes += r->len - r->offset;
+				} else {
+					s->rx_tdma_full[r->band]++;
+					dp_rx_host(s, id);
+				}
+			} else {
+				s->rx_policy_miss[r->band]++;
+				dp_rx_host(s, id);
+			}
 		}
