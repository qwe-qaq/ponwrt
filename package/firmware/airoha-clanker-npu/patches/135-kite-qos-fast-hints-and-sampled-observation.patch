+
+static u32 dp_observe_tick(void)
+{
+ u32 hi, lo, hi2;
+ do {
+  hi = csr_read(mcycleh);
+  lo = csr_read(mcycle);
+  hi2 = csr_read(mcycleh);
+ } while (hi != hi2);
+ return (hi << 24) | (lo >> 8);
+}
+static void dp_observe_init(void)
+{
