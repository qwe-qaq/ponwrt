+ npu_memset(dp_observe_tokens, 0, sizeof(dp_observe_tokens));
+ npu_memset(dp_observe_active, 0, sizeof(dp_observe_active));
+ npu_memset(dp_observe_serial, 0, sizeof(dp_observe_serial));
+ dp_observe_sample[0] = dp_observe_sample[1] = 0;
+ dp_obs.sample_shift = dp->perf.sample_shift;
+ dp_obs.clock_mhz = cpu_clock_get();
+ dp_observe_mask = dp_obs.sample_shift ? (1u << dp_obs.sample_shift) - 1 : 0;
+ dp_observe_loop = 0;
+ dp_observe_published = csr_read(mcycle);
+ npu_memcpy((void *)&dp->observe, &dp_obs, sizeof(dp_obs));
+}
+static void dp_observe_time(u32 band, u32 stage, u32 start, u32 units)
+{
+ struct kdp_observe_time *t = &dp_obs.band[band].time[stage];
+ u32 elapsed;
+ if (!dp_observe_sample[band]) return;
+ elapsed = (u32)csr_read(mcycle) - start;
+ t->samples++; t->cycles += elapsed; t->units += units;
+ if (elapsed > t->max_cycles) t->max_cycles = elapsed;
+}
+/* Tick statistics are sampled independently of batch profiling. A token
+ * records each stage once. WA time is when hart4 first observes wa_done;
+ * ready delay is measured only for WA-before-DMA, where readiness is known
+ * at the DMA callback. No invented hardware/peer ACK timestamp. */
+static void dp_observe_submit(u32 band, u32 token)
+{
+ struct dp_observe_token *t = &dp_observe_tokens[token];
+ if (dp_observe_active_test(token)) {
+  dp_obs.band[band].sample_cancelled++; t->active = 0;
+ }
+ dp_observe_active[token >> 5] &= ~(1u << (token & 31));
+ if (!dp_observe_mask || (++dp_observe_serial[band] & dp_observe_mask)) return;
+ *t = (struct dp_observe_token){ .start = dp_observe_tick(), .active = 1 };
+ dp_observe_active[token >> 5] |= 1u << (token & 31);
+ dp_obs.band[band].sample_packets++;
+}
+static void dp_observe_age(u32 *count, u32 *sum, u32 *max, u32 age)
+{
+ (*count)++; *sum += age;
+ if (age > *max) *max = age;
+}
+static void dp_observe_dma(u32 token)
+{
+ if (!dp_observe_active_test(token)) return;
+ struct dp_observe_token *t = &dp_observe_tokens[token];
+ struct kdp_observe_band *b = &dp_obs.band[dp->token[token].band];
+ u32 now;
+ if (!t->active || t->dma_seen) return;
+ now = dp_observe_tick(); t->dma_seen = 1;
+ dp_observe_age(&b->dma_samples, &b->dma_ticks, &b->dma_max_ticks, now - t->start);
+ if (dp->token[token].wa_done == dp->token[token].submitted) {
+  if (!t->wa_seen) {
+   t->wa_seen = 1;
+   dp_observe_age(&b->wa_samples, &b->wa_ticks, &b->wa_max_ticks, now - t->start);
+  }
+  t->ready_known = 1; t->ready_at = now;
+ }
+}
+static void dp_observe_reap(u32 token, int reusable)
+{
+ if (!dp_observe_active_test(token)) return;
+ struct dp_observe_token *t = &dp_observe_tokens[token];
+ struct kdp_observe_band *b;
+ u32 now;
+ if (!t->active || dp->token[token].state != KDP_TOKEN_WIFI) return;
+ if (!reusable && (t->wa_seen || dp->token[token].wa_done != dp->token[token].submitted)) return;
+ b = &dp_obs.band[dp->token[token].band]; now = dp_observe_tick();
+ if (!t->wa_seen && dp->token[token].wa_done == dp->token[token].submitted) {
+  t->wa_seen = 1;
+  dp_observe_age(&b->wa_samples, &b->wa_ticks, &b->wa_max_ticks, now - t->start);
+ }
+ if (reusable) {
+  dp_observe_age(&b->free_samples, &b->free_ticks, &b->free_max_ticks, now - t->start);
+  if (t->ready_known)
+   dp_observe_age(&b->ready_samples, &b->ready_ticks, &b->ready_max_ticks, now - t->ready_at);
+  t->active = 0;
+  dp_observe_active[token >> 5] &= ~(1u << (token & 31));
+ }
+}
+void kite_dp_observe_poll(void)
+{
+ u32 now, seq;
+ if (!dp) return;
+ dp_observe_loop++;
+ dp_observe_sample[0] = dp_observe_sample[1] =
+  dp_observe_mask && !(dp_observe_loop & dp_observe_mask);
+ /* Check publication only every 64 worker passes; ~93ms at 720MHz.
+  * Counter values are always local until this bounded snapshot copy. */
+ if (dp_observe_loop & 63u) return;
+ now = csr_read(mcycle);
+ if ((u32)(now - dp_observe_published) < (1u << 26)) return;
+ dp_observe_published = now;
+ dp_obs.publishes++;
+ seq = dp->observe.seq + 1;
+ dp->observe.seq = seq;
+ KDP_BARRIER();
+ npu_memcpy((void *)&dp->observe.sample_shift, &dp_obs.sample_shift,
+            sizeof(dp_obs) - sizeof(dp_obs.seq));
+ KDP_BARRIER();
+ dp->observe.seq = seq + 1;
+}
+u32 kite_dp_observe_mmio(u32 band)
+{
+ /* Sample eligibility is separate from the stamp: cycle zero is valid. */
+ return dp_observe_sample[band] ? (u32)csr_read(mcycle) : 0;
+}
+void kite_dp_observe_batch(u32 band, u32 full, u32 packets, u32 start)
+{
+ struct kdp_observe_band *b = &dp_obs.band[band];
+ u32 elapsed;
+ if (!dp) return;
+ b->polls++; b->ring_full += full;
+ if (packets) { b->busy++; b->batches++; b->packets += packets; }
+ if (packets > b->max_batch) b->max_batch = packets;
+ if (!dp_observe_sample[band] || !packets) return;
+ elapsed = (u32)csr_read(mcycle) - start;
+ b->mmio_samples++; b->mmio_cycles += elapsed;
+ if (elapsed > b->mmio_max_cycles) b->mmio_max_cycles = elapsed;
+}
