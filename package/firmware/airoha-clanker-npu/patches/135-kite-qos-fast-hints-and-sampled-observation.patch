+ * completions never fetch a sample record from DRAM. */
+static struct dp_observe_token dp_observe_tokens[KDP_TOKENS]
+ __attribute__((section(".kite_observe")));
+static u32 dp_observe_active[KDP_TOKENS / 32];
+static int dp_observe_active_test(u32 token)
+{
