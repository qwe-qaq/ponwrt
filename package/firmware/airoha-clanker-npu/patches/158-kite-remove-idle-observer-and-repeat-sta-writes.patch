-int kite_dp_tx_next(u32 band, struct kite_tx_desc *out, u16 *id)
+static __attribute__((noinline)) int dp_parse_legacy(u32 band,
+ const unsigned char *payload, u32 len, const struct dp_sta_tx *sta,
+ struct dp_parse_cache *cache, struct kdp_packet *packet, int *parsed, int *fast)
+{
+ u32 i;
+   /* Short, VLAN, IPv6, nonzero DS and control use the original checks.
+    * Failed compact parsing is not permission to skip destination checks. */
+   for (i = 0; i < 6; i++)
+    if (payload[i] != sta->addr[i]) { dp->quality[band].identity_drop++; return 0; }
+   if (kdp_be16(payload + 12) < 0x600 || kdp_be16(payload + 12) == 0x888e) {
+    dp->quality[band].control_drop++; return 0;
+   }
+   if ((dp_perf_flags & KDP_PERF_FAST) && cache->valid) {
+    dp_packet_copy(packet, &cache->packet);
+    *parsed=cache->parsed; *fast=cache->fast;
+    dp_performance[band].parse_reuse++;
+   } else {
+    if ((dp_perf_flags & KDP_PERF_FAST) &&
+        (len < 48 || ((unsigned long)payload & 3)))
+     *fast = kdp_parse_ipv4_fast(payload, len, packet);
+    *parsed = *fast ? 1 : dp_parse_slow(payload, len, packet);
+    if (*fast) dp_performance[band].parse_fast++;
+    else dp_performance[band].parse_slow++;
+   }
+ return 1;
+}
