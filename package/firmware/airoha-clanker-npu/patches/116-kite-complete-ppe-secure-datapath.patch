@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PONWRT_KITE_PACKET_H
+#define PONWRT_KITE_PACKET_H
+#include "kite-datapath.h"
+
+struct kdp_packet {
+	unsigned int src[4], dst[4], ports, protocol, type, vlan, dsfield;
+	unsigned char smac[6], dmac[6];
+};
+static inline unsigned int kdp_be16(const unsigned char *p)
+{
+	return (unsigned int)p[0] << 8 | p[1];
+}
+static inline unsigned int kdp_be32(const unsigned char *p)
+{
+	return (unsigned int)kdp_be16(p) << 16 | kdp_be16(p + 2);
+}
+/* Parse only complete unicast TCP/UDP packets suitable for a flow rule.
+ * Fragments, IPv6 extension headers and TCP connection control stay on the
+ * host. This parser cannot grant firewall or station authorization.
+ */
+static inline int kdp_parse_packet(const unsigned char *p, unsigned int len,
+	struct kdp_packet *out)
+{
+	unsigned int i, type, off = 14, end, l4;
+	if (len < 14 || (p[0] & 1) || (p[6] & 1))
+		return 0;
+	for (i = 0; i < 6; i++) {
+		out->dmac[i] = p[i];
+		out->smac[i] = p[i + 6];
+	}
+	out->vlan = KDP_SLOT_NONE;
+	type = kdp_be16(p + 12);
+	if (type == 0x8100) {
+		if (len < 18)
+			return 0;
+		out->vlan = kdp_be16(p + 14); /* PCP/DEI are policy too */
+		type = kdp_be16(p + 16);
+		off = 18;
+	}
+	for (i = 0; i < 4; i++)
+		out->src[i] = out->dst[i] = 0;
+	if (type == 0x0800) {
+		if (len - off < 20 || p[off] != 0x45 ||
+		    (kdp_be16(p + off + 6) & 0xbfff))
+			return 0;
+		end = off + kdp_be16(p + off + 2);
+		if (end > len || end < off + 20)
+			return 0;
+		out->src[0] = kdp_be32(p + off + 12);
+		out->dst[0] = kdp_be32(p + off + 16);
+		out->protocol = p[off + 9];
+		out->dsfield = p[off + 1];
+		out->type = KDP_FLOW_IPV4;
+		l4 = off + 20;
+	} else if (type == 0x86dd) {
+		if (len - off < 40 || (p[off] >> 4) != 6)
+			return 0;
+		end = off + 40 + kdp_be16(p + off + 4);
+		if (end > len)
+			return 0;
+		for (i = 0; i < 4; i++) {
+			out->src[i] = kdp_be32(p + off + 8 + i * 4);
+			out->dst[i] = kdp_be32(p + off + 24 + i * 4);
+		}
+		out->protocol = p[off + 6];
+		out->dsfield = ((p[off] & 15u) << 4) | (p[off + 1] >> 4);
+		out->type = KDP_FLOW_IPV6;
+		l4 = off + 40;
+	} else {
+		return 0;
+	}
+	if (out->protocol == 6) {
+		if (end - l4 < 20 || (p[l4 + 13] & 7) ||
+		    (p[l4 + 12] >> 4) < 5 ||
+		    (unsigned int)(p[l4 + 12] >> 4) * 4 > end - l4)
+			return 0;
+	} else if (out->protocol == 17) {
+		if (end - l4 < 8 || kdp_be16(p + l4 + 4) != end - l4)
+			return 0;
+	} else {
+		return 0;
+	}
+	out->ports = kdp_be32(p + l4);
+	return 1;
+}
+
+/* Default cfg80211 RFC8325 classifier, with an outer VLAN PCP taking
+ * precedence. Egress has already passed the kernel flow rule. */
+static inline unsigned int kdp_packet_tid(const struct kdp_packet *p)
+{
+	unsigned int dscp = p->dsfield >> 2;
+	if (p->vlan != KDP_SLOT_NONE && (p->vlan >> 13))
+		return p->vlan >> 13;
+	switch (dscp) {
+	case 10: case 12: case 14: case 16: return 0;
+	case 18: case 20: case 22: return 3;
+	case 24: case 26: case 28: case 30: return 4;
+	case 44: case 46: return 6;
+	case 48: return 7;
+	default: return p->dsfield >> 5;
+	}
+}
+
+static inline unsigned int kdp_flow_bucket(const unsigned char *smac,
+	const unsigned char *dmac, unsigned int vlan, unsigned int wcid)
+{
+	unsigned int i, h = wcid ^ vlan;
+	for (i = 0; i < 6; i++)
+		h = (h * 33u) ^ smac[i] ^ ((unsigned int)dmac[i] << 8);
+	h ^= h >> 16;
+	return (h & (KDP_FLOW_BUCKETS - 1)) * KDP_FLOW_WAYS;
+}
+
+/* Spread concurrent connections from one peer across the policy table.
+ * Bridge authorization retains its independent MAC/VLAN bucket. */
+static inline unsigned int kdp_flow_l4_bucket(unsigned int bucket,
+	const unsigned int *src, const unsigned int *dst, unsigned int ports,
+	unsigned int protocol, unsigned int type)
+{
+	unsigned int i, h = bucket ^ ports ^ (protocol << 24) ^ type;
+	for (i = 0; i < 4; i++) {
+		h = (h * 33u) ^ src[i];
+		h = (h * 33u) ^ dst[i];
+	}
+	h ^= h >> 16;
+	h *= 0x7feb352du;
+	h ^= h >> 15;
+	return (h & (KDP_FLOW_BUCKETS - 1)) * KDP_FLOW_WAYS;
+}
+
+#ifdef KDP_BARRIER
+static inline int kdp_flow_matches(const volatile struct kdp_flow *f,
+	const struct kdp_packet *p, unsigned int session, unsigned int generation,
+	unsigned int key_generation, unsigned int wcid, unsigned int band,
+	unsigned int bss)
+{
+	unsigned int i, version = f->version;
+	if (!version)
+		return 0;
+	KDP_BARRIER();
+	if (f->session != session || f->generation != generation ||
+	    f->key_generation != key_generation || f->wcid != wcid ||
+	    f->band != band || f->bss != bss || f->vlan != p->vlan ||
+	    ((p->dsfield ^ f->dsfield) & f->dsmask))
+		return 0;
+	for (i = 0; i < 6; i++)
+		if (f->smac[i] != p->smac[i] || f->dmac[i] != p->dmac[i])
+			return 0;
+	if (f->type != KDP_FLOW_BRIDGE) {
+		if (f->type != p->type || f->ports != p->ports ||
+		    f->protocol != p->protocol)
+			return 0;
+		for (i = 0; i < 4; i++)
+			if (f->src[i] != p->src[i] || f->dst[i] != p->dst[i])
+				return 0;
+	}
+	KDP_BARRIER();
+	return f->version == version;
+}
+#endif
+#endif
