+		}
+		KDP_BARRIER();
+		REG32(TDMA_RX_BASE_PTR(b) + 8) = DP_TDMA_COUNT - 1;
+		REG32(TDMA_RX_BASE_PTR(b) + 12) = 0;
+	}
+	/* As AN7581 tdma_rx_init: data buffers use ARM physical addresses,
+	 * descriptors use the SRAM bus address. Gate remains closed at bind. */
+	REG32(TDMA_RX_CFG) |= 0x80000000u;
+	KDP_BARRIER();
+	REG32(TDMA_GLB_CFG) |= 4;
+	return 1;
+}
+
+static void dp_rearm(u32 band, u32 token)
+{
+	u32 idx = dp_idx[band];
+	u32 desc = dp_ring + band * DP_TDMA_BYTES + idx * 32;
+	REG32(desc + 8) = dp_payload_pa(token);
+	KDP_BARRIER();
+	REG32(desc + 4) = KDP_BUFFER_BYTES;
+	KDP_BARRIER();
+	REG32(TDMA_RX_BASE_PTR(band) + 8) = idx;
+	dp_idx[band] = (idx + 1) % DP_TDMA_COUNT;
+}
+
+void kite_dp_tx_reap(void)
+{
+	u32 i;
+	if (!dp_identity())
+		return;
+	KDP_BARRIER();
+	for (i = 0; i < 32; i++) {
+		volatile struct kdp_token *t = &dp->token[dp_reap];
+		dp_reap = (dp_reap + 1) % KDP_TOKENS;
+		if (!kdp_token_reusable(t))
+			continue;
+		dp->tx_freed[t->band]++;
+		KDP_BARRIER();
+		t->state = KDP_TOKEN_FREE;
+	}
+}
+
+int kite_dp_tx_next(u32 band, struct kite_tx_desc *out, u16 *id)
+{
+	volatile struct kdp_sta *sta;
+	volatile struct kdp_token *t;
+	u32 desc, len, addr, token, info, wcid, bss, b, i, tag;
+	int replacement;
+	struct kdp_packet packet;
+	if (band > 1 || !dp_identity())
+		return 0;
+	if (dp_prepared[band] != 0xffff) {
+		dp->fault = 2; /* caller must commit each successfully prepared frame */
+		return 0;
+	}
+	desc = dp_ring + band * DP_TDMA_BYTES + dp_idx[band] * 32;
+	len = REG32(desc + 4);
+	if (!(len & 0x80000000u))
+		return 0;
+	KDP_BARRIER();
+	len &= 0xffff;
+	addr = REG32(desc + 8);
+	if (addr < dp_payload_pa(0) ||
+	    addr - dp_payload_pa(0) >= KDP_TOKENS * KDP_BUFFER_BYTES ||
+	    ((addr - dp_payload_pa(0)) % KDP_BUFFER_BYTES)) {
+		dp->fault = 3;
+		return 0;
+	}
+	token = (addr - dp_payload_pa(0)) / KDP_BUFFER_BYTES;
+	t = &dp->token[token];
+	if (t->state != KDP_TOKEN_TDMA) {
+		dp->fault = 4;
+		return 0;
+	}
+	info = REG32(desc + 16);
+	tag = ((info >> 14) & 0x7ff) |
+	      (((REG32(desc + 24) >> 24) & 0x7f) << 11);
+	b = (info >> 25) & 1;
+	if (!tag || tag > KDP_ROUTE_MAX ||
+	    dp->route[tag & (KDP_ROUTES - 1)].tag != tag) {
+		dp->stats[band].tx_stale++;
+		goto drop;
+	}
+	KDP_BARRIER();
+	wcid = dp->route[tag & (KDP_ROUTES - 1)].wcid;
+	if (!wcid || wcid >= KDP_WCIDS || b != band ||
+	    len < 14 || len > KDP_BUFFER_BYTES || !dp->enabled || dp->gate)
+		goto drop;
+	sta = &dp->sta[wcid];
+	bss = sta->bss;
+	if (sta->tx_tag != tag || bss > 63 || sta->tx_blocked || !sta->enabled || !sta->authorized || sta->band != b ||
+	    sta->bss != bss || !sta->generation ||
+	    (sta->cipher && (sta->cipher != KDP_CIPHER_CCMP ||
+			    !sta->key_generation)))
+		goto drop;
+	for (i = 0; i < 6; i++)
+		if (dp->payload[token][i] != sta->addr[i])
+			goto drop;
+	/* A bound bridge rule may also deliver ARP or TCP control packets.
+	 * Ethernet II frames use the same normal TXD; only the QoS classifier
+	 * needs an IP header. Local EAPOL remains exclusively host generated. */
+	if (kdp_be16((const void *)(dp->payload[token] + 12)) < 0x600 ||
+	    kdp_be16((const void *)(dp->payload[token] + 12)) == 0x888e)
+		goto drop;
+	npu_memset(&packet, 0, sizeof(packet));
+	packet.vlan = KDP_SLOT_NONE;
+	kdp_parse_packet((const void *)dp->payload[token], len, &packet);
+	if (t->submitted == 0xffffffffu) {
+		t->state = KDP_TOKEN_QUARANTINE;
+		dp->fault = 5;
+		return 0;
+	}
+	replacement = dp_alloc_token();
+	if (replacement < 0) {
+		dp->stats[band].tx_full++;
+		return 0;
+	} /* keep TDMA ownership until a spare buffer exists */
+	/* No checksum offload requested: PPE supplied the final wire packet.
+	 * Short parse-prefix padding belongs to this exclusive token buffer. */
+	for (i = len; i < 72; i++)
+		dp->payload[token][i] = 0;
+	if (!kdp_make_txwi((void *)dp->txwi[token], addr, len, token, wcid,
+			 band, bss, sta->omac, sta->wmm,
+			 sta->wme ? kdp_packet_tid(&packet) : 0, !!sta->cipher,
+			 sta->wme, sta->amsdu)) {
+		dp->token[replacement].state = KDP_TOKEN_FREE;
+		goto drop;
+	}
+	t->generation = sta->generation;
+	t->key_generation = sta->key_generation;
+	t->wcid = wcid;
+	t->band = band;
+	t->submitted++;
+	t->dma_done = t->wa_done = 0;
+	KDP_BARRIER();
+	t->state = KDP_TOKEN_WIFI;
+	dp_prepared[band] = token;
+	dp_replacement[band] = replacement;
+	out->buf0 = dp_txwi_pa(token);
+	out->buf1 = addr;
+	out->ctrl = (76u << 16) | 0x4000u | 72u;
+	out->info = 0;
+	*id = token;
+	return 1;
+drop:
+	dp->tx_drop[band]++;
+	dp_rearm(band, token);
+	return 0;
+}
+
+void kite_dp_tx_commit(u32 band, u16 token)
+{
+	if (!dp_identity() || band > 1 || dp_prepared[band] != token ||
+	    dp_replacement[band] >= KDP_TOKENS) {
+		if (dp)
+			dp->fault = 6;
+		return;
+	}
+	dp->tx_sent[band]++;
+	dp->stats[band].tx_bytes += kdp_get_le32((const void *)dp->txwi[token]) & 0xffff;
+	dp->stats[band].tx_bytes -= 32; /* exclude hardware TXD */
+	dp_rearm(band, dp_replacement[band]);
+	dp_prepared[band] = dp_replacement[band] = 0xffff;
+}
+
+void kite_dp_tx_dma_done(u16 token)
+{
+	if (!dp_identity() || token >= KDP_TOKENS ||
+	    dp->token[token].state != KDP_TOKEN_WIFI ||
+	    dp->token[token].dma_done) {
+		if (dp)
+			dp->fault = 7;
+		return;
+	}
+	dp->token[token].dma_done = dp->token[token].submitted;
+	KDP_BARRIER();
+}
+
+
+/* PARKED: detach the submitting worker before ARM disables WFDMA. Keep
+ * every outstanding buffer owned until the subsequent physical DMA stop. */
+int kite_dp_tx_halt(void)
+{
+	if (!dp) return 1;
+	if (!dp_identity() || !dp->gate || dp->enabled) return 0;
+	dp->stopped = 1;
+	KDP_BARRIER();
+	return 1;
+}
+
+/* Called with all workers parked, PPE rules revoked and WFDMA TX drained.
+ * Disabling an engine is not completion: a busy timeout retains the mapping.
+ */
+int kite_dp_unbind(void)
+{
+	u32 i, abort;
+	if (!dp)
+		return 1;
+	if (!dp_identity() || !dp->gate)
+		return 0;
+	abort = dp->stopped == 1;
+	if (abort && (!kite_tx_dma_stopped() || !kite_dp_rx_empty()))
+		return 0;
+	for (i = 0; i < KDP_TOKENS / 32; i++)
+		kite_dp_tx_reap();
+	for (i = 0; i < KDP_TOKENS; i++)
+		if (!abort && (dp->token[i].state == KDP_TOKEN_WIFI ||
+		    dp->token[i].state == KDP_TOKEN_QUARANTINE))
+			return 0;
+	REG32(TDMA_GLB_CFG) &= ~4u;
+	KDP_BARRIER();
+	for (i = 0; i < 100000; i++)
+		if (!(REG32(TDMA_GLB_CFG) & 8u))
+			break;
+	if (i == 100000) {
+		dp->fault = 8;
+		return 0;
+	}
+	if (abort)
+		for (i = 0; i < KDP_TOKENS; i++) {
+			if (dp->token[i].state == KDP_TOKEN_WIFI && dp->token[i].band < 2)
+				dp->tx_aborted[dp->token[i].band]++;
+			dp->token[i].state = KDP_TOKEN_FREE;
+		}
+	dp->stopped = 2;
+	KDP_BARRIER();
+	dp = 0;
+	return 1;
+}
+#endif
