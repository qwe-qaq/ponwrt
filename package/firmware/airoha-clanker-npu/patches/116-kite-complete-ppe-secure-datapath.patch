+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PONWRT_KITE_DATAPATH_H
+#define PONWRT_KITE_DATAPATH_H
+
+/* Host/NPU wire ABI. Little-endian 32-bit words, no pointers or atomics
+ * requiring the RISC-V A extension. Mapping must be uncached on both ends.
+ * KDP_BARRIER must be a full interconnect barrier (not a compiler barrier).
+ * Host PN callers serialize locally; a WCID has exactly one NPU RX owner.
+ */
+#include "kite-reorder.h"
+
+#define KDP_MAGIC 0x4b440001u
+#define KDP_WCIDS 544u
+#define KDP_ROUTES 2048u
+#define KDP_ROUTE_MAX 0x1ffffu
+#define KDP_TIDS 17u
+#define KDP_FLOWS 512u
+#define KDP_FLOW_WAYS 8u
+#define KDP_FLOW_BUCKETS (KDP_FLOWS / KDP_FLOW_WAYS)
+#define KDP_RX_COUNT 256u
+#define KDP_TOKENS 1024u
+#define KDP_TOKEN_BASE 0x7000u
+#define KDP_BUFFER_BYTES 2048u
+#define KDP_TXWI_BYTES 128u
+#define KDP_PN_SPINS 4096u
+#define KDP_CIPHER_CCMP 0x000fac04u
+
+struct kdp_pn {
+	unsigned int want[2], turn;
+	unsigned int generation, key_generation;
+	unsigned int low, high;
+};
+
+/* One PN counter for both accelerated frames and host fallback. An expired
+ * lock attempt fails closed; it does not clear the other participant's flag.
+ * Never reset this object until both participants have stopped using it.
+ */
+#ifdef KDP_BARRIER
+static inline int kdp_pn_lock(volatile struct kdp_pn *p, unsigned int who)
+{
+	unsigned int peer = who ^ 1u, n;
+	p->want[who] = 1;
+	KDP_BARRIER();
+	p->turn = peer;
+	KDP_BARRIER();
+	for (n = 0; n < KDP_PN_SPINS; n++) {
+		if (!p->want[peer] || p->turn != peer) {
+			KDP_BARRIER();
+			return 1;
+		}
+		KDP_BARRIER();
+	}
+	p->want[who] = 0;
+	KDP_BARRIER();
+	return 0;
+}
+
+static inline void kdp_pn_unlock(volatile struct kdp_pn *p, unsigned int who)
+{
+	KDP_BARRIER();
+	p->want[who] = 0;
+	KDP_BARRIER();
+}
+
+/* 1 accepted, 0 replay, -1 unavailable/stale. A-MSDU subframes must be
+ * assembled/validated as ONE MPDU before this function, never allow equal
+ * PN just because a descriptor says it is another subframe.
+ */
+static inline int kdp_pn_accept(volatile struct kdp_pn *p, unsigned int who,
+	unsigned int generation, unsigned int key_generation,
+	unsigned int low, unsigned int high)
+{
+	int result = -1;
+	if (who > 1 || high > 0xffff || !generation || !key_generation ||
+	    !kdp_pn_lock(p, who))
+		return -1;
+	if (p->generation != generation || p->key_generation != key_generation)
+		goto out;
+	result = high > p->high || (high == p->high && low > p->low);
+	if (result) {
+		p->low = low;
+		p->high = high;
+	}
+out:
+	kdp_pn_unlock(p, who);
+	return result;
+}
+#endif
+
+/* Exact ingress policy installed from an accepted Linux flow rule. Version
+ * is zero while being replaced. Firmware samples version twice, including
+ * after matching: replacement/revocation can only cause a slow-path miss.
+ * Never derive a physical PPE slot from this software table's index/hash.
+ */
+struct kdp_flow {
+	unsigned int version, session, generation, key_generation;
+	unsigned int wcid, band, bss, type;
+	unsigned int src[4], dst[4], ports, protocol;
+	unsigned char smac[6], dmac[6];
+	unsigned int vlan, hw_slot, cookie_lo, cookie_hi, dsfield, dsmask;
+};
+#define KDP_FLOW_IPV4 1u
+#define KDP_FLOW_IPV6 2u
+#define KDP_FLOW_BRIDGE 3u
+#define KDP_SLOT_NONE 0xffffffffu
+
+struct kdp_sta {
+	unsigned int generation, key_generation, enabled, band;
+	unsigned int bss, cipher, keyid, authorized;
+	unsigned int omac, wmm, wme, amsdu;
+	unsigned int host_tids, reserved_sta;
+	unsigned int tx_tag;
+	unsigned char addr[6];
+	unsigned char tx_blocked, reserved;
+	struct kdp_pn pn[KDP_TIDS];
+};
+
+/* PPE etype WCID bits and ACTDP low 6 bits transport an opaque 17-bit
+ * route incarnation, never a physical WTBL index. Tags never wrap within
+ * the PPE driver's lifetime; old queued packets cannot acquire a new key.
+ * The NPU recovers the real WCID/BSS from this host-published route. */
+struct kdp_route { unsigned int tag, wcid; };
+struct kdp_tdma_desc { unsigned int word[8]; };
+struct kdp_token {
+	unsigned int state, submitted, dma_done, wa_done;
+	unsigned int generation, key_generation, wcid, band;
+};
+#define KDP_TOKEN_FREE 0u
+#define KDP_TOKEN_TDMA 1u
+#define KDP_TOKEN_WIFI 2u
+#define KDP_TOKEN_QUARANTINE 3u
+
+#define KDP_RX_TOKENS 5600u
+#define KDP_RX_MAGIC 0x4b520000u
+#define KDP_RX_REORDERED 1u
+#define KDP_RX_PN 2u
+#define KDP_RX_PPE_RETURN 4u
+struct kdp_rx_token {
+	unsigned int generation, key_generation, flags;
+	unsigned short next, wcid, len, offset;
+	unsigned char tid, bss, band, reserved;
+};
+
+struct kdp_band_stats {
+	unsigned int tx_bytes, rx_bytes, tx_stale, tx_full;
+	unsigned int reserved[12];
+};
+struct kdp_shared {
+	unsigned int magic, bytes, session, epoch;
+	unsigned int enabled, fault, gate, stopped;
+	unsigned int tx_sent[2], tx_freed[2], tx_drop[2], tx_bad_done;
+	unsigned int rx_ppe[2], rx_host[2], rx_replay[2], rx_stale[2];
+	unsigned int rx_miss[2], rx_free[2], rx_unsupported[2], tx_aborted[2], reserved[1];
+	struct kdp_sta sta[KDP_WCIDS];
+	struct kdp_route route[KDP_ROUTES];
+	struct kdp_flow flow[KDP_FLOWS];
+	struct kdp_token token[KDP_TOKENS];
+	unsigned short ba_index[KDP_WCIDS][8]; /* session index + 1 */
+	struct kdp_ba ba[KDP_BA_SESSIONS];
+	struct kdp_rx_token rx[KDP_RX_TOKENS];
+	struct kdp_tdma_desc tdma[2][KDP_RX_COUNT];
+	unsigned char txwi[KDP_TOKENS][KDP_TXWI_BYTES];
+	unsigned char payload[KDP_TOKENS][KDP_BUFFER_BYTES];
+	struct kdp_band_stats stats[2];
+};
+
+static inline unsigned int kdp_get_le32(const unsigned char *p)
+{
+	return (unsigned int)p[0] | (unsigned int)p[1] << 8 |
+	       (unsigned int)p[2] << 16 | (unsigned int)p[3] << 24;
+}
+static inline void kdp_put_le16(unsigned char *p, unsigned int v)
+{
+	p[0] = v;
+	p[1] = v >> 8;
+}
+static inline void kdp_put_le32(unsigned char *p, unsigned int v)
+{
+	kdp_put_le16(p, v);
+	kdp_put_le16(p + 2, v >> 16);
+}
+
+/* MT7916 connac2 normal cut-through TXD + firmware TXP, NOT Eagle's
+ * zero-TXD WED format. WTBL owns TX PN and sequence for both TX producers:
+ * PN_VALID/SN_VALID remain clear. Layout mirrors mt76_connac2_mac_write_txwi
+ * and mt7915_tx_prepare_skb for a unicast, Ethernet-encapsulated data frame.
+ */
+static inline int kdp_make_txwi(unsigned char *p, unsigned int pa,
+	unsigned int len, unsigned int token, unsigned int wcid,
+	unsigned int band, unsigned int bss, unsigned int omac,
+	unsigned int wmm, unsigned int tid, unsigned int encrypted,
+	unsigned int wme, unsigned int amsdu)
+{
+	static const unsigned char tid_queue[8] = { 1, 0, 0, 1, 2, 2, 3, 3 };
+	unsigned int i, q;
+	if (len < 14 || len > KDP_BUFFER_BYTES || token >= KDP_TOKENS ||
+	    !wcid || wcid >= KDP_WCIDS || band > 1 || bss > 63 || omac > 63 ||
+	    wmm > 3 || tid > 7 || pa < 0x80000000u || pa >= 0xc0000000u ||
+	    KDP_BUFFER_BYTES > 0xc0000000u - pa)
+		return 0;
+	for (i = 0; i < KDP_TXWI_BYTES; i++)
+		p[i] = 0;
+	q = wmm * 4 + tid_queue[tid];
+	kdp_put_le32(p, (len + 32) | (q << 25));
+	kdp_put_le32(p + 4, 0x80008000u | (band << 30) | (omac << 24) |
+			(tid << 20) | wcid);
+	kdp_put_le32(p + 8, 0x20u | (wme ? 8u : 0u));
+	kdp_put_le32(p + 12, (15u << 11) | (encrypted ? 2u : 0u));
+	/* PID 0: payload completion is WA TX-free, not an skb TX-status request. */
+	kdp_put_le32(p + 28, (2u << 20) | (wme ? 8u << 16 : 0u) |
+			 (amsdu ? 1u << 10 : 0u));
+	kdp_put_le16(p + 32, 0x81u | (encrypted ? 0u : 8u));
+	kdp_put_le16(p + 34, KDP_TOKEN_BASE + token);
+	p[36] = bss;
+	kdp_put_le16(p + 37, 0x3ff);
+	p[39] = 1;
+	kdp_put_le32(p + 40, pa);
+	kdp_put_le16(p + 64, len);
+	return 1;
+}
+
+/* Both independent completions are required, even if WA arrives first.
+ * Wrap is not allowed: rebind after a full hardware drain before 2^32 uses.
+ */
+static inline int kdp_token_reusable(const volatile struct kdp_token *t)
+{
+	return t->state == KDP_TOKEN_WIFI && t->submitted &&
+	       t->dma_done == t->submitted && t->wa_done == t->submitted;
+}
+#endif
