+#include "npu_internal.h"
+#include "npu_wifi.h"
+#define KDP_BARRIER() __asm__ volatile("fence iorw,iorw" ::: "memory")
+#include "kite-datapath-fw.h"
+#include "kite-secure-rxd.h"
+#include "kite-packet.h"
+
+#if defined(AN7581) && defined(MT7916)
+struct dp_rx_context { volatile struct kdp_shared *s; u32 band; };
+
+static void dp_rx_drop(void *opaque, u16 token)
+{
+	struct dp_rx_context *ctx = opaque;
+	if (token < KDP_RX_TOKENS)
+		buf_id_free(0, ctx->band, token);
+}
+static void dp_rx_link(void *opaque, u16 token, u16 next)
+{
+	struct dp_rx_context *ctx = opaque;
+	ctx->s->rx[token].next = next;
+}
+static void dp_rx_host(volatile struct kdp_shared *s, u16 id)
+{
+	volatile struct kdp_rx_token *r = &s->rx[id];
+	s->rx_host[r->band]++;
+	if (pkt_forward(id, r->len, r->wcid, 0, r->band, 2, r->len, 0, 0))
+		buf_id_free(0, r->band, id);
+}
+static int dp_rx_policy(volatile struct kdp_shared *s, u16 id)
+{
+	volatile struct kdp_rx_token *r = &s->rx[id];
+	volatile struct kdp_sta *sta = &s->sta[r->wcid];
+	struct kdp_packet key;
+	u32 i, bucket, bridge, pass;
+	if (!r->offset || s->gate || !s->enabled || !sta->enabled ||
+	    !sta->authorized || (sta->cipher && !(r->flags & KDP_RX_PN)) ||
+	    sta->generation != r->generation ||
+	    sta->key_generation != r->key_generation ||
+	    !kdp_parse_packet((void *)(wifi_pkt_va(id) + r->offset),
+			     r->len - r->offset, &key))
+		return 0;
+	for (i = 0; i < 6; i++)
+		if (key.smac[i] != sta->addr[i])
+			return 0;
+	bridge = kdp_flow_bucket(key.smac, key.dmac, key.vlan, r->wcid);
+	bucket = kdp_flow_l4_bucket(bridge, key.src, key.dst, key.ports,
+				  key.protocol, key.type);
+	for (pass = 0; pass < 2; pass++) {
+		for (i = bucket; i < bucket + KDP_FLOW_WAYS; i++)
+			if (kdp_flow_matches(&s->flow[i], &key, s->session,
+					r->generation, r->key_generation, r->wcid,
+					r->band, r->bss))
+				return 1;
+		if (bucket == bridge)
+			break;
+		bucket = bridge;
+	}
+	return 0;
+}
+
+static void dp_rx_release(void *opaque, const struct kdp_mpdu *m)
+{
+	struct dp_rx_context *ctx = opaque;
+	volatile struct kdp_shared *s = ctx->s;
+	volatile struct kdp_rx_token *first = &s->rx[m->head];
+	volatile struct kdp_sta *sta = &s->sta[first->wcid];
+	u32 accepted = m->complete, n = 0;
+	u16 id = m->head;
+	if (first->generation != sta->generation ||
+	    first->key_generation != sta->key_generation || !sta->authorized) {
+		s->rx_stale[ctx->band]++;
+		accepted = 0;
+	}
+	if (accepted && m->encrypted) {
+		int ret = kdp_pn_accept(&sta->pn[first->tid], 1,
+			first->generation, first->key_generation, m->pn_low, m->pn_high);
+		if (ret != 1) {
+			if (!ret) s->rx_replay[ctx->band]++;
+			else s->rx_stale[ctx->band]++;
+			accepted = 0;
+		}
+	}
+	while (id != KDP_BA_NONE && n++ < m->count) {
+		volatile struct kdp_rx_token *r = &s->rx[id];
+		u16 next = r->next;
+		if (!accepted) {
+			dp_rx_drop(ctx, id);
+		} else {
+			r->flags |= KDP_RX_REORDERED | (m->encrypted ? KDP_RX_PN : 0);
+			KDP_BARRIER();
+			if (dp_rx_policy(s, id) &&
+			    !tdma_tx_submit(id, r->len - r->offset,
+					    wifi_pkt_va(id) + r->offset, r->band)) {
+				s->rx_ppe[r->band]++;
+				s->stats[r->band].rx_bytes += r->len - r->offset;
+			} else
+				dp_rx_host(s, id);
+		}
+		id = next;
+	}
+}
+static const struct kdp_reorder_ops dp_rx_ops = {
+	dp_rx_drop, dp_rx_link, dp_rx_release
+};
+
+static struct kdp_ba *dp_ba_find(volatile struct kdp_shared *s, u32 wcid, u32 tid)
+{
+	u32 index = s->ba_index[wcid][tid];
+	if (!index || index > KDP_BA_SESSIONS)
+		return 0;
+	if (s->ba[index - 1].wcid != wcid || s->ba[index - 1].tid != tid) {
+		s->fault = 12;
+		return 0;
+	}
+	return (void *)&s->ba[index - 1];
+}
+
+/* PARKED transaction only. Existing nodes are discarded before replacement;
+ * neither ADD/DELBA nor a port transition resets the key's replay counter. */
+void kite_dp_ba_set(u32 wcid, u32 tid, u32 ssn, u32 window)
+{
+	volatile struct kdp_shared *s = kite_dp_shared();
+	struct kdp_ba *ba;
+	struct dp_rx_context ctx;
+	u32 i;
+	if (!s || !wcid || wcid >= KDP_WCIDS || tid >= 8 || window > 256)
+		return;
+	ctx.s = s;
+	ctx.band = s->sta[wcid].band;
+	ba = dp_ba_find(s, wcid, tid);
+	if (!ba && window)
+		for (i = 0; i < KDP_BA_SESSIONS; i++)
+			if (!s->ba[i].wcid) {
+				ba = (void *)&s->ba[i];
+				break;
+			}
+	if (!ba) {
+		if (window) {
+			s->rx_unsupported[ctx.band]++;
+			s->sta[wcid].host_tids |= 1u << tid;
+		}
+		return;
+	}
+	kdp_ba_reset(ba, ssn, window, &dp_rx_ops, &ctx);
+	s->ba_index[wcid][tid] = window ? ba - (struct kdp_ba *)s->ba + 1 : 0;
+	ba->wcid = window ? wcid : 0;
+	ba->tid = tid;
+	ba->generation = s->sta[wcid].generation;
+	ba->key_generation = s->sta[wcid].key_generation;
+	s->sta[wcid].host_tids &= ~(1u << tid);
+}
+
+void kite_dp_sta_invalidate(u32 wcid)
+{
+	volatile struct kdp_shared *s = kite_dp_shared();
+	u32 tid;
+	if (!s || !wcid || wcid >= KDP_WCIDS)
+		return;
+	s->sta[wcid].enabled = 0;
+	KDP_BARRIER();
+	for (tid = 0; tid < 8; tid++)
+		kite_dp_ba_set(wcid, tid, 0, 0);
+}
+
+int kite_dp_rx(u32 token, u32 len, u32 band)
+{
+	volatile struct kdp_shared *s = kite_dp_shared();
+	volatile struct kdp_rx_token *r;
+	volatile struct kdp_sta *sta;
+	struct dp_rx_context ctx;
+	struct kdp_rxd rx;
+	struct kdp_ba *ba;
+	const u8 *p;
+	u32 wcid, tid;
+	if (!s || token >= KDP_RX_TOKENS || band > 1)
+		return 0;
+	r = &s->rx[token];
+	r->flags = KDP_RX_MAGIC;
+	r->generation = r->key_generation = 0;
+	r->len = len;
+	r->band = band;
+	r->offset = 0;
+	p = (void *)wifi_pkt_va(token);
+	if (len < 24 || (kdp_get_le32(p) >> 27) != 2)
+		return 0;
+	wcid = kdp_get_le32(p + 4) & 0x3ff;
+	tid = (kdp_get_le32(p + 8) >> 16) & 15;
+	if (!wcid || wcid >= KDP_WCIDS)
+		return 0;
+	sta = &s->sta[wcid];
+	r->generation = sta->generation;
+	r->key_generation = sta->key_generation;
+	r->wcid = wcid;
+	r->bss = kdp_get_le32(p + 8) & 63;
+	r->tid = tid;
+	if (!s->enabled || !sta->enabled || !sta->authorized ||
+	    sta->band != band || r->bss != sta->bss || tid > 7 ||
+	    (sta->host_tids & (1u << tid)))
+		return 0;
+	/* Non-QoS control/management traffic does not belong to the TID's BA
+	 * sequence space and must not permanently latch its data path to Linux. */
+	if ((kdp_get_le32(p + 4) & (1u << 14)) && len >= 40 &&
+	    (kdp_get_le32(p + 24) & 0xfcu) != 0x88u)
+		return 0;
+	ctx.s = s;
+	ctx.band = band;
+	ba = dp_ba_find(s, wcid, tid);
+	if (!kdp_parse_rxd(p, len, band, &rx) ||
+	    (rx.encrypted ? (sta->cipher != KDP_CIPHER_CCMP ||
+			    sta->keyid != rx.keyid || !sta->key_generation) : 0) ||
+	    (rx.format && !rx.offset)) {
+		/* A mixed unsupported stream cannot use two reorder authorities.
+		 * Flush queued complete MPDUs, then latch this TID to Linux until
+		 * a new BA transaction. Shared PN state still rejects replays. */
+		sta->host_tids |= 1u << tid;
+		if (ba)
+			for (u32 i = 0; i < ba->window; i++)
+				kdp_ba_release(ba, &dp_rx_ops, &ctx);
+		s->rx_unsupported[band]++;
+		return 0;
+	}
+	r->offset = rx.offset;
+	if (!ba || !ba->window) {
+		/* No BA means Linux also owns A-MSDU assembly. */
+		if (rx.format)
+			return 0;
+		struct kdp_mpdu single = {
+			.head=token, .tail=token, .count=1, .sn=rx.sequence,
+			.complete=1, .encrypted=rx.encrypted,
+			.pn_low=rx.low, .pn_high=rx.high,
+		};
+		r->next = KDP_BA_NONE;
+		dp_rx_release(&ctx, &single);
+		return 1;
+	}
+	kdp_ba_enqueue(ba, token, rx.sequence, rx.format, rx.encrypted,
+		       rx.low, rx.high, KITE_TICK, &dp_rx_ops, &ctx);
+	return 1;
+}
+
+void kite_dp_rx_timeout(u32 band)
+{
+	volatile struct kdp_shared *s = kite_dp_shared();
+	struct dp_rx_context ctx = { s, band };
+	u32 i;
+	if (!s)
+		return;
+	for (i = 0; i < KDP_BA_SESSIONS; i++) {
+		struct kdp_ba *b = (void *)&s->ba[i];
+		if (b->wcid && s->sta[b->wcid].band == band)
+			kdp_ba_timeout(b, KITE_TICK, wifi_flushone_timeout, &dp_rx_ops, &ctx);
+	}
+}
+
+u32 kite_dp_rx_metadata(u32 token, u32 *generation, u32 *key_generation)
+{
+	volatile struct kdp_shared *s = kite_dp_shared();
+	if (!s || token >= KDP_RX_TOKENS)
+		return 0;
+	*generation = s->rx[token].generation;
+	*key_generation = s->rx[token].key_generation;
+	return s->rx[token].flags;
+}
+void kite_dp_rx_return(u32 token)
+{
+	volatile struct kdp_shared *s = kite_dp_shared();
+	if (!s || token >= KDP_RX_TOKENS)
+		return;
+	s->rx[token].flags |= KDP_RX_PPE_RETURN;
+	s->rx_miss[s->rx[token].band]++;
+}
+
+/* Caller has both RX-worker acknowledgements; hart3 owns only detached
+ * host chains. Keep the negotiated BA window/head, discard every old MPDU. */
+void kite_dp_rx_discard_all(void)
+{
+	volatile struct kdp_shared *s = kite_dp_shared();
+	u32 i;
+	if (!s) return;
+	for (i = 0; i < KDP_BA_SESSIONS; i++) {
+		struct kdp_ba *ba = (void *)&s->ba[i];
+		struct dp_rx_context ctx = { s, ba->wcid ? s->sta[ba->wcid].band : 0 };
+		if (ba->wcid)
+			kdp_ba_reset(ba, ba->head, ba->window, &dp_rx_ops, &ctx);
+	}
+}
+int kite_dp_rx_empty(void)
+{
+	volatile struct kdp_shared *s = kite_dp_shared();
+	u32 i, j;
+	if (!s) return 1;
+	for (i = 0; i < KDP_BA_SESSIONS; i++)
+		for (j = 0; j < KDP_BA_SLOTS; j++)
+			if (s->ba[i].slot[j].count) return 0;
+	return 1;
+}
+#endif
