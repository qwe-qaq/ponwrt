Subject: [PATCH] add bridge L4 policy lookup and Linux host fallback

--- a/kite-datapath.h
+++ b/kite-datapath.h
@@ -106,8 +106,22 @@
 #define KDP_FLOW_IPV4 1u
 #define KDP_FLOW_IPV6 2u
 #define KDP_FLOW_BRIDGE 3u
+/* Bridge capture keeps the PPE MAC admission broad; the NPU applies the
+ * complete L3/L4 tuple before choosing the MT7916 fast path. */
+#define KDP_FLOW_BRIDGE_IPV4 4u
+#define KDP_FLOW_BRIDGE_IPV6 5u
 #define KDP_SLOT_NONE 0xffffffffu
 
+/* Host-adaptor record for a PPE bridge-policy miss. The Ethernet frame is
+ * copied into Linux and re-entered through the selected AP netdev. */
+#define KDP_HOST_FWD_WIFI_TX 1u
+#define KDP_HOST_FALLBACK_MAGIC 0xd74b0000u
+#define KDP_HOST_FALLBACK_PACK(band, wcid) \
+	(KDP_HOST_FALLBACK_MAGIC | (((band) & 1u) << 10) | ((wcid) & 0x3ffu))
+#define KDP_HOST_FALLBACK_VALID(v) (((v) & 0xffff0000u) == KDP_HOST_FALLBACK_MAGIC)
+#define KDP_HOST_FALLBACK_BAND(v) (((v) >> 10) & 1u)
+#define KDP_HOST_FALLBACK_WCID(v) ((v) & 0x3ffu)
+
 struct kdp_sta {
 	unsigned int generation, key_generation, enabled, band;
 	unsigned int bss, cipher, keyid, authorized;
@@ -151,6 +165,11 @@
 	unsigned int rx_policy_hit, rx_policy_miss, rx_tdma_full;
 	unsigned int reserved[9];
 };
+#define KDP_STAT_BRIDGE_HIT       0u
+#define KDP_STAT_BRIDGE_MISS      1u
+#define KDP_STAT_HOST_FALLBACK    2u
+#define KDP_STAT_HOST_FALLBACK_DROP 3u
+#define KDP_STAT_BRIDGE_STALE     4u
 struct kdp_shared {
 	unsigned int magic, bytes, session, epoch;
 	unsigned int enabled, fault, gate, stopped;
