@@ -123,6 +123,67 @@
 	return 1;
 }
 
+static void dp_rearm(u32 band, u32 token);
+
+static int dp_bridge_policy(volatile struct kdp_shared *s,
+	volatile struct kdp_sta *sta, const struct kdp_packet *packet,
+	int parsed, u32 wcid, u32 band)
+{
+	u32 base, i;
+	int present = 0;
+
+	/* First establish that this route has an explicitly installed bridge
+	 * L4 capture policy. Routed WAN->Wi-Fi entries do not have one and must
+	 * continue through the existing direct datapath. */
+	base = kdp_flow_bucket(packet->smac, packet->dmac, packet->vlan, wcid);
+	for (i = base; i < base + KDP_FLOW_WAYS; i++) {
+		volatile struct kdp_flow *f = &s->flow[i];
+		u32 version = f->version;
+		u32 j;
+		if (!version || (f->type != KDP_FLOW_BRIDGE_IPV4 &&
+				f->type != KDP_FLOW_BRIDGE_IPV6) ||
+			f->session != s->session || f->generation != sta->generation ||
+			f->key_generation != sta->key_generation || f->wcid != wcid ||
+			f->band != band || f->bss != sta->bss || f->vlan != packet->vlan)
+			continue;
+		for (j = 0; j < 6; j++)
+			if (f->smac[j] != packet->smac[j] || f->dmac[j] != packet->dmac[j])
+				break;
+		if (j == 6)
+			present = 1;
+	}
+	if (!present)
+		return -1;
+	if (!parsed)
+		return 0;
+	base = kdp_flow_l4_bucket(base, packet->src, packet->dst,
+			packet->ports, packet->protocol, packet->type);
+	for (i = base; i < base + KDP_FLOW_WAYS; i++)
+		if (kdp_flow_matches(&s->flow[i], packet, s->session,
+			sta->generation, sta->key_generation, wcid, band, sta->bss) &&
+			(s->flow[i].type == KDP_FLOW_BRIDGE_IPV4 ||
+			 s->flow[i].type == KDP_FLOW_BRIDGE_IPV6)) {
+			s->stats[band].reserved[KDP_STAT_BRIDGE_HIT]++;
+			return 1;
+		}
+	s->stats[band].reserved[KDP_STAT_BRIDGE_MISS]++;
+	return 0;
+}
+
+static int dp_host_bridge_fallback(u32 band, u32 token, u32 addr, u32 len, u32 wcid)
+{
+	int ret = host_ring_submit(addr, len, band, wcid, 0,
+		KDP_HOST_FWD_WIFI_TX, len, 1, KDP_HOST_FALLBACK_PACK(band, wcid));
+	if (ret == KITE_HOST_HOLD)
+		return ret;
+	if (!ret)
+		dp->stats[band].reserved[KDP_STAT_HOST_FALLBACK]++;
+	else
+		dp->stats[band].reserved[KDP_STAT_HOST_FALLBACK_DROP]++;
+	dp_rearm(band, token);
+	return ret;
+}
+
 static void dp_rearm(u32 band, u32 token)
 {
 	u32 idx = dp_idx[band];
@@ -216,7 +277,16 @@
 		goto drop;
 	npu_memset(&packet, 0, sizeof(packet));
 	packet.vlan = KDP_SLOT_NONE;
-	kdp_parse_packet((const void *)dp->payload[token], len, &packet);
+	{
+		int parsed = kdp_parse_packet((const void *)dp->payload[token], len, &packet);
+		int policy = dp_bridge_policy(dp, sta, &packet, parsed, wcid, band);
+		if (policy == 0) {
+			int fallback = dp_host_bridge_fallback(band, token, addr, len, wcid);
+			if (fallback == KITE_HOST_HOLD)
+				return 0;
+			return 0;
+		}
+	}
 	if (t->submitted == 0xffffffffu) {
