From: ponwrt maintainers
Subject: [PATCH] r71: Classify abnormal host returns without changing RX ownership or delivery.

Native patch on the r70 prepared baseline. Datapath ABI12 unchanged.

--- a/npu_internal.h
+++ b/npu_internal.h
@@ -768,6 +768,7 @@
 #endif
 #define NDBG_SIZE	0x1000
 extern u32 sram_alloc_offset;
+void kite_host_failure_snapshot(u32 *out);
 /* tags and text read in order in a word dump, first char in the MSB */
 #define NDBG_TAG(a, b, c, d)	((u32)(a) << 24 | (b) << 16 | (c) << 8 | (d))
 #define NDBG_MAGIC	NDBG_TAG('N', 'D', 'B', 'G')
@@ -807,6 +808,21 @@
 	NC_KITE_META_REORDER0, NC_KITE_META_REORDER1,
 	NC_KITE_META_UNKNOWN0, NC_KITE_META_UNKNOWN1,
 	NC_KITE_META_FALLBACK0, NC_KITE_META_FALLBACK1,
+	/* r71: core3 only, abnormal host returns; no successful-packet work.
+	 * First six pairs are causes; last six are caller dispositions.
+	 * HOLD retains ownership. A rejection is NOT always a wire-packet loss. */
+	NC_HOST_NOT_READY0 = 72, NC_HOST_NOT_READY1,
+	NC_HOST_INVALID0, NC_HOST_INVALID1,
+	NC_HOST_RING0, NC_HOST_RING1,
+	NC_HOST_GUARD0, NC_HOST_GUARD1,
+	NC_HOST_DESC0, NC_HOST_DESC1,
+	NC_HOST_COPY_HOLD0, NC_HOST_COPY_HOLD1,
+	NC_HOST_RX_REJECT0, NC_HOST_RX_REJECT1,
+	NC_HOST_RX_HOLD0, NC_HOST_RX_HOLD1,
+	NC_HOST_TX_REJECT0, NC_HOST_TX_REJECT1,
+	NC_HOST_TX_HOLD0, NC_HOST_TX_HOLD1,
+	NC_HOST_CHAIN_REJECT0, NC_HOST_CHAIN_REJECT1,
+	NC_HOST_CHAIN_HOLD0, NC_HOST_CHAIN_HOLD1,
 	NC_MAX = 96,
 };
 
