+/* Core3 is the sole writer. Core0 exports a bounded seqlock snapshot.
+ * 88 bytes of SRAM; no payload, pointer or key material is exported. */
+static volatile u32 host_failure[2][11];
+static int host_reject(u32 band, u32 counter, int ret)
+{
+	if (band < 2) {
+		NDBG_CNT(counter + band);
+		/* Temporary cause is consumed by the same hart's wrapper. */
+		host_failure[band][10] = counter;
+	}
+	return ret;
+}
+static void host_result(u32 band, u32 wcid, u32 len, u32 origin, int ret)
+{
+	volatile u32 *v;
+	u32 ring, idx, counter;
+	if (!ret || band > 1)
+		return;
+	counter = origin == 2 ? NC_HOST_CHAIN_REJECT0 :
+		(origin == 1 ? NC_HOST_TX_REJECT0 : NC_HOST_RX_REJECT0);
+	if (ret == KITE_HOST_HOLD)
+		counter += 2;
+	NDBG_CNT(counter + band);
+	v = host_failure[band];
+	v[0]++; /* odd while updating */
+	__asm__ volatile("fence iorw,iorw" ::: "memory");
+	v[1] = timer_raw_tick;
+	v[2] = v[10];
+	v[3] = wcid;
+	v[4] = origin | (ret == KITE_HOST_HOLD ? 0x100u : 0);
+	v[5] = len;
+	idx = REG32(HOSTADPT_RX_DMA_IDX(band));
+	v[6] = idx; v[7] = v[8] = 0;
+	v[9] = hostadpt_tx_ring_ready;
+	ring = band ? hostadpt_rx_ring_base : hostadpt_tx_ring_base;
+	if (hostadpt_tx_ring_ready && ring && idx < HOSTADPT_RING_SIZE) {
+		v[7] = *(volatile u32 *)(ring + idx * 24);
+		v[8] = *(volatile u32 *)(ring + ((idx + 2) % HOSTADPT_RING_SIZE) * 24);
+	}
+	__asm__ volatile("fence iorw,iorw" ::: "memory");
+	v[0]++;
+}
+void kite_host_failure_snapshot(u32 *out)
+{
+	for (u32 b = 0; b < 2; b++) {
+		u32 seq = host_failure[b][0];
+		u32 *d = out + b * 11;
+		__asm__ volatile("fence iorw,iorw" ::: "memory");
+		for (u32 i = 0; i < 10; i++)
+			d[i] = host_failure[b][i];
+		__asm__ volatile("fence iorw,iorw" ::: "memory");
+		d[10] = seq && !(seq & 1) && seq == host_failure[b][0];
+	}
+}
