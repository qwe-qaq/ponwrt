+/* Cold, owned TDMA head only. Timeout discards/rearms this head, never a
+ * WiFi-owned token. PARK ACK does not require processing this queue. */
+static __attribute__((noinline)) int dp_gate_hold(u32 band)
+{
+ u32 now=dp_observe_tick();
+ if (!dp_private.gate_active[band]) {
+  dp_private.gate_active[band]=1; dp_private.gate_since[band]=now;
+ }
+ /* Existing calibrated 64ms bin; a stuck healthy gate cannot pin a head. */
+ if ((u32)(now-dp_private.gate_since[band]) >= dp_age_limit[5]) {
+  dp_r63.band[band].gate_timeout++; return 0;
+ }
+ dp_r63.band[band].gate_hold++; return 1;
+}
