+static __attribute__((noinline)) u32 dp_soft_miss(const struct kdp_packet *p,u32 wi,u32 request)
+{
+ u32 base=kdp_flow_bucket(p->smac,p->dmac,p->vlan,wi),why=7;
+ u32 bucket=kdp_flow_l4_bucket(base,p->src,p->dst,p->ports,p->protocol,p->type);
+ for (u32 i=bucket;i<bucket+KDP_FLOW_WAYS;i++) {
+  volatile struct kdp_flow *f=&dp->r60.soft[i];
+  if (!f->version || f->wcid!=wi) continue;
+  if (dp->r60.soft_request[i]!=request) why=2;
+  else if (f->session!=dp->session || f->generation!=dp->sta[wi].generation ||
+           f->key_generation!=dp->sta[wi].key_generation) why=3;
+  else why=6;
+ }
+ if (why==7) for (u32 i=base;i<base+KDP_FLOW_WAYS;i++) {
+  volatile struct kdp_flow *f=&dp->flow[i];
+  if (!f->version || f->wcid!=wi) continue;
+  if (f->type==KDP_FLOW_BRIDGE_GUARD) { why=4; break; }
+  if (f->type==KDP_FLOW_BRIDGE_CAPTURE) why=5;
+ }
+ return why;
+}
