Subject: [PATCH] allow zero key generation for open bridge fallback

--- a/npu_kite_datapath.c
+++ b/npu_kite_datapath.c
@@ -40,7 +40,10 @@
 		return 0;
 	token = (buf_addr - base) / KDP_BUFFER_BYTES;
 	t = &dp->token[token];
-	if (t->state != KDP_TOKEN_TDMA || !t->generation || !t->key_generation)
+	/* generation is always non-zero. key_generation is zero for an
+	 * authorized open network and is therefore a valid fence value; the host
+	 * side additionally checks that a zero key generation still has no cipher. */
+	if (t->state != KDP_TOKEN_TDMA || !t->generation)
 		return 0;
 	*session = dp->session;
 	*generation = t->generation;
