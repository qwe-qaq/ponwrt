Subject: [PATCH] fence bridge capture lookup against record replacement

--- a/npu_kite_datapath.c
+++ b/npu_kite_datapath.c
@@ -162,21 +162,15 @@
 	base = kdp_flow_bucket(packet->smac, packet->dmac, packet->vlan, wcid);
 	for (i = base; i < base + KDP_FLOW_WAYS; i++) {
 		volatile struct kdp_flow *f = &s->flow[i];
-		u32 version = f->version;
-		u32 j;
-		if (!version || f->type != KDP_FLOW_BRIDGE_CAPTURE ||
-			f->session != s->session || f->generation != sta->generation ||
-			f->key_generation != sta->key_generation || f->wcid != wcid ||
-			f->band != band || f->bss != sta->bss ||
-			((f->vlan == KDP_SLOT_NONE) != (packet->vlan == KDP_SLOT_NONE)) ||
-			(f->vlan != KDP_SLOT_NONE &&
-			 (f->vlan & 0x0fffu) != (packet->vlan & 0x0fffu)))
-			continue;
-		for (j = 0; j < 6; j++)
-			if (f->smac[j] != packet->smac[j] || f->dmac[j] != packet->dmac[j])
-				break;
-		if (j == 6)
+		/* kdp_flow_matches samples version before and after the complete
+		 * record. Capture records are deliberately broad, so the helper
+		 * checks only MAC/VLAN/domain identity for this type. */
+		if (f->type == KDP_FLOW_BRIDGE_CAPTURE &&
+		    kdp_flow_matches(f, packet, s->session,
+			sta->generation, sta->key_generation, wcid, band, sta->bss)) {
 			present = 1;
+			break;
+		}
 	}
 	if (!present)
 		return -1;
