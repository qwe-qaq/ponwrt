+/* Last candidate in the exact bucket is evidence, never authorization.
+ * Preserve the full packet and a version-checked candidate; no payload/key.
+ * Word address/ports are canonical network numeric order; MAC words are
+ * packed byte0 in bits7:0 for a stable little-endian diagnostics contract. */
+static __attribute__((noinline)) void dp_path_miss(const struct kdp_packet *p,
+ u32 wi, u32 request)
+{
+ volatile u32 *v = dp_path_event;
+ struct kdp_flow f;
+ u32 base = kdp_flow_bucket(p->smac,p->dmac,p->vlan,wi);
+ u32 bucket = kdp_flow_l4_bucket(base,p->src,p->dst,p->ports,p->protocol,p->type);
+ u32 slot = KDP_SLOT_NONE, ver = 0, req = 0, stable = 0, diff = 0;
+ npu_memset(&f, 0, sizeof(f));
+ for (u32 i = bucket; i < bucket + KDP_FLOW_WAYS; i++) {
+  if (!dp->r60.soft[i].version || dp->r60.soft[i].wcid != wi) continue;
+  slot = i;
+  if (dp->r60.soft_request[i] == request) break;
+ }
+ if (slot != KDP_SLOT_NONE) {
+  volatile struct kdp_flow *q = &dp->r60.soft[slot];
+  ver = q->version; KDP_BARRIER();
+  npu_memcpy(&f, (const void *)q, sizeof(f)); req = dp->r60.soft_request[slot]; KDP_BARRIER();
+  stable = ver && ver == q->version && ver == f.version &&
+           req == dp->r60.soft_request[slot];
+  if (f.session != dp_session || f.generation != dp->sta[wi].generation ||
+      f.key_generation != dp->sta[wi].key_generation || f.wcid != wi ||
+      f.band != dp->sta[wi].band || f.bss != dp->sta[wi].bss) diff |= 1u;
+  if (req != request) diff |= 2u;
+  if ((f.vlan == KDP_SLOT_NONE) != (p->vlan == KDP_SLOT_NONE) ||
+      (f.vlan != KDP_SLOT_NONE && ((f.vlan ^ p->vlan) & 0xfff))) diff |= 4u;
+  if ((f.dsfield ^ p->dsfield) & f.dsmask) diff |= 8u;
+  for (u32 i = 0; i < 6; i++) {
+   if (f.smac[i] != p->smac[i]) diff |= 16u;
+   if (f.dmac[i] != p->dmac[i]) diff |= 32u;
+  }
+  u32 type = f.type == KDP_FLOW_BRIDGE_IPV4 ? KDP_FLOW_IPV4 :
+             f.type == KDP_FLOW_BRIDGE_IPV6 ? KDP_FLOW_IPV6 : f.type;
+  if (type != p->type) diff |= 64u;
+  if (f.protocol != p->protocol) diff |= 128u;
+  if (f.ports != p->ports) diff |= 256u;
+  for (u32 i = 0; i < 4; i++) {
+   if (f.src[i] != p->src[i]) diff |= 512u;
+   if (f.dst[i] != p->dst[i]) diff |= 1024u;
+  }
+  if (!stable) diff |= 2048u;
+ }
+ dp_path_seq++; KDP_BARRIER();
+ v[0]=timer_raw_tick; v[1]=dp_session; v[2]=dp_epoch;
+ v[3]=dp->sta[wi].band; v[4]=wi; v[5]=request;
+ v[6]=dp->sta[wi].generation; v[7]=dp->sta[wi].key_generation;
+ v[8]=dp->sta[wi].tx_tag; v[9]=p->type; v[10]=p->protocol;
+ v[11]=p->ports; v[12]=p->vlan; v[13]=p->dsfield;
+ for (u32 i=0;i<4;i++) { v[14+i]=p->src[i]; v[18+i]=p->dst[i]; }
+ for (u32 i=0;i<3;i++) {
+  u32 a=0,b=0;
+  for (u32 j=0;j<4;j++) {
+   u32 k=i*4+j;
+   a|=(u32)(k<6?p->smac[k]:p->dmac[k-6])<<(j*8);
+   b|=(u32)(k<6?f.smac[k]:f.dmac[k-6])<<(j*8);
+  }
+  v[22+i]=a; v[47+i]=b;
+ }
+ v[25]=slot; v[26]=ver; v[27]=stable; v[28]=diff;
+ v[29]=f.session; v[30]=f.generation; v[31]=f.key_generation;
+ v[32]=req; v[33]=f.type; v[34]=f.protocol; v[35]=f.ports;
+ v[36]=f.vlan; v[37]=f.dsfield; v[38]=f.dsmask;
+ for (u32 i=0;i<4;i++) { v[39+i]=f.src[i]; v[43+i]=f.dst[i]; }
+ v[50]=f.hw_slot; v[51]=f.cookie_lo; v[52]=f.cookie_hi;
+ v[53]=f.band; v[54]=f.bss;
+ KDP_BARRIER(); dp_path_seq++;
+}
