From: ponwrt maintainers
Subject: [PATCH] r72: Retain pre-DMA busy heads with bounded retry and full policy-miss evidence.

Native incremental patch on release71; no datapath ABI or DMA layout change.

--- a/kite-host.h
+++ b/kite-host.h
@@ -12,6 +12,12 @@
 /* Firmware source ownership is retained on HOLD, including a partial
  * chain. Neither DONE nor the producer index may be published. */
 #define KITE_HOST_HOLD (-2)
+/* Zero DMA side effects: caller retains its queue head and retries fairly. */
+#define KITE_HOST_BUSY (-4)
+#define KITE_HOST_RETRY_TICKS 200u /* nominal 20 ms, timer tick 100 us */
+void kite_host_retry_cancel(u32 band, u32 origin);
+void kite_host_retry_snapshot(u32 *out);
+void kite_dp_path_snapshot(u32 *out);
 #define KITE_HOST_DIAG_MAGIC 0x4b480001u
 #define KITE_HOST_RING_COUNT 512u
 #define KITE_HOST_RING_BYTES (KITE_HOST_RING_COUNT * 24u)
