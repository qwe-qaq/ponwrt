+/* Hart3 owns retry state. Core0 resets only with workers parked at BIND.
+ * Three independent queue heads per band: RX, TX fallback, segmented RX.
+ * HOLD is never subject to this deadline: its DMA ownership is unknown. */
+struct host_retry_state { u32 source, since, active; };
+static struct host_retry_state host_retry[2][3];
+static volatile u32 host_retry_stats[11]; /* attempts[6], expired[2], recovered[2], max ticks */
+void kite_host_retry_cancel(u32 band, u32 origin)
+{
+	if (band < 2 && origin < 3)
+		host_retry[band][origin].active = 0;
+}
+void kite_host_retry_snapshot(u32 *out)
+{
+	for (u32 i = 0; i < 11; i++) out[i] = host_retry_stats[i];
+}
+static int host_retry_result(u32 band, u32 origin, u32 source, int ret)
+{
+	struct host_retry_state *r;
+	u32 age = 0, now = timer_raw_tick;
+	if (band > 1 || origin > 2) return ret;
+	r = &host_retry[band][origin];
+	if (r->active && r->source != source) r->active = 0;
+	if (r->active) {
+		age = now - r->since;
+		if (age > host_retry_stats[10]) host_retry_stats[10] = age;
+	}
+	if (ret == KITE_HOST_BUSY) {
+		host_retry_stats[origin * 2 + band]++;
+		if (!r->active) {
+			r->source = source; r->since = now; r->active = 1;
+		} else if (age >= KITE_HOST_RETRY_TICKS) {
+			host_retry_stats[6 + band]++;
+			r->active = 0;
+			return -1; /* no DMA started; caller may now release once */
+		}
+	} else {
+		if (!ret && r->active) host_retry_stats[8 + band]++;
+		r->active = 0;
+	}
+	return ret;
+}
+
 
