+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PONWRT_KITE_RXD_H
+#define PONWRT_KITE_RXD_H
+
+/* MT7916 connac2 RXD, in little endian wire order. Keep this parser usable
+ * by host-side packet-vector tests without MMIO or the firmware runtime. */
+struct kite_rxd {
+	u16 wcid;
+	u16 sequence;
+	u16 ethernet_offset;
+	u8 tid;
+	u8 bss;
+	u8 amsdu;
+};
+
+static inline u32 kite_get_le32(const u8 *p)
+{
+	return (u32)p[0] | (u32)p[1] << 8 | (u32)p[2] << 16 | (u32)p[3] << 24;
+}
+
+/* 0: eligible for the legacy BA classifier; -1: preserve the RXD and
+ * deliver to mt76. This is deliberately not a replay-protection engine. */
+static inline int kite_parse_mt7916(const u8 *p, u32 len, u32 band,
+				  struct kite_rxd *out)
+{
+	u32 w0, w1, w2, w3, fc, qos, offset = 24;
+
+	if (len < 40 || band > 1)
+		return -1;
+	w0 = kite_get_le32(p);
+	w1 = kite_get_le32(p + 4);
+	w2 = kite_get_le32(p + 8);
+	w3 = kite_get_le32(p + 12);
+	/* Normal data, translated Ethernet, group 4, unicast to this radio. */
+	if (((w0 >> 27) & 31) != 2 || (w0 & 0xffff) != len ||
+	    !(w1 & (1u << 14)) || !(w2 & (1u << 13)) ||
+	    ((w1 >> 28) & 1) != band || ((w3 >> 16) & 3) != 1)
+		return -1;
+	/* Protected frames require host key/PN state. Never bypass mt76's
+	 * post-reorder replay check merely because hardware decrypted a frame. */
+	if (w1 & ((31u << 16) | (31u << 23)))
+		return -1;
+	if (w2 & ((1u << 21) | (0xffu << 23)))
+		return -1;
+	fc = kite_get_le32(p + offset) & 0xffff;
+	qos = kite_get_le32(p + offset + 8);
+	if ((fc & 0xfc) != 0x88 || (fc & ((1u << 10) | (1u << 14))) ||
+	    (qos & 15)) /* sequence control fragment number */
+		return -1;
+	offset += 16; /* group 4 */
+	if (w1 & (1u << 11))
+		offset += 16; /* group 1, NOT 8 bytes */
+	if (w1 & (1u << 12))
+		offset += 8;
+	if (w1 & (1u << 13))
+		offset += 8;
+	if (w1 & (1u << 15)) {
+		if (!(w1 & (1u << 13)))
+			return -1;
+		offset += 72;
+	}
+	offset += 2 * ((w2 >> 14) & 3);
+	if (offset + 14 > len)
+		return -1;
+	out->wcid = w1 & 0x3ff; /* retain all ten bits before policy checks */
+	out->tid = (qos >> 16) & 15;
+	out->bss = w2 & 0x3f;
+	out->sequence = (qos >> 4) & 0xfff;
+	out->amsdu = kite_get_le32(p + 16) & 3;
+	out->ethernet_offset = offset;
+	if (out->wcid >= 544 || out->tid > 7 || out->bss > 15 ||
+	    out->tid != ((w2 >> 16) & 15))
+		return -1;
+	return 0;
+}
+
+/* The existing firmware BA tables have 150 entries each. A 10-bit WTBL
+ * index must never be truncated into somebody else's 8-bit BA session. */
+static inline int kite_legacy_wcid_valid(u32 wcid, u32 dbdc)
+{
+	return wcid > 0 && wcid <= (dbdc ? 255u : 150u);
+}
