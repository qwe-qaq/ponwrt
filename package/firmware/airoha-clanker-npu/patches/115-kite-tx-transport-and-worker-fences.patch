+/* SPDX-License-Identifier: GPL-2.0-only */
+/* MT7916 descriptor transport. This never builds TXWI, changes PN/cipher,
+ * or completes a WA token. All payload/security authority stays in mt76/WA.
+ * Hart 4 is the sole live ring producer, core 0 binds only while it is parked.
+ */
+#include "npu_internal.h"
+#include "npu_wifi.h"
+#include "kite-control.h"
+#include "kite-tx.h"
+#if defined(AN7581) && defined(MT7916)
+#define tx_fence() __asm__ volatile("fence iorw,iorw" ::: "memory")
+struct kite_tx_ring {
+	volatile struct kite_tx_shared *volatile s;
+	volatile struct kite_tx_desc *ring;
+	u32 reg, session, epoch, producer, completed;
+};
+static struct kite_tx_ring tx[2];
+_Static_assert(sizeof(struct kite_tx_shared) == KITE_TX_BYTES, "TX ABI size");
+
+int kite_tx_bound(void)
+{
+	return tx[0].s || tx[1].s;
+}
+static int tx_overlap(u32 a, u32 alen, u32 b, u32 blen)
+{
+	return a < b + blen && b < a + alen;
+}
+int kite_tx_bind(u32 session, u32 epoch, const u32 *a)
+{
+	u32 b = a[0], pa = a[1], ring = a[2], reg = a[3], i, ba;
+	volatile struct kite_tx_shared *s;
+	/* Both TX queues belong to the main HIF. Restrict MMIO to its WFDMA
+  * page already installed for band0 RX, and the two MT7916 TX rings.
+  * MT7916 tx ring IDs 18/19 => WFDMA page + 0x420/0x430.
+  */
+	if (b > 1 || tx[b].s || !session || !epoch || a[4] != KITE_TX_COUNT ||
+	    !pcie_base_2g ||
+	    reg != (pcie_base_2g & ~0xfffu) + 0x420u + b * 16u ||
+	    !kite_tx_range(pa, KITE_TX_BYTES) || (pa & 63) ||
+	    !kite_tx_range(ring, KITE_TX_COUNT * 16) || (ring & 63) ||
+	    tx_overlap(pa, KITE_TX_BYTES, ring, KITE_TX_COUNT * 16))
+		return 0;
+	ba = (wifi_dram_ba_node_addr & 0x3fffffffu) | 0x80000000u;
+	if (tx_overlap(pa, KITE_TX_BYTES, ba, 0x200000) ||
+	    tx_overlap(ring, KITE_TX_COUNT * 16, ba, 0x200000))
+		return 0;
+	for (i = 0; i < 2; i++) {
+		u32 other;
+		if (!tx[i].s)
+			continue;
+		other = ((u32)tx[i].s & 0x3fffffffu) | 0x80000000u;
+		if (tx_overlap(pa, KITE_TX_BYTES, other, KITE_TX_BYTES) ||
+		    tx_overlap(ring, KITE_TX_COUNT * 16, other, KITE_TX_BYTES))
+			return 0;
+		other = ((u32)tx[i].ring & 0x3fffffffu) | 0x80000000u;
+		if (tx_overlap(pa, KITE_TX_BYTES, other, KITE_TX_COUNT * 16) ||
+		    tx_overlap(ring, KITE_TX_COUNT * 16, other,
+			       KITE_TX_COUNT * 16))
+			return 0;
+	}
+	/* TX_DMA_EN and TX_DMA_BUSY must be clear. Readback validates host DMA publication. */
+	if ((REG32((reg & ~0xfffu) + 0x208) & 3) || REG32(reg) != ring ||
+	    REG32(reg + 4) != KITE_TX_COUNT || REG32(reg + 8) ||
+	    REG32(reg + 12))
+		return 0;
+	s = (void *)kite_ctl_pool_alias(pa);
+	tx_fence();
+	if (s->magic != KITE_TX_MAGIC || s->session != session ||
+	    s->epoch != epoch || s->count != KITE_TX_COUNT || s->producer ||
+	    s->published || s->completed || s->fault)
+		return 0;
+	tx[b].ring = (void *)kite_ctl_pool_alias(ring);
+	tx[b].reg = reg;
+	tx[b].session = session;
+	tx[b].epoch = epoch;
+	tx[b].producer = tx[b].completed = 0;
+	tx_fence();
+	tx[b].s = s;
+	tx_fence();
+	return 1;
+}
+void kite_tx_unbind(void)
+{
+	u32 b;
+	/* Core0 invokes only after hart4 ACK. Preserve final counters for host. */
+	for (b = 0; b < 2; b++) {
+		if (!tx[b].s)
+			continue;
+		tx[b].s->cancelled +=
+			kite_tx_distance(tx[b].s->producer, tx[b].producer);
+		tx_fence();
+		tx[b].s = 0;
+	}
+	tx_fence();
+}
+static int kite_tx_desc_valid(const struct kite_tx_desc *d)
+{
+	u32 n0 = (d->ctrl >> 16) & 0x3fff, n1 = d->ctrl & 0x3fff;
+	/* Canonical cut-through descriptor: TXWI/TXP and header parse prefix.
+  * No high address bits, DONE, multi-descriptor chains or arbitrary flags.
+  */
+	return !d->info && (d->ctrl & 0xc000c000u) == 0x4000u &&
+	       kite_tx_range(d->buf0, n0) && kite_tx_range(d->buf1, n1);
+}
+static void kite_tx_step(u32 b)
+{
+	struct kite_tx_ring *t = &tx[b];
+	volatile struct kite_tx_shared *s = t->s;
+	u32 p, d, n, used, budget = KITE_TX_BUDGET;
+	if (!s || s->fault)
+		return;
+	s->polls++;
+	tx_fence();
+	if (s->magic != KITE_TX_MAGIC || s->session != t->session ||
+	    s->epoch != t->epoch || s->count != KITE_TX_COUNT) {
+		s->fault = KITE_TX_FAULT_IDENTITY;
+		return;
+	}
+	p = s->producer;
+	d = REG32(t->reg + 12);
+	if (p >= KITE_TX_COUNT || d >= KITE_TX_COUNT) {
+		s->fault = KITE_TX_FAULT_INDEX;
+		return;
+	}
+	used = kite_tx_distance(t->producer, t->completed);
+	n = kite_tx_distance(d, t->completed);
+	if (n > used) {
+		s->fault = KITE_TX_FAULT_INDEX;
+		return;
+	}
+	s->reaped += n;
+	t->completed = d;
+	s->completed = d;
+	/* Host ring capacity uses HW dma_idx, so producer must never lap it. */
+	if (kite_tx_distance(p, d) < kite_tx_distance(t->producer, d)) {
+		s->fault = KITE_TX_FAULT_INDEX;
+		return;
+	}
+	tx_fence();
+	while (t->producer != p && budget--) {
+		struct kite_tx_desc v;
+		u32 idx = t->producer;
+		v.buf0 = s->input[idx].buf0;
+		v.ctrl = s->input[idx].ctrl;
+		v.buf1 = s->input[idx].buf1;
+		v.info = s->input[idx].info;
+		if (!kite_tx_desc_valid(&v)) {
+			s->invalid++;
+			s->fault = KITE_TX_FAULT_DESC;
+			break;
+		}
+		t->ring[idx].buf0 = v.buf0;
+		t->ring[idx].buf1 = v.buf1;
+		t->ring[idx].info = v.info;
+		t->ring[idx].ctrl = v.ctrl;
+		t->producer = (idx + 1) & KITE_TX_MASK;
+		s->submitted++;
+		if (!t->producer)
+			s->wraps++;
+	}
+	/* Publish valid prefix even if a later descriptor was malformed. A
+  * fault never returns an uncompleted token or switches to a host writer.
+  */
+	tx_fence();
+	if (s->published != t->producer) {
+		REG32(t->reg + 8) = t->producer;
+		tx_fence();
+		if (REG32(t->reg + 8) != t->producer)
+			s->fault = KITE_TX_FAULT_MMIO;
+		s->published = t->producer;
+	}
+	tx_fence();
+}
+void kite_tx_loop(void)
+{
+	npu_dbg_loop(NDBG_TAG('K', 'T', 'X', '4'));
+	for (;;) {
+		npu_dbg_poll();
+		if (kite_ctl_pausepoint(4))
+			continue;
+		kite_tx_step(0);
+		kite_tx_step(1);
+	}
+}
+#endif
