+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PONWRT_KITE_TX_H
+#define PONWRT_KITE_TX_H
+/* ABI 1: little endian words. One input slot maps to the same WFDMA slot.
+ * ARM writes producer and input descriptors; hart 4 writes all other progress
+ * fields and the hardware descriptors. Neither index releases payload tokens.
+ * The host retains mappings until WA TX-free, or the full DMA stop barrier.
+ */
+#define KITE_TX_MAGIC 0x4b540001u
+#define KITE_TX_COUNT 2048u
+#define KITE_TX_MASK (KITE_TX_COUNT - 1)
+#define KITE_TX_HEADER 128u
+#define KITE_TX_BYTES (KITE_TX_HEADER + KITE_TX_COUNT * 16u)
+#define KITE_TX_BUDGET 32u
+#define KITE_TX_FAULT_IDENTITY 1u
+#define KITE_TX_FAULT_INDEX 2u
+#define KITE_TX_FAULT_DESC 3u
+#define KITE_TX_FAULT_MMIO 4u
+struct kite_tx_desc {
+	unsigned int buf0, ctrl, buf1, info;
+};
+struct kite_tx_shared {
+	unsigned int magic, session, epoch, count;
+	unsigned int producer, published, completed, fault;
+	unsigned int submitted, reaped, polls, wraps;
+	unsigned int invalid, cancelled, reserved[18];
+	struct kite_tx_desc input[KITE_TX_COUNT];
+};
+static inline int kite_tx_range(unsigned long long pa, unsigned int len)
+{
+	return pa >= 0x80000000ull && pa < 0xc0000000ull && len &&
+	       len <= 0xc0000000ull - pa;
+}
+static inline unsigned int kite_tx_distance(unsigned int a, unsigned int b)
+{
+	return (a - b) & KITE_TX_MASK;
+}
+#ifndef __KERNEL__
+#if defined(AN7581) && defined(MT7916)
+int kite_tx_bind(unsigned int session, unsigned int epoch,
+		 const unsigned int *args);
+void kite_tx_unbind(void); /* only after every worker ACKs PARK/STOP */
+int kite_tx_bound(void);
+void kite_tx_loop(void);
+#endif
+#endif
+#endif
