+/* Build a bounded, non-authoritative security record for every data frame
+ * handed to Linux.  A zero/invalid record always means host fallback; it can
+ * never grant PN or firewall authority. */
+static u32 kite_host_rx_meta(u32 buf_id, u32 len, u32 band, u16 *wcid,
+				     u8 *amsdu, int classify_result)
+{
+	struct kite_rxd rx;
+	const u8 *p = (const u8 *)wifi_pkt_va(buf_id);
+	u32 w1 = len >= 8 ? kite_get_le32(p + 4) : 0;
+	u32 w2 = len >= 12 ? kite_get_le32(p + 8) : 0;
+	u32 generation = 0, key_generation = 0;
+	u32 reason = KITE_HOST_META_MALFORMED;
+
+	if (len >= 12 && (w1 & ((31u << 16) | (31u << 23))) )
+		reason = KITE_HOST_META_ENCRYPTED;
+	else if (len >= 12 && (w2 & ((1u << 21) | (0xffu << 23))))
+		reason = KITE_HOST_META_ENCRYPTED;
+	else if (!kite_parse_mt7916(p, len, band, &rx)) {
+		*wcid = rx.wcid;
+		*amsdu = rx.amsdu;
+		if (rx.amsdu)
+			reason = KITE_HOST_META_AMSDU;
+		else if (kite_ctl_rx_meta(band, rx.wcid, rx.bss,
+					  &generation, &key_generation))
+			reason = key_generation ? KITE_HOST_META_ENCRYPTED :
+							 KITE_HOST_META_RAW;
+		else
+			reason = KITE_HOST_META_UNAUTHORIZED;
+	}
+	return KITE_HOST_META_PACK(generation,
+				   classify_result == KITE_HOST_CLASSIFY_REORDERED ?
+				   KITE_HOST_META_REORDERED : 0, reason);
+}
