--- a/kite-credit.inc
+++ b/kite-credit.inc
@@ -0,0 +1,131 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Hart4-only persistent accounting. Unlike the parse cache, this survives
+ * PARK. Only a new, validated BIND requests initialization on hart4. Nothing
+ * here authorizes a packet or substitutes for shared DMA + WA proof. */
+#define DP_CREDIT_RESERVE 64u
+struct dp_credit_band {
+ u32 pending, peak, demand, holds, empty;
+ u32 wait_kind, wait_at, empty_cycles, credit_cycles;
+ u32 released, dma_wait, wa_wait, ready_wait;
+ u32 owner_wcid, owner_pending, sta_peak, empty_hi, credit_hi;
+};
+static struct {
+ struct dp_credit_band band[2];
+ u16 owner[KDP_TOKENS], sta[2][KDP_WCIDS];
+ u32 extra_reaps, pressure_tick;
+} dp_credit __attribute__((section(".kite_observe"), aligned(64)));
+static volatile u32 dp_credit_seq;
+static u32 dp_credit_publication[64]
+ __attribute__((section(".kite_observe"), aligned(64)));
+static void dp_credit_init(void)
+{
+ npu_memset(&dp_credit,0,sizeof(dp_credit));
+}
+static void dp_credit_elapsed(struct dp_credit_band *v, u32 now)
+{
+ u32 d=(u32)(now-v->wait_at), old;
+ if (v->wait_kind==1) {
+  old=v->empty_cycles; v->empty_cycles+=d; v->empty_hi+=v->empty_cycles<old;
+ } else if (v->wait_kind==2) {
+  old=v->credit_cycles; v->credit_cycles+=d; v->credit_hi+=v->credit_cycles<old;
+ }
+ v->wait_at=now;
+}
+static void dp_credit_wait(u32 b, u32 kind)
+{
+ struct dp_credit_band *v=&dp_credit.band[b];
+ if (!v->wait_kind && !kind) return;
+ u32 now=csr_read(mcycle);
+ dp_credit_elapsed(v,now);
+ if (kind==1) v->empty++;
+ if (kind==2) v->holds++;
+ v->wait_at=now; v->wait_kind=kind;
+}
+/* Called only on the first PARK observation, after the ACK. Local hart4
+ * state and clock only: never dereference the now host-owned mapping. */
+void kite_dp_tx_park(void)
+{
+ dp_credit_wait(0,0);dp_credit_wait(1,0);
+ dp_credit.band[0].demand=dp_credit.band[1].demand=0;
+}
+static int dp_credit_hold(u32 b)
+{
+ struct dp_credit_band *other=&dp_credit.band[b^1];
+ /* A competing, validated TDMA head can claim a small floor. Idle bands
+  * reserve nothing, so a lone bulk flow borrows the whole free pool. Keep
+  * the head in place: same-band STA queue bypass would violate ordering.
+  * No holder can take back a buffer already owned by WiFi or the host. */
+ if (dp_free_count && other->demand && other->pending<DP_CREDIT_RESERVE &&
+     dp_credit.band[b].pending>=DP_CREDIT_RESERVE &&
+     dp_free_count<=DP_CREDIT_RESERVE-other->pending) {
+  dp_credit_wait(b,2); return 1;
+ }
+ return 0;
+}
+static int dp_credit_commit(u32 id, u32 band, u32 wi)
+{
+ if (id>=KDP_TOKENS || band>1 || !wi || wi>=KDP_WCIDS ||
+     dp_credit.owner[id] || dp_credit.band[band].pending>=KDP_TOKENS ||
+     dp_credit.sta[band][wi]>=KDP_TOKENS) return 0;
+ dp_credit.owner[id]=wi | (band<<10);
+ u32 n=++dp_credit.band[band].pending, count=++dp_credit.sta[band][wi];
+ if (n>dp_credit.band[band].peak) dp_credit.band[band].peak=n;
+ if (count>dp_credit.band[band].sta_peak) dp_credit.band[band].sta_peak=count;
+ return 1;
+}
+static int dp_credit_release(u32 id, u32 band)
+{
+ u32 owner=dp_credit.owner[id], wi=owner&1023u;
+ if (!wi || wi>=KDP_WCIDS || (owner>>10)!=band || !dp_credit.sta[band][wi] ||
+     !dp_credit.band[band].pending) return 0;
+ dp_credit.sta[band][wi]--; dp_credit.owner[id]=0;
+ dp_credit.band[band].pending--; dp_credit.band[band].released++;
+ return 1;
+}
+/* Pure diagnostics. Published on the existing ~84ms snapshot, no token
+ * scan here. Only this isolated uncached alias is read by hart0. */
+static void dp_credit_publish(void)
+{
+ volatile u32 *v=KDP_DIAG_UNCACHED(dp_credit_publication);
+ u32 seq=(dp_credit_seq&~1u)+2;
+ if (!seq) seq=2;
+ dp_credit_seq=seq-1; KDP_BARRIER();
+ for (u32 b=0;b<2;b++) {
+  struct dp_credit_band *s=&dp_credit.band[b];
+  /* Account a continuing wait without adding another retry attempt. */
+  if (s->wait_kind) {
+   u32 now=csr_read(mcycle);
+   dp_credit_elapsed(s,now);
+  }
+  s->owner_wcid=s->owner_pending=0;
+ }
+ for (u32 b=0;b<2;b++) for (u32 wi=1;wi<KDP_WCIDS;wi++)
+  if (dp_credit.sta[b][wi]>dp_credit.band[b].owner_pending) {
+   dp_credit.band[b].owner_pending=dp_credit.sta[b][wi];
+   dp_credit.band[b].owner_wcid=wi;
+  }
+ v[0]=1;v[1]=seq;v[2]=dp_session;v[3]=dp_epoch;
+ v[4]=75;v[5]=cpu_clock_get();v[6]=(u32)csr_read(mcycle)>>8;
+ v[7]=dp_free_count;v[8]=dp_wait_count;
+ v[9]=dp->done.producer;v[10]=dp->done.consumer;v[11]=DP_CREDIT_RESERVE;
+ for (u32 b=0;b<2;b++) {
+  const u32 *s=(const void *)&dp_credit.band[b];
+  for (u32 i=0;i<18;i++) v[12+b*18+i]=s[i];
+ }
+ v[48]=dp_credit.extra_reaps;v[49]=dp_credit.pressure_tick;
+ for (u32 i=50;i<57;i++) v[i]=0;
+ KDP_BARRIER();dp_credit_seq=seq;
+}
+void kite_dp_queue_snapshot(u32 *out)
+{
+ const volatile u32 *v=KDP_DIAG_UNCACHED(dp_credit_publication);
+ for (u32 retry=0;retry<3;retry++) {
+  u32 seq=dp_credit_seq;
+  if (!seq || (seq&1)) continue;
+  KDP_BARRIER();
+  for (u32 i=0;i<57;i++) out[i]=v[i];
+  KDP_BARRIER();
+  if (seq==dp_credit_seq && out[1]==seq) return;
+ }
+ for (u32 i=0;i<57;i++) out[i]=0;
+}
