--- a/kite-observe.inc
+++ b/kite-observe.inc
@@ -10,6 +10,60 @@
 static struct { u32 alloc_probe, alloc_empty, reap_probe, reap_ready; } dp_account;
 static struct kdp_tune_stats dp_tune;
 static u32 dp_observe_sample[2];
+
+/* r73: sampled per-band costs. No shared datapath ABI/layout change.
+ * Hart4 is the only writer; hart0 GET32 takes a bounded seqlock snapshot.
+ * Bulk diagnostics stay in reserved DRAM, only sequence words use SRAM. */
+#define DP_COST_STAGES 12
+static struct {
+ u32 session, epoch, mhz, shift;
+ struct kdp_observe_time stage[DP_COST_STAGES];
+} dp_cost[2] __attribute__((section(".kite_observe")));
+static volatile u32 dp_cost_seq[2];
+u32 kite_dp_cost_stamp(u32 band)
+{
+ return band < 2 && dp_observe_sample[band] ? csr_read(mcycle) : 0;
+}
+u32 kite_dp_cost_step(u32 band, u32 stage, u32 start, u32 units)
+{
+ struct kdp_observe_time *t;
+ u32 seq, elapsed;
+ if (band > 1 || stage >= DP_COST_STAGES || !dp_observe_sample[band]) return 0;
+ elapsed = (u32)csr_read(mcycle) - start;
+ seq = dp_cost_seq[band];
+ dp_cost_seq[band] = seq + 1; KDP_BARRIER();
+ t = &dp_cost[band].stage[stage];
+ t->samples++; t->cycles += elapsed; t->units += units;
+ if (elapsed > t->max_cycles) t->max_cycles = elapsed;
+ KDP_BARRIER(); dp_cost_seq[band] = seq + 2 ? seq + 2 : 2;
+ /* Do not charge the observer's DRAM writes to the following stage. */
+ return csr_read(mcycle);
+}
+void kite_dp_cost_snapshot(u32 band, u32 *out)
+{
+ u32 i, seq, retry;
+ if (band > 1) goto unavailable;
+ for (retry = 0; retry < 3; retry++) {
+  seq = dp_cost_seq[band];
+  if (!seq || (seq & 1)) continue;
+  KDP_BARRIER();
+  out[1]=seq; out[2]=dp_cost[band].session; out[3]=dp_cost[band].epoch;
+  out[4]=dp_cost[band].mhz; out[5]=dp_cost[band].shift;
+  out[6]=band; out[7]=73;
+  for (i=0;i<DP_COST_STAGES;i++) {
+   out[8+i*4]=dp_cost[band].stage[i].samples;
+   out[9+i*4]=dp_cost[band].stage[i].cycles;
+   out[10+i*4]=dp_cost[band].stage[i].units;
+   out[11+i*4]=dp_cost[band].stage[i].max_cycles;
+  }
+  KDP_BARRIER();
+  if (seq == dp_cost_seq[band]) { out[0]=1; return; }
+ }
+unavailable:
+ /* No stale or NOLOAD fields escape when a sample is unavailable. */
+ for (i=0;i<56;i++) out[i]=0;
+}
+
 /* Polled on every TDMA descriptor: keep these small transition fields in
  * SRAM, not in the DRAM observation region competing with packet keys. */
 static struct { u32 pressure_tick; struct kdp_r63_band band[2]; } dp_r63;
@@ -138,6 +192,14 @@
 }
