+++ b/npu_kite_control.c
@@ -0,0 +1,349 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Extended control plane. Core 0 is its sole writer. RX workers only read
+ * STA/BA state; changes require every worker to be parked. This is NOT a
+ * DMA stop/reset protocol: PARK preserves all ring and packet ownership.
+ */
+#include "npu_internal.h"
+#include "npu_wifi.h"
+#include "kite-control.h"
+
+#if defined(AN7581) && defined(MT7916)
+struct kite_ctl_sta {
+	u32 generation;
+	u32 key_generation;
+	u32 cipher;
+	u32 live;
+	u32 band;
+	u32 bss;
+	u32 authorized;
+	u32 keyid;
+};
+_Static_assert(sizeof(struct kite_ctl_sta) == 32, "STA storage ABI");
+
+static struct {
+	u32 session, serial, result, base;
+	volatile u32 park_cookie;
+	u32 accepted, rejected, stations, bas, keys;
+	u32 last[KITE_CTL_WORDS];
+	volatile u32 state;
+	volatile u32 ack[4];
+} ctl;
+
+#define ctl_fence() __asm__ volatile("fence iorw,iorw" ::: "memory")
+
+int kite_ctl_active(void)
+{
+	return ctl.state != KITE_CTL_CLOSED;
+}
+
+int kite_ctl_rx_held(void)
+{
+	return ctl.state == KITE_CTL_PARKING || ctl.state == KITE_CTL_PARKED;
+}
+
+/* Call only between complete units of work, never from inside a DMA copy,
+ * a held mutex, a partially published chain, or an ISR. Each ack has one
+ * writer; there is no shared read-modify-write on the ack mask. */
+int kite_ctl_pausepoint(u32 hart)
+{
+	if (!kite_ctl_rx_held())
+		return 0;
+	if (hart < 1 || hart > 3)
+		return 0;
+	ctl_fence();
+	ctl.ack[hart] = ctl.park_cookie;
+	ctl_fence();
+	return 1;
+}
+
+static u32 kite_ctl_ack(void)
+{
+	u32 i, mask = 0;
+
+	if (!kite_ctl_rx_held())
+		return 0;
+	ctl_fence();
+	for (i = 1; i <= 3; i++)
+		if (ctl.ack[i] == ctl.park_cookie)
+			mask |= 1u << i;
+	return mask;
+}
+
+static int kite_ctl_parked(void)
+{
+	if (ctl.state == KITE_CTL_PARKING &&
+	    kite_ctl_ack() == KITE_CTL_WORKERS) {
+		ctl_fence();
+		ctl.state = KITE_CTL_PARKED;
+	}
+	return ctl.state == KITE_CTL_PARKED;
+}
+
+/* Ring preparation is allowed only while every worker is parked. The
+ * legacy BA/key/debug/pool setters stay blocked throughout the session. */
+int kite_ctl_legacy_setup(u32 cmd, u32 band)
+{
+	int ready;
+
+	if (!kite_ctl_parked() || band > 1)
+		return 0;
+	ready = band ? rxd_5g_init_done : rxd_2g_init_done;
+	return ((cmd == 0 || cmd == 1) && !ready) || (cmd == 13 && ready);
+}
+
+static struct kite_ctl_sta *kite_ctl_sta(u32 wcid)
+{
+	return (struct kite_ctl_sta *)(ctl.base + KITE_CTL_BA_BYTES) + wcid;
+}
+
+u32 kite_ctl_ba_address(u32 band, u32 wcid, u32 tid)
+{
+	struct kite_ctl_sta *sta;
+
+	if (!kite_ctl_active() || !ctl.base || band > 1 ||
+	    !wcid || wcid >= KITE_CTL_WCIDS || tid >= KITE_CTL_TIDS)
+		return 0;
+	sta = kite_ctl_sta(wcid);
+	if (!sta->live || sta->band != band)
+		return 0;
+	return ctl.base + (wcid * KITE_CTL_TIDS + tid) * 28;
+}
+
+int kite_ctl_sta_matches(u32 band, u32 wcid, u32 bss)
+{
+	struct kite_ctl_sta *sta;
+
+	if (!kite_ctl_ba_address(band, wcid, 0))
+		return 0;
+	sta = kite_ctl_sta(wcid);
+	/* Protected-frame replay remains host-owned. KEY records fencing
+	 * state, not a promise that NPU PN validation has been implemented. */
+	return sta->bss == bss && sta->authorized && !sta->cipher;
+}
+
+static void kite_ctl_discard(u32 wcid)
+{
+	u32 tid, addr;
+
+	for (tid = 0; tid < KITE_CTL_TIDS; tid++) {
+		addr = ctl.base + (wcid * KITE_CTL_TIDS + tid) * 28;
+		if (*(u8 *)(addr + 24))
+			ctl.bas--;
+		ba_discard_entry((u32 *)addr);
+		npu_memset((void *)addr, 0, 28);
+	}
+}
+
+/* A consumed RX descriptor does not identify its old STA/key generation.
+ * Until a verified WFDMA drain exists, topology/key changes with live RX
+ * rings are rejected. BA-only updates can safely discard held packets. */
+static int kite_ctl_rings_live(void)
+{
+	return rxd_2g_init_done || rxd_5g_init_done;
+}
+
+static u32 kite_ctl_apply(const u32 *d)
+{
+	u32 op = d[2], wcid = d[5], gen = d[6], tid, addr, i;
+	struct kite_ctl_sta *sta;
+
+	if (op == KITE_CTL_OPEN) {
+		if (kite_ctl_active() || kite_ctl_rings_live())
+			return KITE_CTL_BUSY;
+		if (!d[3] || d[3] <= ctl.session || d[4] != 1)
+			return KITE_CTL_STALE;
+		/* The DRAM pool must already be installed through SET7. It is
+		 * owned by the NPU driver until CLOSE, never an arbitrary pointer.
+		 * Only the documented 2 MiB pool is accepted. */
+		if (!wcid || (wcid & 4095) || gen != 0x200000 ||
+		    wcid >= 0x40000000u || gen > 0x40000000u - wcid ||
+		    !wifi_dram_ba_node_addr ||
+		    ((wifi_dram_ba_node_addr & 0x3fffffffu) != wcid))
+			return KITE_CTL_INVALID;
+		ctl.base = wifi_dram_ba_node_addr + KITE_CTL_BA_OFFSET;
+		npu_memset((void *)ctl.base, 0, KITE_CTL_STORAGE_BYTES);
+		ctl.session = d[3];
+		ctl.park_cookie = d[4];
+		ctl.stations = ctl.bas = ctl.keys = 0;
+		for (i = 1; i <= 3; i++)
+			ctl.ack[i] = 0;
+		ctl_fence();
+		ctl.state = KITE_CTL_PARKING;
+		return KITE_CTL_OK;
+	}
+	if (!kite_ctl_active() || d[3] != ctl.session)
+		return KITE_CTL_STALE;
+	if (op == KITE_CTL_PARK) {
+		if (!kite_ctl_rx_held()) {
+			ctl.park_cookie = d[4];
+			for (i = 1; i <= 3; i++)
+				ctl.ack[i] = 0;
+			ctl_fence();
+			ctl.state = KITE_CTL_PARKING;
+		}
+		return KITE_CTL_OK;
+	}
+	if (!kite_ctl_parked())
+		return KITE_CTL_BUSY;
+	if (op == KITE_CTL_RESUME) {
+		ctl_fence();
+		ctl.state = KITE_CTL_RUNNING;
+		return KITE_CTL_OK;
+	}
+	if (op != KITE_CTL_BA && kite_ctl_rings_live())
+		return KITE_CTL_BUSY;
+	if (op == KITE_CTL_CLOSE) {
+		for (i = 1; i < KITE_CTL_WCIDS; i++)
+			kite_ctl_discard(i);
+		ctl.stations = 0;
+		ctl.base = 0;
+		ctl_fence();
+		ctl.state = KITE_CTL_CLOSED;
+		return KITE_CTL_OK;
+	}
+	if (!wcid || wcid >= KITE_CTL_WCIDS || !gen)
+		return KITE_CTL_INVALID;
+	sta = kite_ctl_sta(wcid);
+	if (op == KITE_CTL_STA_ADD) {
+		if (sta->live || gen <= sta->generation)
+			return KITE_CTL_STALE;
+		if (d[7] > 1 || d[8] > 15)
+			return KITE_CTL_INVALID;
+		kite_ctl_discard(wcid);
+		npu_memset(sta, 0, sizeof(*sta));
+		sta->generation = gen;
+		sta->band = d[7];
+		sta->bss = d[8];
+		sta->keyid = 0xffffffffu;
+		sta->live = 1;
+		ctl.stations++;
+		return KITE_CTL_OK;
+	}
+	if (!sta->live)
+		return KITE_CTL_NOT_FOUND;
+	if (sta->generation != gen)
+		return KITE_CTL_STALE;
+	switch (op) {
+	case KITE_CTL_STA_DEL:
+		kite_ctl_discard(wcid);
+		sta->authorized = sta->live = 0;
+		ctl.stations--;
+		break;
+	case KITE_CTL_PORT:
+		if (d[7] > 1)
+			return KITE_CTL_INVALID;
+		if (!d[7])
+			kite_ctl_discard(wcid);
+		sta->authorized = d[7];
+		break;
+	case KITE_CTL_KEY:
+		if (!d[7] || d[7] <= sta->key_generation)
+			return KITE_CTL_STALE;
+		if (d[9] > 3 && (d[8] || d[9] != 0xffffffffu))
+			return KITE_CTL_INVALID;
+		kite_ctl_discard(wcid);
+		sta->key_generation = d[7];
+		sta->cipher = d[8];
+		sta->keyid = d[9];
+		ctl.keys++;
+		break;
+	case KITE_CTL_BA:
+		tid = d[7];
+		if (tid >= KITE_CTL_TIDS || d[8] > 256 || d[9] > 4095 ||
+		    (!d[8] && d[9]))
+			return KITE_CTL_INVALID;
+		addr = kite_ctl_ba_address(sta->band, wcid, tid);
+		if (*(u8 *)(addr + 24))
+			ctl.bas--;
+		ba_discard_entry((u32 *)addr);
+		npu_memset((void *)addr, 0, 28);
+		*(u8 *)(addr + 25) = sta->band;
+		if (d[8]) {
+			*(u16 *)(addr + 16) = d[8];
+			/* Preserve the negotiated SSN; do not reset it to the
+			 * first received packet, which may arrive out of order. */
+			*(u16 *)(addr + 18) = (d[9] - 1) & 4095;
+			*(u16 *)(addr + 20) = d[9];
+			*(u8 *)(addr + 24) = 4;
+			ctl.bas++;
+		}
+		break;
+	default:
+		return KITE_CTL_INVALID;
+	}
+	ctl_fence();
+	return KITE_CTL_OK;
+}
+
+int kite_ctl_set(u32 *msg, u32 bytes)
+{
+	const u32 *d = msg + 2;
+	u32 i, used, result;
+
+	if (bytes != (KITE_CTL_WORDS + 2) * 4 || (msg[0] & 15) ||
+	    d[0] != KITE_CTL_MAGIC || d[1] != KITE_CTL_WORDS ||
+	    d[2] < KITE_CTL_OPEN || d[2] > KITE_CTL_CLOSE)
+		return 0;
+	used = d[2] == KITE_CTL_OPEN || d[2] == KITE_CTL_STA_DEL ? 7 :
+	       d[2] == KITE_CTL_STA_ADD ? 9 : d[2] == KITE_CTL_PORT ? 8 :
+	       d[2] == KITE_CTL_KEY || d[2] == KITE_CTL_BA ? 10 : 5;
+	for (i = used; i < KITE_CTL_WORDS; i++)
+		if (d[i])
+			return 0;
+	/* Exact retransmission is idempotent, including rejected commands.
+	 * No other request may reuse a serial, and stale sessions may not
+	 * overwrite the result of the current controller's last command. */
+	if (d[3] == ctl.session && d[4] == ctl.serial && ctl.serial) {
+		for (i = 0; i < KITE_CTL_WORDS; i++)
+			if (d[i] != ctl.last[i])
+				return 0;
+		return 1;
+	}
+	if (d[2] != KITE_CTL_OPEN &&
+	    (d[3] != ctl.session || !d[4] || d[4] <= ctl.serial))
+		return 0;
+	if (d[2] == KITE_CTL_OPEN &&
+	    (!d[3] || d[3] <= ctl.session || d[4] != 1))
+		return 0;
+	result = kite_ctl_apply(d);
+	/* Failed OPEN cannot change session/last serial/result identity. */
+	if (d[3] != ctl.session) {
+		ctl.rejected++;
+		return 0;
+	}
+	ctl.result = result;
+	ctl.serial = d[4];
+	npu_memcpy(ctl.last, d, sizeof(ctl.last));
+	if (ctl.result)
+		ctl.rejected++;
+	else
+		ctl.accepted++;
+	return 1;
+}
+
+int kite_ctl_get(u32 *msg, u32 bytes)
+{
+	u32 *d = msg + 2;
+
+	if (bytes != (KITE_CTL_WORDS + 2) * 4 || (msg[0] & 15))
+		return 0;
+	kite_ctl_parked();
+	npu_memset(d, 0, KITE_CTL_WORDS * 4);
+	d[0] = KITE_CTL_MAGIC;
+	d[1] = KITE_CTL_WORDS;
+	d[2] = KITE_CTL_CAPS;
+	d[3] = ctl.session;
+	d[4] = ctl.serial;
+	d[5] = ctl.result;
+	d[6] = ctl.state;
+	d[7] = kite_ctl_ack();
+	d[8] = KITE_CTL_WCIDS;
+	d[9] = KITE_CTL_DRAM_BYTES;
+	d[10] = ctl.accepted;
+	d[11] = ctl.rejected;
+	d[12] = ctl.stations;
+	d[13] = ctl.bas;
+	d[14] = ctl.keys;
+	return 1;
+}
+#endif
--- a/npu_tdma.c
+++ b/npu_tdma.c
@@ -455,9 +455,73 @@
 
 #if defined(AN7581)
 #ifdef WIFI_KITE
+#ifdef MT7916
+/* Token ownership spans descriptor completion AND PPE return. A TDMA
+ * DONE bit alone never permits recycling the Wi-Fi buffer. Producers are
+ * serialized by mutex 0; core 0 is the only return FIFO consumer. */
+static volatile u8 kite_tdma_owner[5600]; /* 0=not submitted, band+1=TDMA */
+static volatile u32 kite_tdma_sent[2], kite_tdma_returned[2];
+static volatile u32 kite_tdma_bad_return, kite_tdma_double_submit;
+static u32 kite_tdma_mutex[2]; /* AN7581 Kite mutex 0, unused by other paths */
+
+void kite_tdma_snapshot(u32 *out)
+{
+	__asm__ volatile("fence iorw,iorw" ::: "memory");
+	out[0] = kite_tdma_sent[0] - kite_tdma_returned[0];
+	out[1] = kite_tdma_sent[1] - kite_tdma_returned[1];
+	out[2] = kite_tdma_bad_return;
+	out[3] = kite_tdma_double_submit;
+}
+
 /* PLIC 95: frames the PPE did not forward, and forwarded frames' buffers
  * (free only), come back on the buffer return FIFO; kite has no BME ring
  * on AN7581. As the stock MT7916 image's handler (0x84009250). */
+static void kite_ppe_return_isr(int src)
+{
+	u32 n = REG32(PPE_WIFI_BUF_CNT) & 0xffff;
+	u32 i, v, info, id, owner, band;
+
+	(void)src;
+	/* Bound an ISR pass even if a bad count is reported. A later interrupt
+	 * can consume the rest. Preserve the stock FIFO POP convention. */
+	if (n > 5600)
+		n = 5600;
+	for (i = 0; i < n; i++) {
+		v = REG32(PPE_WIFI_BUF_ID);
+		if (!PPE_WIFI_BUF_VALID(v))
+			break;
+		id = v & 0xffff;
+		info = (v & PPE_WIFI_BUF_FREE) ? 0 : REG32(PPE_WIFI_BUF_INFO);
+		__asm__ volatile("fence iorw,iorw" ::: "memory");
+		owner = id < 5600 ? kite_tdma_owner[id] : 0;
+		/* Pop before making the buffer reusable. An invalid/duplicate
+		 * return must never insert an arbitrary ID into the free list. */
+		REG32(PPE_WIFI_BUF_ID) = PPE_WIFI_BUF_POP;
+		__asm__ volatile("fence iorw,iorw" ::: "memory");
+		if (!owner || owner > 2) {
+			kite_tdma_bad_return++;
+			continue;
+		}
+		band = owner - 1;
+		kite_tdma_owner[id] = 0;
+		kite_tdma_returned[band]++;
+		__asm__ volatile("fence iorw,iorw" ::: "memory");
+		if (v & PPE_WIFI_BUF_FREE) {
+			buf_id_free(0, band, id);
+			wifi_cnt_inc(2, 4);
+		} else {
+			/* INFO is still WCID/A-MSDU metadata, never a FOE slot. */
+			wifi_cnt_inc(2, 8);
+			if ((info & PPE_WIFI_BUF_WCID) >= 544 ||
+			    pkt_forward_kite_return(id, info & PPE_WIFI_BUF_WCID,
+					    (info >> 16) & 31, band) != 0) {
+				buf_id_free(0, band, id);
+				wifi_cnt_inc(2, 12);
+			}
+		}
+	}
+}
+#else
 static void kite_ppe_return_isr(int src)
 {
 	u32 n = REG32(PPE_WIFI_BUF_CNT) & 0xFFFF;
@@ -490,6 +554,8 @@
