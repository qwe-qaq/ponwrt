  * are little endian. SET33/GET33 carry exactly 64 bytes after WLAN header.
  * A mailbox DONE acknowledges delivery; GET33 reports the command result.
  */
-#define KITE_CTL_MAGIC 0x4b430001u
+#define KITE_CTL_MAGIC 0x4b430002u
 #define KITE_CTL_WORDS 16u
 #define KITE_CTL_WCIDS 544u
 #define KITE_CTL_TIDS 8u
@@ -20,14 +20,33 @@
 #define KITE_CTL_CAP_GENERATION 2u
 #define KITE_CTL_CAP_PARK 4u
 #define KITE_CTL_CAP_KEY_FENCE 8u
-#define KITE_CTL_CAPS 15u
+#define KITE_CTL_CAP_CONTROL_ONLY 16u
+#define KITE_CTL_CAP_ARM_PA 32u
+#define KITE_CTL_CAPS 63u
+#define KITE_CTL_MODE_DATA 0u
+#define KITE_CTL_MODE_CONTROL_ONLY 1u
+
+/* ARM physical DDR: 0x80000000..0xbfffffff. Never accept a bare
+ * offset or the NPU uncached alias as an ARM address. No wrap allowed. */
+static inline int kite_ctl_pool_valid(unsigned long long addr,
+				      unsigned long long size)
+{
+	return addr >= 0x80000000ull && addr < 0xc0000000ull &&
+	       !(addr & 4095) && size == 0x200000 &&
+	       size <= 0xc0000000ull - addr;
+}
+
+static inline unsigned int kite_ctl_pool_alias(unsigned int addr)
+{
+	return (addr & 0x3fffffffu) | 0x40000000u;
+}
 #define KITE_CTL_WORKERS 0x0eu /* AN7581 MT7916 harts 1, 2, 3 */
 
 /* Request words: magic, words, command, session, serial, then args.
  * All unused words must be zero. Session and serial never wrap.
