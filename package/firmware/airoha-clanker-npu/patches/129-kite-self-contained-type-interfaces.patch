Subject: [PATCH] make Kite firmware interfaces self-contained

The bridge fallback declarations are included before npu_internal.h. Keep
the basic wire types independent of include order without defining host u64.

--- a/kite-host.h
+++ b/kite-host.h
@@ -2,6 +2,13 @@
 #ifndef PONWRT_KITE_HOST_H
 #define PONWRT_KITE_HOST_H
 
+#ifndef KITE_FIRMWARE_BASIC_TYPES
+#define KITE_FIRMWARE_BASIC_TYPES
+typedef unsigned char u8;
+typedef unsigned short u16;
+typedef unsigned int u32;
+#endif
+
 /* Firmware source ownership is retained on HOLD, including a partial
  * chain. Neither DONE nor the producer index may be published. */
 #define KITE_HOST_HOLD (-2)
--- a/npu_types.h
+++ b/npu_types.h
@@ -1,9 +1,12 @@
 #ifndef NPU_TYPES_H
 #define NPU_TYPES_H
 
+#ifndef KITE_FIRMWARE_BASIC_TYPES
+#define KITE_FIRMWARE_BASIC_TYPES
 typedef unsigned char u8;
 typedef unsigned short u16;
 typedef unsigned int u32;
+#endif
 typedef unsigned long long u64;
 typedef signed char s8;
 typedef signed short s16;
