+/* Legacy mailbox port numbers are not Linux PCIe controller numbers.
+ * AN7581 port 0 is MAC1 (1fc20000), port 1 is MAC0 (1fc00000).
+ * Keep the vendor selector semantics and select the board topology in DT. */
+static int wifi_pcie_window_config(u32 band)
+{
+	u32 base = wifi_pcie_desc_base & 0x1fffffff;
+	u32 start, end, reg;
+
+	if (band > 1 || wifi_pcie_port_type > 3)
+		return 0;
+	if (wifi_pcie_port_type < 2) {
+		start = base;
+		end = base + 2 * KITE_DESC_BAND_OFF;
+		reg = wifi_pcie_port_type ? KITE_WIN0_BASE : KITE_WIN1_BASE;
+	} else {
+		start = base + (band ? 0 : KITE_DESC_BAND_OFF);
+		end = start + KITE_DESC_BAND_OFF;
+		reg = (band == (wifi_pcie_port_type == 2)) ?
+			KITE_WIN0_BASE : KITE_WIN1_BASE;
+	}
+	REG32(reg) = start;
+	REG32(reg + 4) = end;
+	__asm__ volatile("fence iorw,iorw" ::: "memory");
+	return REG32(reg) == start && REG32(reg + 4) == end;
+}
+
+#if defined(AN7581) && defined(MT7916)
+/* GET32 page 2. Read-only; no payload or keys. Each field is observational,
+ * not an atomic snapshot of the DMA engine and three firmware workers. */
+void kite_wifi_ring_snapshot(u32 *d)
+{
+	u32 band, i;
+
+	d[4] = wifi_pcie_port_type;
+	d[5] = KITE_WIN0_BASE;
+	d[6] = REG32(KITE_WIN0_BASE);
+	d[7] = REG32(KITE_WIN0_BASE + 4);
+	d[8] = KITE_WIN1_BASE;
+	d[9] = REG32(KITE_WIN1_BASE);
+	d[10] = REG32(KITE_WIN1_BASE + 4);
+	for (band = 0; band < 2; band++) {
+		u32 *out = d + 12 + band * 20;
+		u32 reg = band ? pcie_base_5g : pcie_base_2g;
+		u32 ring = band ? rxd_base_5g : rxd_base_2g;
+		u32 idx = band ? rxd_5g_cpu_idx : rxd_2g_cpu_idx;
+		u32 ready = band ? rxd_5g_init_done : rxd_2g_init_done;
+
+		out[0] = reg;
+		out[1] = ring & 0x1fffffff;
+		out[6] = idx;
+		out[12] = ready;
+		/* Only the validated, initialized rings are safe to dereference. */
+		if (!ready || !reg || !ring || idx >= 1536)
+			continue;
+		for (i = 0; i < 4; i++) {
+			out[2 + i] = REG32(reg + i * 4);
+			out[7 + i] = REG32(ring + idx * 16 + i * 4);
+		}
+		out[11] = REG32((reg & ~0xfffu) + 0x208); /* WFDMA GLO_CFG */
+	}
+	d[61] = 0x4b520001; /* KR ring telemetry ABI 1 */
+}
+#endif
 
