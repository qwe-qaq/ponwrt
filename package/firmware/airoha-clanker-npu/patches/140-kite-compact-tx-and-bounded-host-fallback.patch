+static void dp_host_reap(u32 band)
+{
+ u32 n = 0;
+ while (dp_host_head[band] != dp_host_tail[band] && n++ < DP_HOST_COUNT) {
+  volatile struct dp_host_request *q = &dp_host[band][dp_host_head[band] % DP_HOST_COUNT];
+  struct kdp_r59_band *v = &dp_r59.band[band];
+  u32 age;
+  if (q->state != DP_HOST_DONE) break;
+  KDP_BARRIER();
+  if (q->token >= KDP_TOKENS || dp->token[q->token].state != KDP_TOKEN_HOST) {
+   dp->fault = 4; return;
+  }
+  age = (dp_observe_tick() - q->queued_at);
+  v->fallback_ticks += age;
+  if (age > v->fallback_max_ticks) v->fallback_max_ticks = age;
+  if (q->result) { v->fallback_failed++; dp->stats[band].reserved[KDP_STAT_HOST_FALLBACK_DROP]++; }
+  else { v->fallback_completed++; dp->stats[band].reserved[KDP_STAT_HOST_FALLBACK]++; }
+  dp_free_token(q->token);
+  if (kdp_failed(dp)) return;
+  q->state = DP_HOST_IDLE; KDP_BARRIER(); dp_host_head[band]++;
+  v->fallback_pending--;
+ }
