+static int dp_hint_ipv4(volatile struct kdp_shared *s, const struct kdp_sta *sta,
+                       const struct dp_ipv4_key *p, u32 wcid, u32 band)
+{
+ u32 hash=p->ports ^ p->src ^ (p->dst<<7) ^ wcid;
+ hash^=hash>>16; hash*=0x7feb352du; hash^=hash>>15;
+ for (u32 way=0;way<DP_HINT_WAYS;way++) {
+  struct dp_policy_hint *h=&dp_hint[band][hash & (DP_HINT_SETS-1)][way];
+  const kdp_word *mac=(const void *)h->smac;
+  dp_obs.band[band].hint_probe++;
+  if (!h->cap_version || h->key!=hash || h->capture>=KDP_FLOWS ||
+      h->exact>=KDP_FLOWS || !h->exact_version) continue;
+  if (s->flow[h->capture].version!=h->cap_version ||
+      s->flow[h->exact].version!=h->exact_version) continue;
+  KDP_BARRIER();
+  if (h->session!=s->session || h->generation!=sta->generation ||
+      h->key_generation!=sta->key_generation || h->tag!=sta->tx_tag ||
+      h->wcid!=wcid || h->band!=band || h->bss!=sta->bss ||
+      h->vlan!=KDP_SLOT_NONE || (h->cap_ds & h->cap_mask) ||
+      (h->exact_ds & h->exact_mask) || h->src!=p->src || h->dst!=p->dst ||
+      h->ports!=p->ports || h->protocol!=p->protocol ||
+      mac[0]!=p->mac[0] || mac[1]!=p->mac[1] || mac[2]!=p->mac[2]) continue;
+  KDP_BARRIER();
+  if (s->flow[h->capture].version!=h->cap_version ||
+      s->flow[h->exact].version!=h->exact_version) continue;
+  s->stats[band].reserved[KDP_STAT_BRIDGE_HIT]++; return 1;
+ }
+ return 0;
+}
+static int dp_wan_ipv4(volatile struct kdp_shared *s, const struct kdp_sta *sta,
+                      const struct dp_ipv4_key *p, u32 wi, u32 band)
+{
+ struct dp_wan_cache *c=&dp_private.wan[band][wi & 3];
+ u32 seq;
+ if (!c->seq || c->bucket>=KDP_FLOW_BUCKETS) return 0;
+ seq=s->tuning.bucket_seq[c->bucket];
+ if (!seq || (seq&1) || seq!=c->seq) return 0;
+ KDP_BARRIER();
+ if (c->key.wcid!=wi || c->key.vlan!=KDP_SLOT_NONE || c->dsfield ||
+     c->key.mac[0]!=p->mac[0] || c->key.mac[1]!=p->mac[1] || c->key.mac[2]!=p->mac[2] ||
+     c->session!=s->session || c->epoch!=s->epoch || c->generation!=sta->generation ||
+     c->key_generation!=sta->key_generation || c->tag!=sta->tx_tag || c->bss!=sta->bss) return 0;
+ KDP_BARRIER(); if (s->tuning.bucket_seq[c->bucket]!=seq) return 0;
+ dp_tune.wan_hit++; return 1;
+}
