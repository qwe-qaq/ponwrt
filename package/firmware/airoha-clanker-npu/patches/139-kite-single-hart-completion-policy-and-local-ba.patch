  * A stale notification can never release a new incarnation of a token. */
+static int dp_complete(u32 id, u32 seq, u32 band, u32 dma, u32 wa)
+{
+ int reusable = seq && dma == seq && wa == seq;
+ dp_observe_reap(id, reusable, wa == seq, band);
+ dp_account.reap_probe++;
+ if (!reusable) return 0;
