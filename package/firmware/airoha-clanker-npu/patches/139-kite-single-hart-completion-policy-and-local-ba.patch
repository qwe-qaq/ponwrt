 /* Pure diagnostics: hart4 only, published with the existing snapshot.
  * Never used as a token, ownership, admission or watchdog authority. */
 static struct kdp_perf_band dp_performance[2];
+static struct { u32 alloc_probe, alloc_empty, reap_probe, reap_ready; } dp_account;
+static struct kdp_tune_stats dp_tune;
+static u32 dp_pressure_armed;
+static u32 dp_born[KDP_TOKENS] __attribute__((section(".kite_observe")));
+static void dp_pressure(u32 peak)
+{
+ u32 i, now;
+ if (!peak && !dp_pressure_armed) return;
+ if (!peak) dp_pressure_armed = 0;
+ dp_tune.pressure_events++; dp_tune.pressure_pending = dp_wait_count;
+ dp_tune.dma_wait = dp_tune.wa_wait = dp_tune.ready_wait = dp_tune.oldest_ticks = 0;
+ dp_tune.done_backlog = dp->done.producer - dp->done.consumer;
+ now = (u32)csr_read(mcycle) >> 8;
+ for (i = 0; i < KDP_TOKENS; i++) {
+  u32 pending = !!(dp_pending[i >> 5] & (1u << (i & 31)));
+  if (pending != (dp->token[i].state == KDP_TOKEN_WIFI)) {
+   dp_tune.bitmap_fault++; dp->fault = 4; return;
+  }
+  if (!pending) continue;
+  volatile struct kdp_token *t = &dp->token[i];
+  u32 seq = t->submitted, dma = t->dma_done, wa = t->wa_done;
+  u32 age = (now - dp_born[i]) & 0xffffffu;
+  dp_tune.dma_wait += dma != seq; dp_tune.wa_wait += wa != seq;
+  dp_tune.ready_wait += dma == seq && wa == seq;
+  if (age > dp_tune.oldest_ticks) dp_tune.oldest_ticks = age;
+ }
+}
