+static int dp_wan_matches(volatile struct kdp_shared *s, volatile struct kdp_sta *sta,
+ const struct kdp_packet *p, u32 wi, u32 band)
+{
+ struct dp_wan_cache *c = &dp_private.wan[band][wi & 3];
+ const kdp_word *mac = (const void *)p->smac;
+ u32 seq;
+ if (!c->seq || c->bucket >= KDP_FLOW_BUCKETS) return 0;
+ seq = s->tuning.bucket_seq[c->bucket];
+ if (!seq || (seq & 1) || seq != c->seq) return 0;
+ KDP_BARRIER();
+ if (c->key.wcid != wi || c->key.vlan != p->vlan || c->dsfield != p->dsfield ||
+     c->key.mac[0] != mac[0] || c->key.mac[1] != mac[1] || c->key.mac[2] != mac[2] ||
+     c->session != s->session || c->epoch != s->epoch ||
+     c->generation != sta->generation || c->key_generation != sta->key_generation ||
+     c->tag != sta->tx_tag || c->bss != sta->bss) return 0;
+ KDP_BARRIER();
+ if (s->tuning.bucket_seq[c->bucket] != seq) return 0;
+ dp_tune.wan_hit++;
+ return 1; /* domain classification only: no new routing authorization */
+}
+static void dp_wan_save(volatile struct kdp_shared *s, volatile struct kdp_sta *sta,
+ const struct kdp_packet *p, u32 wi, u32 band, u32 bucket, u32 seq)
+{
+ struct dp_wan_cache *c = &dp_private.wan[band][wi & 3];
+ const kdp_word *mac = (const void *)p->smac;
+ c->seq = 0;
+ if (!(s->perf.flags & KDP_PERF_FAST) || !seq || (seq & 1)) return;
+ c->bucket = bucket; c->session = s->session; c->epoch = s->epoch;
+ c->generation = sta->generation; c->key_generation = sta->key_generation;
+ c->tag = sta->tx_tag; c->bss = sta->bss; c->dsfield = p->dsfield;
+ c->key.wcid = wi; c->key.vlan = p->vlan;
+ c->key.mac[0] = mac[0]; c->key.mac[1] = mac[1]; c->key.mac[2] = mac[2];
+ KDP_BARRIER();
+ if (s->tuning.bucket_seq[bucket] == seq) c->seq = seq;
+}
