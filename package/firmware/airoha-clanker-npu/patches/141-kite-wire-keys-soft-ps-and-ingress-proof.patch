+/* Pair adjacent real events after a sampled trigger. Idle intervals remain
+ * in the maximum; no regular CSR read on unsampled per-packet events. */
+static void dp_observe_gap(u32 band,u32 kind)
+{
+ u32 now,elapsed;
+ volatile struct kdp_observe_time *t;
+ if (!dp_gap_armed[band][kind] && !dp_observe_sample[band]) return;
+ now=dp_observe_tick();
+ if (!dp_gap_armed[band][kind]) {
+  dp_gap_start[band][kind]=now; dp_gap_armed[band][kind]=1; return;
+ }
+ dp_gap_armed[band][kind]=0;
+ elapsed=now-dp_gap_start[band][kind]; t=&dp->r60.gap[band][kind];
+ t->samples++; t->cycles+=elapsed; t->units++;
+ if (elapsed>t->max_cycles) t->max_cycles=elapsed;
+}
