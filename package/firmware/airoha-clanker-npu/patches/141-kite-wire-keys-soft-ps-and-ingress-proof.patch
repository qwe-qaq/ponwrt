+static inline unsigned int kdp_soft_find(const volatile struct kdp_shared *s,
+ const struct kdp_packet *p, unsigned int wi, unsigned int request)
+{
+ unsigned int base,i;
+ const volatile struct kdp_sta *sta=&s->sta[wi];
+ if (!request || s->r60.ps[wi].active!=request) return KDP_SLOT_NONE;
+ base=kdp_flow_bucket(p->smac,p->dmac,p->vlan,wi);
+ base=kdp_flow_l4_bucket(base,p->src,p->dst,p->ports,p->protocol,p->type);
+ for (i=base;i<base+KDP_FLOW_WAYS;i++)
+  if (kdp_soft_type(s->r60.soft[i].type) && s->r60.soft_request[i]==request &&
+      kdp_flow_matches(&s->r60.soft[i],p,s->session,sta->generation,
+                       sta->key_generation,wi,sta->band,sta->bss)) return i;
+ return KDP_SLOT_NONE;
