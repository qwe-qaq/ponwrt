+static inline int kdp_soft_record_matches(const volatile struct kdp_shared *s,
+ const struct kdp_packet *p, unsigned int wi, unsigned int request,
+ unsigned int slot, unsigned int version, unsigned int tag)
+{
+ if (!wi || wi>=KDP_WCIDS || !request || slot>=KDP_FLOWS || !version ||
+     s->r60.ps[wi].request!=request || s->r60.ps[wi].active!=request ||
+     !kdp_soft_type(s->r60.soft[slot].type) || s->r60.soft_request[slot]!=request || s->r60.soft[slot].version!=version ||
+     s->sta[wi].tx_tag!=tag || !s->sta[wi].enabled || !s->sta[wi].authorized)
