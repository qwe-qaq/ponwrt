+		    (kdp_get_le32(p + 24) & 0xfcu) != 0x88u);
 	sta = &s->sta[wcid];
 	r->generation = sta->generation;
 	r->key_generation = sta->key_generation;
 	r->wcid = wcid;
-	r->bss = kdp_get_le32(p + 8) & 63;
