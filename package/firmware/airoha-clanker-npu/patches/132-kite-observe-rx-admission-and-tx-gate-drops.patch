From: ponwrt development
Subject: [PATCH] Observe RX early fallback and TX admission without changing packet ownership

--- a/kite-datapath.h
+++ b/kite-datapath.h
@@ -170,7 +170,23 @@
 #define KDP_STAT_BRIDGE_MISS      1u
 #define KDP_STAT_HOST_FALLBACK    2u
 #define KDP_STAT_HOST_FALLBACK_DROP 3u
-#define KDP_STAT_BRIDGE_STALE     4u
+/* Optional telemetry v2: reuse previously unwritten reserved words.
+ * No shared layout, DMA address or ownership/packet ABI changes. */
+#define KDP_STAT_TX_ADMISSION_DROP 4u
+#define KDP_STAT_RX_ENTER         5u
+#define KDP_STAT_RX_EARLY         6u
+#define KDP_STAT_RX_LAST          7u /* wcid:16, tid:8, reason:8 */
+#define KDP_STAT_RX_WORD2         8u
+#define KDP_RX_EARLY_DISABLED     1u
+#define KDP_RX_EARLY_STA          2u
+#define KDP_RX_EARLY_BAND         3u
+#define KDP_RX_EARLY_BSS          4u
+#define KDP_RX_EARLY_BAR          5u
+#define KDP_RX_EARLY_TID          6u
+#define KDP_RX_EARLY_NON_QOS      7u
+#define KDP_RX_EARLY_UNSUPPORTED  8u
+#define KDP_RX_EARLY_NO_BA        9u
+
 struct kdp_shared {
 	unsigned int magic, bytes, session, epoch;
 	unsigned int enabled, fault, gate, stopped;
--- a/npu_kite_datapath.c
+++ b/npu_kite_datapath.c
@@ -341,11 +341,19 @@
 	KDP_BARRIER();
 	wcid = dp->route[tag & (KDP_ROUTES - 1)].wcid;
 	if (!wcid || wcid >= KDP_WCIDS || b != band ||
-	    len < 14 || len > KDP_BUFFER_BYTES || !dp->enabled || dp->gate)
-		goto drop;
+	    len < 14 || len > KDP_BUFFER_BYTES)
+		goto drop;
+	if (!dp->enabled || dp->gate) {
+		dp->stats[band].reserved[KDP_STAT_TX_ADMISSION_DROP]++;
+		goto drop;
+	}
 	sta = &dp->sta[wcid];
 	bss = sta->bss;
-	if (sta->tx_tag != tag || bss > 63 || sta->tx_blocked || !sta->enabled || !sta->authorized || sta->band != b ||
+	if (sta->tx_blocked || !sta->enabled || !sta->authorized) {
+		dp->stats[band].reserved[KDP_STAT_TX_ADMISSION_DROP]++;
+		goto drop;
+	}
+	if (sta->tx_tag != tag || bss > 63 || sta->band != b ||
 	    sta->bss != bss || !sta->generation ||
 	    (sta->cipher && (sta->cipher != KDP_CIPHER_CCMP ||
 			    !sta->key_generation)))
--- a/npu_kite_secure_rx.c
+++ b/npu_kite_secure_rx.c
@@ -222,6 +222,21 @@
 		kite_dp_ba_set(wcid, tid, 0, 0);
 }
 
+static int dp_rx_early(volatile struct kdp_shared *s, u32 band,
+		       u32 reason, u32 wcid, u32 tid, u32 word2)
+{
+	s->stats[band].reserved[KDP_STAT_RX_EARLY]++;
+	/* Background management/control traffic must not overwrite the last
+	 * identified data failure. Never export payload, keys or packet PN. */
+	if (reason) {
+		s->stats[band].reserved[KDP_STAT_RX_WORD2] = word2;
+		KDP_BARRIER();
+		s->stats[band].reserved[KDP_STAT_RX_LAST] =
+			(wcid << 16) | (tid << 8) | reason;
+	}
+	return 0;
+}
+
 int kite_dp_rx(u32 token, u32 len, u32 band)
 {
 	volatile struct kdp_shared *s = kite_dp_shared();
@@ -231,9 +246,10 @@
 	struct kdp_rxd rx;
