 	const u8 *p;
-	u32 wcid, tid;
+	u32 wcid, tid, word2, observe;
 	if (!s || token >= KDP_RX_TOKENS || band > 1)
 		return 0;
+	s->stats[band].reserved[KDP_STAT_RX_ENTER]++;
 	r = &s->rx[token];
 	r->flags = KDP_RX_MAGIC;
 	r->generation = r->key_generation = 0;
@@ -242,42 +258,49 @@
