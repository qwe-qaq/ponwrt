-		return 0;
+	if (!observe)
+		return dp_rx_early(s, band, 0, wcid, tid, word2);
 	ctx.s = s;
 	ctx.band = band;
 	ba = dp_ba_find(s, wcid, tid);
@@ -293,13 +316,13 @@
 			for (u32 i = 0; i < ba->window; i++)
