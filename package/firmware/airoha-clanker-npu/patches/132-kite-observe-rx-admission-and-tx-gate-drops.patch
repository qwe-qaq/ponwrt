+	if (sta->band != band)
+		return dp_rx_early(s, band, observe * KDP_RX_EARLY_BAND, wcid, tid, word2);
+	if (r->bss != sta->bss)
+		return dp_rx_early(s, band, observe * KDP_RX_EARLY_BSS, wcid, tid, word2);
 	ctx.s = s;
 	ctx.band = band;
 	{
 		u32 bar_tid, ssn;
 		int bar = kdp_parse_bar(p, len, band, sta, &bar_tid, &ssn);
 		if (bar < 0)
-			return 0;
+			return dp_rx_early(s, band, observe * KDP_RX_EARLY_BAR, wcid, tid, word2);
 		if (bar > 0) {
 			ba = dp_ba_find(s, wcid, bar_tid);
 			if (ba && !(sta->host_tids & (1u << bar_tid)))
 				kdp_ba_bar(ba, ssn, &dp_rx_ops, &ctx);
