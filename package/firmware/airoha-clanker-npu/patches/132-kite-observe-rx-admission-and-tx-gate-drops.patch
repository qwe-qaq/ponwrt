-	if (!s->enabled || !sta->enabled || !sta->authorized ||
-	    sta->band != band || r->bss != sta->bss)
-		return 0;
+	if (!s->enabled)
+		return dp_rx_early(s, band, observe * KDP_RX_EARLY_DISABLED, wcid, tid, word2);
+	if (!sta->enabled || !sta->authorized)
