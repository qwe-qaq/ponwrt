Subject: r67 PS drain proof scans the band ring for the target only

dp_ps_drain_poll() refused the drain proof whenever the band TDMA head was
ready, without checking whose descriptor it was. A saturated or held
unrelated STA on the same band could withhold the target's proof
indefinitely. Scan the bounded 64-entry ring (called only between fully
flushed batches, so every ready slot is unconsumed) and refuse only if a
ready descriptor resolves to the target WCID or cannot be attributed.
A foreign head in front of an older target packet still blocks.
Counters: perf.reserved[6] = deferrals for a possible target descriptor;
observe.band[b].reserved = proofs the old head rule would have refused.
ABI12 layout unchanged.

--- a/npu_kite_datapath.c
+++ b/npu_kite_datapath.c
@@ -1025,9 +1025,29 @@
 }
 
 static u32 dp_ps_probe_at;
+/* r67: does any unconsumed TDMA descriptor on this band possibly belong to
+ * the drain target? Called only between fully flushed batches (via
+ * kite_dp_ba_poll), so every ready slot is genuinely unconsumed. The whole
+ * bounded ring is scanned, not just the head: a foreign head may sit in
+ * front of an older target packet. A descriptor whose route tag no longer
+ * resolves (e.g. target route already withdrawn) is treated as possibly the
+ * target -- hart4 drops such a head immediately, so this cannot stall. */
+static int dp_ps_ring_target(u32 b, u32 wi)
+{
+ for (u32 n=0;n<DP_TDMA_COUNT;n++) {
+  u32 desc=dp_ring+b*DP_TDMA_BYTES+((dp_idx[b]+n)%DP_TDMA_COUNT)*32,info,tag;
+  if (!(REG32(desc+4)&0x80000000u)) continue;
+  KDP_BARRIER();
+  info=REG32(desc+16);
+  tag=((info>>14)&0x7ff)|(((REG32(desc+24)>>24)&0x7f)<<11);
+  if (!tag || tag>KDP_ROUTE_MAX || dp->route[tag&(KDP_ROUTES-1)].tag!=tag ||
+      dp->route[tag&(KDP_ROUTES-1)].wcid==wi) return 1;
+ }
+ return 0;
+}
 static void dp_ps_drain_poll(void)
 {
- u32 wi=dp->r60.drain_wcid,request,b;
+ u32 wi=dp->r60.drain_wcid,request,b,head;
  if (!wi || wi>=KDP_WCIDS) return;
  volatile struct kdp_suspend *p=&dp->r60.ps[wi];
  request=p->request;
@@ -1036,11 +1056,17 @@
  if ((u32)(now-dp_ps_probe_at)<cpu_clock_get()*1000u) return;
  dp_ps_probe_at=now;
  b=dp->sta[wi].band;
- if (b>1 || (REG32(dp_ring+b*DP_TDMA_BYTES+dp_idx[b]*32+4)&0x80000000u)) return;
+ if (b>1) return;
+ head=REG32(dp_ring+b*DP_TDMA_BYTES+dp_idx[b]*32+4)&0x80000000u;
+ /* Only target-owned (or unattributable) ready descriptors block the
+  * proof. A ready head holding only other STAs' packets no longer does. */
+ if (dp_ps_ring_target(b,wi)) { dp->perf.reserved[6]++; return; }
  if (p->issued-p->failed!=p->consumed) return;
  /* No direct packet may overtake an older DMA/WA-owned packet. */
  for (u32 i=0;i<KDP_TOKENS;i++)
   if (dp->token[i].state==KDP_TOKEN_WIFI && dp->token[i].wcid==wi) return;
+ /* Count proofs the old whole-band head rule would have refused. */
+ if (head) dp_obs.band[b].reserved++;
  KDP_BARRIER(); p->drained=request;
 }
 
