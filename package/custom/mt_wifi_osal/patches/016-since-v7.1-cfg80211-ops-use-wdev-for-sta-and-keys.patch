From: local private research
Subject: [PATCH] mt_wifi_osal: Take wireless_dev in station/key cfg80211 ops

Linux 7.1 converted the station and key cfg80211_ops callbacks from
struct net_device to struct wireless_dev (7.0 still used net_device).
backports 7.2, which this tree builds cfg80211 from, has the new
signatures, so the mtk_cfg80211_ops initializer no longer type-checks:

  mt_osal_cfg80211.c:3578:35: error: initialization of
  'int (*)(struct wiphy *, struct wireless_dev *, const u8 *,
  struct station_info *)' from incompatible pointer type
  'int (*)(struct wiphy *, struct net_device *, ...)'
  [-Wincompatible-pointer-types]

Affected: add/get/del_key, set_default_beacon_key,
set_default_mgmt_key, add/del/change_station, get/dump_station.
The earlier wdev conversions (del_virtual_intf, get_channel,
abort_scan, mgmt_tx, ...) are already handled in this file, so only
these ten remain.

Keep the old signatures for cfg80211 < 7.1 and derive the net_device
from wdev->netdev on 7.1+, leaving the function bodies untouched.

Signed-off-by: local private research
---
--- a/mt_osal_cfg80211.c
+++ b/mt_osal_cfg80211.c
@@ -38,6 +38,16 @@
 
 #define MSEC_TO_SEC(_msec)		((_msec) / MSEC_PER_SEC)
 
+/*
+ * Linux 7.1 把 station/key 这一批 cfg80211_ops 的第二个参数从
+ * struct net_device 换成 struct wireless_dev（upstream 7.0 还是 netdev，
+ * 7.1 全部改完）。backports 7.2 已包含该变更，故按 7.1 做版本分支。
+ */
+#if (KERNEL_VERSION(7, 1, 0) <= LINUX_VERSION_CODE) || \
+	(defined(CFG_CFG80211_VERSION) && (KERNEL_VERSION(7, 1, 0) <= CFG_CFG80211_VERSION))
+#define MT_CFG80211_USE_WDEV	1
+#endif
+
 unsigned char mt_zero_mac_addr[MT_MAC_ADDR_LEN]  = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
 
 static u16 mtk_vht_high_rate_bw80[3][4] = {
@@ -2399,10 +2409,17 @@
 
 static int mt_cfg80211_ops_sta_get(
 	struct wiphy *wiphy,
+#if defined(MT_CFG80211_USE_WDEV)
+	struct wireless_dev *wdev,
+#else
 	struct net_device *netdev,
+#endif
 	const u8 *mac_addr,
 	struct station_info *pSinfo)
 {
+#if defined(MT_CFG80211_USE_WDEV)
+	struct net_device *netdev = wdev ? wdev->netdev : NULL;
+#endif
 	struct mt_priv_ops_sta_info mtk_sta_info;
 	struct mt_cfg80211_vndr_ctrl ctrl_data, *ctrl_data_ptr = &ctrl_data;
 
