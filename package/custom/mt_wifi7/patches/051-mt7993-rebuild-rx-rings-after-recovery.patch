From: chasey-dev <ellenyoung0912@gmail.com>
Subject: [PATCH] mt7993: rebuild the RX rings the way they are first built

The recovery works up to a point: PCI_COMMAND is caught at 0x0000, BAR0 goes
back, and this time the chip really takes the descriptors - the WFDMA sets
DDONE on the semaphore release we queue, which only the device can do.  The
reply still never arrives.

The RX side is where the mistake is.  An RX ring is not empty at index zero:
pci_dma_init_rx_event_queue() leaves head at q_size - 1 and tail at q_size,
clears DDONE on every descriptor and fills each one with the address of a
buffer that is already mapped.  Our recovery only dropped head and tail to
zero and rewrote the ring registers.  From the driver's point of view the
ring was now empty and the next index to read was one; from the hardware's
point of view the descriptors still carried stale state, and the two never
agreed again.  Whatever the firmware wrote stayed unread.

Rebuild them the way they are first built: walk the descriptors, clear DDONE
and refill them from the buffers that are already DMA mapped, then put the
indices back on the empty-ring convention before the hardware registers are
written.  Rings that only come up after the download are skipped - their
buffers do not exist yet and the post-download init owns them - and the TX
side keeps the plain reset it already needs.

The probes stay in place: the event ring is sampled before the rebuild, after
it, and again before every MCU command push, and the firmware is asked to
take ownership and give it back, which it has to answer either way.  A ring
that moves now means the whole path is live; a ring that stays put after
this, with the firmware still answering the ownership pulse, points at the
download image rather than the transport.

Signed-off-by: chasey-dev <ellenyoung0912@gmail.com>
---
--- a/wlan_hwifi/bus/mtk_pci_dma.c
+++ b/wlan_hwifi/bus/mtk_pci_dma.c
@@ -2469,6 +2469,36 @@
 }
 
 /*
+ * Bring-up diagnostic: dump the MCU event ring.  Commands make it into the
+ * chip (the WFDMA sets DDONE on the descriptor we queued), yet no reply ever
+ * comes back, so the question is whether the firmware wrote anything at all.
+ * The hardware write index is the answer: it only moves when the chip puts a
+ * packet in the ring, and we never reset it here.
+ */
+static void
+pci_dma_diag_rx_snapshot(struct pci_trans *trans, const char *tag)
+{
+	struct mtk_bus_trans *btrans = to_bus_trans(trans);
+	int i;
+
+	for (i = 0; i < trans->rxq_num; i++) {
+		struct pci_rx_queue *rxq = &trans->rxq[i];
+
+		if (rxq->q.disable || rxq->q.q_attr != Q_RX_EVENT_WM)
+			continue;
+
+		dev_err(to_device(trans),
+			"diag rx[%s]: base=0x%08x cnt=0x%08x cidx=0x%08x didx=0x%08x sw=%u/%u\n",
+			tag,
+			bus_read(btrans, rxq->q.hw_desc_base),
+			bus_read(btrans, rxq->q.hw_cnt_addr),
+			bus_read(btrans, rxq->q.hw_cidx_addr),
+			bus_read(btrans, rxq->q.hw_didx_addr),
+			rxq->q.head, rxq->q.tail);
+	}
+}
+
+/*
  * Bring-up diagnostic: the ROM clears its own PCIe configuration the moment
  * it accepts PATCH_FINISH_REQ.  Nothing on the host side notices until the
  * next command times out 20 s later, so check the MCU command queue and put
@@ -2529,6 +2559,13 @@
 		ret, bus_read(btrans, trans->lp_fw_own_reg_addr));
 
 	/*
+	 * Snapshot the event ring before anything is rewritten: if the chip
+	 * wrote a reply while we were not looking, didx is already ahead of
+	 * zero here and the whole "no answer" story changes.
+	 */
+	pci_dma_diag_rx_snapshot(trans, "pre-rebuild");
+
+	/*
 	 * The WFDMA went back to index zero together with the config space
 	 * while our head/tail are sitting in the middle of the ring, so the
 	 * chip would wait for descriptor zero and never look at anything we
@@ -2544,11 +2581,40 @@
 	}
 
 	for (i = 0; i < trans->rxq_num; i++) {
-		if (trans->rxq[i].q.disable)
+		struct pci_rx_queue *rxq = &trans->rxq[i];
+		int j;
+
+		if (rxq->q.disable)
+			continue;
+
+		/*
+		 * Rings that only come up after the download have no buffers
+		 * behind their descriptors yet, so leave them alone - the
+		 * post-download init owns them.
+		 */
+		if (rxq->need_init_after_fwdl)
 			continue;
 
-		trans->rxq[i].q.head = 0;
-		trans->rxq[i].q.tail = 0;
+		/*
+		 * RX rings do not start at zero: a fresh one has head at
+		 * q_size - 1 and tail at q_size, and every descriptor has
+		 * DDONE clear with a buffer behind it.  Zeroing the indices
+		 * alone leaves the driver believing the ring is empty while
+		 * the hardware walks descriptors that still look consumed,
+		 * so rewrite the descriptors from the buffers that are
+		 * already mapped and put the indices back on the empty-ring
+		 * convention.
+		 */
+		rxq->magic_cnt = 0;
+		for (j = 0; j < rxq->q.q_size; j++) {
+			struct pci_dma_cb *cb = &rxq->q.cb[j];
+
+			clear_ddone(cb->alloc_va);
+			fill_rxd(cb, 0, 0);
+		}
+
+		rxq->q.head = rxq->q.q_size - 1;
+		rxq->q.tail = rxq->q.q_size;
 	}
 
 	pci_chip_dma_init(trans);
@@ -2569,6 +2635,43 @@
 		bus_read(btrans, q->hw_cidx_addr),
 		bus_read(btrans, q->hw_didx_addr));
 
+	pci_dma_diag_rx_snapshot(trans, "post-rebuild");
+
+	/*
+	 * Ownership probe.  Handing the chip back asks the firmware a direct
+	 * question: the pulse only completes when the owner state really
+	 * flips, so a clean return means something on the other side is still
+	 * driving that handshake.  Then watch for a moment whether it gives
+	 * the chip back on its own, which is what a finished patch does, and
+	 * take it again either way so the command we are about to queue can
+	 * actually be fetched.
+	 */
+	if (dev->chip_drv->ctl_ops->driver_own) {
+		int took = 0;
+
+		ret = dev->chip_drv->ctl_ops->driver_own(dev, btrans, false);
+		took = (ret == 0);
+		dev_err(to_device(trans),
+			"diag: fw own ret=%d took=%d lpctl=0x%08x\n",
+			ret, took, bus_read(btrans, trans->lp_fw_own_reg_addr));
+
+		for (i = 0; i < 100; i++) {
+			if (!(bus_read(btrans, trans->lp_fw_own_reg_addr) & 0x4))
+				break;
+			msleep(10);
+		}
+
+		dev_err(to_device(trans),
+			"diag: fw handed back after %d ms (lpctl=0x%08x)\n",
+			took ? i * 10 : -1,
+			bus_read(btrans, trans->lp_fw_own_reg_addr));
+
+		ret = dev->chip_drv->ctl_ops->driver_own(dev, btrans, true);
+		dev_err(to_device(trans),
+			"diag: own taken again ret=%d lpctl=0x%08x\n",
+			ret, bus_read(btrans, trans->lp_fw_own_reg_addr));
+	}
+
 	return true;
 }
 
@@ -2580,8 +2683,18 @@
 	struct pci_queue_buf buf;
 	dma_addr_t addr;
 
-	if (q->q_attr == Q_TX_CMD_WM)
-		pci_dma_diag_resync(trans, q);
+	if (q->q_attr == Q_TX_CMD_WM) {
+		/*
+		 * Every MCU command goes through here, so the snapshot taken
+		 * before each push doubles as a "what did the chip write since
+		 * the last command" probe: the sem release times out 20 s
+		 * before the next command is queued, and its event ring
+		 * position at that point says whether a reply was ever
+		 * produced.
+		 */
+		if (!pci_dma_diag_resync(trans, q))
+			pci_dma_diag_rx_snapshot(trans, "cmd");
+	}
 
 	if (((q->head + 1) % q->q_size) == q->tail)
 		goto err;
