From: chasey-dev <ellenyoung0912@gmail.com>
Subject: [PATCH] mt7993: sample DRV_FW_STAT_SYNC and WF_MCU_SYSRAM around the patch download

The ROM patch download on AN7581 dies between PATCH_START_REQ and the
response to PATCH_FINISH_REQ:

  mt7993: mt7993_check_fwdl_state(): check target stat=1, cur state=1
  mt7993: HW/SW Version: 0x8a108a10, Build Time: 20250623123248
  pcieport: AER: Correctable, Physical Layer, RxErr
  pcieport: AER: Uncorrectable (Fatal), Data Link Layer, SDES
  mt7993: Failed to start patch

20 ms separate the header print from the link going down, and the failing
step is either the 12 KB scatter download (which is fire-and-forget, with
wait_resp = false) or the WM CPU jumping into it.  Everything after the
failure is unreadable because the endpoint is gone, so sample the state
before each step:

  0x0e00f0  CONN_HOST_CSR_TOP WF_BAND0_LPCTL, DRV_FW_STAT_SYNC[6:4]
  0x090000  chip 0x1849_xxxx, i.e. MCU address 0x0090_0000 -> WF_MCU_SYSRAM
  0x080000  chip 0x1848_xxxx, the other WF_MCU_SYSRAM alias

A sane lpctl and a SRAM image that matches the payload after the scatter
mean the download worked and the crash is on the firmware side; 0xffffffff
or 0xdeadxxxx there means the endpoint went away during the download.

Signed-off-by: chasey-dev <ellenyoung0912@gmail.com>
---
--- a/wlan_hwifi/mcu/mcu_wm.c
+++ b/wlan_hwifi/mcu/mcu_wm.c
@@ -284,6 +284,59 @@ exit:
 	return mode;
 }
 
+/*
+ * Bring-up diagnostics: the ROM patch download dies somewhere between
+ * PATCH_START_REQ and the response to PATCH_FINISH_REQ, and the endpoint
+ * leaves the bus in the process, so nothing after the failure is readable.
+ * Sample the two places that tell us *where* it dies, before it dies:
+ *
+ *   0x0e00f0  BAR window for chip 0x1806_00f0 (CONN_HOST_CSR_TOP
+ *             WF_BAND0_LPCTL), i.e. DRV_FW_STAT_SYNC[6:4]
+ *   0x090000  BAR window for chip 0x1849_xxxx (WF_MCU_SYSRAM), which is
+ *             where MCU address 0x0090_0000 lives
+ *   0x080000  BAR window for chip 0x1848_xxxx (WF_MCU_SYSRAM), the other
+ *             alias of the same SRAM
+ *
+ * Readable values after send_firmware() mean the scatter went through and
+ * the chip only dies when the WM CPU jumps; 0xffffffff/deadfeed means the
+ * endpoint went away during the download itself.
+ */
+#define MCU_DIAG_LPCTL		0x0e00f0
+#define MCU_DIAG_SRAM_WIN9	0x090000
+#define MCU_DIAG_SRAM_WIN8	0x080000
+
+static u32
+mcu_wm_diag_word(const u8 *p)
+{
+	return (u32)p[0] | ((u32)p[1] << 8) |
+	       ((u32)p[2] << 16) | ((u32)p[3] << 24);
+}
+
+static void
+mcu_wm_diag_dump(struct mtk_hw_dev *dev, const char *tag, const u8 *ref)
+{
+	struct mtk_bus_trans *bt = dev->bus_trans;
+	int i;
+
+	dev_err(dev->dev, "diag[%s] lpctl(0x%x)=0x%08x\n", tag,
+		MCU_DIAG_LPCTL, bus_read(bt, MCU_DIAG_LPCTL));
+
+	for (i = 0; i < 8; i++) {
+		if (ref)
+			dev_err(dev->dev,
+				"diag[%s] +0x%02x exp=0x%08x w9=0x%08x w8=0x%08x\n",
+				tag, i * 4, mcu_wm_diag_word(ref + i * 4),
+				bus_read(bt, MCU_DIAG_SRAM_WIN9 + i * 4),
+				bus_read(bt, MCU_DIAG_SRAM_WIN8 + i * 4));
+		else
+			dev_err(dev->dev,
+				"diag[%s] +0x%02x w9=0x%08x w8=0x%08x\n",
+				tag, i * 4,
+				bus_read(bt, MCU_DIAG_SRAM_WIN9 + i * 4),
+				bus_read(bt, MCU_DIAG_SRAM_WIN8 + i * 4));
+	}
+}
+
 static int
 mcu_wm_load_patch(struct mtk_hw_dev *dev, struct mtk_mcu_entry *mcu_entry)
 {
@@ -332,6 +385,8 @@ mcu_wm_load_patch(struct mtk_hw_dev *dev, struct mtk_mcu_entry *mcu_entry)
 	dev_err(dev->dev, "HW/SW Version: 0x%x, Build Time: %.16s\n",
 		 be32_to_cpu(hdr->hw_sw_ver), hdr->build_date);
 
+	mcu_wm_diag_dump(dev, "pre", NULL);
+
 	n_region = be32_to_cpu(hdr->desc.n_region);
 	if (n_region > PACH_MAX_N_SECTION) {
 		dev_err(dev->dev, "n_region error\n");
@@ -376,8 +431,11 @@ mcu_wm_load_patch(struct mtk_hw_dev *dev, struct mtk_mcu_entry *mcu_entry)
 			dev_err(dev->dev, "Failed to send patch\n");
 			goto out;
 		}
+
+		mcu_wm_diag_dump(dev, "post", dl);
 	}
 
+	dev_err(dev->dev, "diag[start] issuing PATCH_FINISH_REQ\n");
 	ret = mcu_wm_start_patch(dev);
 	if (ret)
 		dev_err(dev->dev, "Failed to start patch\n");
