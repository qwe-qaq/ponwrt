From: chasey-dev <ellenyoung0912@gmail.com>
Subject: [PATCH] mt7993: put BAR0 and the WFDMA rings back after PATCH_FINISH_REQ

Reading the endpoint's config space live shows the whole story: PCI_COMMAND
is already 0x0000 at the first sample after 0x07 is fetched, so the chip
clears its own PCIe configuration the moment it accepts the patch.  The BARs
come back by hand and LPCTL then reads 0x00000004 - BIT(2), FW_OWN_STAT, the
value the vendor firmware leaves behind - so the MCU is alive and the patch
is running.  What stays dead is the WFDMA: the hardware write index is back
at zero while the software head/tail are still at 4/3, so the chip waits for
descriptor zero and never looks at the semaphore release that was just
queued.  That is the 20 s timeout, not a watchdog.

Do the recovery on the command path itself.  The first MCU command after 0x07
has to be answered, so pci_dma_tx_queue_skb_raw() checks PCI_COMMAND before
queueing anything on Q_TX_CMD_WM and, if the chip cleared the memory bit,
writes BAR0 and PCI_COMMAND back, drops every ring's head/tail to zero and
rebuilds base/count/cidx/didx through the normal queue init.  Only that one
queue is inspected, it carries firmware commands and never a data packet, and
a healthy device pays a single config read per command.

This has to live in the bus layer.  mtk_pci.ko already imports symbols from
mtk_hwifi.ko, so the MCU side calling back into the bus would make the two
modules depend on each other and modpost refuses to resolve it - an earlier
version of this patch failed exactly there.

With the rings back the semaphore release becomes the first command that has
to be answered, so the next boot either shows sem=3 and a firmware download
that continues into RAM code, or it shows the release timing out on a channel
that is genuinely dead.  The rebuilt-ring path also reports PCI_COMMAND, the
Linux irq number and msi_enabled after the restore, which tells us whether the
chip's MSI capability survived the wipe.

Signed-off-by: chasey-dev <ellenyoung0912@gmail.com>
---
--- a/wlan_hwifi/bus/mtk_pci_dma.c
+++ b/wlan_hwifi/bus/mtk_pci_dma.c
@@ -2468,6 +2468,71 @@
 	return true;
 }
 
+/*
+ * Bring-up diagnostic: the ROM clears its own PCIe configuration the moment
+ * it accepts PATCH_FINISH_REQ.  Nothing on the host side notices until the
+ * next command times out 20 s later, so check the MCU command queue and put
+ * the BARs and the WFDMA rings back before the next descriptor is queued.
+ *
+ * Only Q_TX_CMD_WM is inspected - it carries firmware commands and never a
+ * data packet - and the recovery only runs when PCI_COMMAND really lost its
+ * memory bit, so a healthy device pays a single config read per command.
+ */
+static bool
+pci_dma_diag_resync(struct pci_trans *trans)
+{
+	struct pci_dev *pdev = trans->pdev;
+	resource_size_t bar0 = pci_resource_start(pdev, 0);
+	u16 cmd_before = 0, cmd_after = 0;
+	int i;
+
+	pci_read_config_word(pdev, PCI_COMMAND, &cmd_before);
+	if (cmd_before & PCI_COMMAND_MEMORY)
+		return false;
+
+	pci_write_config_dword(pdev, PCI_BASE_ADDRESS_0, lower_32_bits(bar0));
+	pci_write_config_word(pdev, PCI_COMMAND,
+			      PCI_COMMAND_MEMORY | PCI_COMMAND_MASTER);
+
+	dev_err(to_device(trans),
+		"diag: PCI config was cleared (cmd=0x%04x), BAR0 back to 0x%llx\n",
+		cmd_before, (unsigned long long)bar0);
+
+	/*
+	 * The WFDMA went back to index zero together with the config space
+	 * while our head/tail are sitting in the middle of the ring, so the
+	 * chip would wait for descriptor zero and never look at anything we
+	 * queue.  Buffers keep their DMA addresses, only the ring bookkeeping
+	 * is rewritten.
+	 */
+	for (i = 0; i < trans->txq_num; i++) {
+		if (trans->txq[i].q.disable)
+			continue;
+
+		trans->txq[i].q.head = 0;
+		trans->txq[i].q.tail = 0;
+	}
+
+	for (i = 0; i < trans->rxq_num; i++) {
+		if (trans->rxq[i].q.disable)
+			continue;
+
+		trans->rxq[i].q.head = 0;
+		trans->rxq[i].q.tail = 0;
+	}
+
+	pci_chip_dma_init(trans);
+	pci_dma_hw_init_queues(trans);
+	pci_chip_dma_enable(trans);
+
+	pci_read_config_word(pdev, PCI_COMMAND, &cmd_after);
+	dev_err(to_device(trans),
+		"diag: rings rebuilt, cmd=0x%04x irq=%d msi_enabled=%d\n",
+		cmd_after, pdev->irq, pdev->msi_enabled);
+
+	return true;
+}
+
 static int
 pci_dma_tx_queue_skb_raw(struct pci_trans *trans, u8 qid,
 			  struct sk_buff *skb, u32 tx_info)
@@ -2476,6 +2541,9 @@
 	struct pci_queue_buf buf;
 	dma_addr_t addr;
 
+	if (q->q_attr == Q_TX_CMD_WM)
+		pci_dma_diag_resync(trans);
+
 	if (((q->head + 1) % q->q_size) == q->tail)
 		goto err;
 
--- a/wlan_hwifi/mcu/mcu_wm.c
+++ b/wlan_hwifi/mcu/mcu_wm.c
@@ -302,24 +302,6 @@
 	return false;
 }
 
-static void
-mcu_diag_restore_pci(struct mtk_hw_dev *dev)
-{
-	struct pci_dev *pdev = to_pci_dev(dev->dev);
-	resource_size_t bar0 = pci_resource_start(pdev, 0);
-
-	pci_write_config_dword(pdev, PCI_BASE_ADDRESS_0,
-			       lower_32_bits(bar0));
-	pci_write_config_word(pdev, PCI_COMMAND,
-			      PCI_COMMAND_MEMORY | PCI_COMMAND_MASTER);
-
-	dev_err(dev->dev,
-		"diag: BAR0 back to 0x%llx, lpctl=0x%08x on_misc=0x%08x\n",
-		(unsigned long long)bar0,
-		bus_read(dev->bus_trans, DIAG48_LPCTL_ADDR),
-		bus_read(dev->bus_trans, DIAG48_ON_MISC_ADDR));
-}
-
 static int
 mcu_wm_start_patch(struct mtk_hw_dev *dev)
 {
@@ -347,8 +329,8 @@
 		return -EIO;
 	}
 
-	if (diag_jump_trace && mcu_diag_jump_trace(dev))
-		mcu_diag_restore_pci(dev);
+	if (diag_jump_trace)
+		mcu_diag_jump_trace(dev);
 
 	return 0;
 }
