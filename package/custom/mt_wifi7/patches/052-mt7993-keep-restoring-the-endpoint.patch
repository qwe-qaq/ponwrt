 /*
- * Bring-up diagnostic: the ROM clears its own PCIe configuration the moment
- * it accepts PATCH_FINISH_REQ.  Nothing on the host side notices until the
- * next command times out 20 s later, so check the MCU command queue and put
- * the BARs and the WFDMA rings back before the next descriptor is queued.
+ * Bring-up diagnostic: the endpoint drops its own PCIe configuration the
+ * moment the ROM accepts PATCH_FINISH_REQ, and it keeps re-initialising its
+ * core for a while after that.  A single restore written into that window is
+ * lost: PCI_COMMAND reads back as if the write stuck, but the memory window
+ * stays shut and every MMIO read falls through to DRAM.  The values look like
+ * data, change on every access, and quietly poison everything downstream -
+ * the ownership handshake "succeeds", the rings read back plausibly, and a
+ * command queue that nobody serves looks exactly like firmware that refuses
+ * to answer.
  *
- * Only Q_TX_CMD_WM is inspected - it carries firmware commands and never a
- * data packet - and the recovery only runs when PCI_COMMAND really lost its
- * memory bit, so a healthy device pays a single config read per command.
+ * So restore in a loop, and only believe it once the chip answers like a
+ * chip: LPCTL carries nothing but the ownership handshake, and a ring base
+ * register has to hand back the address that was just programmed into it.
  */
 static bool
+pci_dma_diag_cfg_alive(struct pci_trans *trans)
+{
+	struct mtk_bus_trans *btrans = to_bus_trans(trans);
+	u32 lpctl = bus_read(btrans, trans->lp_fw_own_reg_addr);
+
+	return !(lpctl & ~0x7u);
+}
+
+static bool
+pci_dma_diag_ring_live(struct pci_trans *trans, struct pci_queue *q)
+{
+	struct mtk_bus_trans *btrans = to_bus_trans(trans);
+	u32 want = SET_FIELD(BASE_PTR, q->cb[0].alloc_pa);
+	u32 cnt = bus_read(btrans, q->hw_cnt_addr);
+
+	return bus_read(btrans, q->hw_desc_base) == want &&
+	       (cnt & 0xffff) == q->q_size;
+}
+
+static int
+pci_dma_diag_restore_cfg(struct pci_trans *trans, resource_size_t bar0)
+{
+	struct pci_dev *pdev = trans->pdev;
+	u16 cmd = 0;
+	int i, good = 0;
+
+	for (i = 0; i < 200; i++) {
+		pci_write_config_dword(pdev, PCI_BASE_ADDRESS_0,
+				       lower_32_bits(bar0));
+		pci_write_config_word(pdev, PCI_COMMAND,
+				      PCI_COMMAND_MEMORY | PCI_COMMAND_MASTER);
+
+		/*
+		 * The reset the endpoint went through is still draining when
+		 * the patch hands the chip back, so leave a gap between
+		 * attempts instead of hammering the config space.
+		 */
+		msleep(10);
+
+		pci_read_config_word(pdev, PCI_COMMAND, &cmd);
+		if ((cmd & (PCI_COMMAND_MEMORY | PCI_COMMAND_MASTER)) !=
+		    (PCI_COMMAND_MEMORY | PCI_COMMAND_MASTER)) {
+			good = 0;
+			continue;
+		}
+
+		if (!pci_dma_diag_cfg_alive(trans)) {
+			good = 0;
+			continue;
+		}
+
+		/* Three answers in a row: the window is really back. */
+		if (++good >= 3)
+			return i + 1;
+	}
+
+	return -ETIMEDOUT;
+}
+
+static bool
 pci_dma_diag_resync(struct pci_trans *trans, struct pci_queue *q)
 {
 	struct mtk_bus_trans *btrans = to_bus_trans(trans);
@@ -2517,159 +2582,148 @@
