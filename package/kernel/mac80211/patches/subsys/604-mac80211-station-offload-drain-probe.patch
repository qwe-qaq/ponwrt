Subject: [PATCH] r60 wire keys, ordered PS handoff and ingress proof

--- a/include/net/mac80211.h
+++ b/include/net/mac80211.h
@@ -7914,6 +7914,16 @@
 				struct ieee80211_txq *txq);
 
 /**
+ * ieee80211_sta_tx_pending - conservative software/airtime drain probe
+ * @sta: live station, protected by the caller's station lifetime lock
+ *
+ * Caller must stop its TX dequeue worker first and retain its external
+ * offload admission fence. This can sleep; it does not close admission or
+ * replace driver DMA/completion accounting. True means remain in software.
+ */
+bool ieee80211_sta_tx_pending(struct ieee80211_sta *sta);
+
+/**
  * ieee80211_txq_get_depth - get pending frame/byte count of given txq
  *
  * The values are not guaranteed to be coherent with regard to each other, i.e.
--- a/net/mac80211/tx.c
+++ b/net/mac80211/tx.c
@@ -28,6 +28,7 @@
 #include <net/fq_impl.h>
 #include <net/sock.h>
 #include <net/gso.h>
+#include <net/sch_generic.h>
 
 #include "ieee80211_i.h"
 #include "driver-ops.h"
@@ -6661,3 +6662,49 @@
 
 	return 0;
 }
+
+/* Used only at an offload wake boundary, not on the packet path. Stop the
+ * tasklet and drain pre-existing net/RCU readers before looking for backlog,
+ * so a packet cannot disappear between mac80211 and the stopped driver. */
+bool ieee80211_sta_tx_pending(struct ieee80211_sta *pub)
+{
+ struct sta_info *sta=container_of(pub,struct sta_info,sta);
+ struct ieee80211_local *local=sta->sdata->local;
+ bool pending=false;
+ int i;
+ tasklet_disable(&local->tx_pending_tasklet);
+ synchronize_net();
+ spin_lock_bh(&sta->ps_lock);
+ pending=test_sta_flag(sta,WLAN_STA_PS_STA) ||
+         test_sta_flag(sta,WLAN_STA_PS_DRIVER) ||
+         test_sta_flag(sta,WLAN_STA_PS_DELIVER);
+ for (i=0;i<IEEE80211_NUM_ACS;i++)
+  pending |= !skb_queue_empty(&sta->ps_tx_buf[i]) ||
+             !skb_queue_empty(&sta->tx_filtered[i]) ||
+             atomic_read(&sta->airtime[i].aql_tx_pending);
+ spin_unlock_bh(&sta->ps_lock);
+ spin_lock_bh(&local->fq.lock);
+ for (i=0;i<IEEE80211_NUM_TIDS+1;i++) {
+  struct ieee80211_txq *q=pub->txq[i];
+  struct txq_info *qi;
+  if (!q) continue;
+  qi=to_txq_info(q);
+  pending |= qi->tin.backlog_packets || !skb_queue_empty(&qi->frags);
+ }
+ spin_unlock_bh(&local->fq.lock);
+ /* Pending tasklet queues are shared: be conservative about other STAs. */
+ for (i=0;i<local->hw.queues;i++)
+  pending |= !skb_queue_empty(&local->pending[i]);
+ /* dev_queue_xmit may still own a fallback frame in the VIF qdisc.
+  * An empty mac80211 TXQ alone is not proof of that handoff draining. */
+ rcu_read_lock();
+ smp_mb();
+ for (i=0;i<sta->sdata->dev->real_num_tx_queues;i++) {
+  struct Qdisc *q=rcu_dereference(netdev_get_tx_queue(sta->sdata->dev,i)->qdisc);
+  if (q) pending |= !qdisc_is_empty(q) || qdisc_is_running(q);
+ }
+ rcu_read_unlock();
+ tasklet_enable(&local->tx_pending_tasklet);
+ return pending;
+}
+EXPORT_SYMBOL(ieee80211_sta_tx_pending);
