+/* Only exceptional frees touch this ring. The normal enqueue/dequeue path
+ * has no new clock read, header parse or printk. All callers hold fq.lock. */
+static void ieee80211_queue_loss_record(struct ieee80211_local *local,
+                                      struct txq_info *txqi,
+                                      struct sk_buff *skb, u8 reason)
+{
+ struct ieee80211_queue_loss *q = &local->queue_loss;
+ struct ieee80211_queue_loss_event *e;
+ struct iphdr ip;
+ struct tcphdr tcp;
+ int off = skb_network_offset(skb);
+
+ lockdep_assert_held(&local->fq.lock);
+ e = &q->events[q->serial % IEEE80211_QUEUE_LOSS_ENTRIES];
+ memset(e, 0, sizeof(*e));
+ e->serial = ++q->serial;
+ e->ns = ktime_get_ns();
+ e->reason = reason;
+ if (reason == 1) q->capacity++;
+ else if (reason == 2) q->codel++;
+ else q->purge++;
+ e->len = skb->len;
+ e->backlog = local->fq.backlog;
+ e->memory = local->fq.memory_usage;
+ e->tid = txqi->txq.tid;
+ if (txqi->txq.sta) ether_addr_copy(e->sta, txqi->txq.sta->addr);
+ e->frag_list = skb_has_frag_list(skb);
+ /* IPv4 TCP header identity only. Aggregates describe their head only;
+  * short/non-IP/fragmented/invalid headers keep tcp_valid=0. */
+ if (skb->protocol != htons(ETH_P_IP) || off < 0 ||
+     off > skb->len || skb->len - off < sizeof(ip) ||
+     skb_copy_bits(skb, off, &ip, sizeof(ip)) ||
+     ip.version != 4 || ip.ihl < 5 || ip.protocol != IPPROTO_TCP ||
+     (ntohs(ip.frag_off) & 0x3fff) ||
+     ntohs(ip.tot_len) < ip.ihl * 4 + sizeof(tcp) ||
+     ntohs(ip.tot_len) > skb->len - off)
+  return;
+ off += ip.ihl * 4;
+ if (skb_copy_bits(skb, off, &tcp, sizeof(tcp)) || tcp.doff < 5 ||
+     ip.ihl * 4 + tcp.doff * 4 > ntohs(ip.tot_len))
+  return;
+ e->src = ip.saddr; e->dst = ip.daddr;
+ e->sport = tcp.source; e->dport = tcp.dest;
+ e->seq = ntohl(tcp.seq); e->ack = ntohl(tcp.ack_seq);
+ e->tcp_valid = 1;
+}
+
 static void codel_drop_func(struct sk_buff *skb,
 			    void *ctx)
 {
@@ -1399,6 +1448,7 @@
 	local = vif_to_sdata(txqi->txq.vif)->local;
 	hw = &local->hw;
 
