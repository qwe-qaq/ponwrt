+/* Snapshot once per open, under fq.lock; formatting runs outside the lock. */
+static int queue_loss_show(struct seq_file *m, void *unused)
+{
+ struct ieee80211_queue_loss *q = m->private;
+ u64 first = q->serial > IEEE80211_QUEUE_LOSS_ENTRIES ?
+             q->serial - IEEE80211_QUEUE_LOSS_ENTRIES : 0;
+ u64 i;
+ seq_printf(m, "queue_loss_ring first=%llu last=%llu overwritten=%llu capacity=%u fq_capacity=%llu codel=%llu purge=%llu\n",
+            q->serial ? first + 1 : 0, q->serial, first,
+            IEEE80211_QUEUE_LOSS_ENTRIES, q->capacity, q->codel, q->purge);
+ for (i = first; i < q->serial; i++) {
+  const struct ieee80211_queue_loss_event *e = &q->events[i % IEEE80211_QUEUE_LOSS_ENTRIES];
+  seq_printf(m, "queue_loss serial=%llu ns=%llu reason=%u sta=%pM tid=%u len=%u backlog=%u memory=%u tcp_valid=%u src=%pI4 sport=%u dst=%pI4 dport=%u seq=%u ack=%u frag_list=%u\n",
+             e->serial, e->ns, e->reason, e->sta, e->tid, e->len,
+             e->backlog, e->memory, e->tcp_valid, &e->src, ntohs(e->sport),
+             &e->dst, ntohs(e->dport), e->seq, e->ack, e->frag_list);
+ }
+ seq_puts(m, "scope=FQ_only reason1=capacity reason2=CoDel reason3=purge tuple=head_only no_delivery_proof\n");
+ return 0;
+}
+static int queue_loss_open(struct inode *inode, struct file *file)
+{
+ struct ieee80211_local *local = inode->i_private;
+ struct ieee80211_queue_loss *q = kvzalloc(sizeof(*q), GFP_KERNEL);
+ int ret;
+ if (!q) return -ENOMEM;
+ spin_lock_bh(&local->fq.lock);
+ *q = local->queue_loss;
+ spin_unlock_bh(&local->fq.lock);
+ ret = single_open(file, queue_loss_show, q);
+ if (ret) kvfree(q);
+ return ret;
+}
+static int queue_loss_release(struct inode *inode, struct file *file)
+{
+ struct seq_file *m = file->private_data;
+ kvfree(m->private);
+ return single_release(inode, file);
+}
+static const struct file_operations queue_loss_ops = {
+ .open = queue_loss_open,
+ .read = seq_read,
+ .llseek = seq_lseek,
+ .release = queue_loss_release,
+};
 
