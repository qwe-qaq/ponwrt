+ /* A short peer inactivity timeout must not race a coarse driver worker.
+  * Query actual offloaded TX at expiry as well. The driver may not sleep. */
+ if (!test_bit(HT_AGG_STATE_WANT_STOP, &tid_tx->state) &&
+     sta->local->ops->sta_tx_activity &&
+     sta->local->ops->sta_tx_activity(&sta->local->hw, &sta->sta, tid))
+  WRITE_ONCE(tid_tx->last_tx, jiffies);
 	timeout = tid_tx->last_tx + TU_TO_JIFFIES(tid_tx->timeout);
 	if (time_is_after_jiffies(timeout)) {
 		mod_timer(&tid_tx->session_timer, timeout);
 		return;
 	}
 
+ if (sta->local->ops->sta_tx_agg_event)
+  sta->local->ops->sta_tx_agg_event(&sta->local->hw, &sta->sta, tid, 3, 0, tid_tx->timeout);
 	ht_dbg(sta->sdata, "tx session timer expired on %pM tid %d\n",
 	       sta->sta.addr, tid);
 
