+/* No copy/allocation and no socket-owned, shared or nonlinear rewrite.
+ * __pskb_pull_tail can leave fragment charges on an already linear skb;
+ * the core helper normalizes only actual head allocation accounting. */
+static u32 ieee80211_txq_condense(struct sk_buff *skb)
+{
+ u32 before = skb->truesize;
+ if (!skb->sk && !skb->destructor && !skb_shared(skb) && !skb_cloned(skb) &&
+     !skb_is_nonlinear(skb) && !skb_is_gso(skb) && !skb_has_frag_list(skb) &&
+     before > SKB_TRUESIZE(skb_end_offset(skb)))
+  skb_condense(skb);
+ return before - skb->truesize;
+}
