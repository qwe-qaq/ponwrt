From: ponwrt maintainers
Subject: [PATCH] r79 safe Kite forwarded skb accounting copy

--- a/include/net/mac80211.h
+++ b/include/net/mac80211.h
@@ -3192,7 +3192,7 @@
  *	within &struct ieee80211_sta.
  * @chanctx_data_size: size (in bytes) of the drv_priv data area
  *	within &struct ieee80211_chanctx_conf.
- * @txq_condense: normalize unowned linear forwarded skb accounting before FQ
+ * @txq_condense: normalize/copy oversized unowned linear forwarded skbs before FQ
  * @txq_data_size: size (in bytes) of the drv_priv data area
  *	within @struct ieee80211_txq.
  *
--- a/net/mac80211/debugfs.c
+++ b/net/mac80211/debugfs.c
@@ -91,6 +91,7 @@
              &e->dst, ntohs(e->dport), e->seq, e->ack, e->frag_list, e->truesize, e->headlen, e->headroom, e->headsize, e->data_len, e->nr_frags, e->gso_size, e->gso_segs);
  }
  seq_printf(m,"queue_condense packets=%llu bytes=%llu\n",q->condensed,q->condensed_bytes);
+ seq_printf(m,"queue_copy packets=%llu bytes=%llu failed_kept=%llu\n",q->copied,q->copy_bytes,q->copy_failed);
  first=q->burst_serial>IEEE80211_QUEUE_BURSTS?q->burst_serial-IEEE80211_QUEUE_BURSTS:0;
  seq_printf(m,"queue_burst_ring first=%llu last=%llu overwritten=%llu capacity=%u\n",q->burst_serial?first+1:0,q->burst_serial,first,IEEE80211_QUEUE_BURSTS);
  for (i=first;i<q->burst_serial;i++) {
--- a/net/mac80211/ieee80211_i.h
+++ b/net/mac80211/ieee80211_i.h
@@ -1467,6 +1467,7 @@
 struct ieee80211_queue_loss {
  u64 serial, capacity, codel, purge, burst_serial;
  u64 condensed, condensed_bytes;
+ u64 copied, copy_failed, copy_bytes;
  struct ieee80211_queue_burst bursts[IEEE80211_QUEUE_BURSTS];
