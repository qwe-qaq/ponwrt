 };
--- a/net/mac80211/tx.c
+++ b/net/mac80211/tx.c
@@ -1532,17 +1532,38 @@
 	ieee80211_free_txskb(&local->hw, skb);
 }
 
-/* No copy/allocation and no socket-owned, shared or nonlinear rewrite.
- * __pskb_pull_tail can leave fragment charges on an already linear skb;
- * the core helper normalizes only actual head allocation accounting. */
+/* Normalize only driver-opted-in, unowned linear forwarded frames. */
 static u32 ieee80211_txq_condense(struct sk_buff *skb)
 {
- u32 before = skb->truesize;
+ u32 before=skb->truesize;
  if (!skb->sk && !skb->destructor && !skb_shared(skb) && !skb_cloned(skb) &&
      !skb_is_nonlinear(skb) && !skb_is_gso(skb) && !skb_has_frag_list(skb) &&
-     before > SKB_TRUESIZE(skb_end_offset(skb)))
-  skb_condense(skb);
- return before - skb->truesize;
+     before>SKB_TRUESIZE(skb_end_offset(skb))) skb_condense(skb);
+ return before-skb->truesize;
+}
+/* Run before FQ takes ownership. Preserve ALL headroom/header offsets and
+ * 64 bytes tailroom for encryption/padding. Core skb_copy_expand copies cb,
+ * device, priority, checksum, VLAN, mark, hash, timestamps, extensions and
+ * dst references. Never modify or free the original on allocation failure. */
+static struct sk_buff *ieee80211_txq_copy_forwarded(struct sk_buff *skb,
+                                                  bool *failed)
+{
+ struct sk_buff *copy;
+ unsigned int head=skb_headroom(skb);
+ if (!skb->skb_iif || skb->sk || skb->destructor || skb_shared(skb) ||
+     skb_cloned(skb) || skb_is_nonlinear(skb) || skb_is_gso(skb) ||
+     skb_has_frag_list(skb) || skb_shinfo(skb)->nr_frags ||
+     skb_shinfo(skb)->tx_flags || skb_shinfo(skb)->destructor_arg ||
+     skb->len>2048 || head>512 || skb->truesize<8192 ||
+     skb->truesize<4*SKB_TRUESIZE(head+skb->len+64)) return skb;
+ copy=skb_copy_expand(skb,head,64,GFP_ATOMIC);
+ if (!copy) { *failed=true; return skb; }
+ skb_copy_queue_mapping(copy,skb);
+ copy->next=skb->next;
+ /* A forward segment list uses next only. It has not entered a queue yet. */
+ skb->next=NULL;
+ consume_skb(skb);
+ return copy;
 }
 
 static void ieee80211_txq_enqueue(struct ieee80211_local *local,
@@ -1551,20 +1572,35 @@
 {
 	struct fq *fq = &local->fq;
 	struct fq_tin *tin = &txqi->tin;
-	u32 flow_idx, condensed = 0;
+	u32 flow_idx, condensed = 0, copied=0, copy_failed=0;
+ u64 copy_bytes=0;
 	u64 saved = 0;
 	struct sk_buff *segment;
 
-	if (local->hw.txq_condense)
-		for (segment = skb; segment; segment = segment->next) {
-			u32 bytes = ieee80211_txq_condense(segment);
-			condensed += !!bytes; saved += bytes;
-		}
+ if (local->hw.txq_condense) {
+  struct sk_buff **link=&skb;
+  while (*link) {
+   u32 before=(*link)->truesize;
+   bool failed=false;
+   segment=*link;
+   if (txqi->txq.sta && txqi->txq.tid<IEEE80211_NUM_TIDS) {
+    segment=ieee80211_txq_copy_forwarded(segment,&failed);
+    copy_failed+=failed;
+    if (segment!=*link) {copied++;copy_bytes+=before-segment->truesize;}
+    *link=segment;
+   }
+   u32 bytes=ieee80211_txq_condense(segment);
+   condensed+=!!bytes;saved+=bytes;
+   link=&segment->next;
+  }
+ }
 	ieee80211_set_skb_enqueue_time(skb);
 
 	spin_lock_bh(&fq->lock);
 	local->queue_loss.condensed += condensed;
 	local->queue_loss.condensed_bytes += saved;
+ local->queue_loss.copied+=copied;local->queue_loss.copy_failed+=copy_failed;
+ local->queue_loss.copy_bytes+=copy_bytes;
 	/*
 	 * For management frames, don't really apply codel etc.,
 	 * we don't want to apply any shaping or anything we just
