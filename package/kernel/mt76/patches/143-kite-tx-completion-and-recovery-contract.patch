--- a/mt7915/npu-control.c
+++ b/mt7915/npu-control.c
@@ -907,6 +907,41 @@
 	mutex_unlock(&dev->kite.lock);
 	return ret;
 }
+struct mt7915_dp_pending {
+	u32 wifi, quarantine, dma_wait, wa_wait, ready;
+};
+
+/* Concurrent snapshot, not a drain proof. The fence independently observes
+ * ownership; individual tokens may advance while these counts are read. */
+static struct mt7915_dp_pending
+mt7915_dp_pending(struct mt7915_dev *dev, int band)
+{
+	struct mt7915_dp_pending p = {};
+	struct kdp_shared *s = READ_ONCE(dev->mt76.kite_dp);
+	unsigned int i;
+
+	if (!s || !dev->kite.dp_bound)
+		return p;
+	dma_rmb();
+	for (i = 0; i < KDP_TOKENS; i++) {
+		struct kdp_token *t = &s->token[i];
+		u32 state = READ_ONCE(t->state), seq;
+
+		if (band >= 0 && READ_ONCE(t->band) != band)
+			continue;
+		p.quarantine += state == KDP_TOKEN_QUARANTINE;
+		if (state != KDP_TOKEN_WIFI)
+			continue;
+		p.wifi++;
+		seq = READ_ONCE(t->submitted);
+		p.dma_wait += !seq || READ_ONCE(t->dma_done) != seq;
+		p.wa_wait += !seq || READ_ONCE(t->wa_done) != seq;
+		p.ready += seq && READ_ONCE(t->dma_done) == seq &&
+			   READ_ONCE(t->wa_done) == seq;
+	}
+	return p;
+}
+
 /* Drain before replacing keys/revoking a port/reusing a WCID. This waits
  * for WA token completion, not just descriptor consumption. Keep NAPI/WA
  * running. Frames arriving after the admission gate fail back to mac80211
@@ -917,6 +952,7 @@
 	unsigned long until = jiffies + msecs_to_jiffies(3000);
 	int b;
 	unsigned int i;
+	struct mt7915_dp_pending pending;
