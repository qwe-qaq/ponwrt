 		return 0;
 	if (dev->kite.dp_bound) {
@@ -951,9 +987,11 @@
 		usleep_range(1000, 2000);
 	} while (time_before(jiffies, until));
 fault:
+	pending = mt7915_dp_pending(dev, -1);
 	dev_err(dev->mt76.dev,
-		"Kite TX security fence failed: outstanding=%u; queues held for full recovery\n",
-		READ_ONCE(dev->mt76.token_count));
+		"Kite TX security fence failed: host=%u DP=%u dma_wait=%u wa_wait=%u ready=%u quarantine=%u; queues held for full recovery\n",
+		READ_ONCE(dev->mt76.token_count), pending.wifi, pending.dma_wait,
+		pending.wa_wait, pending.ready, pending.quarantine);
 	dev->kite.tx_reset_requested = true;
 	dev->recovery.state |= MT_MCU_CMD_WDT_MASK;
 	mt7915_reset(dev);
@@ -993,7 +1031,15 @@
 		reaped = kite_tx_read(&s->reaped);
 		progress = reaped + READ_ONCE(q->kite_wa_freed);
 		if (dp) {
-			progress += READ_ONCE(dp->tx_freed[b]);
+			u32 freed = READ_ONCE(dp->tx_freed[b]);
+
+			/* Host beacons/control completions must not hide stuck PPE
+			 * payloads (boot.log: host advanced, 11 DP tokens did not). */
+			if (freed != dev->kite.dp_last_freed[b] ||
+			    READ_ONCE(dp->tx_sent[b]) == freed) {
+				dev->kite.dp_progress_at[b] = jiffies;
+				dev->kite.dp_last_freed[b] = freed;
+			}
 			dp_pending = READ_ONCE(dp->tx_sent[b]) - READ_ONCE(dp->tx_freed[b]);
 			if (report)
 				dev_info(dev->mt76.dev,
@@ -1003,7 +1049,7 @@
 					 dp->tx_sent[b], dp->tx_freed[b], dp->tx_drop[b], dp_pending, dp->tx_bad_done);
 		}
 		if (progress != q->kite_last_progress ||
-		    (!READ_ONCE(q->queued) && !READ_ONCE(q->kite_pending) && !dp_pending)) {
+		    (!READ_ONCE(q->queued) && !READ_ONCE(q->kite_pending))) {
 			q->kite_progress_at = jiffies;
 			q->kite_last_progress = progress;
 		}
@@ -1022,7 +1068,15 @@
 				kite_tx_read(&s->fault),
 				READ_ONCE(dev->mt76.token_count));
 		if (kite_tx_read(&s->fault) || (dp && kdp_failed(dp)) ||
-		    time_after(jiffies, q->kite_progress_at + 15 * HZ)) {
+		    time_after(jiffies, q->kite_progress_at + 15 * HZ) ||
+		    (dp_pending && time_after(jiffies, dev->kite.dp_progress_at[b] + 15 * HZ))) {
+			struct mt7915_dp_pending pending = mt7915_dp_pending(dev, b);
+
+			dev_err(dev->mt76.dev,
+				"Kite DP band%d stalled: pending=%u dma_wait=%u wa_wait=%u ready=%u quarantine=%u hw_submitted=%u hw_reaped=%u\n",
+				b, pending.wifi, pending.dma_wait, pending.wa_wait,
+				pending.ready, pending.quarantine,
+				kite_tx_read(&s->ppe_submitted), kite_tx_read(&s->ppe_reaped));
 			mt7915_kite_tx_gate(dev, true);
 			dev->kite.tx_reset_requested = true;
 			dev_err(dev->mt76.dev,
@@ -1113,7 +1167,8 @@
 	struct kdp_shared *s = READ_ONCE(dev->mt76.kite_dp);
 	unsigned int b, i, sta = 0, flows = 0, wifi = 0, tdma = 0, quarantine = 0;
 
-	seq_printf(m, "abi=2 negotiated=%u bound=%u attached=%u changing=%u\n",
+	seq_printf(m, "abi=%u negotiated=%u bound=%u attached=%u changing=%u\n",
+		KDP_ABI_VERSION,
 		dev->kite.datapath, dev->kite.dp_bound, dev->kite.dp_attached,
 		dev->kite.dp_changing);
 	seq_printf(m, "rx_fence_stage=%u pauses=%u resumes=%u failures=%u held=%u key_pending=%u pse_empty=%08x query=%08x count=%u\n",
@@ -1160,6 +1215,19 @@
 			s->rx_free[b], s->rx_replay[b], s->rx_stale[b], s->rx_unsupported[b],
 			s->tx_sent[b], s->stats[b].tx_bytes, s->tx_freed[b], s->tx_drop[b],
 			s->stats[b].tx_stale, s->stats[b].tx_full, s->tx_aborted[b]);
+	seq_printf(m, "host_token_limit=%u dp_token_first=%u dp_token_limit=%u reserved=%u change_error=%d\n",
+		dev->mt76.token_size, KDP_TOKEN_BASE, KDP_TOKEN_LIMIT,
+		dev->kite.dp_tokens_reserved, dev->kite.dp_change_error);
+	for (b = 0; b < 2; b++) {
+		struct mt7915_dp_pending pending = mt7915_dp_pending(dev, b);
+		struct mt76_queue *q = dev->kite.txq[b];
+		struct kite_tx_shared *tx = q ? q->kite_tx : NULL;
+
+		seq_printf(m, "completion_band%u pending=%u dma_wait=%u wa_wait=%u ready=%u quarantine=%u hw_submitted=%u hw_reaped=%u\n",
+			b, pending.wifi, pending.dma_wait, pending.wa_wait, pending.ready,
+			pending.quarantine, tx ? kite_tx_read(&tx->ppe_submitted) : 0,
+			tx ? kite_tx_read(&tx->ppe_reaped) : 0);
+	}
 	seq_puts(m, "rx_ppe=TDMA submission; rx_free_only=buffer return, not delivery proof; tx_freed=DMA+WA completion, not peer ACK; counters wrap at 32 bits\n");
 	return 0;
 }
@@ -1179,7 +1247,7 @@
 {
