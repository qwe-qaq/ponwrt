 }
 
-/* MT7916 WA returns a 15-bit token. This reserved range is disjoint from
- * mt76's 8192 skb tokens and 0x7fff sentinel. Consuming the message does not
+/* A 15-bit WA event field does not establish a 32768-entry token table.
+ * Native MT7916 supports 8192 tokens; reserve the upper 1024 for PPE and
+ * allocate host SKBs only from the lower 7168. Without that reservation,
+ * these IDs still belong to ordinary mt76 (including non-NPU devices). Consuming the message does not
  * free the buffer: hart4 additionally requires the actual WFDMA completion.
  * dp_done_lock serializes WA parsers across MCU queues. */
 bool mt7915_npu_dp_tx_free(struct mt7915_dev *dev, u16 token)
@@ -1268,7 +1343,8 @@
 	u32 seq;
 	unsigned long flags;
 
-	if (token < KDP_TOKEN_BASE || token >= KDP_TOKEN_BASE + KDP_TOKENS)
+	if (!dev->kite.dp_tokens_reserved ||
+	    token < KDP_TOKEN_BASE || token >= KDP_TOKEN_LIMIT)
 		return false;
 	s = READ_ONCE(dev->mt76.kite_dp);
 	if (!s || !READ_ONCE(dev->kite.dp_bound)) {
--- a/mt7915/npu-datapath.inc
+++ b/mt7915/npu-datapath.inc
@@ -62,7 +62,13 @@
 	if (!ret)
 		ret = mt7915_npu_tx_fence(dev);
 	if (ret) {
-		WRITE_ONCE(dev->mt76.kite_dp->fault, 11);
+		/* A host fence error is not an NPU identity/ownership fault.
+		 * Keep the original firmware fault and the closed admission;
+		 * full recovery must still prove PARK and physical DMA stop. */
+		dev->kite.dp_change_error = ret;
+		dev->kite.tx_reset_requested = true;
+		dev->recovery.state |= MT_MCU_CMD_WDT_MASK;
+		mt7915_reset(dev);
 		return ret;
 	}
 	return 0;
--- a/mt7915/npu.c
+++ b/mt7915/npu.c
@@ -173,6 +173,13 @@
 			mt76_npu_deinit(&dev->mt76);
 			return ret;
 		}
+		/* Reserve before DMA/MCU initialization; changing this with live
+		 * host tokens would alias a WA completion to the wrong owner. */
+		BUILD_BUG_ON(KDP_TOKEN_LIMIT != MT7915_TOKEN_SIZE);
+		if (npu_tx) {
+			dev->mt76.token_size = KDP_TOKEN_BASE;
+			dev->kite.dp_tokens_reserved = true;
+		}
 		dev_info(dev->mt76.dev,
 			 "Kite data-development mode enabled (port type %u); stop/drain ABI active\n",
