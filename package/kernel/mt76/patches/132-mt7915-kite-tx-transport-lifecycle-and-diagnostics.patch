+	if (!dev->npu_dma_allocations.next || dev->npu_quarantine)
+		return;
+	list_for_each_entry_safe(a, tmp, &dev->npu_dma_allocations, list) {
+		dma_free_coherent(dev->dma_dev, a->bytes, a->ptr, a->pa);
+		list_del(&a->list);
+		kfree(a);
