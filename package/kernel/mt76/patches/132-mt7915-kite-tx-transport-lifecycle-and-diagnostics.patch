+void *mt76_npu_alloc_coherent(struct mt76_dev *dev, size_t size, dma_addr_t *pa)
+{
+	struct mt76_npu_dma_allocation *a;
+	a = kzalloc(sizeof(*a), GFP_KERNEL);
+	if (!a)
+		return NULL;
+	a->ptr = dma_alloc_coherent(dev->dma_dev, size, &a->pa, GFP_KERNEL);
+	if (!a->ptr) {
+		kfree(a);
+		return NULL;
+	}
