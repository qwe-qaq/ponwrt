+/* TX memory is coherent for ARM/WFDMA; NPU uses the uncached DDR alias.
+ * The control mutex serializes bind/park/unbind, not normal queue traffic.
+ * q->lock serializes the host producer with its admission gate.
+ */
+static u32 kite_tx_read(const unsigned int *p)
+{
+	return le32_to_cpu((__force __le32)READ_ONCE(*p));
+}
+static void mt7915_kite_tx_gate(struct mt7915_dev *dev, bool stop)
+{
+	int b;
+	for (b = 0; b < 2; b++) {
+		struct mt76_queue *q = dev->kite.txq[b];
+		if (!q || !q->kite_tx)
+			continue;
+		spin_lock_bh(&q->lock);
+		q->kite_tx_blocked = stop;
+		spin_unlock_bh(&q->lock);
+	}
+	if (!stop)
+		mt76_worker_schedule(&dev->mt76.tx_worker);
+}
+int mt7915_npu_tx_bind(struct mt7915_dev *dev)
+{
+	int b, ret = 0;
+	if (!dev->kite.tx_enabled)
+		return 0;
+	mutex_lock(&dev->kite.lock);
+	for (b = 0; b < (dev->dbdc_support ? 2 : 1); b++) {
+		struct mt76_queue *q = dev->kite.txq[b];
+		struct kite_tx_shared *s;
+		u64 reg = dev->pcie_bar0 + MT_TXQ_RING_BASE(b) +
+			  MT_TXQ_ID(b) * 16;
+		u32 args[5];
+		if (!q || q->ndesc != KITE_TX_COUNT || q->queued || q->head ||
+		    q->tail ||
+		    !kite_tx_range(q->desc_dma, q->ndesc * sizeof(*q->desc)) ||
+		    upper_32_bits(reg) ||
+		    mtk_wed_device_active(&dev->mt76.mmio.wed)) {
+			ret = -EINVAL;
+			break;
+		}
+		if (!q->kite_tx) {
+			q->kite_tx = mt76_npu_alloc_coherent(
+				&dev->mt76, KITE_TX_BYTES, &q->kite_tx_dma);
+			if (!q->kite_tx) {
+				ret = -ENOMEM;
+				break;
+			}
+		}
+		if (!kite_tx_range(q->kite_tx_dma, KITE_TX_BYTES) ||
+		    (q->kite_tx_dma & 63)) {
+			ret = -ERANGE;
+			break;
+		}
+		s = q->kite_tx;
+		memset(s, 0, KITE_TX_BYTES);
+		s->magic = (__force u32)cpu_to_le32(KITE_TX_MAGIC);
+		s->session = (__force u32)cpu_to_le32(dev->kite.session);
+		s->epoch = (__force u32)cpu_to_le32(dev->kite.serial + 1);
+		s->count = (__force u32)cpu_to_le32(KITE_TX_COUNT);
+		dma_wmb();
+		args[0] = b;
+		args[1] = q->kite_tx_dma;
+		args[2] = q->desc_dma;
+		args[3] = reg;
+		args[4] = KITE_TX_COUNT;
+		/* From this call onward even a timeout may have installed the writer. */
+		dev->kite.tx_bound = true;
+		ret = mt7915_kite_command(dev, KITE_CTL_TX_BIND, args,
+					  ARRAY_SIZE(args));
+		if (ret)
+			break;
+		q->kite_tx_active = true;
+		q->kite_tx_blocked = false;
+		q->kite_progress_at = jiffies;
+		q->kite_last_progress = READ_ONCE(q->kite_wa_freed);
+		q->kite_aborted += q->kite_pending;
+		q->kite_pending = 0;
+		dev_info(
+			dev->mt76.dev,
+			"Kite TX band%d bound: session=%u epoch=%u input=%pad ring=%pad reg=%#x count=%u; NPU copies/submits, WA frees payload\n",
+			b, dev->kite.session, kite_tx_read(&s->epoch),
+			&q->kite_tx_dma, &q->desc_dma, args[3], KITE_TX_COUNT);
+	}
+	if (ret)
+		mt7915_kite_fault(dev, ret);
+	else
+		dev->kite.tx_reset_requested = false;
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
+int mt7915_npu_tx_halt(struct mt7915_dev *dev)
+{
+	int ret, b;
+	if (!dev->kite.tx_bound)
+		return 0;
+	mt7915_kite_tx_gate(dev, true);
+	mutex_lock(&dev->kite.lock);
+	ret = mt7915_kite_command(dev, KITE_CTL_PARK, NULL, 0);
+	if (!ret)
+		ret = mt7915_kite_wait_parked(dev);
+	if (!ret)
+		ret = mt7915_kite_command(dev, KITE_CTL_TX_UNBIND, NULL, 0);
+	if (!ret) {
+		dev->kite.tx_bound = false;
+		for (b = 0; b < 2; b++) {
+			struct mt76_queue *q = dev->kite.txq[b];
+			if (!q || !q->kite_tx)
+				continue;
+			q->kite_tx_active = false;
+			dev_info(
+				dev->mt76.dev,
+				"Kite TX band%d stopped: submitted=%u reaped=%u cancelled=%u WA_freed=%u queued=%d\n",
+				b, kite_tx_read(&q->kite_tx->submitted),
+				kite_tx_read(&q->kite_tx->reaped),
+				kite_tx_read(&q->kite_tx->cancelled),
+				READ_ONCE(q->kite_wa_freed), q->queued);
+		}
+		/* RX workers must run to complete the subsequent DATA_STOP drain. */
+		ret = mt7915_kite_command(dev, KITE_CTL_RESUME, NULL, 0);
+	}
+	if (ret)
+		mt7915_kite_fault(dev, ret);
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
+/* Drain before replacing keys/revoking a port/reusing a WCID. This waits
+ * for WA token completion, not just descriptor consumption. Keep NAPI/WA
+ * running. Frames arriving after the admission gate fail back to mac80211
+ * status; existing queued frames remain owned until genuine completion.
+ */
+int mt7915_npu_tx_fence(struct mt7915_dev *dev)
+{
+	unsigned long until = jiffies + msecs_to_jiffies(3000);
+	int b;
+	if (!dev->kite.tx_bound)
+		return 0;
+	mt7915_kite_tx_gate(dev, true);
+	do {
+		bool empty = true;
+		for (b = 0; b < 2; b++) {
+			struct mt76_queue *q = dev->kite.txq[b];
+			if (!q || !q->kite_tx)
+				continue;
+			if (kite_tx_read(&q->kite_tx->fault))
+				goto fault;
+			mt76_queue_tx_cleanup(dev, q, false);
+			if (READ_ONCE(q->queued))
+				empty = false;
+		}
+		if (empty && !READ_ONCE(dev->mt76.token_count))
+			return 0;
+		usleep_range(1000, 2000);
+	} while (time_before(jiffies, until));
+fault:
+	dev_err(dev->mt76.dev,
+		"Kite TX security fence failed: outstanding=%u; queues held for full recovery\n",
+		READ_ONCE(dev->mt76.token_count));
+	dev->kite.tx_reset_requested = true;
+	dev->recovery.state |= MT_MCU_CMD_WDT_MASK;
+	mt7915_reset(dev);
+	return -ETIMEDOUT;
+}
+void mt7915_npu_tx_unfence(struct mt7915_dev *dev)
+{
+	if (dev->kite.tx_bound && !dev->kite.failed &&
+	    !dev->kite.tx_reset_requested)
+		mt7915_kite_tx_gate(dev, false);
+}
+void mt7915_npu_tx_watchdog(struct mt7915_dev *dev)
+{
+	int b;
+	bool report;
+	if (!dev->kite.tx_bound || dev->kite.tx_reset_requested ||
+	    dev->kite.failed)
+		return;
+	report = time_after_eq(jiffies, dev->kite.tx_log_at + 30 * HZ);
+	for (b = 0; b < 2; b++) {
+		struct mt76_queue *q = dev->kite.txq[b];
+		struct kite_tx_shared *s;
+		u32 progress, submitted, reaped;
+		if (!q || !q->kite_tx_active)
+			continue;
+		s = q->kite_tx;
+		dma_rmb();
+		submitted = kite_tx_read(&s->submitted);
+		reaped = kite_tx_read(&s->reaped);
+		progress = reaped + READ_ONCE(q->kite_wa_freed);
+		if (progress != q->kite_last_progress ||
+		    (!READ_ONCE(q->queued) && !READ_ONCE(q->kite_pending))) {
+			q->kite_progress_at = jiffies;
+			q->kite_last_progress = progress;
+		}
+		if (report)
+			dev_info(
+				dev->mt76.dev,
+				"Kite TX band%d: session=%u epoch=%u staged=%u published=%u dma=%u submitted=%u reaped=%u WA_freed=%u queued=%d wraps=%u full=%u gated=%u fault=%u tokens=%u\n",
+				b, dev->kite.session, kite_tx_read(&s->epoch),
+				kite_tx_read(&s->producer),
+				kite_tx_read(&s->published),
+				kite_tx_read(&s->completed), submitted, reaped,
+				READ_ONCE(q->kite_wa_freed),
+				READ_ONCE(q->queued), kite_tx_read(&s->wraps),
+				READ_ONCE(q->kite_full),
+				READ_ONCE(q->kite_gated),
+				kite_tx_read(&s->fault),
+				READ_ONCE(dev->mt76.token_count));
+		if (kite_tx_read(&s->fault) ||
+		    time_after(jiffies, q->kite_progress_at + 15 * HZ)) {
+			mt7915_kite_tx_gate(dev, true);
+			dev->kite.tx_reset_requested = true;
+			dev_err(dev->mt76.dev,
+				"Kite TX band%d fault/stall: code=%u; requesting full recovery, mappings retained\n",
+				b, kite_tx_read(&s->fault));
+			dev->recovery.state |= MT_MCU_CMD_WDT_MASK;
+			mt7915_reset(dev);
+			break;
+		}
+	}
+	if (report)
+		dev->kite.tx_log_at = jiffies;
+}
+static int mt7915_kite_tx_show(struct seq_file *seq, void *data)
+{
+	struct mt7915_dev *dev = seq->private;
+	int b;
+	mutex_lock(&dev->mt76.mutex);
+	seq_printf(
+		seq,
+		"tx_abi=1 requested=%u enabled=%u bound=%u session=%u tokens=%u unknown_free=%u recovery_pending=%u\n",
+		dev->kite.tx_requested, dev->kite.tx_enabled,
+		dev->kite.tx_bound, dev->kite.session,
+		READ_ONCE(dev->mt76.token_count),
+		READ_ONCE(dev->kite.tx_unknown), dev->kite.tx_reset_requested);
+	for (b = 0; b < 2; b++) {
+		struct mt76_queue *q = dev->kite.txq[b];
+		struct kite_tx_shared *s;
+		if (!q || !q->kite_tx)
+			continue;
+		s = q->kite_tx;
+		dma_rmb();
+		seq_printf(
+			seq,
+			"band%d active=%u gate=%u epoch=%u input=%pad ring=%pad head=%u tail=%u queued=%d staged=%u published=%u dma=%u submitted=%u reaped=%u WA_freed=%u kicks=%u wraps=%u full=%u gated=%u cancelled=%u invalid=%u fault=%u polls=%u pending=%u aborted=%u\n",
+			b, q->kite_tx_active, q->kite_tx_blocked,
+			kite_tx_read(&s->epoch), &q->kite_tx_dma, &q->desc_dma,
+			q->head, q->tail, q->queued, kite_tx_read(&s->producer),
+			kite_tx_read(&s->published),
+			kite_tx_read(&s->completed),
+			kite_tx_read(&s->submitted), kite_tx_read(&s->reaped),
+			READ_ONCE(q->kite_wa_freed), q->kite_kicks,
+			kite_tx_read(&s->wraps), q->kite_full, q->kite_gated,
+			kite_tx_read(&s->cancelled), kite_tx_read(&s->invalid),
+			kite_tx_read(&s->fault), kite_tx_read(&s->polls),
+			READ_ONCE(q->kite_pending), q->kite_aborted);
+	}
+	mutex_unlock(&dev->mt76.mutex);
+	return 0;
+}
