From: ponwrt development <noreply@local>
Subject: [PATCH] Normalize host fallback headers, observe native BA progress and default cache on

r69 on r68. Preserve ABI12, exact policy/PN and DMA+WA ownership.

--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -3,6 +3,8 @@
 
 #include <linux/etherdevice.h>
 #include <linux/timekeeping.h>
+#include <linux/if_vlan.h>
+#include <net/dsfield.h>
 #include "coredump.h"
 #include "mt7915.h"
 #include "../dma.h"
@@ -1248,6 +1250,46 @@
 
 #include "../kite-packet.h"
 
+/* The copied fallback record is gone; data is a complete Ethernet frame.
+ * Preserve inline VLAN bytes/protocol and let native TX apply its QoS map.
+ * In particular an Ethernet destination byte is never an IP DS field. */
+static bool mt7915_kite_host_headers(struct sk_buff *skb,
+                                     struct mt7915_kite_host_headers *o)
+{
+ __be16 inner;
+ int depth = 0;
+ if (!pskb_may_pull(skb, ETH_HLEN)) return false;
+ skb_scrub_packet(skb, true);
+ skb_clear_hash(skb);
+ __vlan_hwaccel_clear_tag(skb);
+ memset(skb->cb, 0, sizeof(skb->cb));
+ skb->priority = 0;
+ skb_set_queue_mapping(skb, 0);
+ skb->ip_summed = CHECKSUM_NONE;
+ skb->csum = 0;
+ skb->encapsulation = 0;
+ skb_reset_mac_header(skb);
+ skb->mac_len = 0;
+ skb->protocol = eth_hdr(skb)->h_proto;
+ inner = vlan_get_protocol_and_depth(skb, skb->protocol, &depth);
+ if (!inner) return false;
+ if (!depth) depth = ETH_HLEN;
+ skb_set_network_header(skb, depth);
+ skb->transport_header = (typeof(skb->transport_header))~0U;
+ o->protocol = ntohs(inner); o->offset = depth; o->ds = 0;
+ if (inner == htons(ETH_P_IP)) {
+  if (!pskb_may_pull(skb, depth + sizeof(struct iphdr)) ||
+      ip_hdr(skb)->version != 4 || ip_hdr(skb)->ihl < 5 ||
+      !pskb_may_pull(skb, depth + ip_hdr(skb)->ihl * 4)) return false;
+  o->ds = ipv4_get_dsfield(ip_hdr(skb));
+ } else if (inner == htons(ETH_P_IPV6)) {
+  if (!pskb_may_pull(skb, depth + sizeof(struct ipv6hdr)) ||
+      ipv6_hdr(skb)->version != 6) return false;
+  o->ds = ipv6_get_dsfield(ipv6_hdr(skb));
+ }
+ return true;
+}
+
 struct mt7915_kite_host_tx {
 	struct sk_buff *skb;
 	struct mt7915_vif *vif;
@@ -1275,9 +1317,7 @@
 	if (!wdev || !wdev->netdev || !netif_running(wdev->netdev))
 		return;
 	ctx->skb->dev = wdev->netdev;
-	ctx->skb->protocol = eth_hdr(ctx->skb)->h_proto;
-	skb_reset_network_header(ctx->skb);
-	skb_reset_transport_header(ctx->skb);
+	/* Ethernet and network offsets were normalized before VIF iteration. */
 	ctx->sent = true;
 	/* dev_queue_xmit consumes the skb even on an error. */
 	ctx->xmit_error = dev_queue_xmit(ctx->skb);
@@ -1302,6 +1342,7 @@
  u32 record[KDP_HOST_RECORD_WORDS], request=0, slot=KDP_SLOT_NONE;
  bool accounted=false;
  struct kdp_packet packet;
+ struct mt7915_kite_host_headers headers = {};
  unsigned long flags;
 
 	reject = MT7915_KITE_HOST_META;
@@ -1378,6 +1419,20 @@
 	mphy = mt76_dev_phy(&dev->mt76, ctx.band);
 	if (!mphy || mphy->band_idx != ctx.band || !mphy->hw)
 		goto reject;
+ reject = MT7915_KITE_HOST_META;
+ {
+  bool valid = mt7915_kite_host_headers(skb, &headers);
+  struct mt7915_kite_host_stats *h = &dev->kite.host_headers[ctx.band];
+  spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+  if (valid) {
+   h->packets++; h->vlan += headers.offset > ETH_HLEN;
+   h->ipv4 += headers.protocol == ETH_P_IP;
+   h->ipv6 += headers.protocol == ETH_P_IPV6;
+   h->last = headers;
+  } else h->bad++;
+  spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+  if (!valid) goto reject;
+ }
 	ieee80211_iterate_active_interfaces_atomic(mphy->hw,
 		IEEE80211_IFACE_ITER_NORMAL, mt7915_kite_host_tx_iter, &ctx);
 	reject = MT7915_KITE_HOST_VIF;
