 }
+
+/* Native BA callbacks are scheduling hints, never drain/ownership proof.
+ * MAC80211 may still have STOP set when OPERATIONAL returns. Schedule the
+ * existing worker; its complete queue check and DMA prefix remain mandatory. */
+void mt7915_npu_ba_transition(struct ieee80211_hw *hw, struct ieee80211_sta *sta,
+                             u8 tid, u32 action, int result)
+{
+ struct mt7915_dev *dev = mt7915_hw_dev(hw);
+ struct mt7915_sta *msta = (void *)sta->drv_priv;
+ struct mt7915_kite_ba_wait *b;
+ struct mt7915_kite_ps_state *p;
+ unsigned long flags;
+ u32 wi = msta->wcid.idx;
+ u64 now;
+ bool finish = false;
+ if (tid >= 8 || !wi || wi >= KDP_WCIDS || !READ_ONCE(dev->kite.dp_bound)) return;
+ if (action != IEEE80211_AMPDU_TX_START &&
+     action != IEEE80211_AMPDU_TX_OPERATIONAL &&
+     action != IEEE80211_AMPDU_TX_STOP_CONT &&
+     action != IEEE80211_AMPDU_TX_STOP_FLUSH &&
+     action != IEEE80211_AMPDU_TX_STOP_FLUSH_CONT) return;
+ spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+ b = &msta->npu_ba_wait[tid]; now = ktime_get_ns();
+ b->last_ns = now; b->action = action; b->result = result;
+ if (action == IEEE80211_AMPDU_TX_START) {
+  b->starts++; b->started_ns = result < 0 ? 0 : now;
+ } else {
+  finish = true;
+  if (action == IEEE80211_AMPDU_TX_OPERATIONAL) b->operational += !result;
+  else b->stops++;
+  if (b->started_ns) {
+   b->elapsed_ns = now - b->started_ns;
+   if (b->elapsed_ns > b->max_ns) b->max_ns = b->elapsed_ns;
+   b->started_ns = 0;
+  }
+ }
+ b->failures += result < 0;
+ p = &dev->kite.ps[wi];
+ if (finish && dev->kite.dp_work_initialized && !dev->kite.dp_work_stopping &&
+     test_bit(wi, dev->kite.dp_ps_pending)) {
+  p->queue_retry_at = jiffies;
+  if (!p->queued_ns) p->queued_ns = now;
+  mod_delayed_work(system_wq, &dev->kite.dp_ps_work, 0);
+ }
+ spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+}
