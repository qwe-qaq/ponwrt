+	dev_info(dev->mt76.dev,
+		"Kite DMA quiesce begin: tx_bound=%u dp_bound=%u quarantine=%u\n",
+		dev->kite.tx_bound, dev->kite.dp_bound, dev->mt76.npu_quarantine);
 	mt76_npu_disable_irqs(&dev->mt76);
 	ret = -EIO;
 	for (attempt = 0; attempt < 3; attempt++) {
+		dev_info(dev->mt76.dev, "Kite DMA quiesce TX_HALT attempt=%d/3\n", attempt + 1);
 		ret = mt7915_npu_tx_halt(dev);
+		if (ret)
+			dev_info(dev->mt76.dev,
+				"Kite DMA quiesce TX_HALT attempt=%d/3 ret=%d tx_bound=%u dp_bound=%u\n",
+				attempt + 1, ret, dev->kite.tx_bound, dev->kite.dp_bound);
 		if (!ret)
 			break;
 		/* A failed proof never releases ownership. Give a firmware
@@ -685,7 +693,12 @@
 		ret = mt7915_dma_disable(dev, false);
 	if (!ret) {
 		for (attempt = 0; attempt < 3; attempt++) {
+			dev_info(dev->mt76.dev, "Kite DMA quiesce DATA_STOP attempt=%d/3\n", attempt + 1);
 			ret = mt7915_npu_data_stop(dev);
+			if (ret)
+				dev_info(dev->mt76.dev,
+					"Kite DMA quiesce DATA_STOP attempt=%d/3 ret=%d tx_bound=%u dp_bound=%u\n",
+					attempt + 1, ret, dev->kite.tx_bound, dev->kite.dp_bound);
 			if (!ret)
 				break;
 			if (!mt76_npu_device_active(&dev->mt76) ||
@@ -698,8 +711,12 @@
 		if (mt76_npu_device_active(&dev->mt76))
 			dev->mt76.npu_quarantine = true;
 		dev_err(dev->mt76.dev,
-			"DMA stop failed: %d; TX tokens and RX buffers retained\n", ret);
+			"Kite DMA quiesce failed: %d; TX tokens and RX buffers retained; tx_bound=%u dp_bound=%u quarantine=%u\n",
+			ret, dev->kite.tx_bound, dev->kite.dp_bound, dev->mt76.npu_quarantine);
 	} else {
+		dev_info(dev->mt76.dev,
+			"Kite DMA quiesce complete: tx_bound=%u dp_bound=%u\n",
+			dev->kite.tx_bound, dev->kite.dp_bound);
 		/* DATA_STOP/host-unbind is the ownership proof that permits a
 		 * subsequent ring reset. */
 		dev->mt76.npu_quarantine = false;

