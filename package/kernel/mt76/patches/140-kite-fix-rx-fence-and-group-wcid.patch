From: ponwrt development <noreply@local>
Subject: [PATCH] mt7915: fix STA RX fence and preserve source WCID identity

Do not gate RX drain on PSE SFD_PARK (bit 21 / port 2 queue 5).
MT7916 retains StoreForward pages; the failed CU readback 0x9fdfffff
shows all receive queues empty while the SFD queue remains occupied.
Keep MDP_RX/SEC_RX/RXIOC/HIF drain, dual WFDMA stop, worker ACK and
both old-RX purges before publishing new station/key generations.

Use the original RXD WCID for NPU epoch checks before the group RX
mapping to the vif GTK WCID. Group traffic cannot carry NPU security
proofs. Add fence stage/register and per-band RX identity diagnostics.

Validated with extracted production functions, captured-register
regression and fault injection; hardware acceptance remains pending.

--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -297,6 +297,102 @@
 	mtk_wed_device_ppe_check(&dev->mt76.mmio.wed, skb,
 				 FIELD_GET(MT_DMA_PPE_CPU_REASON, info),
 				 FIELD_GET(MT_DMA_PPE_ENTRY, info));
+}
+
+/* Metadata epochs describe the WCID in the hardware RXD. For group RX,
+ * mt7915_rx_get_wcid() selects the vif WCID for GTK/mac80211 processing;
+ * that separate key owner must not replace the source identity check. */
+static int
+mt7915_kite_rx_security(struct mt7915_dev *dev, struct mt76_rx_status *status,
+		       enum mt76_rxq_id q, const u32 *info, u16 raw_wcid,
+		       bool unicast, __le16 fc, u16 seq_ctrl)
+{
+#ifdef CONFIG_MT7915_NPU
+	struct kdp_shared *dp = READ_ONCE(dev->mt76.kite_dp);
+	u32 meta;
+	unsigned int band;
+	int ret;
+
+	if (!dp || (q != MT_RXQ_NPU0 && q != MT_RXQ_NPU1))
+		return 0;
+	band = q - MT_RXQ_NPU0;
+	if (!status->wcid) {
+		/* Unknown peers' authentication/association frames remain host
+		 * owned, with no reorder or PN proof attached. */
+		dev->kite.dp_rx_meta_untracked[band]++;
+		return 0;
+	}
+	meta = info[0];
+	if (raw_wcid >= KDP_WCIDS ||
+	    (meta & 0xffff0000u) != KDP_RX_MAGIC ||
+	    (meta & ~(KDP_RX_MAGIC | KDP_RX_REORDERED | KDP_RX_PN |
+		       KDP_RX_PPE_RETURN))) {
+		ret = -EPROTO;
+		goto reject;
+	}
+	if (info[1] != READ_ONCE(dp->sta[raw_wcid].generation) ||
+	    info[2] != READ_ONCE(dp->sta[raw_wcid].key_generation)) {
+		ret = -ESTALE;
+		goto reject;
+	}
+	/* Firmware never grants accelerated/PN proofs to group traffic.
+	 * GTK replay remains owned by the vif WCID and mac80211. */
+	if (!unicast || raw_wcid != status->wcid->idx) {
+		if (meta & (KDP_RX_REORDERED | KDP_RX_PN | KDP_RX_PPE_RETURN)) {
+			ret = -EPROTO;
+			goto reject;
+		}
+		goto accepted;
+	}
+	if ((meta & KDP_RX_REORDERED) &&
+	    (!ieee80211_is_data_qos(fc) || ieee80211_has_morefrags(fc) ||
+	     (seq_ctrl & 15) || (status->amsdu && !(status->flag & RX_FLAG_8023)))) {
+		ret = -EPROTO;
+		goto reject;
+	}
+	if ((meta & KDP_RX_PN) &&
+	    (!(meta & KDP_RX_REORDERED) || !(status->flag & RX_FLAG_DECRYPTED) ||
+	     READ_ONCE(dp->sta[raw_wcid].cipher) != KDP_CIPHER_CCMP)) {
+		ret = -EPROTO;
+		goto reject;
+	}
+	status->npu_security = 1;
+	status->npu_generation = info[1];
+	status->npu_key_generation = info[2];
+	status->flag &= ~(RX_FLAG_AMPDU_DETAILS | RX_FLAG_MACTIME_START |
+			  RX_FLAG_MACTIME_END | RX_FLAG_MACTIME_PLCP_START);
+	if ((meta & KDP_RX_PPE_RETURN) && mt76_ppe_device_active(&dev->mt76)) {
+		struct airoha_ppe_dev *ppe = rcu_dereference(dev->mt76.mmio.ppe_dev);
+
+		if (ppe)
+			airoha_kite_learn_hint(ppe);
+	}
+	if (meta & KDP_RX_REORDERED) {
+		/* PPE can consume siblings of a translated A-MSDU: each host
+		 * subframe is already complete and must not be reassembled. */
+		status->amsdu = status->first_amsdu = status->last_amsdu = 0;
+		status->npu_reordered = 1;
+	}
+	if (meta & KDP_RX_PN)
+		status->npu_pn_proof = 1;
+accepted:
+	dev->kite.dp_rx_meta_ok[band]++;
+	return 0;
+reject:
+	if (ret == -ESTALE)
+		dev->kite.dp_rx_meta_stale[band]++;
+	else
+		dev->kite.dp_rx_meta_invalid[band]++;
+	dev_warn_ratelimited(dev->mt76.dev,
+		"Kite RX metadata rejected: band=%u raw_wcid=%u key_wcid=%u fc=%04x meta=%08x generation=%u/%u key_generation=%u/%u err=%d\n",
+		band, raw_wcid, status->wcid->idx, le16_to_cpu(fc), meta,
+		info[1], raw_wcid < KDP_WCIDS ? READ_ONCE(dp->sta[raw_wcid].generation) : 0,
+		info[2], raw_wcid < KDP_WCIDS ? READ_ONCE(dp->sta[raw_wcid].key_generation) : 0,
+		ret);
+	return ret;
+#else
+	return 0;
+#endif
 }
 
