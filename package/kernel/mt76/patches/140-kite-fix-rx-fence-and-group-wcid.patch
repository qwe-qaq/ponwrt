 		mt76_set(dev, MT_ARB_SCR(b), MT_ARB_SCR_RX_DISABLE);
@@ -133,26 +163,34 @@
 	 * the hardware queue counts to drain the decrypt/translation/HIF path.
 	 * The elapsed delay alone is not the completion condition. */
