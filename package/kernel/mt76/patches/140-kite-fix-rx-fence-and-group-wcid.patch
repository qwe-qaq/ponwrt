-/* MT7916 wf_pse_top: true PSE RX/SEC/RXIOC/SFD and HIF queues.
- * Check both read-only empty bits (including band1 RXIOC) and explicit
- * queue counts. Do not reuse PLE debugfs offsets as PSE drain evidence. */
+/* MT7916 wf_pse_top: MDP_RX, SEC_RX, RXIOC and HIF receive queues.
+ * SFD_PARK (bit 21, port 2 queue 5) retains StoreForward pages; the PLE
+ * AMSDU_GC DIS_SFD_KEEP_SAME_PAGE control documents that retention.
+ * It is not an RX drain queue and may remain occupied with RF RX held.
+ * Do not flush firmware-owned SFD packets or wait for that TX lifetime.
+ * Check both read-only RX empty bits (including band1 RXIOC) and explicit
+ * queue counts. Physical DMA stop, worker ACK and RX purges follow. */
 static bool mt7915_dp_rx_queues_empty(struct mt7915_dev *dev)
 {
-	static const u8 pid[] = { 2, 2, 2, 2, 0, 0, 0, 0, 0, 0 };
-	static const u8 qid[] = { 2, 4, 5, 7, 0, 1, 2, 3, 4, 5 };
+	static const u8 pid[] = { 2, 2, 2, 0, 0, 0, 0, 0, 0 };
+	static const u8 qid[] = { 2, 4, 7, 0, 1, 2, 3, 4, 5 };
 	unsigned int i;
 
-	if ((mt76_rr(dev, MT_KITE_PSE_EMPTY) & MT_KITE_PSE_RX_EMPTY) !=
-	    MT_KITE_PSE_RX_EMPTY)
+	dev->kite.dp_rx_pse_empty = mt76_rr(dev, MT_KITE_PSE_EMPTY);
+	dev->kite.dp_rx_pse_query = dev->kite.dp_rx_pse_count = 0;
+	if ((dev->kite.dp_rx_pse_empty & MT_KITE_PSE_RX_EMPTY) != MT_KITE_PSE_RX_EMPTY)
 		return false;
 	for (i = 0; i < ARRAY_SIZE(pid); i++) {
 		mt76_wr(dev, MT_KITE_PSE_QUERY,
 			BIT(31) | ((u32)pid[i] << 10) | ((u32)qid[i] << 24));
-		if (!mt76_poll(dev, MT_KITE_PSE_QUERY, BIT(31), 0, 10) ||
-		    mt76_get_field(dev, MT_KITE_PSE_COUNT, GENMASK(11, 0)))
+		if (!mt76_poll(dev, MT_KITE_PSE_QUERY, BIT(31), 0, 10)) {
+			dev->kite.dp_rx_pse_query = mt76_rr(dev, MT_KITE_PSE_QUERY);
+			return false;
+		}
+		dev->kite.dp_rx_pse_query = mt76_rr(dev, MT_KITE_PSE_QUERY);
+		dev->kite.dp_rx_pse_count = mt76_get_field(dev, MT_KITE_PSE_COUNT, GENMASK(11, 0));
+		if (dev->kite.dp_rx_pse_count)
 			return false;
 	}
 	return true;
@@ -115,6 +125,24 @@
 		mt76_set(dev, MT_WFDMA0_GLO_CFG + ofs, MT_WFDMA0_GLO_CFG_RX_DMA_EN);
 }
 
+/* Capture the failing fence before control is latched. No key material or
+ * client addresses are logged, and no register is written by this helper. */
+static int mt7915_dp_rx_error(struct mt7915_dev *dev, int ret)
+{
+	u32 ofs = dev->hif2 ? MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0) : 0;
+
+	dev->kite.dp_rx_failures++;
+	dev_err(dev->mt76.dev,
+		"Kite RX fence failed: stage=%u err=%d serial=%u pse_empty=%08x need=%08x query=%08x count=%u dma0=%08x dma1=%08x mac0=%08x mac1=%08x; admission held\n",
+		dev->kite.dp_rx_stage, ret, dev->kite.serial,
+		dev->kite.dp_rx_pse_empty, (u32)MT_KITE_PSE_RX_EMPTY,
+		dev->kite.dp_rx_pse_query, dev->kite.dp_rx_pse_count,
+		mt76_rr(dev, MT_WFDMA0_GLO_CFG),
+		ofs ? mt76_rr(dev, MT_WFDMA0_GLO_CFG + ofs) : 0,
+		mt76_rr(dev, MT_ARB_SCR(0)), mt76_rr(dev, MT_ARB_SCR(1)));
+	return ret;
+}
+
 static int mt7915_dp_rx_pause(struct mt7915_dev *dev)
 {
 	u32 ofs = dev->hif2 ? MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0) : 0;
@@ -124,6 +152,8 @@
 	lockdep_assert_held(&dev->kite.lock);
 	if (!dev->kite.dp_bound)
 		return 0;
