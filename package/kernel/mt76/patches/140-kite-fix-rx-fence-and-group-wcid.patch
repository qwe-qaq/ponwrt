 	while (!mt7915_dp_rx_queues_empty(dev)) {
 		if (time_after_eq(jiffies, until))
-			return -ETIMEDOUT;
+			return mt7915_dp_rx_error(dev, -ETIMEDOUT);
 		usleep_range(1000, 2000);
