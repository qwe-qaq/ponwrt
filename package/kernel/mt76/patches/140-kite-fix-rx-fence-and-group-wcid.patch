-		return mt7915_kite_fault(dev, ret);
+		return mt7915_kite_fault(dev, mt7915_dp_rx_error(dev, ret));
 	mt7915_dp_dma_rx_restore(dev);
 	for (b = 0; b < 2; b++)
 		if (!(dev->kite.dp_rx_mac[b] & MT_ARB_SCR_RX_DISABLE))
@@ -180,6 +223,8 @@
 	dma_wmb();
 	if (s->enabled && !s->fault)
 		WRITE_ONCE(s->gate, 0);
+	dev->kite.dp_rx_stage = 10;
+	dev->kite.dp_rx_resumes++;
 	mt7915_npu_tx_unfence(dev);
 	return 0;
 }
