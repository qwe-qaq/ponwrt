 	dev->kite.dp_rx_cfg[0] = mt76_rr(dev, MT_WFDMA0_GLO_CFG);
 	if (ofs)
 		dev->kite.dp_rx_cfg[1] = mt76_rr(dev, MT_WFDMA0_GLO_CFG + ofs);
+	dev->kite.dp_rx_stage = 3; /* physical RX stop */
