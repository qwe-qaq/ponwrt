+/* Explicit firmware-writer lifetime. UNBIND is only one phase of stop:
+ * WFDMA, TDMA/PPE, NAPI and devm allocations still need their own drain
+ * and quarantine before a caller may reclaim pages or restart DMA. */
+int mt7915_npu_host_bind(struct mt7915_dev *dev, u64 pa0, u64 pa1, u32 bands)
+{
+	u32 s[KITE_CTL_WORDS], args[4];
+	int ret;
+
+	if (!dev->kite.active || dev->kite.control_only ||
+	    (bands != 1 && bands != 3) || !kite_host_ring_valid(pa0) ||
+	    (bands == 3 ? !kite_host_ring_valid(pa1) : pa1 != 0))
+		return -EINVAL;
+	args[0] = pa0;
+	args[1] = pa1;
+	args[2] = bands;
+	args[3] = KITE_HOST_RING_COUNT;
+	mutex_lock(&dev->kite.lock);
+	if (dev->kite.failed || dev->kite.host_bound) {
+		ret = -EBUSY;
+		goto out;
+	}
+	ret = mt7915_kite_status(dev, s);
+	if (!ret && !(s[2] & KITE_CTL_CAP_HOST_RING))
+		ret = -EOPNOTSUPP;
+	if (!ret)
+		ret = mt7915_kite_wait_parked(dev);
+	if (!ret) {
+		/* From submission onwards the result may be unknown. Keep the
+		 * host's ownership marker even on a mailbox/result failure. */
+		dev->kite.host_bound = true;
+		ret = mt7915_kite_command(dev, KITE_CTL_HOST_BIND, args, 4);
+		dev->kite.host_epoch = dev->kite.serial;
+	}
+	if (ret)
+		mt7915_kite_fault(dev, ret);
+out:
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
+
+int mt7915_npu_host_unbind(struct mt7915_dev *dev)
+{
+	int ret = 0;
+
+	mutex_lock(&dev->kite.lock);
+	if (!dev->kite.host_bound)
+		goto out;
+	if (dev->kite.failed) {
+		ret = -EIO;
+		goto out;
+	}
+	ret = mt7915_kite_command(dev, KITE_CTL_PARK, NULL, 0);
+	if (!ret)
+		ret = mt7915_kite_wait_parked(dev);
+	if (!ret)
+		ret = mt7915_kite_command(dev, KITE_CTL_HOST_UNBIND,
+					 &dev->kite.host_epoch, 1);
+	if (!ret)
+		dev->kite.host_bound = false;
+	else
+		mt7915_kite_fault(dev, ret);
+	/* Deliberately leave workers parked, with all packet state intact. */
+out:
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
+
