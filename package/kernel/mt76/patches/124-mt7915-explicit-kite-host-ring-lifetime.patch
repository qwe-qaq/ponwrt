+int kite_host_bind(u32 session, u32 epoch, u32 bandmask, u32 pa0, u32 pa1);
+int kite_host_unbind(u32 session, u32 epoch);
+u32 kite_host_bound(void);
+void kite_host_snapshot(u32 *out);
+#else
+static inline int kite_host_faulted(void) { return 0; }
+#endif
+#endif
