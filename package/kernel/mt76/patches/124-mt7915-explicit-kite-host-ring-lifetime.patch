+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PONWRT_KITE_HOST_H
+#define PONWRT_KITE_HOST_H
+
+/* Firmware source ownership is retained on HOLD, including a partial
+ * chain. Neither DONE nor the producer index may be published. */
+#define KITE_HOST_HOLD (-2)
+#define KITE_HOST_DIAG_MAGIC 0x4b480001u
+#define KITE_HOST_RING_COUNT 512u
+#define KITE_HOST_RING_BYTES (KITE_HOST_RING_COUNT * 24u)
+
+static inline int kite_host_ring_valid(unsigned long long addr)
+{
+	return addr >= 0x80000000ull && addr < 0xc0000000ull &&
+	       !(addr & 63) && KITE_HOST_RING_BYTES <= 0xc0000000ull - addr;
+}
