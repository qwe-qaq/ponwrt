+ /* Wide capability changes need the same preparation-stop proof as local
+  * BA. PARK ACK follows hart4's fully published tail; RESUME keeps the DP
+  * gate closed while WA/DMA completion drains. Never infer quiescence from
+  * an empty token snapshot before the producer has acknowledged stopping. */
+ ret = mt7915_kite_command(dev, KITE_CTL_PARK, NULL, 0);
+ if (!ret) ret = mt7915_kite_command(dev, KITE_CTL_RESUME, NULL, 0);
+ if (ret) {
+  mt7915_kite_fault(dev, ret);
+  dev->kite.tx_reset_requested = true;
+  dev->recovery.state |= MT_MCU_CMD_WDT_MASK;
+  mt7915_reset(dev);
+  mutex_unlock(&dev->kite.lock);
