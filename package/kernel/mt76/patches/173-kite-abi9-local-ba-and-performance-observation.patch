+
+/* Local BA changes never replace a key, QoS map or station HW capability.
+ * Caller holds mt76.mutex and stops the host worker. Hold kite.lock across
+ * this transaction so PPE PARK/rekey cannot invalidate request identity. */
+static int mt7915_npu_ba_ack(struct mt7915_dev *dev, struct kdp_shared *s, u32 request)
+{
+ unsigned long until = jiffies + msecs_to_jiffies(3000);
+ do {
+  if (kdp_failed(s) || dev->kite.failed || dev->kite.tx_reset_requested)
+   return -EIO;
+  if (READ_ONCE(s->tuning.ba.ack) == request) { dma_rmb(); return 0; }
+  usleep_range(1000, 2000);
+ } while (time_before(jiffies, until));
+ return -ETIMEDOUT;
+}
+static int mt7915_npu_ba_fail(struct mt7915_dev *dev, int ret)
+{
+ /* Never release a timed-out request or MCU contract. Recovery must prove
+  * the normal physical stop; a mere absence of pending packets is not ACK. */
+ dev->kite.ba_local_failed++;
+ dev->kite.tx_reset_requested = true;
+ dev->recovery.state |= MT_MCU_CMD_WDT_MASK;
+ mt7915_kite_gate_set(dev, dev->mt76.kite_dp, true, MT7915_KITE_GATE_AMSDU);
+ mt7915_kite_tx_gate(dev, true);
+ dev_err(dev->mt76.dev, "Kite local BA fence failed: %d; retained for recovery\n", ret);
+ mt7915_reset(dev);
+ return ret;
+}
+int mt7915_npu_ba_pause(struct mt7915_dev *dev, struct mt7915_sta *msta,
+ unsigned int tid, bool wide)
+{
+ struct kdp_shared *s = READ_ONCE(dev->mt76.kite_dp);
+ struct kdp_ba_gate *g;
+ unsigned long until;
+ u32 request, i;
+ int b, ret;
+ if (wide) return mt7915_npu_amsdu_pause(dev, msta);
+ if (!s || !dev->kite.dp_bound || !msta->wcid.idx || msta->wcid.idx >= KDP_WCIDS)
+  return 0;
+ if (tid >= 8) return -EINVAL;
+ mutex_lock(&dev->kite.lock);
+ if (dev->kite.dp_changing || kdp_failed(s) || dev->kite.tx_reset_requested ||
+     READ_ONCE(s->gate) || !READ_ONCE(s->sta[msta->wcid.idx].enabled)) {
+  mutex_unlock(&dev->kite.lock);
+  return -EBUSY;
+ }
+ g = &s->tuning.ba; request = READ_ONCE(g->request);
+ if (request != READ_ONCE(g->ack) || request >= U32_MAX - 1) {
+  ret = -EOVERFLOW; goto fault;
+ }
+ dev->kite.ba_local_started_ns = ktime_get_ns();
+ dev->kite.ba_local_requests++;
+ mt7915_kite_trace_event(dev, 24, msta->wcid.idx,
+  ((READ_ONCE(s->sta[msta->wcid.idx].amsdu) & 255) << 8) | tid, 0);
+ mt7915_kite_tx_gate(dev, true);
+ WRITE_ONCE(g->wcid, msta->wcid.idx); WRITE_ONCE(g->tids, BIT(tid));
+ WRITE_ONCE(g->generation, READ_ONCE(s->sta[msta->wcid.idx].generation));
+ WRITE_ONCE(g->key_generation, READ_ONCE(s->sta[msta->wcid.idx].key_generation));
+ dma_wmb(); WRITE_ONCE(g->request, ++request);
+ ret = mt7915_npu_ba_ack(dev, s, request);
+ if (ret) goto fault;
+ until = jiffies + msecs_to_jiffies(3000);
+ do {
+  bool empty = true;
+  if (kdp_failed(s) || dev->kite.tx_reset_requested) { ret = -EIO; goto fault; }
+  for (b = 0; b < 2; b++) {
+   struct mt76_queue *q = dev->kite.txq[b];
+   if (!q || !q->kite_tx) continue;
+   if (kite_tx_read(&q->kite_tx->fault)) { ret = -EIO; goto fault; }
+   mt76_queue_tx_cleanup(dev, q, false);
+   if (READ_ONCE(q->queued)) empty = false;
+  }
+  for (i = 0; i < KDP_TOKENS; i++) {
+   struct kdp_token *t = &s->token[i];
+   u32 state = READ_ONCE(t->state);
+   if (state == KDP_TOKEN_QUARANTINE) { ret = -EIO; goto fault; }
+   if (state != KDP_TOKEN_WIFI) continue;
+   dma_rmb();
+   if (READ_ONCE(t->wcid) == msta->wcid.idx && READ_ONCE(s->tuning.token_tid[i]) == tid)
+    empty = false;
+  }
+  if (empty && !READ_ONCE(dev->mt76.token_count)) return 2; /* retains mutex */
+  usleep_range(1000, 2000);
+ } while (time_before(jiffies, until));
+ ret = -ETIMEDOUT;
+fault:
+ ret = mt7915_npu_ba_fail(dev, ret);
+ mutex_unlock(&dev->kite.lock);
+ return ret;
+}
+int mt7915_npu_ba_resume(struct mt7915_dev *dev, int fence, int result)
+{
+ struct kdp_shared *s = READ_ONCE(dev->mt76.kite_dp);
+ u64 elapsed;
+ if (fence != 2) {
+  if (fence == 1) {
+   if (result) return mt7915_npu_ba_fail(dev, result);
+   mt7915_npu_amsdu_resume(dev);
+  }
+  return result;
+ }
+ if (!result) {
+  WRITE_ONCE(s->tuning.ba.tids, 0);
+  dma_wmb();
+  WRITE_ONCE(s->tuning.ba.request, READ_ONCE(s->tuning.ba.request) + 1);
+  result = mt7915_npu_ba_ack(dev, s, READ_ONCE(s->tuning.ba.request));
+ }
+ elapsed = ktime_get_ns() - dev->kite.ba_local_started_ns;
+ dev->kite.ba_local_total_ns += elapsed;
+ if (elapsed > dev->kite.ba_local_max_ns) dev->kite.ba_local_max_ns = elapsed;
+ mt7915_kite_trace_event(dev, 25, READ_ONCE(s->tuning.ba.wcid),
+                         READ_ONCE(s->tuning.ba.request), result);
+ if (result) mt7915_npu_ba_fail(dev, result);
+ else mt7915_npu_tx_unfence(dev);
+ mutex_unlock(&dev->kite.lock);
+ return result;
 }
 
