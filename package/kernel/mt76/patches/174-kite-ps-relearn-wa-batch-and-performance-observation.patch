+/* SPDX-License-Identifier: ISC */
+/* dp_done_lock makes both MCU NAPI queues a single completion producer.
+ * The lock is acquired once per bounded batch, never across host callbacks. */
+static void mt7915_npu_wa_flush(struct mt7915_dev *dev, const u16 *tokens, u32 count)
+{
+ struct kdp_shared *s;
+ unsigned long flags;
+ u32 producer, consumer, n, overflow = 0;
+ u64 start, elapsed;
+ spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+ s = READ_ONCE(dev->mt76.kite_dp);
+ if (!s || !dev->kite.dp_bound) { dev->kite.tx_unknown += count; goto out; }
+ dev->kite.wa.batches++;
+ producer = dev->kite.dp_done_producer;
+ consumer = READ_ONCE(s->done.consumer); dma_rmb();
+ if (s->session != dev->kite.session || s->epoch != dev->kite.dp_epoch) goto fault;
+ for (n = 0; n < count; n++) {
+  volatile struct kdp_token *t;
+  u32 id = tokens[n] - KDP_TOKEN_BASE, seq;
+  if (id >= KDP_TOKENS) goto fault;
+  t = &s->token[id]; seq = READ_ONCE(t->submitted);
+  if (READ_ONCE(t->state) != KDP_TOKEN_WIFI || !seq || READ_ONCE(t->wa_done) ||
+      READ_ONCE(t->wcid) >= KDP_WCIDS || READ_ONCE(t->band) > 1) goto fault;
+  dma_wmb(); WRITE_ONCE(t->wa_done, seq);
+  if ((u32)(producer - consumer) >= KDP_DONE_COUNT) overflow++;
+  else {
+   struct kdp_done_entry *e = &s->done.entry[producer & (KDP_DONE_COUNT - 1)];
+   WRITE_ONCE(e->token, id); WRITE_ONCE(e->submitted, seq); producer++;
+   dev->kite.dp_done_events++;
+  }
+ }
+ goto publish;
+fault:
+ dev->kite.wa.errors++;
+ if (READ_ONCE(s->tx_bad_done) != U32_MAX) WRITE_ONCE(s->tx_bad_done, s->tx_bad_done + 1);
+ mt7915_kite_gate_set(dev, s, true, MT7915_KITE_GATE_RECOVERY);
+publish:
+ /* Publish any valid preceding events even if the final event was invalid. */
+ if (overflow) WRITE_ONCE(s->done.overflow, s->done.overflow + overflow);
+ dev->kite.dp_done_producer = producer;
+ dev->kite.dp_done_publish_calls++;
+ start = ktime_get_mono_fast_ns();
+ if (producer != dev->kite.dp_done_published) {
+  dma_wmb(); WRITE_ONCE(s->done.producer, producer);
+  dev->kite.dp_done_published = producer; dev->kite.dp_done_publish_writes++;
+ } else dev->kite.dp_done_publish_skips++;
+ elapsed = ktime_get_mono_fast_ns() - start;
+ dev->kite.wa.publish_ns += elapsed;
+ if (elapsed > dev->kite.wa.publish_max_ns) dev->kite.wa.publish_max_ns = elapsed;
+out:
+ spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+}
+bool mt7915_npu_dp_tx_free(struct mt7915_dev *dev, u16 token)
+{
+ if (!dev->kite.dp_tokens_reserved || token < KDP_TOKEN_BASE || token >= KDP_TOKEN_LIMIT) return false;
+ mt7915_npu_wa_flush(dev, &token, 1); return true;
+}
+void mt7915_npu_dp_tx_done_publish(struct mt7915_dev *dev)
+{
+ /* Compatibility callers have already published at their batch boundary. */
+ if (READ_ONCE(dev->kite.dp_bound)) mt7915_npu_wa_flush(dev, NULL, 0);
+}
+void mt7915_npu_wa_begin(struct mt7915_kite_wa_batch *b)
+{
+ b->count = b->events = 0; b->start_ns = ktime_get_mono_fast_ns();
+}
+bool mt7915_npu_wa_add(struct mt7915_dev *dev, struct mt7915_kite_wa_batch *b, u16 token)
+{
+ if (!dev->kite.dp_tokens_reserved || token < KDP_TOKEN_BASE || token >= KDP_TOKEN_LIMIT) return false;
+ b->token[b->count++] = token; b->events++;
+ if (b->count == ARRAY_SIZE(b->token)) {
+  mt7915_npu_wa_flush(dev, b->token, b->count); b->count = 0;
+ }
+ return true;
+}
+void mt7915_npu_wa_end(struct mt7915_dev *dev, struct mt7915_kite_wa_batch *b)
+{
+ static const u32 ns[7] = {1000,4000,16000,64000,256000,1000000,4000000};
+ unsigned long flags;
+ u64 elapsed;
+ u32 i = 0;
+ if (b->count) mt7915_npu_wa_flush(dev, b->token, b->count);
+ elapsed = ktime_get_mono_fast_ns() - b->start_ns;
+ while (i < 7 && elapsed > ns[i]) i++;
+ spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+ dev->kite.wa.reports++; dev->kite.wa.events += b->events;
+ dev->kite.wa.total_ns += elapsed; dev->kite.wa.age[i]++;
+ if (elapsed > dev->kite.wa.max_ns) dev->kite.wa.max_ns = elapsed;
+ spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+ b->count = 0;
+}
