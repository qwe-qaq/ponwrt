+#ifdef CONFIG_MT7915_NPU
+static void mt7915_rx_poll_observe(struct mt76_dev *mdev, int q, int done, int budget, u64 ns)
+{
+ struct mt7915_dev *dev = container_of(mdev, struct mt7915_dev, mt76);
+ struct mt7915_kite_napi_stats *v;
+ unsigned long flags;
+ if (!READ_ONCE(dev->kite.dp_bound) || q < 0 || q >= __MT_RXQ_MAX) return;
+ spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+ v = &dev->kite.napi[q]; v->polls++; v->packets += done; v->budget += done >= budget;
+ v->total_ns += ns; if (ns > v->max_ns) v->max_ns = ns;
+ spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+}
+#endif
