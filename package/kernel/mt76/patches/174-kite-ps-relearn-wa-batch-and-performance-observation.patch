+/* SPDX-License-Identifier: ISC */
+#define MT7915_KITE_WAKE_QUIET_MS 250
+static void mt7915_dp_ps_work(struct work_struct *work)
+{
+ struct mt7915_dev *dev = container_of(to_delayed_work(work), struct mt7915_dev, kite.dp_ps_work);
+ unsigned int wi;
+ unsigned long again = 0;
+ mutex_lock(&dev->mt76.mutex);
+ for (wi = 1; wi < KDP_WCIDS; wi++) {
+  struct mt7915_kite_ps_state *p = &dev->kite.ps[wi];
+  struct kdp_shared *s;
+  unsigned long flags, delay;
+  bool revoke = false;
+  int ret;
+  spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+  s = READ_ONCE(dev->mt76.kite_dp);
+  if (!test_bit(wi, dev->kite.dp_ps_pending)) goto unlock;
+  if (!s || !dev->kite.dp_attached || dev->kite.failed || dev->kite.dp_work_stopping ||
+      !dev->kite.live[wi]) {
+   clear_bit(wi, dev->kite.dp_ps_pending);
+   /* Never modify a reused WCID/key using a retired worker request. */
+   goto unlock;
+  }
+  if (p->generation != s->sta[wi].generation || p->key_generation != s->sta[wi].key_generation) {
+   /* A key/STA transaction already fenced the old generation. Adopt only
+    * an explicit software fence on the current live identity; a retired
+    * request must never clear unrelated state on a reused WCID. */
+   memset(p, 0, sizeof(*p));
+   p->generation = s->sta[wi].generation; p->key_generation = s->sta[wi].key_generation;
+   if (!(s->sta[wi].tx_blocked & KDP_TX_BLOCK_SOFTWARE)) {
+    clear_bit(wi, dev->kite.dp_ps_pending); goto unlock;
+   }
+   WRITE_ONCE(s->sta[wi].tx_blocked, s->sta[wi].tx_blocked | KDP_TX_BLOCK_WAKE);
+   dma_wmb(); p->changed_at = jiffies; p->since_ns = ktime_get_ns();
+  }
+  /* Track PS even while the controlled port is closed; enabled remains
+   * an independent admission check. Otherwise re-authorization could
+   * inherit a stranded WAKE bit or lose the last sleeping indication. */
+  revoke = !p->revoked;
+  spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+  if (revoke) {
+   u64 start = ktime_get_ns();
+   ret = airoha_kite_revoke_tx(rcu_access_pointer(dev->mt76.mmio.ppe_dev), wi);
+   mt7915_kite_context_done(dev, 0, wi, start, ret);
+   if (ret) {
+    mutex_lock(&dev->kite.lock); mt7915_kite_fault(dev, ret); mutex_unlock(&dev->kite.lock);
+    break; /* admission and ownership remain closed */
+   }
+  }
+  spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+  /* mt76.mutex excludes key/STA replacement across the sleeping revoke. */
+  if (revoke) { p->revoked = 1; p->revokes++; }
+  if (READ_ONCE(s->sta[wi].tx_blocked) & KDP_TX_BLOCK_PS) goto unlock;
+  delay = msecs_to_jiffies(MT7915_KITE_WAKE_QUIET_MS);
+  if (time_before(jiffies, p->changed_at + delay)) {
+   delay = p->changed_at + delay - jiffies;
+   if (!again || delay < again) again = delay;
+   goto unlock;
+  }
+  /* Only a completed revoke and a quiet awake interval can reopen native
+   * flow learning. Do not reinstall the retired hardware policy. */
+  WRITE_ONCE(s->sta[wi].tx_blocked, s->sta[wi].tx_blocked & ~KDP_TX_BLOCK_WAKE);
+  dma_wmb();
+  clear_bit(wi, dev->kite.dp_ps_pending);
+  p->revoked = 0; p->resumes++;
+  if (p->since_ns) {
+   u64 elapsed = ktime_get_ns() - p->since_ns;
+   p->blocked_ns += elapsed;
+   if (elapsed > p->max_blocked_ns) p->max_blocked_ns = elapsed;
+   p->since_ns = 0;
+  }
+  spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+  mt7915_kite_trace_event(dev, 27, wi, 0, 0);
+  airoha_kite_learn_hint(rcu_access_pointer(dev->mt76.mmio.ppe_dev));
+  continue;
+unlock:
+  spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+ }
+ mutex_unlock(&dev->mt76.mutex);
+ /* Do not postpone an immediate notification already queued by NAPI. */
+ if (again && !READ_ONCE(dev->kite.dp_work_stopping))
+  queue_delayed_work(system_wq, &dev->kite.dp_ps_work, again);
+}
+void mt7915_npu_dp_work_init(struct mt7915_dev *dev)
+{
+ INIT_DELAYED_WORK(&dev->kite.dp_ps_work, mt7915_dp_ps_work);
+ dev->kite.dp_work_initialized = true;
+}
+void mt7915_npu_dp_work_stop(struct mt7915_dev *dev)
+{
+ unsigned long flags;
+ if (!dev->kite.dp_work_initialized) return;
+ spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+ WRITE_ONCE(dev->kite.dp_work_stopping, true);
+ spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+ cancel_delayed_work_sync(&dev->kite.dp_ps_work);
+}
+void mt7915_npu_ps(struct mt7915_dev *dev, u16 wi, bool ps)
+{
+ struct kdp_shared *s;
+ struct mt7915_kite_ps_state *p;
+ unsigned long flags;
+ bool changed = false;
+ spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+ s = READ_ONCE(dev->mt76.kite_dp);
+ if (!s || !wi || wi >= KDP_WCIDS || !dev->kite.dp_bound || dev->kite.dp_work_stopping || !dev->kite.live[wi])
+  goto out;
+ p = &dev->kite.ps[wi];
+ if (p->generation != s->sta[wi].generation || p->key_generation != s->sta[wi].key_generation) {
+  memset(p, 0, sizeof(*p));
+  p->generation = s->sta[wi].generation; p->key_generation = s->sta[wi].key_generation;
+ }
+ changed = !!(s->sta[wi].tx_blocked & KDP_TX_BLOCK_PS) != ps;
+ if (!changed) { p->coalesced++; goto out; }
+ p->changes++; if (ps) p->sleeps++; else p->wakes++;
+ p->changed_at = jiffies;
+ if (!p->since_ns) p->since_ns = ktime_get_ns();
+ /* WAKE remains set through oscillation and the sleeping revoke worker. */
+ WRITE_ONCE(s->sta[wi].tx_blocked, (s->sta[wi].tx_blocked | KDP_TX_BLOCK_WAKE) & ~KDP_TX_BLOCK_PS);
+ if (ps) WRITE_ONCE(s->sta[wi].tx_blocked, s->sta[wi].tx_blocked | KDP_TX_BLOCK_PS);
+ dma_wmb();
+ set_bit(wi, dev->kite.dp_ps_pending);
+ mod_delayed_work(system_wq, &dev->kite.dp_ps_work, 0);
+out:
+ spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+ if (changed) mt7915_kite_trace_event(dev, 26, wi, ps, 0);
+}
