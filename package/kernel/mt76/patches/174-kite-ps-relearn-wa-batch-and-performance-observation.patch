+   for (i = 0; i < 4; i++) {
+    seq_printf(m, "r59_age%u_%u", b, i);
+    for (j = 0; j < 8; j++) seq_printf(m, " bin%u=%u", j, z->age[i][j]);
+    seq_putc(m, '\n');
+   }
+  }
