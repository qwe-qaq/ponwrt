+void mt7915_npu_control_detach(struct mt7915_dev *dev)
+{
+	struct airoha_npu *npu;
+	int ret = 0;
+
+	mutex_lock(&dev->kite.lock);
+	npu = dev->kite.control_npu;
+	if (!npu)
+		goto out;
+	if (dev->kite.active && !dev->kite.failed) {
+		ret = mt7915_kite_command(dev, KITE_CTL_PARK, NULL, 0);
+		if (!ret)
