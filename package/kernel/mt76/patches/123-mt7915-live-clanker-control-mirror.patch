+	    !dev->kite.active || dev->kite.failed)
+		return;
+	mutex_lock(&dev->kite.lock);
+	ret = mt7915_kite_command(dev, KITE_CTL_PARK, NULL, 0);
+	if (!ret)
+		ret = mt7915_kite_wait_parked(dev);
+	if (!ret)
+		ret = mt7915_kite_command(dev, KITE_CTL_CLOSE, NULL, 0);
+	if (ret)
+		mt7915_kite_fault(dev, ret);
+	else {
+		dev->kite.active = false;
+		memset(dev->kite.live, 0, sizeof(dev->kite.live));
+	}
+	mutex_unlock(&dev->kite.lock);
+	if (ret)
+		return;
+	ret = mt7915_npu_control_open(dev);
+	if (!ret)
+		ret = mt7915_npu_control_resume(dev);
+	if (ret && !dev->kite.failed) {
+		mutex_lock(&dev->kite.lock);
+		mt7915_kite_fault(dev, ret);
+		mutex_unlock(&dev->kite.lock);
+	}
+}
