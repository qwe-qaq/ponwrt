+		if (ret)
+			mt7915_kite_fault(dev, ret);
+	}
+	if (dev->kite.failed)
+		dev_warn(dev->mt76.dev,
+			 "Kite mirror detached with unconfirmed session; BA reservation retained, reopen requires closed firmware session\n");
+	dev->kite.active = false;
+	dev->kite.control_npu = NULL;
+	airoha_npu_put(npu);
