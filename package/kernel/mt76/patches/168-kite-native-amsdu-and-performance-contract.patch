+/* Update just the optional aggregation word, never station authorization.
+ * The MCU caller has first withdrawn the old publication and, if it was
+ * usable, drained both host and NPU TX before changing the HW contract. */
+void mt7915_npu_amsdu_update(struct mt7915_dev *dev, struct mt7915_sta *msta)
+{
+	struct kdp_shared *s = READ_ONCE(dev->mt76.kite_dp);
+	struct ieee80211_sta *sta = container_of((void *)msta, struct ieee80211_sta, drv_priv);
+	struct ieee80211_vif *vif = container_of((void *)msta->vif, struct ieee80211_vif, drv_priv);
+	u16 wi = msta->wcid.idx;
+	u32 contract;
+
+	if (!s || !dev->kite.dp_bound || !wi || wi >= KDP_WCIDS ||
+	    !READ_ONCE(dev->kite.live[wi]))
+		return;
+	contract = kdp_amsdu_contract(npu_amsdu && vif->type == NL80211_IFTYPE_AP &&
+		!test_bit(MT_WCID_FLAG_4ADDR, &msta->wcid.flags) && !sta->tdls,
+		msta->wcid.amsdu, sta->wme, msta->npu_amsdu_len,
+		msta->npu_amsdu_tids);
+	dma_wmb();
+	WRITE_ONCE(s->sta[wi].amsdu, contract);
+}
+
+int mt7915_npu_amsdu_pause(struct mt7915_dev *dev, struct mt7915_sta *msta)
+{
+	struct kdp_shared *s = READ_ONCE(dev->mt76.kite_dp);
+	u16 wi = msta->wcid.idx;
+	int ret;
+
+	if (!s || !dev->kite.dp_bound || !wi || wi >= KDP_WCIDS)
+		return 0;
+	/* Suppress any newly prepared aggregate before draining already
+	 * published descriptors; a failed proof leaves normal recovery held. */
+	if (!(READ_ONCE(s->sta[wi].amsdu) & 0xff))
+		return 0;
+	/* flow_offload_mutex callbacks may concurrently PARK/RESUME. Hold
+	 * their admission too until this MCU transaction has finished. */
+	mutex_lock(&dev->kite.lock);
+	if (READ_ONCE(dev->kite.dp_changing)) {
+		mutex_unlock(&dev->kite.lock);
+		return -EBUSY;
+	}
+	/* Serialize with the entire RESUME check-and-open critical section,
+	 * not just its flag read: an older callback must not open the gate
+	 * after the drain has begun. Do not hold this mutex while draining. */
+	WRITE_ONCE(dev->kite.dp_changing, true);
+	WRITE_ONCE(s->sta[wi].amsdu, 0);
+	dma_wmb();
+	mutex_unlock(&dev->kite.lock);
+	ret = mt7915_npu_tx_fence(dev);
+	return ret ? ret : 1;
+}
+
+void mt7915_npu_amsdu_resume(struct mt7915_dev *dev)
+{
+	/* Only the caller which acquired this fence releases it. On fence
+	 * failure, normal recovery retains dp_changing and TX ownership. */
+	mutex_lock(&dev->kite.lock);
+	WRITE_ONCE(dev->kite.dp_changing, false);
+	mt7915_npu_tx_unfence(dev);
+	mutex_unlock(&dev->kite.lock);
+}
