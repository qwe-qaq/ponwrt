 /* SPDX-License-Identifier: ISC */
 /* Retry schedules observations; elapsed time is never drain proof. */
 #define MT7915_KITE_DRAIN_RETRY_MS 10
-static bool mt7915_dp_ps_queues_pending(struct mt7915_dev *dev, u32 wi)
+#define MT7915_KITE_PS_HOST BIT(7)
+#define MT7915_KITE_PS_OFFCHANNEL BIT(8)
+#define MT7915_KITE_PS_IDENTITY BIT(9)
+
+/* mt76.mutex protects q/shared lifetimes. No ownership is released here. */
+static bool mt7915_dp_ps_tx_identity(struct mt7915_dev *dev,
+                                    struct mt76_queue *q)
+{
+ struct kite_tx_shared *tx;
+ if (!q || !q->kite_tx_active || q->kite_tx_blocked) return false;
+ tx=q->kite_tx;
+ return tx && kite_tx_read(&tx->magic)==KITE_TX_MAGIC &&
+        kite_tx_read(&tx->session)==dev->kite.session &&
+        kite_tx_read(&tx->count)==KITE_TX_COUNT &&
+        !kite_tx_read(&tx->fault) && !kite_tx_read(&tx->cancelled);
+}
+static u32 mt7915_dp_ps_queues_pending(struct mt7915_dev *dev, u32 wi,
+                                      struct mt7915_kite_ps_fence *f)
 {
  struct mt76_wcid *wcid;
  struct mt7915_sta *msta;
  struct ieee80211_sta *sta;
- bool pending=true;
+ struct mt76_queue *q;
+ unsigned long flags;
+ u32 pending,band=READ_ONCE(dev->mt76.kite_dp->sta[wi].band);
  wcid=rcu_dereference_protected(dev->mt76.wcid[wi],lockdep_is_held(&dev->mt76.mutex));
- if (!wcid || !wcid->sta) return true;
+ if (!wcid || !wcid->sta || band>=ARRAY_SIZE(dev->kite.txq)) return MT7915_KITE_PS_IDENTITY;
  msta=container_of(wcid,struct mt7915_sta,wcid);
  sta=container_of((void *)msta,struct ieee80211_sta,drv_priv);
+ q=dev->kite.txq[band];
  mt76_worker_disable(&dev->mt76.tx_worker);
  pending=ieee80211_sta_tx_pending(sta);
- pending |= !skb_queue_empty(&wcid->tx_pending) || !skb_queue_empty(&wcid->tx_offchannel) ||
-            atomic_read(&wcid->non_aql_packets);
+ if (!skb_queue_empty(&wcid->tx_pending)) pending |= MT7915_KITE_PS_HOST;
+ if (!skb_queue_empty(&wcid->tx_offchannel)) pending |= MT7915_KITE_PS_OFFCHANNEL;
+ if (!pending && q) {
+  spin_lock_irqsave(&q->lock,flags);
+  if (mt7915_dp_ps_tx_identity(dev,q)) {
+   f->session=kite_tx_read(&q->kite_tx->session);
+   f->epoch=kite_tx_read(&q->kite_tx->epoch);
+   f->reaped=kite_tx_read(&q->kite_tx->reaped); dma_rmb();
+   f->target=q->kite_staged;
+   /* At most one staging ring plus one device ring can be outstanding. */
+   if ((u32)(f->target-f->reaped)>2*KITE_TX_COUNT) pending |= MT7915_KITE_PS_IDENTITY;
+  } else pending |= MT7915_KITE_PS_IDENTITY;
+  spin_unlock_irqrestore(&q->lock,flags);
+ } else if (!q) pending |= MT7915_KITE_PS_IDENTITY;
  mt76_worker_enable(&dev->mt76.tx_worker);
  return pending;
+}
+/* Once captured, later ordinary traffic cannot move this target. Native
+ * AC/PSD and direct NPU TX use the same band WFDMA FIFO. Actual DMA reap
+ * proves transfer of the older prefix; WA remains the payload owner. */
+static bool mt7915_dp_ps_prefix_done(struct mt7915_dev *dev, u32 wi,
+                                    struct mt7915_kite_ps_fence *f)
+{
+ u32 band=READ_ONCE(dev->mt76.kite_dp->sta[wi].band);
+ struct mt76_queue *q;
+ if (band>=ARRAY_SIZE(dev->kite.txq)) return false;
+ q=dev->kite.txq[band];
+ if (!mt7915_dp_ps_tx_identity(dev,q) ||
+     kite_tx_read(&q->kite_tx->session)!=f->session ||
+     kite_tx_read(&q->kite_tx->epoch)!=f->epoch) return false;
+ f->reaped=kite_tx_read(&q->kite_tx->reaped); dma_rmb();
+ return (s32)(f->reaped-f->target)>=0;
 }
 static void mt7915_dp_ps_work(struct work_struct *work)
 {
