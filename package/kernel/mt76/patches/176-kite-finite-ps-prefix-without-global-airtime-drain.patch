+       issued-failed!=READ_ONCE(s->r60.ps[wi].consumed)) {
+    p->queue_wait++; again=msecs_to_jiffies(MT7915_KITE_DRAIN_RETRY_MS); goto unlock;
+   }
+   p->fence=fence; p->fence_valid=1; p->fence_changes=changes;
