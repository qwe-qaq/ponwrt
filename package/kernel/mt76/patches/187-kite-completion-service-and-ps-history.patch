 #ifdef CONFIG_MT7915_NPU
+/* First pending tasklet scheduling timestamp, consumed once by the poll.
+ * No descriptor access, no logging, and never holds a lock across NAPI. */
+static void mt7915_kite_rx_schedule(struct mt7915_dev *dev, u32 intr)
+{
+ static const u8 queues[]={MT_RXQ_MCU,MT_RXQ_MCU_WA,MT_RXQ_MAIN_WA,MT_RXQ_BAND1_WA};
+ unsigned long flags;u64 now;
+ if (!READ_ONCE(dev->kite.dp_bound) || !READ_ONCE(dev->kite.observe_service)) return;
+ now=ktime_get_mono_fast_ns();
+ spin_lock_irqsave(&dev->kite.dp_done_lock,flags);
+ for(u32 i=0;i<ARRAY_SIZE(queues);i++){
+  u32 q=queues[i];
+  if ((intr&MT_INT_RX(q)) && !dev->kite.napi[q].schedule_ns)
+   dev->kite.napi[q].schedule_ns=now;
+ }
+ spin_unlock_irqrestore(&dev->kite.dp_done_lock,flags);
+}
 static void mt7915_rx_poll_observe(struct mt76_dev *mdev, int q, int done, int budget, u64 ns)
 {
  struct mt7915_dev *dev = container_of(mdev, struct mt7915_dev, mt76);
@@ -824,6 +840,16 @@
  spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
  v = &dev->kite.napi[q]; v->polls++; v->packets += done; v->budget += done >= budget;
  v->total_ns += ns; if (ns > v->max_ns) v->max_ns = ns;
+ if (READ_ONCE(dev->kite.observe_service)) {
+  u64 end=ktime_get_mono_fast_ns(),start=end>=ns?end-ns:0;
+  if (v->schedule_ns && start>=v->schedule_ns) {
+   u64 delay=start-v->schedule_ns;
+   v->delay_samples++;v->delay_ns+=delay;if(delay>v->delay_max_ns)v->delay_max_ns=delay;
+   v->schedule_ns=0;
+  }
+  /* A concurrently scheduled next poll timestamp must not be consumed. */
+  v->last_poll_ns=end;
+ }
  spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
  mt7915_npu_ps_progress(mdev);
 }
