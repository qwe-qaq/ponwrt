+static int mt7915_kite_ps_history_show(struct seq_file *m, void *unused)
+{
+ struct mt7915_dev *dev=m->private;u32 last;
+ spin_lock_bh(&dev->kite.dp_done_lock);last=dev->kite.ps_event_serial;spin_unlock_bh(&dev->kite.dp_done_lock);
+ seq_printf(m,"r76_ps_ring last=%u first=%u overwritten=%u capacity=%u serial_modulo_u32=1\n",
+  last,last>MT7915_KITE_PS_EVENTS?last-MT7915_KITE_PS_EVENTS+1:!!last,
+  last>MT7915_KITE_PS_EVENTS?last-MT7915_KITE_PS_EVENTS:0,MT7915_KITE_PS_EVENTS);
+ for(u32 i=0;i<MT7915_KITE_PS_EVENTS;i++){
+  struct mt7915_kite_ps_event e;
+  spin_lock_bh(&dev->kite.dp_done_lock);e=dev->kite.ps_events[i];spin_unlock_bh(&dev->kite.dp_done_lock);
+  if(e.serial)seq_printf(m,"r63_ps_event serial=%u ns=%llu event=%u wcid=%u raw=%u generation=%u key_generation=%u request=%u blocked=%u issued=%u consumed=%u\n",
+   e.serial,e.ns,e.event,e.wcid,e.raw,e.generation,e.key_generation,e.request,e.blocked,e.issued,e.consumed);
+ }
+ return 0;
+}
