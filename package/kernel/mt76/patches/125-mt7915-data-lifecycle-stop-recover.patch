+static int mt7915_kite_wait_stopped(struct mt7915_dev *dev)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(1000);
+	u32 s[KITE_CTL_WORDS];
+	int ret;
+
+	do {
+		ret = mt7915_kite_status(dev, s);
+		if (ret)
+			return ret;
+		if (s[3] != dev->kite.session || s[4] != dev->kite.serial)
+			return -EPROTO;
+		if (s[6] == KITE_CTL_STOPPED && s[7] == KITE_CTL_WORKERS)
+			return 0;
+		if (s[6] == KITE_CTL_FAULTED ||
+		    s[6] == KITE_CTL_FAULTED_DRAIN)
+			return -EIO;
+		usleep_range(1000, 2000);
+	} while (time_before(jiffies, deadline));
+	return -ETIMEDOUT;
