+/* Serialize observation and the existing gate write, without changing any
+ * caller's admission condition or DMA ordering. Attribution is to the FIRST
+ * closer; repeated closes are counted without restarting the duration. */
+static void mt7915_kite_gate_set(struct mt7915_dev *dev, struct kdp_shared *s,
+                                bool close, unsigned int reason)
+{
+ unsigned long flags;
+ u64 now, duration;
+ struct mt7915_kite_gate_stat *stat;
+ spin_lock_irqsave(&dev->kite.trace_lock, flags);
+ now = ktime_get_ns();
+ if (close) {
+  dev->kite.gate_stat[reason].requests++;
+  if (!dev->kite.gate_observed) {
+   dev->kite.gate_observed = true;
+   dev->kite.gate_since = now;
+   dev->kite.gate_reason = reason;
+   dev->kite.gate_stat[reason].closed++;
+  }
+ } else if (dev->kite.gate_observed) {
+  stat = &dev->kite.gate_stat[dev->kite.gate_reason];
+  duration = now - dev->kite.gate_since;
+  stat->total_ns += duration;
+  if (duration > stat->max_ns) stat->max_ns = duration;
+  dev->kite.gate_observed = false;
+ }
+ WRITE_ONCE(s->gate, close);
+ spin_unlock_irqrestore(&dev->kite.trace_lock, flags);
+}
+static void mt7915_kite_context_done(struct mt7915_dev *dev, unsigned int reason,
+                                    u32 wcid, u64 start, int error)
+{
