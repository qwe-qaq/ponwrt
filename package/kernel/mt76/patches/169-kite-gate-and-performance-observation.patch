+ u64 duration = ktime_get_ns() - start;
+ struct mt7915_kite_context_stat *stat;
+ spin_lock_irqsave(&dev->kite.trace_lock, flags);
+ stat = &dev->kite.context_stat[reason];
+ stat->calls++; stat->total_ns += duration; stat->failed += !!error;
+ if (duration > stat->max_ns) stat->max_ns = duration;
+ dev->kite.context_wcid[reason] = wcid;
+ spin_unlock_irqrestore(&dev->kite.trace_lock, flags);
+ mt7915_kite_trace_event(dev, 17, reason, wcid, error);
+}
 
