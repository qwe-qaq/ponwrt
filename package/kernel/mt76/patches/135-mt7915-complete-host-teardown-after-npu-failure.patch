Subject: mt7915: finish host station teardown after an NPU control failure

Keep NPU failure and DMA ownership intact, while honoring mac80211 downward
station and key removal callbacks. New station/key authorization still fails.

--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -454,6 +454,15 @@
 	if (!err)
 		mt7915_npu_key_commit(dev, wcid, key);
 out:
+	/* mac80211 key removal cannot be rejected. A failed NPU fence keeps
+	 * admission closed and DMA ownership retained, but must not leave a
+	 * deleted host key index live. Installs still propagate every error.
+	 */
+	if (cmd == DISABLE_KEY) {
+		if (idx == *wcid_keyidx)
+			*wcid_keyidx = -1;
+		err = 0;
+	}
 	mt7915_npu_tx_unfence(dev);
 	mutex_unlock(&dev->mt76.mutex);
 
@@ -930,9 +939,11 @@
 		return mt7915_npu_port(dev, msta, true);
 
 	case MT76_STA_EVENT_DISASSOC:
-		ret = mt7915_npu_port(dev, msta, false);
-		if (ret)
-			return ret;
+		/* Downward sta_state transitions must complete host/MCU cleanup.
+		 * NPU errors remain latched; this does not ACK its drain, release
+		 * mappings, or permit a new STA/authorization in the failed session.
+		 */
+		mt7915_npu_port(dev, msta, false);
 		mutex_lock(&dev->mt76.mutex);
 		for (i = 0; i < ARRAY_SIZE(msta->twt.flow); i++)
 			mt7915_mac_twt_teardown_flow(dev, msta, i);
