+/* ABI11: bounded PS authorization and ordered host handoff. Existing DMA
+ * offsets stay fixed. ARM owns request/active and soft flow versions;
+ * hart4 owns issued/failed/drained; the host RX consumer owns consumed.
+ * Counters are cumulative for the shared session, never reset on a wake. */
+struct kdp_suspend {
+ unsigned int request, active, issued, failed, consumed, drained;
+ unsigned int consumed_serial;
+ /* ARM-only observation: first real BIND after wake, millisecond clock. */
+ unsigned int resume_ms, learned_ms, learned_request;
+};
+#define KDP_HOST_FALLBACK_RECORD 0x800u
+#define KDP_HOST_RECORD_WORDS 6u
+#define KDP_HOST_RECORD_BYTES (KDP_HOST_RECORD_WORDS * 4u)
+struct kdp_r60 {
+ unsigned int drain_wcid; /* host selects one bounded drain probe */
+ unsigned int bind_state, bind_glb_before, bind_glb_after, unbind_glb;
+ unsigned int bind_ring[2][4]; /* base/count/cpu/dma readback */
+ unsigned int degraded[2], ingress_reason[2], ingress_p7;
+ unsigned int ps_wait_polls[2], ps_parse_drop[2], ps_policy_drop[2];
+ unsigned int host_ps_rejected[2], host_ps_delivered[2];
+ unsigned int soft_full, soft_unsupported;
+ struct kdp_observe_time gap[2][2]; /* TDMA ready / WFDMA publish; ticks=256 cycles */
+ struct kdp_suspend ps[KDP_WCIDS];
+ struct kdp_flow soft[KDP_FLOWS];
+ unsigned int soft_request[KDP_FLOWS];
 };
