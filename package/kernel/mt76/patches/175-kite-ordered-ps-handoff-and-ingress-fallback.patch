+/* Public checked entry. The TDMA producer uses the word writer only
+ * after its descriptor range, token, frame length and TID checks. */
+static inline int kdp_write_txwi(unsigned char *p, const struct kdp_txwi_template *t,
+ unsigned int pa, unsigned int len, unsigned int token, unsigned int tid, unsigned int amsdu)
