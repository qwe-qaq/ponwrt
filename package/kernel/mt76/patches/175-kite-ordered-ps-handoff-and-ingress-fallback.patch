+static inline int kdp_soft_type(unsigned int type)
+{
+ return type==KDP_FLOW_IPV4 || type==KDP_FLOW_IPV6 ||
+        type==KDP_FLOW_BRIDGE_IPV4 || type==KDP_FLOW_BRIDGE_IPV6;
+}
+static inline unsigned int kdp_soft_find(const volatile struct kdp_shared *s,
+ const struct kdp_packet *p, unsigned int wi, unsigned int request)
+{
+ unsigned int base,i;
+ const volatile struct kdp_sta *sta=&s->sta[wi];
+ if (!request || s->r60.ps[wi].active!=request) return KDP_SLOT_NONE;
+ base=kdp_flow_bucket(p->smac,p->dmac,p->vlan,wi);
+ base=kdp_flow_l4_bucket(base,p->src,p->dst,p->ports,p->protocol,p->type);
+ for (i=base;i<base+KDP_FLOW_WAYS;i++)
+  if (kdp_soft_type(s->r60.soft[i].type) && s->r60.soft_request[i]==request &&
+      kdp_flow_matches(&s->r60.soft[i],p,s->session,sta->generation,
+                       sta->key_generation,wi,sta->band,sta->bss)) return i;
+ return KDP_SLOT_NONE;
+}
+static inline int kdp_soft_record_matches(const volatile struct kdp_shared *s,
+ const struct kdp_packet *p, unsigned int wi, unsigned int request,
+ unsigned int slot, unsigned int version, unsigned int tag)
+{
+ if (!wi || wi>=KDP_WCIDS || !request || slot>=KDP_FLOWS || !version ||
+     s->r60.ps[wi].request!=request || s->r60.ps[wi].active!=request ||
+     !kdp_soft_type(s->r60.soft[slot].type) || s->r60.soft_request[slot]!=request || s->r60.soft[slot].version!=version ||
+     s->sta[wi].tx_tag!=tag || !s->sta[wi].enabled || !s->sta[wi].authorized)
+  return 0;
+ if (!kdp_flow_matches(&s->r60.soft[slot],p,s->session,s->sta[wi].generation,
+     s->sta[wi].key_generation,wi,s->sta[wi].band,s->sta[wi].bss)) return 0;
+ KDP_BARRIER();
+ return s->r60.soft[slot].version==version && s->r60.ps[wi].active==request;
+}
