+/* Counters are per driver instance and wrap modulo 2^32. Read-only
+ * observation never changes IRQ affinity, ownership or firmware state. */
+static int mt7915_kite_rx_show(struct seq_file *seq, void *data)
+{
+	struct mt7915_dev *dev = seq->private;
+	int b;
+
+	mutex_lock(&dev->mt76.mutex);
+	seq_printf(seq, "rx_host_abi=1 batching=1 session=%u epoch=%u\n",
+		   dev->kite.session, dev->kite.host_epoch);
+	for (b = 0; b < 2; b++) {
+		struct mt76_queue *q = &dev->mt76.q_rx[MT_RXQ_NPU0 + b];
+
+		seq_printf(
+			seq,
+			"band%d polls=%u frames=%u batches=%u invalid=%u empty=%u budget=%u refill_short=%u max_batch=%u irqs=%u irq_empty=%u queued=%d ndesc=%d\n",
+			b, READ_ONCE(q->kite_rx_polls),
+			READ_ONCE(q->kite_rx_frames),
+			READ_ONCE(q->kite_rx_batches),
+			READ_ONCE(q->kite_rx_invalid),
+			READ_ONCE(q->kite_rx_empty),
+			READ_ONCE(q->kite_rx_budget),
+			READ_ONCE(q->kite_rx_refill_short),
+			READ_ONCE(q->kite_rx_max_batch),
+			READ_ONCE(q->kite_rx_irqs),
+			READ_ONCE(q->kite_rx_irq_empty), READ_ONCE(q->queued),
+			q->ndesc);
+	}
+	mutex_unlock(&dev->mt76.mutex);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mt7915_kite_rx);
 DEFINE_SHOW_ATTRIBUTE(mt7915_kite_tx);
 void mt7915_npu_tx_debugfs(struct mt7915_dev *dev, struct dentry *dir)
 {
 	debugfs_create_file("kite_tx", 0400, dir, dev, &mt7915_kite_tx_fops);
-}
+	debugfs_create_file("kite_rx", 0400, dir, dev, &mt7915_kite_rx_fops);
+}
