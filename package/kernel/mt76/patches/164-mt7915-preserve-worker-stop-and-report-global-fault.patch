+
+/* Serialized by mt76.mutex, including failed reset retries. */
+static inline void mt7915_tx_worker_disable(struct mt7915_dev *dev)
+{
+	if (dev->recovery.tx_worker_stopped)
+		return;
+	mt76_worker_disable(&dev->mt76.tx_worker);
+	dev->recovery.tx_worker_stopped = true;
+}
+
+static inline void mt7915_tx_worker_enable(struct mt7915_dev *dev)
+{
+	if (!dev->recovery.tx_worker_stopped)
+		return;
+	mt76_worker_enable(&dev->mt76.tx_worker);
+	dev->recovery.tx_worker_stopped = false;
+}
 
