+static int mt7915_kite_command(struct mt7915_dev *dev, u32 op,
+			       const u32 *args, unsigned int nargs)
+{
+	return __mt7915_kite_command(dev, op, args, nargs, false);
+}
+
+/* A failed transaction blocks ordinary updates.  Recovery may continue only
+ * after a fresh status read proves the same session is still alive and is not
+ * in a firmware FAULTED state.  This is the ownership proof that permits a
+ * PARK/DATA_STOP sequence; it never clears the failure latch by itself. */
+static int mt7915_kite_recovery_command(struct mt7915_dev *dev, u32 op,
+					const u32 *args, unsigned int nargs,
+					u32 *state)
+{
+	u32 s[KITE_CTL_WORDS];
+	int ret;
+
+	ret = mt7915_kite_status(dev, s);
+	if (ret)
+		return ret;
+	if (s[3] != dev->kite.session || s[6] == KITE_CTL_CLOSED ||
+	    s[6] == KITE_CTL_FAULTED || s[6] == KITE_CTL_FAULTED_DRAIN)
+		return -EIO;
+	dev->kite.recovery_status = s[6];
+	dev->kite.recovery_attempts++;
+	if (state)
+		*state = s[6];
+	/* Keep recovery commands inside the firmware's documented state
+	 * machine.  A valid mailbox response is not by itself proof that an
+	 * operation is meaningful in the current lifecycle state. */
+	switch (op) {
+	case KITE_CTL_PARK:
+		if (s[6] == KITE_CTL_STOPPING || s[6] == KITE_CTL_STOPPED)
+			return -EBUSY;
+		break;
+	case KITE_CTL_DATA_STOP:
+		if (s[6] != KITE_CTL_RUNNING && s[6] != KITE_CTL_PARKED)
+			return -EBUSY;
+		break;
+	case KITE_CTL_DATA_RECOVER:
+		if (s[6] != KITE_CTL_STOPPED)
+			return -EBUSY;
+		break;
+	case KITE_CTL_TX_UNBIND:
+	case KITE_CTL_DP_UNBIND:
+	case KITE_CTL_HOST_UNBIND:
+		if (s[6] != KITE_CTL_PARKED && s[6] != KITE_CTL_STOPPED)
+			return -EBUSY;
+		break;
+	default:
+		break;
+	}
+	return __mt7915_kite_command(dev, op, args, nargs, true);
+}
