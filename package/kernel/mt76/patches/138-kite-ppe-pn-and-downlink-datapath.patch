+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PONWRT_KITE_REORDER_H
+#define PONWRT_KITE_REORDER_H
+
+/* Fixed 12-bit sequence space; windows are at most 256 MPDUs. Storage is
+ * per negotiated BA session, not per possible WCID. A cell owns a complete
+ * A-MSDU chain or an unfinished one. Only complete MPDUs can be indicated.
+ * The caller serializes each session and supplies buffer-release callbacks.
+ */
+#define KDP_BA_SLOTS 256u
+#define KDP_BA_SESSIONS 128u
+#define KDP_BA_NONE 0xffffu
+struct kdp_mpdu {
+	unsigned int pn_low, pn_high, tick;
+	unsigned short head, tail, count, sn;
+	unsigned char complete, encrypted, reserved[2];
+};
+struct kdp_ba {
+	unsigned int generation, key_generation;
+	unsigned short wcid, tid, head, window;
+	struct kdp_mpdu slot[KDP_BA_SLOTS];
+};
+
+/* Buffers have one link while owned by this engine. A callback accepting
+ * a released MPDU becomes its owner, including when it chooses to drop it.
+ * No callback may re-enter this session.
+ */
+struct kdp_reorder_ops {
+	void (*drop)(void *ctx, unsigned short token);
+	void (*link)(void *ctx, unsigned short first, unsigned short next);
+	void (*release)(void *ctx, const struct kdp_mpdu *mpdu);
+};
+
+static inline void kdp_ba_empty(struct kdp_mpdu *m)
+{
+	m->head = m->tail = KDP_BA_NONE;
+	m->count = 0;
+	m->complete = 0;
+}
+
+static inline void kdp_ba_release(struct kdp_ba *b,
+	const struct kdp_reorder_ops *ops, void *ctx)
+{
+	struct kdp_mpdu *m = &b->slot[b->head & (KDP_BA_SLOTS - 1)];
+	if (m->count) {
+		/* release also receives incomplete chains and MUST drop them */
+		ops->release(ctx, m);
+		kdp_ba_empty(m);
+	}
+	b->head = (b->head + 1) & 4095;
+}
+
+static inline void kdp_ba_reset(struct kdp_ba *b, unsigned int ssn,
+	unsigned int window, const struct kdp_reorder_ops *ops, void *ctx)
+{
+	unsigned int i;
+	for (i = 0; i < KDP_BA_SLOTS; i++) {
+		struct kdp_mpdu *m = &b->slot[i];
+		if (m->count) {
+			m->complete = 0;
+			ops->release(ctx, m);
+		}
+		kdp_ba_empty(m);
+	}
+	b->head = ssn & 4095;
+	b->window = window <= KDP_BA_SLOTS ? window : 0;
+}
+
+/* MT7916 payload-format: 0 single, 3 first, 2 middle, 1 last.
+ * Equal PN is permitted only WITHIN one not-yet-released MPDU, with matching
+ * sequence/cipher and an actual first subframe. Replay is checked once by
+ * release, after sequence reorder, for the entire MPDU.
+ */
+static inline void kdp_ba_enqueue(struct kdp_ba *b, unsigned short token,
+	unsigned int sn, unsigned int format, unsigned int encrypted,
+	unsigned int low, unsigned int high, unsigned int tick,
+	const struct kdp_reorder_ops *ops, void *ctx)
+{
+	struct kdp_mpdu *m;
+	unsigned int delta;
+	if (!b->window || b->window > KDP_BA_SLOTS || sn > 4095 ||
+	    format > 3 || high > 0xffff || token == KDP_BA_NONE) {
+		ops->drop(ctx, token);
+		return;
+	}
+	delta = (sn - b->head) & 4095;
+	if (delta >= 2048) {
+		ops->drop(ctx, token);
+		return;
+	}
+	while (delta >= b->window) {
+		kdp_ba_release(b, ops, ctx);
+		delta--;
+	}
+	m = &b->slot[sn & (KDP_BA_SLOTS - 1)];
+	if (format == 0 || format == 3) {
+		if (m->count && m->complete) {
+			ops->drop(ctx, token);
+			return;
+		}
+		if (m->count) {
+			/* A fresh FIRST starts a fresh MPDU. Discard the entire old
+			 * unfinished chain before accepting any new subframes. */
+			ops->release(ctx, m);
+			kdp_ba_empty(m);
+		}
+		m->sn = sn;
+		m->head = m->tail = token;
+		m->count = 1;
+		m->pn_low = low;
+		m->pn_high = high;
+		m->encrypted = !!encrypted;
+		m->complete = format == 0;
+		m->tick = tick;
+		ops->link(ctx, token, KDP_BA_NONE);
+	} else {
+		if (!m->count || m->complete || m->sn != sn || m->count >= 64 ||
+		    m->encrypted != !!encrypted || m->pn_low != low ||
+		    m->pn_high != high) {
+			ops->drop(ctx, token);
+			return;
+		}
+		ops->link(ctx, m->tail, token);
+		ops->link(ctx, token, KDP_BA_NONE);
+		m->tail = token;
+		m->count++;
+		m->complete = format == 1;
+	}
+	while (b->slot[b->head & (KDP_BA_SLOTS - 1)].count &&
+	       b->slot[b->head & (KDP_BA_SLOTS - 1)].complete)
+		kdp_ba_release(b, ops, ctx);
+}
+
+static inline void kdp_ba_timeout(struct kdp_ba *b, unsigned int now,
+	unsigned int timeout, const struct kdp_reorder_ops *ops, void *ctx)
+{
+	unsigned int i, advance = 0;
+	/* Age arithmetic is modulo 2^32. Caller uses a timeout below 2^31. */
+	for (i = 0; i < b->window; i++) {
+		struct kdp_mpdu *m = &b->slot[(b->head + i) & (KDP_BA_SLOTS - 1)];
+		if (m->count && now - m->tick > timeout)
+			advance = i + 1;
+	}
+	while (advance--)
