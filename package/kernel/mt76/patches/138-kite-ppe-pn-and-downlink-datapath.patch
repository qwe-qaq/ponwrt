+/* Shared lifetime uses the NPU allocator's existing DMA quarantine. Never
+ * publish capability from merely allocating these pages. DP_BIND must be
+ * acknowledged while workers are parked; rules/admission are separate. */
+int mt7915_npu_dp_bind(struct mt7915_dev *dev)
+{
+	struct kdp_shared *s;
+	u32 args[3];
+	int ret = 0;
+
+	if (!dev->kite.datapath)
+		return 0;
+	mutex_lock(&dev->kite.lock);
+	if (dev->kite.dp_bound || !dev->kite.tx_bound) {
+		ret = -EBUSY;
+		goto out;
+	}
+	s = dev->mt76.kite_dp;
+	if (!s) {
+		s = mt76_npu_alloc_coherent(&dev->mt76, sizeof(*s), &dev->kite.dp_dma);
+		if (!s) {
+			ret = -ENOMEM;
+			goto out;
+		}
+		dev->mt76.kite_dp = s;
+	}
+	if (!kite_tx_range(dev->kite.dp_dma, sizeof(*s)) ||
+	    (dev->kite.dp_dma & 63)) {
+		ret = -ERANGE;
+		goto out;
+	}
+	if (s->magic == KDP_MAGIC && s->session == dev->kite.session) {
+		unsigned int wi;
+
+		if (s->stopped != 2) {
+			ret = -EBUSY;
+			goto out;
+		}
+		memset(s->flow, 0, sizeof(s->flow));
+		memset(s->token, 0, sizeof(s->token));
+		memset(s->rx, 0, sizeof(s->rx));
+		for (wi = 1; wi < KDP_WCIDS; wi++)
+			mt7915_dp_sta_enable(&s->sta[wi]);
+		memset(s, 0, offsetof(struct kdp_shared, sta));
+	} else {
+		memset(s, 0, sizeof(*s));
+	}
+	s->magic = KDP_MAGIC;
+	s->bytes = sizeof(*s);
+	s->session = dev->kite.session;
+	s->epoch = dev->kite.serial + 1;
+	s->gate = 1;
+	dma_wmb();
+	args[0] = dev->kite.dp_dma;
+	args[1] = sizeof(*s);
+	args[2] = s->epoch;
+	dev->kite.dp_bound = true; /* an uncertain reply retains ownership */
+	dev->kite.dp_epoch = s->epoch;
+	ret = mt7915_kite_command(dev, KITE_CTL_DP_BIND, args, 3);
+	if (!ret)
+		dev_info(dev->mt76.dev,
+			 "Kite datapath bound: session=%u epoch=%u bytes=%zu; admission closed\n",
+			 s->session, s->epoch, sizeof(*s));
+out:
+	if (ret)
+		mt7915_kite_fault(dev, ret);
+	mutex_unlock(&dev->kite.lock);
+	if (!ret) {
+		ret = airoha_kite_attach(rcu_access_pointer(dev->mt76.mmio.ppe_dev),
+					dev->mt76.kite_dp, &mt7915_dp_ops, dev);
+		if (!ret) {
+			unsigned int wi;
+
+			dev->kite.dp_attached = true;
+			for (wi = 1; wi < KDP_WCIDS; wi++)
+				mt7915_dp_sta_enable(&dev->mt76.kite_dp->sta[wi]);
+			dev->kite.dp_changing = dev->kite.dp_rx_held = false;
+			dev->kite.dp_key_pending = 0;
+			WRITE_ONCE(dev->mt76.kite_dp->enabled, 1);
+			dma_wmb();
+			WRITE_ONCE(dev->mt76.kite_dp->gate, 0);
+		}
+	}
+	return ret;
+}
+
+/* MT7916 WA returns a 15-bit token. This reserved range is disjoint from
+ * mt76's 8192 skb tokens and 0x7fff sentinel. Consuming the message does not
+ * free the buffer: hart4 additionally requires the actual WFDMA completion.
+ * dp_done_lock serializes WA parsers across MCU queues. */
+bool mt7915_npu_dp_tx_free(struct mt7915_dev *dev, u16 token)
+{
+	struct kdp_shared *s;
+	volatile struct kdp_token *t;
+	u32 seq;
+	unsigned long flags;
+
+	if (token < KDP_TOKEN_BASE || token >= KDP_TOKEN_BASE + KDP_TOKENS)
+		return false;
+	s = READ_ONCE(dev->mt76.kite_dp);
+	if (!s || !READ_ONCE(dev->kite.dp_bound)) {
+		dev->kite.tx_unknown++;
+		return true;
+	}
+	spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+	t = &s->token[token - KDP_TOKEN_BASE];
+	dma_rmb();
+	seq = READ_ONCE(t->submitted);
+	if (READ_ONCE(s->session) != dev->kite.session ||
+	    READ_ONCE(s->epoch) != dev->kite.dp_epoch ||
+	    READ_ONCE(t->state) != KDP_TOKEN_WIFI || !seq ||
+	    READ_ONCE(t->wa_done) || READ_ONCE(t->wcid) >= KDP_WCIDS ||
+	    READ_ONCE(t->band) > 1) {
+		WRITE_ONCE(s->tx_bad_done, READ_ONCE(s->tx_bad_done) + 1);
+		WRITE_ONCE(s->gate, 1);
+		WRITE_ONCE(s->fault, 9);
+		spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+		return true;
+	}
+	dma_wmb();
+	WRITE_ONCE(t->wa_done, seq);
+	spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+	return true;
+}
+
+int mt7915_npu_key_finish(struct mt7915_dev *dev, struct mt76_wcid *wcid,
+			 struct ieee80211_key_conf *key, bool install, int result)
+{
+	struct kdp_sta *s;
+	struct ieee80211_key_seq seq;
+	u32 args[5];
+	int i, ret = result;
+
+	if (!dev->kite.dp_key_pending)
+		return result;
+	mutex_lock(&dev->kite.lock);
+	if (dev->kite.dp_key_pending != wcid->idx || ret ||
+	    dev->kite.key_generation[wcid->idx] == U32_MAX) {
+		ret = mt7915_kite_fault(dev, ret ?: -ESTALE);
+		goto out;
+	}
+	args[0] = wcid->idx;
+	args[1] = dev->kite.generation[wcid->idx];
+	args[2] = ++dev->kite.key_generation[wcid->idx];
+	args[3] = install ? key->cipher : 0;
+	args[4] = install ? key->keyidx : U32_MAX;
+	ret = mt7915_kite_command(dev, KITE_CTL_KEY, args, 5);
+	if (ret) {
+		mt7915_kite_fault(dev, ret);
+		goto out;
+	}
+	s = &dev->mt76.kite_dp->sta[wcid->idx];
+	/* RX is stopped in hardware and firmware. rx_lock also excludes host
+	 * timeout releases using the old PN object while it is replaced. */
+	spin_lock_bh(&dev->mt76.rx_lock);
+	/* Removing a pairwise key must never turn an authorized protected
+	 * STA into an open fast-path peer between mac80211 state callbacks. */
+	if (!install)
+		s->authorized = 0;
+	s->key_generation = args[2];
+	s->cipher = args[3];
+	s->keyid = args[4];
+	for (i = 0; i < KDP_TIDS; i++) {
+		struct kdp_pn *pn = &s->pn[i];
+		u8 *p = seq.ccmp.pn;
+
+		memset(&seq, 0, sizeof(seq));
+		if (install && key->cipher == WLAN_CIPHER_SUITE_CCMP)
+			ieee80211_get_key_rx_seq(key, i == 16 ? -1 : i, &seq);
+		memset(pn, 0, sizeof(*pn));
+		pn->generation = s->generation;
+		pn->key_generation = s->key_generation;
+		pn->high = (u32)p[0] << 8 | p[1];
+		pn->low = (u32)p[2] << 24 | (u32)p[3] << 16 | (u32)p[4] << 8 | p[5];
+	}
+	if (install)
+		mt7915_dp_sta_enable(s);
+	else
+		s->enabled = 0;
+	spin_unlock_bh(&dev->mt76.rx_lock);
+	ret = mt7915_dp_rx_finish(dev);
+	if (!ret)
+		dev->kite.dp_key_pending = 0;
+out:
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
