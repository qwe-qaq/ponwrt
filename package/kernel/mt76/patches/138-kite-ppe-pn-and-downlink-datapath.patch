+/* Called under dev->rx_lock, which serializes participant 0 across NAPI,
+ * timeout release and both bands. Firmware serializes participant 1 for
+ * each WCID. Coherent DMA memory and full mb() implement the wire lock.
+ */
+bool mt76_kite_check_pn(struct mt76_dev *dev, struct sk_buff *skb, int tid)
+{
+	struct mt76_rx_status *r = (void *)skb->cb;
+	struct kdp_shared *s = READ_ONCE(dev->kite_dp);
+	volatile struct kdp_sta *sta;
+	u32 lo, hi;
+	int ret;
+
+	lockdep_assert_held(&dev->rx_lock);
+	if (!s || !r->wcid || r->wcid->idx >= KDP_WCIDS)
+		return false;
+	sta = &s->sta[r->wcid->idx];
+	if (!READ_ONCE(sta->generation) ||
+	    READ_ONCE(sta->cipher) != KDP_CIPHER_CCMP)
+		return false;
+	/* A stale or untagged skb cannot borrow a newly installed key's PN.
+	 * Proofs are private NPU-ring metadata, never an on-air RXD flag. */
+	if (!r->npu_security || tid < 0 || tid >= KDP_TIDS ||
+	    r->npu_generation != READ_ONCE(sta->generation) ||
+	    r->npu_key_generation != READ_ONCE(sta->key_generation) ||
+	    READ_ONCE(sta->cipher) != KDP_CIPHER_CCMP || READ_ONCE(s->fault))
+		goto reject;
+	if (!r->npu_pn_proof) {
+		hi = (u32)r->iv[0] << 8 | r->iv[1];
+		lo = (u32)r->iv[2] << 24 | (u32)r->iv[3] << 16 |
+		     (u32)r->iv[4] << 8 | r->iv[5];
+		ret = kdp_pn_accept(&sta->pn[tid], 0, r->npu_generation,
+				   r->npu_key_generation, lo, hi);
+		if (ret != 1)
+			goto reject;
+		dev->kite_pn_accept++;
+	} else {
+		dev->kite_pn_proof++;
+	}
+	if (r->flag & RX_FLAG_IV_STRIPPED)
+		r->flag |= RX_FLAG_PN_VALIDATED;
+	return true;
+reject:
+	dev->kite_pn_reject++;
+	r->flag |= RX_FLAG_ONLY_MONITOR;
+	return true;
+}
+EXPORT_SYMBOL_GPL(mt76_kite_check_pn);
