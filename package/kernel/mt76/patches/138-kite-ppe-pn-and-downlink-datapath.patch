+static int mt7915_kite_datapath_show(struct seq_file *m, void *unused)
+{
+	struct mt7915_dev *dev = m->private;
+	struct kdp_shared *s = READ_ONCE(dev->mt76.kite_dp);
+	unsigned int b, i, sta = 0, flows = 0, wifi = 0, tdma = 0, quarantine = 0;
+
+	seq_printf(m, "abi=1 negotiated=%u bound=%u attached=%u changing=%u\n",
+		dev->kite.datapath, dev->kite.dp_bound, dev->kite.dp_attached,
+		dev->kite.dp_changing);
+	if (!s)
+		return 0;
+	dma_rmb();
+	seq_printf(m, "magic=%08x bytes=%u session=%u epoch=%u enabled=%u gate=%u fault=%u stopped=%u\n",
+		s->magic, s->bytes, s->session, s->epoch, s->enabled, s->gate, s->fault, s->stopped);
+	for (i = 1; i < KDP_WCIDS; i++) {
+		struct kdp_sta *peer = &s->sta[i];
+
+		sta += !!READ_ONCE(peer->enabled);
+		if (READ_ONCE(peer->generation) && READ_ONCE(dev->kite.live[i]))
+			seq_printf(m, "sta%u generation=%u key_generation=%u cipher=%08x authorized=%u enabled=%u band=%u bss=%u tx_tag=%u tx_blocked=%u host_tids=%02x\n",
+				i, peer->generation, peer->key_generation, peer->cipher,
+				peer->authorized, peer->enabled, peer->band, peer->bss,
+				peer->tx_tag, peer->tx_blocked, peer->host_tids);
+	}
+	for (i = 0; i < KDP_FLOWS; i++)
+		flows += !!READ_ONCE(s->flow[i].version);
+	for (i = 0; i < KDP_TOKENS; i++) {
+		u32 state = READ_ONCE(s->token[i].state);
+
+		wifi += state == KDP_TOKEN_WIFI;
+		tdma += state == KDP_TOKEN_TDMA;
+		quarantine += state == KDP_TOKEN_QUARANTINE;
+	}
+	seq_printf(m, "stations=%u ingress_policies=%u tokens_wifi=%u tokens_tdma=%u tokens_quarantine=%u tx_bad_done=%u\n",
+		sta, flows, wifi, tdma, quarantine, READ_ONCE(s->tx_bad_done));
+	spin_lock_bh(&dev->mt76.rx_lock);
+	seq_printf(m, "host_pn_accept=%llu host_pn_proof=%llu host_pn_reject=%llu\n",
+		dev->mt76.kite_pn_accept, dev->mt76.kite_pn_proof, dev->mt76.kite_pn_reject);
+	spin_unlock_bh(&dev->mt76.rx_lock);
+	for (b = 0; b < 2; b++)
+		seq_printf(m, "band%u rx_ppe=%u rx_bytes=%u rx_host=%u rx_return=%u rx_free_only=%u rx_replay=%u rx_stale=%u rx_unsupported=%u tx_sent=%u tx_bytes=%u tx_freed=%u tx_drop=%u tx_stale=%u tx_full=%u tx_aborted=%u\n",
+			b, s->rx_ppe[b], s->stats[b].rx_bytes, s->rx_host[b], s->rx_miss[b],
+			s->rx_free[b], s->rx_replay[b], s->rx_stale[b], s->rx_unsupported[b],
+			s->tx_sent[b], s->stats[b].tx_bytes, s->tx_freed[b], s->tx_drop[b],
+			s->stats[b].tx_stale, s->stats[b].tx_full, s->tx_aborted[b]);
+	seq_puts(m, "rx_ppe=TDMA submission; rx_free_only=buffer return, not delivery proof; tx_freed=DMA+WA completion, not peer ACK; counters wrap at 32 bits\n");
+	return 0;
