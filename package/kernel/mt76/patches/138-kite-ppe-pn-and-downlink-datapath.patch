+/* SPDX-License-Identifier: ISC */
+/* Included after the control command/ACK helpers. Lock order:
+ * mt76.mutex -> flow_offload_mutex -> kite.lock -> rx_lock.
+ * PPE callbacks never acquire mt76.mutex.
+ */
+static int mt7915_dp_pause(void *priv)
+{
+	struct mt7915_dev *dev = priv;
+	struct kdp_shared *s = dev->mt76.kite_dp;
+	int ret;
+
+	mutex_lock(&dev->kite.lock);
+	WRITE_ONCE(s->gate, 1);
+	dma_wmb();
+	ret = mt7915_kite_command(dev, KITE_CTL_PARK, NULL, 0);
+	if (!ret)
+		ret = mt7915_kite_wait_parked(dev);
+	if (ret)
+		mt7915_kite_fault(dev, ret);
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
+
+static int mt7915_dp_resume(void *priv)
+{
+	struct mt7915_dev *dev = priv;
+	struct kdp_shared *s = dev->mt76.kite_dp;
+	int ret;
+
+	mutex_lock(&dev->kite.lock);
+	ret = mt7915_kite_command(dev, KITE_CTL_RESUME, NULL, 0);
+	if (!ret && !dev->kite.dp_changing && READ_ONCE(s->enabled)) {
+		dma_wmb();
+		WRITE_ONCE(s->gate, 0);
+	}
+	if (ret)
+		mt7915_kite_fault(dev, ret);
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
+
+static const struct airoha_kite_ops mt7915_dp_ops = {
+	.pause = mt7915_dp_pause,
+	.resume = mt7915_dp_resume,
+};
+
+/* Mark the affected STA unavailable before releasing the PPE mutex, so a
+ * simultaneous new TC rule cannot reinstall the just-revoked generations. */
+static int mt7915_dp_change_begin(struct mt7915_dev *dev, u32 wcid)
+{
+	int ret;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	if (!dev->kite.dp_bound)
+		return 0;
+	if (dev->kite.dp_changing)
+		return -EBUSY;
+	dev->kite.dp_changing = true;
+	WRITE_ONCE(dev->mt76.kite_dp->gate, 1);
+	dma_wmb();
+	ret = airoha_kite_revoke(rcu_access_pointer(dev->mt76.mmio.ppe_dev), wcid);
+	if (!ret)
+		ret = mt7915_npu_tx_fence(dev);
+	if (ret) {
+		WRITE_ONCE(dev->mt76.kite_dp->fault, 11);
+		return ret;
+	}
+	return 0;
+}
+
+/* MT7916 wf_pse_top: true PSE RX/SEC/RXIOC/SFD and HIF queues.
+ * Check both read-only empty bits (including band1 RXIOC) and explicit
+ * queue counts. Do not reuse PLE debugfs offsets as PSE drain evidence. */
+static bool mt7915_dp_rx_queues_empty(struct mt7915_dev *dev)
+{
+	static const u8 pid[] = { 2, 2, 2, 2, 0, 0, 0, 0, 0, 0 };
+	static const u8 qid[] = { 2, 4, 5, 7, 0, 1, 2, 3, 4, 5 };
+	unsigned int i;
+
+	if ((mt76_rr(dev, MT_KITE_PSE_EMPTY) & MT_KITE_PSE_RX_EMPTY) !=
+	    MT_KITE_PSE_RX_EMPTY)
+		return false;
+	for (i = 0; i < ARRAY_SIZE(pid); i++) {
+		mt76_wr(dev, MT_KITE_PSE_QUERY,
+			BIT(31) | ((u32)pid[i] << 10) | ((u32)qid[i] << 24));
+		if (!mt76_poll(dev, MT_KITE_PSE_QUERY, BIT(31), 0, 10) ||
+		    mt76_get_field(dev, MT_KITE_PSE_COUNT, GENMASK(11, 0)))
+			return false;
+	}
+	return true;
+}
+
+static int mt7915_dp_dma_rx_disable(struct mt7915_dev *dev)
+{
+	u32 ofs = dev->hif2 ? MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0) : 0;
+
+	mt76_clear(dev, MT_WFDMA0_GLO_CFG, MT_WFDMA0_GLO_CFG_RX_DMA_EN);
+	if (ofs)
+		mt76_clear(dev, MT_WFDMA0_GLO_CFG + ofs, MT_WFDMA0_GLO_CFG_RX_DMA_EN);
+	if (!mt76_poll(dev, MT_WFDMA0_GLO_CFG,
+			MT_WFDMA0_GLO_CFG_RX_DMA_BUSY, 0, 1000) ||
+	    (ofs && !mt76_poll(dev, MT_WFDMA0_GLO_CFG + ofs,
+			      MT_WFDMA0_GLO_CFG_RX_DMA_BUSY, 0, 1000)))
+		return -ETIMEDOUT;
+	return 0;
+}
+
+static void mt7915_dp_dma_rx_restore(struct mt7915_dev *dev)
+{
+	u32 ofs = dev->hif2 ? MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0) : 0;
+
+	if (dev->kite.dp_rx_cfg[0] & MT_WFDMA0_GLO_CFG_RX_DMA_EN)
+		mt76_set(dev, MT_WFDMA0_GLO_CFG, MT_WFDMA0_GLO_CFG_RX_DMA_EN);
+	if (ofs && (dev->kite.dp_rx_cfg[1] & MT_WFDMA0_GLO_CFG_RX_DMA_EN))
+		mt76_set(dev, MT_WFDMA0_GLO_CFG + ofs, MT_WFDMA0_GLO_CFG_RX_DMA_EN);
+}
+
+static int mt7915_dp_rx_pause(struct mt7915_dev *dev)
+{
+	u32 ofs = dev->hif2 ? MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0) : 0;
+	unsigned long until = jiffies + msecs_to_jiffies(1000);
+	int b, ret;
+
+	lockdep_assert_held(&dev->kite.lock);
+	if (!dev->kite.dp_bound)
+		return 0;
+	for (b = 0; b < 2; b++) {
+		dev->kite.dp_rx_mac[b] = mt76_rr(dev, MT_ARB_SCR(b));
+		mt76_set(dev, MT_ARB_SCR(b), MT_ARB_SCR_RX_DISABLE);
+	}
+	dev->kite.dp_rx_held = true;
+	/* Finish an already receiving HE PPDU (maximum 5.484 ms), then use
+	 * the hardware queue counts to drain the decrypt/translation/HIF path.
+	 * The elapsed delay alone is not the completion condition. */
+	usleep_range(6000, 8000);
+	while (!mt7915_dp_rx_queues_empty(dev)) {
+		if (time_after_eq(jiffies, until))
+			return -ETIMEDOUT;
+		usleep_range(1000, 2000);
+	}
+	dev->kite.dp_rx_cfg[0] = mt76_rr(dev, MT_WFDMA0_GLO_CFG);
+	if (ofs)
+		dev->kite.dp_rx_cfg[1] = mt76_rr(dev, MT_WFDMA0_GLO_CFG + ofs);
+	ret = mt7915_dp_dma_rx_disable(dev);
+	if (!ret)
+		ret = mt7915_kite_command(dev, KITE_CTL_PARK, NULL, 0);
+	if (!ret)
+		ret = mt7915_kite_wait_parked(dev);
+	if (!ret)
+		ret = mt7915_kite_command(dev, KITE_CTL_DP_RX_PURGE, NULL, 0);
+	/* WM/WA command completions share WFDMA. Restore their DMA while
+	 * keeping radio RX and both NPU RX workers stopped during MCU rekey. */
+	if (!ret)
+		mt7915_dp_dma_rx_restore(dev);
+	return ret;
+}
+
+static int mt7915_dp_rx_finish(struct mt7915_dev *dev)
+{
+	struct kdp_shared *s = dev->mt76.kite_dp;
+	int b, ret;
+
+	lockdep_assert_held(&dev->kite.lock);
+	if (!dev->kite.dp_bound || !dev->kite.dp_rx_held)
+		return 0;
+	/* Purge again while radio RX is still disabled: no unread descriptor
+	 * can acquire the replacement key's generation merely by resuming. */
+	ret = mt7915_dp_dma_rx_disable(dev);
+	if (!ret)
+		ret = mt7915_kite_command(dev, KITE_CTL_DP_RX_PURGE, NULL, 0);
+	if (!ret)
+		ret = mt7915_kite_command(dev, KITE_CTL_RESUME, NULL, 0);
+	if (ret)
+		return mt7915_kite_fault(dev, ret);
+	mt7915_dp_dma_rx_restore(dev);
+	for (b = 0; b < 2; b++)
+		if (!(dev->kite.dp_rx_mac[b] & MT_ARB_SCR_RX_DISABLE))
+			mt76_clear(dev, MT_ARB_SCR(b), MT_ARB_SCR_RX_DISABLE);
+	dev->kite.dp_rx_held = dev->kite.dp_changing = false;
+	dma_wmb();
+	if (s->enabled && !s->fault)
+		WRITE_ONCE(s->gate, 0);
+	mt7915_npu_tx_unfence(dev);
+	return 0;
+}
+
+static void mt7915_dp_sta_attributes(struct mt7915_dev *dev,
+				     struct mt7915_sta *msta)
+{
+	struct ieee80211_sta *sta = container_of((void *)msta, struct ieee80211_sta, drv_priv);
+	struct ieee80211_vif *vif = container_of((void *)msta->vif, struct ieee80211_vif, drv_priv);
+	struct kdp_sta *s = &dev->mt76.kite_dp->sta[msta->wcid.idx];
+
+	s->omac = msta->vif->mt76.omac_idx;
+	s->wmm = msta->vif->mt76.wmm_idx;
+	s->wme = sta->wme;
+	/* WTBL aggregation remains available; use standalone Ethernet MSDUs
+	 * until the per-peer A-MSDU size/lifetime contract is explicitly passed. */
+	s->amsdu = 0;
+	s->band = msta->vif->phy->mt76->band_idx;
+	s->bss = msta->vif->mt76.idx;
+	ether_addr_copy(s->addr, sta->addr);
+	/* PS/TWT notifications share this byte; preserve their bits. */
+	spin_lock_bh(&dev->kite.dp_done_lock);
+	s->tx_blocked = (s->tx_blocked & ~4u) |
+		(((vif->offload_flags & IEEE80211_OFFLOAD_CUSTOM_QOS) || msta->vif->npu_acm) ? 4 : 0);
+	spin_unlock_bh(&dev->kite.dp_done_lock);
+	s->reserved_sta = vif->type == NL80211_IFTYPE_AP &&
+		!test_bit(MT_WCID_FLAG_4ADDR, &msta->wcid.flags) &&
+		!sta->tdls && s->omac < 64 && s->wmm < 4;
+}
+
+static void mt7915_dp_sta_enable(struct kdp_sta *s)
+{
+	dma_wmb();
+	WRITE_ONCE(s->enabled, s->tx_tag && s->reserved_sta && s->authorized &&
+		(!s->cipher || (s->cipher == KDP_CIPHER_CCMP && s->key_generation)));
+}
+
+/* MCU PS notifications run in NAPI. Close admission immediately, then
+ * perform sleeping PPE invalidation on a worker. Late in-flight frames are
+ * dropped until mac80211 owns new egress; no unsignalled NPU PS queue. */
+static void mt7915_dp_block_tx(struct mt7915_dev *dev, u16 wi, u8 bit, bool set)
+{
+	unsigned long flags;
+	struct kdp_shared *s = READ_ONCE(dev->mt76.kite_dp);
+
+	if (!s || !READ_ONCE(dev->kite.dp_bound) || !wi || wi >= KDP_WCIDS)
+		return;
+	spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+	WRITE_ONCE(s->sta[wi].tx_blocked, set ? s->sta[wi].tx_blocked | bit :
+		   s->sta[wi].tx_blocked & ~bit);
+	dma_wmb();
+	spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+}
+
+static void mt7915_dp_ps_work(struct work_struct *work)
+{
+	struct mt7915_dev *dev = container_of(work, struct mt7915_dev, kite.dp_ps_work);
+	unsigned int wi;
+
+	mutex_lock(&dev->mt76.mutex);
+	for (wi = 1; wi < KDP_WCIDS; wi++) {
+		int ret;
+
+		if (!test_and_clear_bit(wi, dev->kite.dp_ps_pending) ||
+		    !dev->kite.dp_attached || dev->kite.failed ||
+		    !READ_ONCE(dev->mt76.kite_dp->sta[wi].tx_blocked))
+			continue;
+		ret = airoha_kite_revoke_tx(rcu_access_pointer(dev->mt76.mmio.ppe_dev), wi);
+		if (ret) {
+			mutex_lock(&dev->kite.lock);
+			mt7915_kite_fault(dev, ret);
+			mutex_unlock(&dev->kite.lock);
+			break;
+		}
+	}
+	mutex_unlock(&dev->mt76.mutex);
+}
+
+void mt7915_npu_dp_work_init(struct mt7915_dev *dev)
+{
+	INIT_WORK(&dev->kite.dp_ps_work, mt7915_dp_ps_work);
+	dev->kite.dp_work_initialized = true;
+}
+
+void mt7915_npu_dp_work_stop(struct mt7915_dev *dev)
+{
+	unsigned long flags;
+
+	if (!dev->kite.dp_work_initialized)
+		return;
+	spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+	WRITE_ONCE(dev->kite.dp_work_stopping, true);
+	spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+	if (dev->kite.dp_work_initialized)
+		cancel_work_sync(&dev->kite.dp_ps_work);
+}
+
+void mt7915_npu_ps(struct mt7915_dev *dev, u16 wi, bool ps)
+{
+	struct kdp_shared *s;
+	unsigned long flags;
+
+	spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+	s = READ_ONCE(dev->mt76.kite_dp);
+	if (!s || !wi || wi >= KDP_WCIDS || !READ_ONCE(dev->kite.dp_bound) ||
+	    dev->kite.dp_work_stopping)
+		goto out;
+	WRITE_ONCE(s->sta[wi].tx_blocked, ps ? s->sta[wi].tx_blocked | 1 :
+		   s->sta[wi].tx_blocked & ~1);
+	dma_wmb();
+	if (ps) {
+		set_bit(wi, dev->kite.dp_ps_pending);
+		schedule_work(&dev->kite.dp_ps_work);
+	}
+out:
+	spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+}
+
+int mt7915_npu_twt(struct mt7915_dev *dev, u16 wi, bool active)
+{
+	lockdep_assert_held(&dev->mt76.mutex);
+	if (!dev->kite.dp_attached)
+		return 0;
+	mt7915_dp_block_tx(dev, wi, 2, active);
+	if (active)
+		return airoha_kite_revoke_tx(rcu_access_pointer(dev->mt76.mmio.ppe_dev), wi);
+	return 0;
+}
+
+/* The default DSCP/VLAN classifier is implemented in NPU. Configured maps
+ * and ACM require mac80211 policy; revoke existing egress immediately. */
+int mt7915_npu_qos(struct mt7915_dev *dev, struct mt7915_vif *mvif)
+{
+	struct kdp_shared *s = dev->mt76.kite_dp;
+	unsigned int wi;
+	bool block = mvif->npu_qos_custom || mvif->npu_acm;
+	int ret = 0;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	if (!dev->kite.dp_attached)
+		return 0;
+	for (wi = 1; wi < KDP_WCIDS; wi++) {
+		if (!s->sta[wi].generation || s->sta[wi].bss != mvif->mt76.idx ||
+		    s->sta[wi].band != mvif->phy->mt76->band_idx)
+			continue;
+		mt7915_dp_block_tx(dev, wi, 4, block);
+		if (block) {
+			ret = airoha_kite_revoke_tx(rcu_access_pointer(dev->mt76.mmio.ppe_dev), wi);
+			if (ret)
+				break;
+		}
+	}
+	if (ret) {
+		mutex_lock(&dev->kite.lock);
+		mt7915_kite_fault(dev, ret);
+		mutex_unlock(&dev->kite.lock);
+	}
+	return ret;
+}
