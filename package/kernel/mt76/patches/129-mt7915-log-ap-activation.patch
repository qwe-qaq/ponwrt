Subject: [PATCH] mt7915: report radio and AP activation failures

--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -104,6 +104,10 @@
 	mutex_lock(&dev->mt76.mutex);
 	ret = mt7915_run(hw);
 	mutex_unlock(&dev->mt76.mutex);
+
+	if (ret)
+		dev_err(dev->mt76.dev, "Wi-Fi radio start failed: band=%u error=%d\n",
+			mt7915_hw_phy(hw)->mt76->band_idx, ret);
 
 	return ret;
 }
@@ -292,6 +296,10 @@
 
 	if (!is_mt7915(&dev->mt76))
 		mt7915_mcu_set_vow_band(dev, mvif);
+
+	if (ret)
+		dev_err(dev->mt76.dev, "Wi-Fi interface add failed: band=%u type=%u error=%d\n",
+			phy->mt76->band_idx, vif->type, ret);
 
 	return ret;
 }
@@ -733,6 +741,13 @@
 	err = mt7915_mcu_add_sta(dev, vif, NULL, CONN_STATE_PORT_SECURE, false);
 out:
 	mutex_unlock(&dev->mt76.mutex);
+
+	if (err)
+		dev_err(dev->mt76.dev, "Wi-Fi AP start failed: band=%u error=%d\n",
+			phy->mt76->band_idx, err);
+	else if (mt76_npu_device_active(&dev->mt76))
+		dev_info(dev->mt76.dev, "Wi-Fi AP started: band=%u; NPU RX active, host security/TX\n",
+			 phy->mt76->band_idx);
 
 	return err;
 }
