+/* Only control events enter this fixed ARM ring, never ordinary packets.
+ * dp_done_lock serializes MCU notifications and the sleeping worker. */
+static void mt7915_dp_ps_trace_locked(struct mt7915_dev *dev, u32 wi, u32 event, u32 raw)
+{
+ struct mt7915_kite_ps_event *e;
+ struct kdp_shared *s = READ_ONCE(dev->mt76.kite_dp);
+ u32 serial = ++dev->kite.ps_event_serial;
+ e = &dev->kite.ps_events[(serial - 1) % MT7915_KITE_PS_EVENTS];
+ memset(e, 0, sizeof(*e)); e->ns=ktime_get_ns();
+ e->serial=serial; e->event=event; e->wcid=wi; e->raw=raw;
+ if (s && wi && wi<KDP_WCIDS) {
+  e->generation=s->sta[wi].generation; e->key_generation=s->sta[wi].key_generation;
+  e->request=s->r60.ps[wi].request; e->blocked=s->sta[wi].tx_blocked;
+  e->issued=s->r60.ps[wi].issued; e->consumed=s->r60.ps[wi].consumed;
+ }
+}
+void mt7915_npu_ps_raw(struct mt7915_dev *dev, u16 wi, u32 raw)
+{
+ unsigned long flags;
+ spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+ mt7915_dp_ps_trace_locked(dev, wi, 0, raw);
+ spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+}
+/* Existing NAPI/WA and TX-worker batch boundaries publish progress. A
+ * delayed fallback covers NPU drain completion with no following IRQ.
+ * No sleeping lock, mailbox, per-packet work or ownership change here. */
+void mt7915_npu_ps_progress(struct mt76_dev *mdev)
+{
+ struct mt7915_dev *dev=container_of(mdev,struct mt7915_dev,mt76);
+ struct kdp_shared *s;
+ unsigned long flags, wi;
+ bool wake=false;
+ if (!READ_ONCE(dev->kite.dp_work_initialized)) return;
+ spin_lock_irqsave(&dev->kite.dp_done_lock,flags);
+ s=READ_ONCE(mdev->kite_dp);
+ if (!s || dev->kite.dp_work_stopping || !dev->kite.dp_bound) goto out;
+ for_each_set_bit(wi, dev->kite.dp_ps_pending, KDP_WCIDS) {
+  struct mt7915_kite_ps_state *p=&dev->kite.ps[wi];
+  struct mt76_queue *q;
+  u32 consumed,drained,reaped,staged,band=s->sta[wi].band;
+  if (band>=2 || (s->sta[wi].tx_blocked & KDP_TX_BLOCK_PS)) continue;
+  q=dev->kite.txq[band]; if (!q || !q->kite_tx) continue;
+  consumed=READ_ONCE(s->r60.ps[wi].consumed);
+  drained=READ_ONCE(s->r60.ps[wi].drained);
+  reaped=kite_tx_read(&q->kite_tx->reaped); staged=READ_ONCE(q->kite_staged);
+  if (consumed==p->seen_consumed && drained==p->seen_drained &&
+      reaped==p->seen_reaped && staged==p->seen_staged) continue;
+  p->seen_consumed=consumed; p->seen_drained=drained;
+  p->seen_reaped=reaped; p->seen_staged=staged;
+  p->progress_wakes++; if (!p->queued_ns) p->queued_ns=ktime_get_ns(); wake=true;
+ }
+ if (wake) mod_delayed_work(system_wq,&dev->kite.dp_ps_work,0);
+out:
+ spin_unlock_irqrestore(&dev->kite.dp_done_lock,flags);
+}
 
