Subject: mt7915: expose a software forwarding endpoint for Kite

--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -1873,7 +1873,7 @@
 	return ret;
 }
 
-#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+#if defined(CONFIG_NET_MEDIATEK_SOC_WED) || defined(CONFIG_MT7915_NPU)
 static int
 mt7915_net_fill_forward_path(struct ieee80211_hw *hw,
 			     struct ieee80211_vif *vif,
@@ -1881,6 +1881,7 @@
 			     struct net_device_path_ctx *ctx,
 			     struct net_device_path *path)
 {
+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
 	struct mt7915_vif *mvif = (struct mt7915_vif *)vif->drv_priv;
 	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
 	struct mt7915_dev *dev = mt7915_hw_dev(hw);
@@ -1888,7 +1889,7 @@
 	struct mtk_wed_device *wed = &dev->mt76.mmio.wed;
 
 	if (!mtk_wed_device_active(wed))
-		return -ENODEV;
+		goto software;
 
 	if (msta->wcid.idx > MT7915_WTBL_STA)
 		return -EIO;
@@ -1907,6 +1908,21 @@
 	ctx->dev = NULL;
 
 	return 0;
+software:
+#endif
+#ifdef CONFIG_MT7915_NPU
+	/* Normal Ethernet endpoint: flowtable still transmits through mac80211,
+	 * including current STA authorization, keys, PN and WA token ownership.
+	 * Kite has no verified PPE/WDMA ABI; never manufacture a WDMA path.
+	 */
+	if (is_mt7916(&mt7915_hw_dev(hw)->mt76)) {
+		path->type = DEV_PATH_ETHERNET;
+		path->dev = ctx->dev;
+		ctx->dev = NULL;
+		return 0;
+	}
+#endif
+	return -ENODEV;
 }
 #endif
 
@@ -1993,7 +2009,7 @@
 	.sta_add_debugfs = mt7915_sta_add_debugfs,
 #endif
 	.set_radar_background = mt7915_set_radar_background,
-#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+#if defined(CONFIG_NET_MEDIATEK_SOC_WED) || defined(CONFIG_MT7915_NPU)
 	.net_fill_forward_path = mt7915_net_fill_forward_path,
 #endif
 #if defined(CONFIG_NET_MEDIATEK_SOC_WED) || defined(CONFIG_MT7915_NPU)
