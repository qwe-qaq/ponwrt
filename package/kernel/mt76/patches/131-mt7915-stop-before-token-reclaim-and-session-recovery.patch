+/* RX NAPI state is shared with NPU teardown. Never disable the same poller
+ * twice after a failed reset, and never let a completing poll rearm an IRQ. */
+void mt7915_dma_napi_disable(struct mt7915_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	int i;
+
+	if (dev->recovery.napi_stopped)
+		return;
+	WRITE_ONCE(mdev->npu_napi_enabled[0], false);
+	WRITE_ONCE(mdev->npu_napi_enabled[1], false);
+	mt76_for_each_q_rx(mdev, i)
+		if (!mt76_queue_is_wed_rro(&mdev->q_rx[i]))
+			napi_disable(&mdev->napi[i]);
+	mt76_npu_disable_irqs(mdev);
+	dev->recovery.napi_stopped = true;
+}
+
+void mt7915_dma_napi_enable(struct mt7915_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	int i;
+
+	if (!dev->recovery.napi_stopped)
+		return;
+	mt76_for_each_q_rx(mdev, i) {
+		if (mt76_queue_is_wed_rro(&mdev->q_rx[i]))
+			continue;
+		napi_enable(&mdev->napi[i]);
+		if (i == MT_RXQ_NPU0 || i == MT_RXQ_NPU1)
+			WRITE_ONCE(mdev->npu_napi_enabled[i - MT_RXQ_NPU0], true);
+	}
+	dev->recovery.napi_stopped = false;
+	local_bh_disable();
+	mt76_for_each_q_rx(mdev, i)
+		if (!mt76_queue_is_wed_rro(&mdev->q_rx[i]))
+			napi_schedule(&mdev->napi[i]);
+	local_bh_enable();
+}
+
+/* This is the ownership barrier for both token and RX page reclamation.
+ * Call with NAPI disabled. A failed proof is sticky for this driver instance. */
+int mt7915_dma_quiesce(struct mt7915_dev *dev)
+{
+	int ret;
+
+	if (dev->mt76.npu_quarantine)
+		return -EIO;
+	mt76_npu_disable_irqs(&dev->mt76);
+	ret = mt7915_dma_disable(dev, false);
+	if (!ret)
+		ret = mt7915_npu_data_stop(dev);
+	if (ret) {
+		if (mt76_npu_device_active(&dev->mt76))
+			dev->mt76.npu_quarantine = true;
+		dev_err(dev->mt76.dev,
+			"DMA stop failed: %d; TX tokens and RX buffers retained\n", ret);
+	}
+	return ret;
+}
