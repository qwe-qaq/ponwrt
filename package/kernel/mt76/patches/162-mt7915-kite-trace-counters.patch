+static int mt7915_kite_trace_show(struct seq_file *m, void *unused)
+{
+	struct mt7915_dev *dev = m->private;
+	unsigned long age = READ_ONCE(dev->kite.trace_last_at);
+
+	mutex_lock(&dev->mt76.mutex);
+	seq_printf(m,
+		"trace_abi=1 session=%u tx_bound=%u dp_bound=%u dp_attached=%u tx_gate0=%u tx_gate1=%u dp_gate=%u dp_fault=%u tx_reset=%u failed=%u recovery=%08x quarantine=%u tokens=%u\n",
+		dev->kite.session, dev->kite.tx_bound, dev->kite.dp_bound,
+		dev->kite.dp_attached,
+		dev->kite.txq[0] ? dev->kite.txq[0]->kite_tx_blocked : 0,
+		dev->kite.txq[1] ? dev->kite.txq[1]->kite_tx_blocked : 0,
+		dev->mt76.kite_dp ? READ_ONCE(dev->mt76.kite_dp->gate) : 0,
+		dev->mt76.kite_dp ? READ_ONCE(dev->mt76.kite_dp->fault) : 0,
+		dev->kite.tx_reset_requested, dev->kite.failed,
+		dev->recovery.state, dev->mt76.npu_quarantine,
+		READ_ONCE(dev->mt76.token_count));
+	seq_printf(m,
+		"events gate_changes=%u timeout_resolved=%u timeout_unresolved=%u faults=%u stalls=%u radio_start=%u radio_stop=%u recovery_worker=%u recovery_failures=%u reset_requests=%u full_attempts=%u\n",
+		dev->kite.trace_gate_changes, dev->kite.trace_timeout_resolved,
+		dev->kite.trace_timeout_unresolved, dev->kite.trace_faults,
+		dev->kite.trace_stalls, dev->kite.trace_radio_starts,
+		dev->kite.trace_radio_stops, dev->kite.trace_recovery_workers,
+		dev->kite.trace_recovery_failures, dev->kite.trace_reset_requests,
+		dev->kite.trace_full_attempts);
+	seq_printf(m, "last_event=%u last_op=%u last_error=%d last_state=%u age_ms=%lu\n",
+		dev->kite.trace_last_event, dev->kite.trace_last_op,
+		dev->kite.trace_last_error, dev->kite.trace_last_state,
+		age ? jiffies_to_msecs(jiffies - age) : 0UL);
+	mutex_unlock(&dev->mt76.mutex);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mt7915_kite_trace);
+
 void mt7915_npu_tx_debugfs(struct mt7915_dev *dev, struct dentry *dir)
 {
 	debugfs_create_file("kite_datapath", 0400, dir, dev, &mt7915_kite_datapath_fops);
 	debugfs_create_file("kite_tx", 0400, dir, dev, &mt7915_kite_tx_fops);
 	debugfs_create_file("kite_rx", 0400, dir, dev, &mt7915_kite_rx_fops);
+	debugfs_create_file("kite_trace", 0400, dir, dev, &mt7915_kite_trace_fops);
 }
 
