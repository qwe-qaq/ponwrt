--- a/mt7915/npu.c
+++ b/mt7915/npu.c
@@ -0,0 +1,264 @@
+// SPDX-License-Identifier: ISC
+/*
+ * Airoha AN7581 + MT7916 Kite host integration.
+ *
+ * Clanker owns the MT7916 WiFi RX descriptor rings in NPU SRAM.  Linux owns
+ * the two host-adaptor rings exposed through the common mt76 NPU code.  The
+ * mailbox values here follow Clanker's SET_WAIT/GET_WAIT Kite handlers.
+ */
+
+#include <linux/of.h>
+
+#include "mt7915.h"
+
+#if IS_ENABLED(CONFIG_MT76_NPU)
+
+#define MT7915_KITE_RX_RING_SIZE	MT7915_RX_RING_SIZE
+#define MT7915_KITE_RING_REG_SIZE	0x10
+
+/* The vendor Kite RX metadata and reset protocol still need board validation.
+ * Loading Clanker firmware does not require transferring WiFi ring ownership.
+ * Keep normal mt7915 RX as the default until that protocol is complete.
+ */
+static bool npu_enable;
+module_param(npu_enable, bool, 0400);
+MODULE_PARM_DESC(npu_enable, "Experimental Kite RX ownership (default off)");
+
+static struct airoha_npu *mt7915_npu(struct mt7915_dev *dev)
+{
+	return rcu_access_pointer(dev->mt76.mmio.npu);
+}
+
+static bool mt7915_npu_present(struct mt7915_dev *dev)
+{
+	struct device_node *np = dev->mt76.dev->of_node;
+	struct device_node *npu;
+
+	if (!npu_enable || !is_mt7916(&dev->mt76) || !np)
+		return false;
+
+	npu = of_parse_phandle(np, "airoha,npu", 0);
+	if (!npu)
+		return false;
+	of_node_put(npu);
+
+	return true;
+}
+
+static int mt7915_npu_set(struct mt7915_dev *dev, int band,
+			  enum airoha_npu_wlan_set_cmd cmd, u32 val)
+{
+	struct airoha_npu *npu = mt7915_npu(dev);
+
+	if (!npu)
+		return -ENODEV;
+
+	return mt76_npu_send_msg(npu, band, cmd, val, GFP_KERNEL);
+}
+
+static int mt7915_npu_program_band(struct mt7915_dev *dev, u8 band,
+				   struct mt76_queue *q, u32 ring_reg)
+{
+	struct airoha_npu *npu = mt7915_npu(dev);
+	u32 rxdesc_base;
+	int ret;
+
+	/* SET 0 is the WiFi ring's BAR register address. */
+	ret = mt7915_npu_set(dev, band, WLAN_FUNC_SET_WAIT_PCIE_ADDR,
+			     lower_32_bits(dev->pcie_bar0 + ring_reg));
+	if (ret)
+		return ret;
+
+	/* SET 1 is the number of 16-byte descriptors, not a DMA address. */
+	ret = mt7915_npu_set(dev, band, WLAN_FUNC_SET_WAIT_DESC,
+			     MT7915_KITE_RX_RING_SIZE);
+	if (ret)
+		return ret;
+
+	ret = mt76_npu_get_msg(npu, band, WLAN_FUNC_GET_WAIT_RXDESC_BASE,
+			       &rxdesc_base, GFP_KERNEL);
+	if (ret)
+		return ret;
+
+	/* Clanker allocated the descriptor block in NPU SRAM. Point the MT7916
+	 * ring register at the returned address and leave the Linux shadow ring
+	 * unused while Kite is active. */
+	writel(rxdesc_base, &q->regs->desc_base);
+
+	dev_info(dev->mt76.dev, "Kite band%u RX descriptors at 0x%08x\n",
+		 band, rxdesc_base);
+	return 0;
+}
+
+int mt7915_npu_init(struct mt7915_dev *dev)
+{
+	struct device_node *np = dev->mt76.dev->of_node;
+	u32 port_type = 2;
+	int ret;
+
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_SOC_WED)
+	/* WED and Kite cannot consume the same MT7916 RX rings.  Leave WED in
+	 * charge when it attached successfully and keep NPU firmware idle. */
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed)) {
+		dev_warn(dev->mt76.dev,
+			 "Kite NPU disabled because WED owns the MT7916 RX rings\n");
+		return 0;
+	}
+#endif
+
+	if (!mt7915_npu_present(dev))
+		return 0;
+
+	dev_warn(dev->mt76.dev,
+		 "Experimental Kite RX: reset and firmware stop are not validated\n");
+
+	if (of_property_read_u32(np, "airoha,npu-pcie-port-type", &port_type))
+		dev_info(dev->mt76.dev,
+			 "Kite PCIe port type not specified, using %u\n", port_type);
+	if (port_type > 3)
+		return -EINVAL;
+
+	ret = mt76_npu_init(&dev->mt76, dev->pcie_bar0,
+				    MT76_NPU_TYPE_KITE);
+	if (ret)
+		return ret;
+
+	/* Clanker uses model 2 for MT7916D DBDC and fast flag bit 0 for the
+	 * AN7581 pipeline.  The PCIe port type selects the two inbound windows. */
+	ret = mt7915_npu_set(dev, 0, WLAN_FUNC_SET_WAIT_DRIVER_MODEL, 2);
+	if (ret)
+		goto err_deinit;
+	ret = mt7915_npu_set(dev, 0, WLAN_FUNC_SET_WAIT_PCIE_PORT_TYPE,
+			     port_type);
+	if (ret)
+		goto err_deinit;
+	ret = mt7915_npu_set(dev, 0, WLAN_FUNC_SET_WAIT_FAST_FLAG, 1);
+	if (ret)
+		goto err_deinit;
+
+	dev_info(dev->mt76.dev, "Kite NPU profile enabled (port type %u)\n",
+		 port_type);
+	return 0;
+
+err_deinit:
+	mt76_npu_deinit(&dev->mt76);
+	return ret;
+}
+
+int mt7915_npu_start(struct mt7915_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	u32 hif1_ofs = dev->hif2 ? MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0) : 0;
+	int ret;
+
+	if (!mt76_npu_device_active(mdev))
+		return 0;
+
+	ret = mt76_npu_rx_queue_init(mdev, &mdev->q_rx[MT_RXQ_NPU0]);
+	if (ret)
+		return ret;
+	if (dev->dbdc_support) {
+		ret = mt76_npu_rx_queue_init(mdev, &mdev->q_rx[MT_RXQ_NPU1]);
+		if (ret)
+			return ret;
+	}
+
+
+	ret = mt7915_npu_program_band(dev, 0, &mdev->q_rx[MT_RXQ_MAIN],
+				      MT_RXQ_RING_BASE(MT_RXQ_MAIN) +
+				      MT_RXQ_ID(MT_RXQ_MAIN) * MT7915_KITE_RING_REG_SIZE);
+	if (ret)
+		return ret;
+
+	if (dev->dbdc_support) {
+		ret = mt7915_npu_program_band(dev, 1,
+					      &mdev->q_rx[MT_RXQ_BAND1],
+					      MT_RXQ_RING_BASE(MT_RXQ_BAND1) +
+					      MT_RXQ_ID(MT_RXQ_BAND1) * MT7915_KITE_RING_REG_SIZE +
+					      hif1_ofs);
+		if (ret)
+			return ret;
+	}
+
+	/* Enable each band after its ring is populated.  SET 3 is deliberately
+	 * left to the station/interface control path: value 1 means force every
+	 * frame to the host and would disable the Kite forwarding path. */
+	ret = mt7915_npu_set(dev, 0, WLAN_FUNC_SET_WAIT_PCIE_STATE, 1);
+	if (ret)
+		return ret;
+	if (dev->dbdc_support) {
+		ret = mt7915_npu_set(dev, 1, WLAN_FUNC_SET_WAIT_PCIE_STATE, 1);
+		if (ret)
+			return ret;
+	}
+
+
+	/* The WiFi data IRQs now belong to Clanker.  Keep the normal Linux queue
+	 * objects as shadows for teardown and recovery, but do not schedule their
+	 * host RX pollers. */
+	mt7915_dual_hif_set_irq_mask(dev, true,
+				    MT_INT_RX(MT_RXQ_MAIN) |
+				    MT_INT_RX(MT_RXQ_BAND1), 0);
+
+	airoha_npu_wlan_enable_irq(mt7915_npu(dev), 0);
+	if (dev->dbdc_support)
+		airoha_npu_wlan_enable_irq(mt7915_npu(dev), 1);
+
+	dev_info(dev->mt76.dev, "Kite host-adaptor RX queues ready\n");
+	return 0;
+}
+
+int mt7915_npu_ba_set(struct mt7915_dev *dev, u8 band, u16 wcid,
+		      u8 tid, u16 ssn, u16 win_size)
+{
+	u32 val;
+
+	if (!mt76_npu_device_active(&dev->mt76))
+		return 0;
+	if (!wcid || wcid > 255 || tid > 7 || win_size > 511 || ssn > 4095)
+		return -ERANGE;
+
+	/* Clanker SET_WAIT 4: tid[2:0], wcid[10:3], window[19:11],
+	 * starting sequence number[31:20].  A zero window/SSN resets the entry. */
+	val = FIELD_PREP(GENMASK(2, 0), tid) |
+	      FIELD_PREP(GENMASK(10, 3), wcid) |
+	      FIELD_PREP(GENMASK(19, 11), win_size) |
+	      FIELD_PREP(GENMASK(31, 20), ssn);
+
+	return mt7915_npu_set(dev, band, WLAN_FUNC_SET_WAIT_BA_WIN_SIZE, val);
+}
+
+int mt7915_npu_sta_del(struct mt7915_dev *dev, u8 band, u16 wcid)
+{
+	if (!mt76_npu_device_active(&dev->mt76))
+		return 0;
+	if (!wcid || wcid > 255)
+		return -ERANGE;
+
+	return mt7915_npu_set(dev, band, WLAN_FUNC_SET_WAIT_DEL_STA, wcid);
+}
+
