+static void mt7915_kite_aggregation_sta(struct seq_file *m, struct mt7915_dev *dev,
+                                      struct mt7915_sta *msta, unsigned int i)
+{
+ struct mt76_wcid *wcid = &msta->wcid;
+ unsigned int j;
+ seq_printf(m, "r73_peer%u band=%u generation=%u key_generation=%u\n", i,
+  wcid->phy_idx, dev->kite.generation[i], dev->kite.key_generation[i]);
+  for (j = 0; j < 8; j++) {
+   struct mt7915_kite_ba_wait b;
+   spin_lock_bh(&dev->kite.dp_done_lock); b = msta->npu_ba_wait[j];
+   spin_unlock_bh(&dev->kite.dp_done_lock);
+   if (b.starts || b.stops || b.operational)
+    seq_printf(m,"r69_ba%u_%u starts=%u operational=%u stops=%u failures=%u action=%u result=%d started_ns=%llu last_ns=%llu elapsed_ns=%llu max_ns=%llu\n",
+     i,j,b.starts,b.operational,b.stops,b.failures,b.action,b.result,b.started_ns,b.last_ns,b.elapsed_ns,b.max_ns);
+  }
+  seq_printf(m, "r59_agg%u peer_max_bytes=%u native_enabled=%u native_max_subframes=8 tids=%u",
+             i, msta->npu_amsdu_len, wcid->amsdu, msta->npu_amsdu_tids);
+  for (j = 0; j < 8; j++) seq_printf(m, " ba%u=%u", j, msta->npu_ba_window[j]);
+  seq_putc(m, '\n');
+  seq_printf(m,"r66_agg%u mcu_acked=%u enable=%u max_subframes=%u mpdu_code=%u\n",
+   i,msta->npu_amsdu_mcu_acked,msta->npu_amsdu_mcu&0xff,
+   (msta->npu_amsdu_mcu>>8)&0xff,(msta->npu_amsdu_mcu>>16)&0xff);
+  seq_printf(m,"r60_wtbl%u valid=%u age_jiffies=%lu",i,
+   READ_ONCE(msta->npu_wtbl_valid),jiffies-READ_ONCE(msta->npu_wtbl_at));
+  for (j=0;j<10;j++) seq_printf(m," dw%u=%08x",j,READ_ONCE(msta->npu_wtbl[j]));
+  seq_putc(m,'\n');
+  /* Native station polling owns the bank selector. Ask it for a bounded
+   * snapshot; diagnostics must not race NAPI by selecting a WTBL bank. */
+  WRITE_ONCE(msta->npu_wtbl_pending,true);
+}
