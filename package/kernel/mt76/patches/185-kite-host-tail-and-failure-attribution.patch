+/* Only failed MPDUs take this path. PAIR/header/end boundaries close the
+ * previous MPDU; following MSDU IDs describe source, not successful ACKs.
+ * Missing pair/token evidence remains explicit unknown. */
+void mt7915_npu_wa_failure_end(struct mt7915_dev *dev, struct mt7915_kite_wa_batch *b)
+{
+ unsigned long flags;
+ struct mt7915_kite_failed_event *e = &b->failed;
+ u32 band, source;
+ if (!b->failed_active) return;
+ band = e->band < 2 ? e->band : 2;
+ source = e->source & 3;
+ spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+ e->serial = ++dev->kite.failed_serial;
+ dev->kite.failed_class[band][source]++;
+ if (e->wcid < MT7916_WTBL_SIZE) {
+  struct mt7915_kite_failed_wcid *w = &dev->kite.failed_wcid[e->wcid];
+  if (w->generation != e->generation) {
+   memset(w, 0, sizeof(*w)); w->generation = e->generation;
+  }
+  w->count[source]++;
+ }
+ dev->kite.failed_events[(e->serial - 1) & 31] = *e;
+ spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+ b->failed_active = false;
+}
+void mt7915_npu_wa_failure_start(struct mt7915_dev *dev, struct mt7915_kite_wa_batch *b,
+                               struct mt76_wcid *wcid, u16 idx, u32 info, u32 txd)
+{
+ struct mt7915_kite_failed_event *e = &b->failed;
+ memset(e, 0, sizeof(*e));
+ e->ns = ktime_get_mono_fast_ns(); e->session = READ_ONCE(dev->kite.session);
+ e->wcid = idx; e->band = wcid ? wcid->phy_idx : 0xff;
+ e->peer = wcid && wcid->sta; e->info = info; e->txd = txd;
+ if (idx < MT7916_WTBL_SIZE) e->generation = READ_ONCE(dev->kite.generation[idx]);
