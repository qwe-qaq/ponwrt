+static int mt7915_kite_events_show(struct seq_file *m, void *unused)
+{
+	struct mt7915_dev *dev = m->private;
+	unsigned long flags;
+	u32 head, count, i;
+
+	spin_lock_irqsave(&dev->kite.trace_lock, flags);
+	head = dev->kite.trace_head;
+	count = min_t(u32, head, MT7915_KITE_TRACE_RING);
+	seq_printf(m, "events_abi=1 head=%u count=%u capacity=%u\n", head,
+		   count, MT7915_KITE_TRACE_RING);
+	for (i = 0; i < count; i++) {
+		u32 index = (head - count + i) & (MT7915_KITE_TRACE_RING - 1);
+		struct mt7915_kite_trace_event *entry = &dev->kite.trace_ring[index];
+
+		seq_printf(m,
+			"event seq=%u type=%u band=%u state=%u error=%d session=%u epoch=%u age_ms=%lu\n",
+			READ_ONCE(entry->seq), entry->event, entry->band, entry->state,
+			entry->error, entry->session, entry->epoch,
+			entry->at ? jiffies_to_msecs(jiffies - entry->at) : 0UL);
+	}
+	spin_unlock_irqrestore(&dev->kite.trace_lock, flags);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mt7915_kite_events);
