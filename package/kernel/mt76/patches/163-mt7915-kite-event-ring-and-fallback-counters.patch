+/* A bounded transition history makes a drop/recovery diagnosable after
+ * printk rotation without adding a printk to the packet path.  The writer is
+ * used from control, workqueue and radio callbacks, so the ring has its own
+ * short IRQ-safe lock.  Readers hold the same lock while formatting it. */
+void mt7915_kite_trace_event(struct mt7915_dev *dev, u32 event, u32 band,
+			     u32 state, int error)
+{
+	struct mt7915_kite_trace_event *entry;
+	unsigned long flags;
+	u32 seq, index;
+
+	spin_lock_irqsave(&dev->kite.trace_lock, flags);
+	seq = ++dev->kite.trace_head;
+	index = (seq - 1) & (MT7915_KITE_TRACE_RING - 1);
+	entry = &dev->kite.trace_ring[index];
+	entry->event = event;
+	entry->band = band;
+	entry->state = state;
+	entry->error = error;
+	entry->session = dev->kite.session;
+	entry->epoch = dev->kite.dp_epoch;
+	entry->at = jiffies;
+	/* Publish the sequence last. */
+	WRITE_ONCE(entry->seq, seq);
+	spin_unlock_irqrestore(&dev->kite.trace_lock, flags);
+}
