+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PONWRT_KITE_CONTROL_H
+#define PONWRT_KITE_CONTROL_H
+
+/* Separate from GET31's DMA/secure-forwarding capability mask. All words
+ * are little endian. SET33/GET33 carry exactly 64 bytes after WLAN header.
+ * A mailbox DONE acknowledges delivery; GET33 reports the command result.
+ */
+#define KITE_CTL_MAGIC 0x4b430001u
+#define KITE_CTL_WORDS 16u
+#define KITE_CTL_WCIDS 544u
+#define KITE_CTL_TIDS 8u
+#define KITE_CTL_BA_BYTES (KITE_CTL_WCIDS * KITE_CTL_TIDS * 28u)
+#define KITE_CTL_STA_BYTES (KITE_CTL_WCIDS * 32u)
+#define KITE_CTL_STORAGE_BYTES (KITE_CTL_BA_BYTES + KITE_CTL_STA_BYTES)
+#define KITE_CTL_BA_OFFSET 0x30000u /* above 5000 legacy 36-byte nodes */
+#define KITE_CTL_DRAM_BYTES (KITE_CTL_BA_OFFSET + KITE_CTL_STORAGE_BYTES)
+
+#define KITE_CTL_CAP_WCID544 1u
+#define KITE_CTL_CAP_GENERATION 2u
+#define KITE_CTL_CAP_PARK 4u
+#define KITE_CTL_CAP_KEY_FENCE 8u
+#define KITE_CTL_CAPS 15u
+#define KITE_CTL_WORKERS 0x0eu /* AN7581 MT7916 harts 1, 2, 3 */
+
+/* Request words: magic, words, command, session, serial, then args.
+ * All unused words must be zero. Session and serial never wrap.
+ */
+enum kite_ctl_op {
+	KITE_CTL_OPEN = 1, /* new session; arg0=BA DRAM address, arg1=size */
+	KITE_CTL_PARK, /* async cooperative park; no DMA drain claim */
+	KITE_CTL_RESUME,
+	KITE_CTL_STA_ADD, /* wcid, generation, band, bss */
+	KITE_CTL_STA_DEL, /* wcid, generation */
+	KITE_CTL_PORT, /* wcid, generation, authorized */
+	KITE_CTL_KEY, /* wcid, generation, key generation, cipher, keyid */
+	KITE_CTL_BA, /* wcid, generation, tid, window (0=DELBA), SSN */
+	KITE_CTL_CLOSE,
+};
+enum kite_ctl_result {
+	KITE_CTL_OK,
+	KITE_CTL_INVALID,
+	KITE_CTL_STALE,
+	KITE_CTL_BUSY,
+	KITE_CTL_NO_MEMORY,
+	KITE_CTL_NOT_FOUND,
+};
+enum kite_ctl_state {
+	KITE_CTL_CLOSED,
+	KITE_CTL_RUNNING,
+	KITE_CTL_PARKING,
+	KITE_CTL_PARKED,
+};
+/* Reply: magic, words, capabilities, session, last serial, result, state,
+ * ack mask, WCID count, required DRAM bytes, accepted commands, rejected
+ * commands, live STAs, active BA sessions, key fences, reserved zero.
+ */
+
+#ifndef __KERNEL__
+#if defined(AN7581) && defined(MT7916)
+int kite_ctl_set(u32 *msg, u32 bytes);
+int kite_ctl_get(u32 *msg, u32 bytes);
+int kite_ctl_pausepoint(u32 hart);
+u32 kite_ctl_ba_address(u32 band, u32 wcid, u32 tid);
+int kite_ctl_active(void);
+int kite_ctl_sta_matches(u32 band, u32 wcid, u32 bss);
+int kite_ctl_rx_held(void);
+int kite_ctl_legacy_setup(u32 cmd, u32 band);
+void ba_discard_entry(u32 *entry);
+#else
+static inline int kite_ctl_pausepoint(u32 hart) { (void)hart; return 0; }
+static inline int kite_ctl_active(void) { return 0; }
+static inline int kite_ctl_rx_held(void) { return 0; }
+#endif
+#endif
+#endif
