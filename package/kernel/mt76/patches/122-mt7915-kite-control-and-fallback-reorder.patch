--- /dev/null
+++ b/mt7915/npu-control.c
@@ -0,0 +1,296 @@
+// SPDX-License-Identifier: ISC
+/* GET/SET33 control transactions. This does not grant DMA ownership. */
+#include <linux/delay.h>
+#include <linux/of_reserved_mem.h>
+#include "mt7915.h"
+#include "kite-control.h"
+
+static int mt7915_kite_status(struct mt7915_dev *dev, u32 *s)
+{
+	struct airoha_npu *npu = rcu_access_pointer(dev->mt76.mmio.npu);
+	__le32 wire[KITE_CTL_WORDS];
+	int i, ret;
+
+	if (!npu)
+		return -ENODEV;
+	ret = airoha_npu_wlan_get_msg(npu, 0,
+		(enum airoha_npu_wlan_get_cmd)33, wire, sizeof(wire), GFP_KERNEL);
+	if (ret)
+		return ret;
+	for (i = 0; i < KITE_CTL_WORDS; i++)
+		s[i] = le32_to_cpu(wire[i]);
+	if (s[0] != KITE_CTL_MAGIC || s[1] != KITE_CTL_WORDS ||
+	    s[8] != KITE_CTL_WCIDS || s[9] != KITE_CTL_DRAM_BYTES || s[15])
+		return -EPROTO;
+	return 0;
+}
+
+static int mt7915_kite_result(u32 result)
+{
+	switch (result) {
+	case KITE_CTL_OK: return 0;
+	case KITE_CTL_INVALID: return -EINVAL;
+	case KITE_CTL_STALE: return -ESTALE;
+	case KITE_CTL_BUSY: return -EBUSY;
+	case KITE_CTL_NO_MEMORY: return -ENOMEM;
+	case KITE_CTL_NOT_FOUND: return -ENOENT;
+	default: return -EPROTO;
+	}
+}
+
+static int mt7915_kite_command(struct mt7915_dev *dev, u32 op,
+			       const u32 *args, unsigned int nargs)
+{
+	struct airoha_npu *npu = rcu_access_pointer(dev->mt76.mmio.npu);
+	__le32 wire[KITE_CTL_WORDS] = {};
+	u32 s[KITE_CTL_WORDS];
+	int i, ret;
+
+	lockdep_assert_held(&dev->kite.lock);
+	if (!npu || dev->kite.failed)
+		return -EIO;
+	if (nargs > KITE_CTL_WORDS - 5 || dev->kite.serial == U32_MAX)
+		return -EOVERFLOW;
+	wire[0] = cpu_to_le32(KITE_CTL_MAGIC);
+	wire[1] = cpu_to_le32(KITE_CTL_WORDS);
+	wire[2] = cpu_to_le32(op);
+	wire[3] = cpu_to_le32(dev->kite.session);
+	wire[4] = cpu_to_le32(++dev->kite.serial);
+	for (i = 0; i < nargs; i++)
+		wire[5 + i] = cpu_to_le32(args[i]);
+	ret = airoha_npu_wlan_send_msg(npu, 0,
+		(enum airoha_npu_wlan_set_cmd)33, wire, sizeof(wire), GFP_KERNEL);
+	if (ret)
+		return ret;
+	ret = mt7915_kite_status(dev, s);
+	if (ret)
+		return ret;
+	if (s[3] != dev->kite.session || s[4] != dev->kite.serial)
+		return -EPROTO;
+	return mt7915_kite_result(s[5]);
+}
+
+static int mt7915_kite_wait_parked(struct mt7915_dev *dev)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(250);
+	u32 s[KITE_CTL_WORDS];
+	int ret;
+
+	do {
+		ret = mt7915_kite_status(dev, s);
+		if (ret)
+			return ret;
+		if (s[3] != dev->kite.session || s[4] != dev->kite.serial)
+			return -EPROTO;
+		if (s[6] == KITE_CTL_PARKED && s[7] == KITE_CTL_WORKERS)
+			return 0;
+		usleep_range(1000, 2000);
+	} while (time_before(jiffies, deadline));
+	return -ETIMEDOUT;
+}
+
+static int mt7915_kite_fault(struct mt7915_dev *dev, int ret)
+{
+	dev->kite.failed = true;
+	dev_err(dev->mt76.dev,
+		"Kite control failed (%d), session %u command %u; control halted, DMA drain unconfirmed\n",
+		ret, dev->kite.session, dev->kite.serial);
+	return ret;
+}
+
+int mt7915_npu_control_open(struct mt7915_dev *dev)
+{
+	struct airoha_npu *npu = rcu_access_pointer(dev->mt76.mmio.npu);
+	u32 s[KITE_CTL_WORDS], args[2];
+	struct resource res;
+	int ret;
+
+	if (!npu)
+		return 0;
+	mutex_lock(&dev->kite.lock);
+	ret = mt7915_kite_status(dev, s);
+	if (ret)
+		goto out;
+	if ((s[2] & KITE_CTL_CAPS) != KITE_CTL_CAPS ||
+	    s[6] != KITE_CTL_CLOSED || s[3] == U32_MAX) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	ret = of_reserved_mem_region_to_resource_byname(npu->dev->of_node,
+						       "ba", &res);
+	if (ret)
+		goto out;
+	if (!res.start || res.start & 4095 || res.end >= SZ_1G ||
+	    resource_size(&res) != SZ_2M) {
+		ret = -EINVAL;
+		goto out;
+	}
+	args[0] = res.start;
+	args[1] = resource_size(&res);
+	dev->kite.session = s[3] + 1;
+	dev->kite.serial = 0;
+	ret = mt7915_kite_command(dev, KITE_CTL_OPEN, args, 2);
+	if (!ret) {
+		dev->kite.active = true;
+		ret = mt7915_kite_wait_parked(dev);
+	}
+	if (ret)
+		mt7915_kite_fault(dev, ret);
+	else
+		dev_info(dev->mt76.dev,
+			 "Kite control ABI 1: 544 WCIDs, generation/key fences, workers parked; DMA drain not implied\n");
+out:
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
+
+int mt7915_npu_control_resume(struct mt7915_dev *dev)
+{
+	int ret;
+
+	if (!dev->kite.active)
+		return 0;
+	mutex_lock(&dev->kite.lock);
+	ret = mt7915_kite_command(dev, KITE_CTL_RESUME, NULL, 0);
+	if (ret)
+		mt7915_kite_fault(dev, ret);
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
+
+/* Every update is one serialized PARK -> all workers ACK -> mutation ->
+ * RESUME transaction. A failed/timed-out request never permits speculative
+ * resume or reclaim; a timeout can leave the park status unconfirmed. */
+static int mt7915_kite_update(struct mt7915_dev *dev, u32 op,
+			     const u32 *args, unsigned int nargs)
+{
+	int ret;
+
+	lockdep_assert_held(&dev->kite.lock);
+	ret = mt7915_kite_command(dev, KITE_CTL_PARK, NULL, 0);
+	if (!ret)
+		ret = mt7915_kite_wait_parked(dev);
+	if (!ret)
+		ret = mt7915_kite_command(dev, op, args, nargs);
+	if (!ret)
+		ret = mt7915_kite_command(dev, KITE_CTL_RESUME, NULL, 0);
+	if (ret)
+		mt7915_kite_fault(dev, ret);
+	return ret;
+}
+
+int mt7915_npu_sta_add(struct mt7915_dev *dev, struct mt7915_sta *msta)
+{
+	u32 idx = msta->wcid.idx, args[4];
+	int ret = 0;
+
+	if (!dev->kite.active)
+		return 0;
+	if (!idx || idx >= KITE_CTL_WCIDS)
+		return -ERANGE;
+	mutex_lock(&dev->kite.lock);
+	if (dev->kite.generation[idx] == U32_MAX) {
+		ret = mt7915_kite_fault(dev, -EOVERFLOW);
+		goto out;
+	}
+	args[0] = idx;
+	args[1] = ++dev->kite.generation[idx];
+	args[2] = msta->vif->phy->mt76->band_idx;
+	args[3] = msta->vif->mt76.idx;
+	ret = mt7915_kite_update(dev, KITE_CTL_STA_ADD, args, 4);
+	if (!ret)
+		dev->kite.key_generation[idx] = 0;
+out:
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
+
+int mt7915_npu_sta_del(struct mt7915_dev *dev, u8 band, u16 wcid)
+{
+	u32 args[2];
+	int ret;
+
+	if (!dev->kite.active)
+		return 0;
+	if (!wcid || wcid >= KITE_CTL_WCIDS)
+		return -ERANGE;
+	mutex_lock(&dev->kite.lock);
+	args[0] = wcid;
+	args[1] = dev->kite.generation[wcid];
+	ret = mt7915_kite_update(dev, KITE_CTL_STA_DEL, args, 2);
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
+
+int mt7915_npu_port(struct mt7915_dev *dev, struct mt7915_sta *msta,
+		    bool authorized)
+{
+	u32 idx = msta->wcid.idx, args[3];
+	int ret;
+
+	if (!dev->kite.active)
+		return 0;
+	if (!idx || idx >= KITE_CTL_WCIDS)
+		return -ERANGE;
+	mutex_lock(&dev->kite.lock);
+	args[0] = idx;
+	args[1] = dev->kite.generation[idx];
+	args[2] = authorized;
+	ret = mt7915_kite_update(dev, KITE_CTL_PORT, args, 3);
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
+
+int mt7915_npu_key(struct mt7915_dev *dev, struct mt76_wcid *wcid,
+		   struct ieee80211_key_conf *key, bool install)
+{
+	u32 idx = wcid->idx, args[5];
+	int ret;
+
+	if (!dev->kite.active)
+		return 0;
+	/* Group/management key replay stays entirely in mac80211. */
+	if (!(key->flags & IEEE80211_KEY_FLAG_PAIRWISE) ||
+	    key->cipher == WLAN_CIPHER_SUITE_AES_CMAC)
+		return 0;
+	if (!idx || idx >= KITE_CTL_WCIDS)
+		return -ERANGE;
+	mutex_lock(&dev->kite.lock);
+	if (dev->kite.key_generation[idx] == U32_MAX) {
+		ret = mt7915_kite_fault(dev, -EOVERFLOW);
+		goto out;
+	}
+	args[0] = idx;
+	args[1] = dev->kite.generation[idx];
+	args[2] = ++dev->kite.key_generation[idx];
+	args[3] = install ? key->cipher : 0;
+	args[4] = install ? key->keyidx : U32_MAX;
+	/* Firmware rejects live RX key changes until WFDMA can be drained.
+	 * It must never treat this metadata as replay validation authority. */
+	ret = mt7915_kite_update(dev, KITE_CTL_KEY, args, 5);
+out:
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
+
+int mt7915_npu_ba_set(struct mt7915_dev *dev, u8 band, u16 wcid,
+		      u8 tid, u16 ssn, u16 win_size)
+{
+	u32 args[5];
+	int ret;
+
+	if (!dev->kite.active)
+		return 0;
+	if (!wcid || wcid >= KITE_CTL_WCIDS || tid >= KITE_CTL_TIDS ||
+	    win_size > 256 || ssn > 4095 || (!win_size && ssn))
+		return -ERANGE;
+	mutex_lock(&dev->kite.lock);
+	args[0] = wcid;
+	args[1] = dev->kite.generation[wcid];
+	args[2] = tid;
+	args[3] = win_size;
+	args[4] = ssn;
+	ret = mt7915_kite_update(dev, KITE_CTL_BA, args, 5);
+	mutex_unlock(&dev->kite.lock);
+	return ret;
+}
