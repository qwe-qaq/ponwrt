 			b, s->rx_ppe[b], s->stats[b].rx_bytes, s->rx_host[b], s->rx_miss[b],
 			s->rx_free[b], s->rx_replay[b], s->rx_stale[b], s->rx_unsupported[b],
 			s->stats[b].rx_policy_hit, s->stats[b].rx_policy_miss, s->stats[b].rx_tdma_full,
+			s->stats[b].reserved[KDP_STAT_BRIDGE_HIT],
+			s->stats[b].reserved[KDP_STAT_BRIDGE_MISS],
+			s->stats[b].reserved[KDP_STAT_HOST_FALLBACK],
+			s->stats[b].reserved[KDP_STAT_HOST_FALLBACK_DROP],
 			s->tx_sent[b], s->stats[b].tx_bytes, s->tx_freed[b], s->tx_drop[b],
