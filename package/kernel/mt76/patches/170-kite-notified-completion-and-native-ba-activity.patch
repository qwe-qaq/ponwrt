+ if (msta->npu_ba_generation != gen || msta->npu_ba_key != key || msta->npu_ba_tag != tag) {
+  memset(msta->npu_ba_seen, 0, sizeof(msta->npu_ba_seen));
+  memset(msta->npu_ba_timer_seen, 0, sizeof(msta->npu_ba_timer_seen));
+  memset(msta->npu_ba_retry, 0, sizeof(msta->npu_ba_retry));
+  msta->npu_ba_generation = gen; msta->npu_ba_key = key; msta->npu_ba_tag = tag;
+ }
+ *packets = count;
+ return true;
+}
+
+bool mt7915_npu_tx_activity(struct ieee80211_hw *hw, struct ieee80211_sta *sta, u8 tid)
+{
+ struct mt7915_dev *dev = mt7915_hw_dev(hw);
+ struct mt7915_sta *msta = (void *)sta->drv_priv;
+ unsigned long flags;
+ u32 count;
+ bool active = false;
+
+ if (!READ_ONCE(dev->kite.dp_bound)) return false;
+ spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+ if (mt7915_kite_activity(dev, msta, tid, &count) &&
+     count != msta->npu_ba_timer_seen[tid]) {
+  msta->npu_ba_timer_seen[tid] = count;
+  dev->kite.ba_timer_refresh++;
+  active = true;
+ }
+ spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+ return active;
+}
+
+void mt7915_npu_ba_event(struct ieee80211_hw *hw, struct ieee80211_sta *sta,
+                        u8 tid, u8 event, u16 value, u16 timeout)
+{
+ struct mt7915_dev *dev = mt7915_hw_dev(hw);
+ struct mt7915_sta *msta = (void *)sta->drv_priv;
+ unsigned long flags;
+ u32 count;
+ if (!READ_ONCE(dev->kite.dp_bound) || tid >= 8) return;
+ /* Seed a newly operational session so earlier traffic cannot keep an
+  * otherwise idle session alive. A new packet after this snapshot counts. */
+ if (event == 4 && !value) {
+  spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+  if (mt7915_kite_activity(dev, msta, tid, &count))
+   msta->npu_ba_timer_seen[tid] = count;
+  spin_unlock_irqrestore(&dev->kite.dp_done_lock, flags);
+ }
+ if (event == 4) return; /* driver records signed MCU result separately */
+ /* event1=response, 2=peer DELBA, 3=local inactivity; WCID, timeout/TID,
+  * status/reason. No packet log, no client address or key material. */
+ mt7915_kite_trace_event(dev, 18 + event, msta->wcid.idx,
+                          ((u32)timeout << 16) | tid, value);
