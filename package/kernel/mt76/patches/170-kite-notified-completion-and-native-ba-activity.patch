+static void mt7915_kite_ba_station(void *data, struct ieee80211_sta *sta)
+{
+ struct mt7915_dev *dev = data;
+ struct mt7915_sta *msta = (void *)sta->drv_priv;
+ unsigned int tid;
+ if (!sta->wme || !(sta->deflink.ht_cap.ht_supported || sta->deflink.he_cap.has_he)) return;
+ for (tid = 0; tid < 8; tid++) {
+  unsigned long flags;
+  u32 count;
+  bool changed = false, start = false;
+  int ret;
+  spin_lock_irqsave(&dev->kite.dp_done_lock, flags);
+  if (mt7915_kite_activity(dev, msta, tid, &count) && count != msta->npu_ba_seen[tid]) {
