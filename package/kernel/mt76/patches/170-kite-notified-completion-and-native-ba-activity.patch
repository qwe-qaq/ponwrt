+/* SPDX-License-Identifier: ISC */
+/* Activity is real WFDMA publication, independent of delayed WA reports.
+ * All snapshots and observer cursors use dp_done_lock. The timer callback
+ * cannot sleep; BA start is invoked after dropping that lock, under RCU. */
+static bool mt7915_kite_activity(struct mt7915_dev *dev, struct mt7915_sta *msta,
+                                 u8 tid, u32 *packets)
+{
+ struct kdp_shared *s = READ_ONCE(dev->mt76.kite_dp);
+ struct kdp_tx_activity *a;
+ struct kdp_sta *p;
+ u32 wi = msta->wcid.idx, seq, gen, key, tag, count;
+
+ lockdep_assert_held(&dev->kite.dp_done_lock);
+ if (!s || tid >= 8 || !wi || wi >= KDP_WCIDS ||
+     !READ_ONCE(dev->kite.dp_bound) || !READ_ONCE(dev->kite.live[wi]) ||
+     READ_ONCE(dev->kite.dp_work_stopping) || READ_ONCE(dev->kite.failed) ||
+     READ_ONCE(s->session) != dev->kite.session || READ_ONCE(s->epoch) != dev->kite.dp_epoch ||
+     !READ_ONCE(s->enabled) || READ_ONCE(s->gate) || kdp_failed(s)) return false;
+ p = &s->sta[wi]; a = &s->activity[wi];
+ seq = READ_ONCE(a->seq);
+ if (!seq || (seq & 1)) return false;
+ dma_rmb();
+ gen = READ_ONCE(a->generation); key = READ_ONCE(a->key_generation);
+ tag = READ_ONCE(a->tag); count = READ_ONCE(a->packets[tid]);
+ if (!gen || gen != READ_ONCE(dev->kite.generation[wi]) ||
+     key != READ_ONCE(dev->kite.key_generation[wi]) ||
+     gen != READ_ONCE(p->generation) || key != READ_ONCE(p->key_generation) ||
+     !tag || tag != READ_ONCE(p->tx_tag) || !READ_ONCE(p->enabled) ||
+     !READ_ONCE(p->authorized) || READ_ONCE(p->tx_blocked) || !READ_ONCE(p->wme) ||
+     READ_ONCE(p->band) != msta->vif->phy->mt76->band_idx ||
+     READ_ONCE(p->bss) != msta->vif->mt76.idx) return false;
+ dma_rmb();
+ if (seq != READ_ONCE(a->seq) ||
+     !READ_ONCE(s->enabled) || READ_ONCE(s->gate) || kdp_failed(s) ||
+     READ_ONCE(s->session) != dev->kite.session || READ_ONCE(s->epoch) != dev->kite.dp_epoch ||
+     !READ_ONCE(dev->kite.live[wi]) || READ_ONCE(dev->kite.dp_work_stopping) ||
+     gen != READ_ONCE(p->generation) || key != READ_ONCE(p->key_generation) ||
+     tag != READ_ONCE(p->tx_tag) || !READ_ONCE(p->enabled) || !READ_ONCE(p->authorized) ||
+     READ_ONCE(p->tx_blocked)) return false;
