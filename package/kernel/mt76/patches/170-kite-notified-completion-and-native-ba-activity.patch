+    * Publish it before consuming the timer cursor under the same lock as
+    * the expiry query, so expiry cannot see consumed activity + old time. */
+   ieee80211_refresh_tx_agg_session_timer(sta, tid);
+   msta->npu_ba_timer_seen[tid] = count;
+   dev->kite.ba_refresh++;
+   changed = true;
